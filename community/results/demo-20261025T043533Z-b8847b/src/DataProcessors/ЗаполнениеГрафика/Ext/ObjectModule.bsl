Процедура ЗаполнитьГрафик(ДатаНачала, ДатаОкончания, ВыходныеДни) Экспорт
    Если Не ЗначениеЗаполнено(Подразделение) Тогда ВызватьИсключение "Укажите подразделение"; КонецЕсли;
    Если ДатаНачала > ДатаОкончания Тогда ВызватьИсключение "Некорректный период"; КонецЕсли;
    Набор = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей();
    Набор.Отбор.Подразделение.Установить(Подразделение); Набор.Прочитать();
    Дат = НачалоДня(ДатаНачала);
    Пока Дат <= ДатаОкончания Цикл
        Запись = Неопределено;
        Для Каждого С Из Набор Цикл Если С.Дата = Дат Тогда Запись = С; Прервать; КонецЕсли; КонецЦикла;
        Если Запись = Неопределено Тогда Запись = Набор.Добавить(); КонецЕсли;
        Запись.Подразделение = Подразделение; Запись.Дата = Дат;
        Запись.Значение = ?(СтрНайти(ВыходныеДни, Строка(ДеньНедели(Дат))) > 0, 0, 8);
        Запись.Дни = ?(Запись.Значение > 0, 1, 0);
        Дат = Дат + 86400;
    КонецЦикла;
    Набор.Записать();
КонецПроцедуры
