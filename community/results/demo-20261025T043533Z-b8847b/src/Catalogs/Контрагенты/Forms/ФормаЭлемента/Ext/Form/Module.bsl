&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ПостроитьПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)
    МенеджерИзмененНаСервере();
КонецПроцедуры

&НаСервере
Процедура МенеджерИзмененНаСервере()
    СохранитьПоляВОбъект();
    ПостроитьПоля();
КонецПроцедуры

&НаСервере
Процедура СохранитьПоляВОбъект()
    Для Каждого Карта Из КартаПолей Цикл
        Найденные = Объект.ДополнительныеСведения.НайтиСтроки(Новый Структура("Характеристика", Карта.Характеристика));
        Если Найденные.Количество() = 0 Тогда Строка = Объект.ДополнительныеСведения.Добавить();
        Иначе Строка = Найденные[0]; КонецЕсли;
        Строка.Характеристика = Карта.Характеристика;
        Строка.Значение = ЭтотОбъект[Карта.Имя];
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПостроитьПоля()
    Удаляемые = Новый Массив;
    Для Каждого Карта Из КартаПолей Цикл
        Элементы.Удалить(Элементы[Карта.Имя]);
        Удаляемые.Добавить(Карта.Имя);
    КонецЦикла;
    КартаПолей.Очистить();
    Новые = Новый Массив;
    Виды = УчетСервер.ТаблицаЗапроса("ВЫБРАТЬ Характеристика ИЗ Справочник.ФизическиеЛица.ДополнительныеСведения ГДЕ Ссылка = &Менеджер", Новый Структура("Менеджер", Объект.Менеджер));
    Номер = 0;
    Для Каждого Вид Из Виды Цикл
        Если Не ЗначениеЗаполнено(Вид.Характеристика) Тогда Продолжить; КонецЕсли;
        Если КартаПолей.НайтиСтроки(Новый Структура("Характеристика", Вид.Характеристика)).Количество() > 0 Тогда Продолжить; КонецЕсли;
        Номер = Номер + 1; Имя = "ДопПоле" + Формат(Номер, "ЧГ=0");
        Новые.Добавить(Новый РеквизитФормы(Имя, Вид.Характеристика.ТипЗначения, , Строка(Вид.Характеристика), Истина));
        Карта = КартаПолей.Добавить(); Карта.Имя = Имя; Карта.Характеристика = Вид.Характеристика;
    КонецЦикла;
    ИзменитьРеквизиты(Новые, Удаляемые);
    Для Каждого Карта Из КартаПолей Цикл
        Поле = Элементы.Добавить(Карта.Имя, Тип("ПолеФормы"), Элементы.ДополнительныеПоля);
        Поле.Вид = ВидПоляФормы.ПолеВвода; Поле.ПутьКДанным = Карта.Имя;
        Поле.Заголовок = Строка(Карта.Характеристика);
        Найденные = Объект.ДополнительныеСведения.НайтиСтроки(Новый Структура("Характеристика", Карта.Характеристика));
        Если Найденные.Количество() > 0 Тогда ЭтотОбъект[Карта.Имя] = Найденные[0].Значение; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    СохранитьПоляВОбъект();
    ТекущийОбъект.ДополнительныеСведения.Очистить();
    Для Каждого Стр Из Объект.ДополнительныеСведения Цикл
        С = ТекущийОбъект.ДополнительныеСведения.Добавить();
        С.Характеристика = Стр.Характеристика; С.Значение = Стр.Значение;
    КонецЦикла;
КонецПроцедуры
