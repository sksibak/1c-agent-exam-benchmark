Функция ТаблицаЗапроса(Текст, Параметры = Неопределено) Экспорт
    Запрос = Новый Запрос(Текст);
    Если Параметры <> Неопределено Тогда
        Для Каждого П Из Параметры Цикл
            Запрос.УстановитьПараметр(П.Ключ, П.Значение);
        КонецЦикла;
    КонецЕсли;
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ЗаблокироватьРегистр(Имя) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить(Имя);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Функция ОстаткиОУ(Документ) Экспорт
    Подразделения = Новый Массив;
    Если Документ.Метаданные().Имя = "Сборка" Тогда
        Подразделения.Добавить(Документ.ПодразделениеИсточник);
    Иначе
        Для Каждого Стр Из Документ.СписокНоменклатуры Цикл
            Подразделение = ?(ЗначениеЗаполнено(Стр.Подразделение), Стр.Подразделение, Документ.Подразделение);
            Если ЗначениеЗаполнено(Подразделение) И Подразделения.Найти(Подразделение) = Неопределено Тогда Подразделения.Добавить(Подразделение); КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Источник = Новый ТаблицаЗначений; Источник.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
    Для Каждого Подразделение Из Подразделения Цикл Источник.Добавить().Подразделение = Подразделение; КонецЦикла;
    Если Источник.Количество() > 0 Тогда
        Блокировка = Новый БлокировкаДанных;
        Элемент = Блокировка.Добавить("РегистрНакопления.ОстаткиНоменклатуры");
        Элемент.Режим = РежимБлокировкиДанных.Исключительный;
        Элемент.ИсточникДанных = Источник;
        Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
        Блокировка.Заблокировать();
    КонецЕсли;
    Документ.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Документ.Движения.ОстаткиНоменклатуры.Очистить();
    Документ.Движения.ОстаткиНоменклатуры.Записать();
    Возврат ТаблицаЗапроса("ВЫБРАТЬ Подразделение, Номенклатура, Свойство, Партия, ДокументПартии,
    |КоличествоОстаток КАК Количество, СтоимостьОстаток КАК Стоимость
    |ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Граница, Подразделение В (&Подразделения))",
    Новый Структура("Граница,Подразделения", Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая), Подразделения));
КонецФункции

Функция МетодСписания(Подразделение, Дата) Экспорт
    Т = ТаблицаЗапроса("ВЫБРАТЬ Метод ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, Подразделение = &Подразделение)", Новый Структура("Дата,Подразделение", Дата, Подразделение));
    Если Т.Количество() = 0 Тогда
        Возврат Перечисления.УчетнаяПолитика.Средняя;
    КонецЕсли;
    Возврат Т[0].Метод;
КонецФункции

Функция СписатьОУ(Документ, Остатки, Подразделение, Номенклатура, Свойство, Количество, Метод, ВсеСвойства = Ложь) Экспорт
    Если Количество <= 0 Тогда ВызватьИсключение "Количество должно быть положительным"; КонецЕсли;
    Отбор = Новый Структура("Подразделение,Номенклатура", Подразделение, Номенклатура);
    Если Не ВсеСвойства Тогда Отбор.Вставить("Свойство", Свойство); КонецЕсли;
    Строки = Остатки.НайтиСтроки(Отбор);
    Доступно = 0; Стоимость = 0;
    Для Каждого Стр Из Строки Цикл
        Доступно = Доступно + Стр.Количество;
        Стоимость = Стоимость + Стр.Стоимость;
    КонецЦикла;
    Если Доступно < Количество Тогда
        ВызватьИсключение СтрШаблон("Недостаточно %1 в подразделении %2: требуется %3, имеется %4", Номенклатура, Подразделение, Количество, Доступно);
    КонецЕсли;
    // Порядок меняется без обращения к данным документов-партий.
    Остатки.Сортировать(?(Метод = Перечисления.УчетнаяПолитика.ЛИФО, "Партия Убыв, ДокументПартии Убыв", "Партия Возр, ДокументПартии Возр"));
    Строки = Остатки.НайтиСтроки(Отбор);
    Осталось = Количество; Итог = 0;
    Если Метод = Перечисления.УчетнаяПолитика.Средняя Тогда
        ЦелеваяСтоимость = ?(Количество = Доступно, Стоимость, Окр(Стоимость * Количество / Доступно, 2));
    КонецЕсли;
    Для Каждого Стр Из Строки Цикл
        Если Осталось = 0 Тогда Прервать; КонецЕсли;
        Если Стр.Количество <= 0 Тогда Продолжить; КонецЕсли;
        К = Мин(Осталось, Стр.Количество);
        Если Метод = Перечисления.УчетнаяПолитика.Средняя Тогда
            // При средней партии списываются пропорционально, чтобы стоимость и количество каждой партии обнулялись вместе.
            К = ?(Осталось = Стр.Количество Или Строки.Количество() = 1, Осталось, Мин(Осталось, Окр(Стр.Количество * Количество / Доступно, 6)));
            Если К = 0 Тогда Продолжить; КонецЕсли;
        КонецЕсли;
        С = ?(К = Стр.Количество, Стр.Стоимость, Окр(Стр.Стоимость * К / Стр.Количество, 2));
        Д = Документ.Движения.ОстаткиНоменклатуры.ДобавитьРасход();
        Д.Период = Документ.Дата;
        Д.Подразделение = Подразделение; Д.Номенклатура = Номенклатура;
        Д.Свойство = Стр.Свойство; Д.Партия = Стр.Партия; Д.ДокументПартии = Стр.ДокументПартии;
        Д.Количество = К; Д.Стоимость = С;
        Стр.Количество = Стр.Количество - К; Стр.Стоимость = Стр.Стоимость - С;
        Осталось = Осталось - К; Итог = Итог + С; ПоследняяСтрока = Стр; ПоследнееДвижение = Д;
    КонецЦикла;
    // Остаток округления количества распределяется по оставшимся партиям.
    Если Осталось > 0 Тогда
        Для Каждого Стр Из Строки Цикл
            Если Осталось = 0 Тогда Прервать; КонецЕсли;
            Если Стр.Количество <= 0 Тогда Продолжить; КонецЕсли;
            К = Мин(Осталось, Стр.Количество);
            С = ?(К = Стр.Количество, Стр.Стоимость, Окр(Стр.Стоимость * К / Стр.Количество, 2));
            Д = Документ.Движения.ОстаткиНоменклатуры.ДобавитьРасход();
            Д.Период = Документ.Дата; Д.Подразделение = Подразделение; Д.Номенклатура = Номенклатура;
            Д.Свойство = Стр.Свойство; Д.Партия = Стр.Партия; Д.ДокументПартии = Стр.ДокументПартии; Д.Количество = К; Д.Стоимость = С;
            Стр.Количество = Стр.Количество - К; Стр.Стоимость = Стр.Стоимость - С;
            Осталось = Осталось - К; Итог = Итог + С; ПоследняяСтрока = Стр; ПоследнееДвижение = Д;
        КонецЦикла;
    КонецЕсли;
    Если Метод = Перечисления.УчетнаяПолитика.Средняя И Итог <> ЦелеваяСтоимость Тогда
        Разница = ЦелеваяСтоимость - Итог;
        ПоследнееДвижение.Стоимость = ПоследнееДвижение.Стоимость + Разница;
        ПоследняяСтрока.Стоимость = ПоследняяСтрока.Стоимость - Разница;
        Итог = ЦелеваяСтоимость;
    КонецЕсли;
    Возврат Итог;
КонецФункции

Процедура ПриходОУ(Документ, Подразделение, Номенклатура, Свойство, Количество, Стоимость) Экспорт
    Если Количество <= 0 Или Стоимость < 0 Тогда ВызватьИсключение "Некорректное количество или стоимость прихода"; КонецЕсли;
    Д = Документ.Движения.ОстаткиНоменклатуры.ДобавитьПриход();
    Д.Период = Документ.Дата; Д.Подразделение = Подразделение; Д.Номенклатура = Номенклатура;
    Д.Свойство = Свойство; Д.Партия = Документ.Дата; Д.ДокументПартии = Документ.Ссылка; Д.Количество = Количество; Д.Стоимость = Стоимость;
КонецПроцедуры

Процедура ПодготовитьБУ(Документ) Экспорт
    ЗаблокироватьРегистр("РегистрБухгалтерии.Хозрасчетный");
    Документ.Движения.Хозрасчетный.Записывать = Истина;
    Документ.Движения.Хозрасчетный.Очистить();
    Документ.Движения.Хозрасчетный.Записать();
КонецПроцедуры

Функция Проводка(Документ, Дебет, Кредит, Сумма) Экспорт
    Д = Документ.Движения.Хозрасчетный.Добавить();
    Д.Период = Документ.Дата; Д.СчетДт = Дебет; Д.СчетКт = Кредит; Д.Сумма = Сумма;
    Возврат Д;
КонецФункции

Процедура Приход(Документ) Экспорт
    Документ.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Документ.Движения.Хозрасчетный.Записывать = Истина;
    Для Каждого Стр Из Документ.СписокНоменклатуры Цикл
        Если Стр.Количество <= 0 Тогда ВызватьИсключение "Количество должно быть больше нуля"; КонецЕсли;
        С = ?(Стр.Сумма = 0, Окр(Стр.Количество * Стр.Цена, 2), Стр.Сумма);
        Если С < 0 Тогда ВызватьИсключение "Отрицательная сумма закупки"; КонецЕсли;
        Подразделение = ?(ЗначениеЗаполнено(Стр.Подразделение), Стр.Подразделение, Документ.Подразделение);
        Если ЗначениеЗаполнено(Подразделение) Тогда
            ПриходОУ(Документ, Подразделение, Стр.Номенклатура, Стр.Свойство, Стр.Количество, С);
        КонецЕсли;
        Если ЗначениеЗаполнено(Документ.Склад) Тогда
            Д = Проводка(Документ, ПланыСчетов.Управленческий.Товары, ПланыСчетов.Управленческий.Поставщики, С);
            Д.НоменклатураДт = Стр.Номенклатура; Д.СкладДт = Документ.Склад; Д.КоличествоДт = Стр.Количество;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ГруппаАналогов(Номенклатура, Связи) Экспорт
    Группа = Новый Массив; Группа.Добавить(Номенклатура);
    Индекс = 0;
    Пока Индекс < Группа.Количество() Цикл
        Товар = Группа[Индекс];
        Для Каждого С Из Связи Цикл
            Если С.Товар = Товар Тогда Кандидат = С.Аналог;
            ИначеЕсли С.Аналог = Товар Тогда Кандидат = С.Товар;
            Иначе Продолжить;
            КонецЕсли;
            Если Группа.Найти(Кандидат) = Неопределено Тогда Группа.Добавить(Кандидат); КонецЕсли;
        КонецЦикла;
        Индекс = Индекс + 1;
    КонецЦикла;
    Возврат Группа;
КонецФункции

Процедура ПродажаБУ(Документ) Экспорт
    ПодготовитьБУ(Документ);
    Парам = Новый Структура("Граница,Счет,Склад", Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая), ПланыСчетов.Управленческий.Товары, Документ.Склад);
    Остатки = ТаблицаЗапроса("ВЫБРАТЬ Номенклатура, КоличествоОстаток КАК Количество
    |ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Граница, Счет = &Счет, Склад = &Склад)", Парам);
    Общие = ТаблицаЗапроса("ВЫБРАТЬ Номенклатура, СУММА(КоличествоОстаток) КАК Количество, СУММА(СуммаОстаток) КАК Стоимость
    |ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Граница, Счет = &Счет, )
    |СГРУППИРОВАТЬ ПО Номенклатура", Парам);
    Связи = ТаблицаЗапроса("ВЫБРАТЬ Товар, Аналог ИЗ РегистрСведений.Аналоги");
    Артикулы = ТаблицаЗапроса("ВЫБРАТЬ Ссылка, Артикул ИЗ Справочник.Номенклатура УПОРЯДОЧИТЬ ПО Артикул, Ссылка");
    Для Каждого Стр Из Документ.СписокНоменклатуры Цикл
        Если Стр.Количество <= 0 Тогда ВызватьИсключение "Количество должно быть больше нуля"; КонецЕсли;
        Группа = ГруппаАналогов(Стр.Номенклатура, Связи);
        Кандидаты = Новый Массив; Кандидаты.Добавить(Стр.Номенклатура);
        Для Каждого А Из Артикулы Цикл
            Если А.Ссылка <> Стр.Номенклатура И Группа.Найти(А.Ссылка) <> Неопределено Тогда Кандидаты.Добавить(А.Ссылка); КонецЕсли;
        КонецЦикла;
        Осталось = Стр.Количество;
        Выручка = ?(Стр.Сумма = 0, Окр(Стр.Цена * Стр.Количество, 2), Стр.Сумма); Распределено = 0;
        Для Каждого Товар Из Кандидаты Цикл
            Если Осталось = 0 Тогда Прервать; КонецЕсли;
            Складской = Остатки.Найти(Товар, "Номенклатура");
            Общий = Общие.Найти(Товар, "Номенклатура");
            Если Складской = Неопределено Или Общий = Неопределено Тогда Продолжить; КонецЕсли;
            Если Складской.Количество <= 0 Или Общий.Количество <= 0 Тогда Продолжить; КонецЕсли;
            К = Мин(Осталось, Складской.Количество);
            Себестоимость = ?(К = Общий.Количество, Общий.Стоимость, Окр(Общий.Стоимость * К / Общий.Количество, 2));
            С = ?(К = Осталось, Выручка - Распределено, Окр(Выручка * К / Стр.Количество, 2));
            Д = Проводка(Документ, ПланыСчетов.Управленческий.ПрибылиУбытки, ПланыСчетов.Управленческий.Товары, Себестоимость);
            Д.НоменклатураКт = Товар; Д.СкладКт = Документ.Склад; Д.КоличествоКт = К;
            ПродажаДвижение(Документ, Стр.Номенклатура, Товар, Справочники.Подразделения.ПустаяСсылка(), К, Себестоимость, С);
            Общий.Количество = Общий.Количество - К; Общий.Стоимость = Общий.Стоимость - Себестоимость;
            Складской.Количество = Складской.Количество - К;
            Распределено = Распределено + С; Осталось = Осталось - К;
        КонецЦикла;
        Если Осталось > 0 Тогда ВызватьИсключение СтрШаблон("Не хватает товара %1 и его аналогов: %2", Стр.Номенклатура, Осталось); КонецЕсли;
        Д = Проводка(Документ, ПланыСчетов.Управленческий.Покупатели, ПланыСчетов.Управленческий.ПрибылиУбытки, Выручка);
    КонецЦикла;
КонецПроцедуры

Процедура ПродажаДвижение(Документ, Номенклатура, Продано, Подразделение, Количество, Себестоимость, Выручка) Экспорт
    Д = Документ.Движения.Продажи.Добавить(); Д.Период = Документ.Дата;
    Д.Номенклатура = Номенклатура; Д.Продано = Продано; Д.Подразделение = Подразделение;
    Д.Количество = Количество; Д.Себестоимость = Себестоимость; Д.Выручка = Выручка;
КонецПроцедуры

Процедура Продажа(Документ) Экспорт
    Документ.Движения.Продажи.Записывать = Истина;
    Если ЗначениеЗаполнено(Документ.Склад) Тогда ПродажаБУ(Документ); КонецЕсли;
    Остатки = ОстаткиОУ(Документ);
    Политики = ТаблицаЗапроса("ВЫБРАТЬ Подразделение, Метод ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, )", Новый Структура("Дата", Документ.Дата));
    Для Каждого Стр Из Документ.СписокНоменклатуры Цикл
        Подразделение = ?(ЗначениеЗаполнено(Стр.Подразделение), Стр.Подразделение, Документ.Подразделение);
        Если Не ЗначениеЗаполнено(Подразделение) Тогда Продолжить; КонецЕсли;
        Политика = Политики.Найти(Подразделение, "Подразделение");
        Метод = ?(Политика = Неопределено, Перечисления.УчетнаяПолитика.Средняя, Политика.Метод);
        С = СписатьОУ(Документ, Остатки, Подразделение, Стр.Номенклатура, Стр.Свойство, Стр.Количество, Метод, Не ЗначениеЗаполнено(Стр.Свойство));
        Выручка = ?(Стр.Сумма = 0, Окр(Стр.Количество * Стр.Цена, 2), Стр.Сумма);
        ПродажаДвижение(Документ, Стр.Номенклатура, Стр.Номенклатура, Подразделение, Стр.Количество, С, Выручка);
    КонецЦикла;
КонецПроцедуры

Процедура Сборка(Документ) Экспорт
    Остатки = ОстаткиОУ(Документ);
    Парам = Новый Структура("Дата", Документ.Дата);
    Спецификации = ТаблицаЗапроса("ВЫБРАТЬ С.СистемныйБлок, С.Номенклатура, С.Свойство, С.Количество
    |ИЗ РегистрСведений.Спецификации КАК С
    |ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ СистемныйБлок, МАКСИМУМ(Период) КАК Период
    |ИЗ РегистрСведений.Спецификации ГДЕ Период <= &Дата СГРУППИРОВАТЬ ПО СистемныйБлок) КАК Версии
    |ПО С.СистемныйБлок = Версии.СистемныйБлок И С.Период = Версии.Период", Парам);
    ОбщаяСтоимость = 0; ВсегоБлоков = 0; СтоимостиБлоков = Новый Массив;
    Для Каждого Стр Из Документ.СистемныеБлоки Цикл
        Если Стр.Количество <= 0 Тогда ВызватьИсключение "Некорректное количество блоков"; КонецЕсли;
        Состав = Спецификации.НайтиСтроки(Новый Структура("СистемныйБлок", Стр.Номенклатура));
        Если Состав.Количество() = 0 Тогда ВызватьИсключение СтрШаблон("Не задана спецификация %1", Стр.Номенклатура); КонецЕсли;
        СтоимостьБлока = 0;
        Для Каждого Деталь Из Состав Цикл
            СтоимостьБлока = СтоимостьБлока + СписатьОУ(Документ, Остатки, Документ.ПодразделениеИсточник, Деталь.Номенклатура, Деталь.Свойство, Деталь.Количество * Стр.Количество, Перечисления.УчетнаяПолитика.Средняя);
        КонецЦикла;
        СтоимостиБлоков.Добавить(СтоимостьБлока);
        ВсегоБлоков = ВсегоБлоков + Стр.Количество;
    КонецЦикла;
    Для Каждого Стр Из Документ.ДополнительныеДетали Цикл
        ОбщаяСтоимость = ОбщаяСтоимость + СписатьОУ(Документ, Остатки, Документ.ПодразделениеИсточник, Стр.Номенклатура, Стр.Свойство, Стр.Количество, Перечисления.УчетнаяПолитика.Средняя);
    КонецЦикла;
    Если ВсегоБлоков = 0 Тогда ВызватьИсключение "Не указаны собираемые блоки"; КонецЕсли;
    // Дополнительные детали распределяются пропорционально числу блоков; стандартные — по их спецификации.
    Распределено = 0; Номер = 0;
    Для Каждого Стр Из Документ.СистемныеБлоки Цикл
        Номер = Номер + 1;
        С = ?(Номер = Документ.СистемныеБлоки.Количество(), ОбщаяСтоимость - Распределено, Окр(ОбщаяСтоимость * Стр.Количество / ВсегоБлоков, 2));
        ПриходОУ(Документ, Документ.ПодразделениеПолучатель, Стр.Номенклатура, Справочники.Свойства.ПустаяСсылка(), Стр.Количество, СтоимостиБлоков[Номер - 1] + С);
        Распределено = Распределено + С;
    КонецЦикла;
КонецПроцедуры

Процедура НачислениеЗарплаты(Документ) Экспорт
    НастроитьВидыРасчета();
    ЗаблокироватьРегистр("РегистрРасчета.Начисления");
    Набор = Документ.Движения.Начисления;
    Набор.Записывать = Истина;
    Для Каждого Стр Из Документ.ОсновныеНачисления Цикл
        Если Не ЗначениеЗаполнено(Стр.Сотрудник) Или Не ЗначениеЗаполнено(Стр.Подразделение) Тогда ВызватьИсключение "Укажите сотрудника и подразделение"; КонецЕсли;
        Если Стр.ДатаНачала > Стр.ДатаОкончания Тогда ВызватьИсключение "Начало периода больше окончания"; КонецЕсли;
        Если Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка И НачалоМесяца(Стр.ДатаНачала) <> НачалоМесяца(Стр.ДатаОкончания) Тогда
            ВызватьИсключение "Тариф и премия вводятся в пределах одного месяца";
        КонецЕсли;
        Начало = НачалоДня(Стр.ДатаНачала);
        Пока Начало <= Стр.ДатаОкончания Цикл
            Окончание = Мин(КонецМесяца(Начало), КонецДня(Стр.ДатаОкончания));
            Д = Набор.Добавить();
            Д.Сотрудник = Стр.Сотрудник; Д.Подразделение = Стр.Подразделение; Д.ВидРасчета = Стр.ВидРасчета;
            Д.ПериодРегистрации = НачалоМесяца(Начало);
            Д.ПериодДействияНачало = Начало; Д.ПериодДействияКонец = Окончание;
            Если Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
                Д.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало), -1);
                Д.БазовыйПериодКонец = НачалоМесяца(Начало) - 1;
            ИначеЕсли Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
                Д.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Стр.ДатаНачала), -3);
                Д.БазовыйПериодКонец = НачалоМесяца(Стр.ДатаНачала) - 1;
            КонецЕсли;
            Начало = НачалоМесяца(ДобавитьМесяц(Начало, 1));
        КонецЦикла;
    КонецЦикла;
    Набор.Записать();
    ПересчитатьНачисления();
    // Платформа не должна повторно записать набор с нулевыми результатами.
    Набор.Прочитать();
КонецПроцедуры

Функция ВКомандировке(Данные, Сотрудник, Подразделение, День)
    Для Каждого Д Из Данные Цикл
        Если Д.Сотрудник = Сотрудник И Д.Подразделение = Подразделение
            И Д.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка
            И Д.ПериодДействияНачало <= День И Д.ПериодДействияКонец >= День Тогда Возврат Истина; КонецЕсли;
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Процедура ПересчитатьНачисления() Экспорт
    // Используются только записанные входные данные регистра, без чтения табличных частей документов.
    Данные = ТаблицаЗапроса("ВЫБРАТЬ Регистратор, НомерСтроки, Сотрудник, Подразделение, ВидРасчета,
    |ПериодРегистрации, ПериодДействияНачало, ПериодДействияКонец, БазовыйПериодНачало, БазовыйПериодКонец,
    |Результат, Часы, Дни, ОтработаноДней, Ставка, Процент, Стаж
    |ИЗ РегистрРасчета.Начисления УПОРЯДОЧИТЬ ПО ПериодДействияНачало, НомерСтроки");
    Графики = ТаблицаЗапроса("ВЫБРАТЬ Регистратор, НомерСтроки,
    |ЕСТЬNULL(ЗначениеФактическийПериодДействия, 0) КАК Часы, ЕСТЬNULL(ДниФактическийПериодДействия, 0) КАК Дни,
    |ЕСТЬNULL(ДниПериодРегистрации, 0) КАК Норма
    |ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Активность = ИСТИНА)");
    Ставки = ТаблицаЗапроса("ВЫБРАТЬ Период, Сотрудник, Подразделение, Оклад ИЗ РегистрСведений.СведенияОСотрудниках УПОРЯДОЧИТЬ ПО Период");
    Шкала = ТаблицаЗапроса("ВЫБРАТЬ Стаж, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО Стаж");
    Сотрудники = ТаблицаЗапроса("ВЫБРАТЬ Ссылка, НачалоСтажа ИЗ Справочник.ФизическиеЛица");
    Для Каждого Д Из Данные Цикл
        Д.Результат = 0; Д.Часы = 0; Д.Дни = 0; Д.Ставка = 0; Д.Процент = 0; Д.Стаж = 0; Д.ОтработаноДней = 0;
        Сотрудник = Сотрудники.Найти(Д.Сотрудник, "Ссылка");
        Если Сотрудник <> Неопределено И ЗначениеЗаполнено(Сотрудник.НачалоСтажа) Тогда
            Месяц = НачалоМесяца(Д.ПериодДействияНачало);
            Лет = Год(Месяц) - Год(Сотрудник.НачалоСтажа);
            Если ДобавитьМесяц(Сотрудник.НачалоСтажа, Лет * 12) > Месяц Тогда Лет = Лет - 1; КонецЕсли;
            Д.Стаж = Макс(0, Лет);
        КонецЕсли;
        Для Каждого Ш Из Шкала Цикл Если Ш.Стаж <= Д.Стаж Тогда Д.Процент = Ш.Процент; КонецЕсли; КонецЦикла;
        СтрокиГрафика = Графики.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Д.Регистратор, Д.НомерСтроки));
        Если СтрокиГрафика.Количество() > 0 Тогда
            Д.Часы = СтрокиГрафика[0].Часы; Д.Дни = СтрокиГрафика[0].Дни;
        КонецЕсли;
        Если Д.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
            Для Каждого С Из Ставки Цикл
                Если С.Сотрудник = Д.Сотрудник И С.Подразделение = Д.Подразделение И С.Период <= НачалоМесяца(Д.ПериодДействияНачало) Тогда Д.Ставка = С.Оклад; КонецЕсли;
            КонецЦикла;
            Д.Результат = Окр(Д.Ставка * Д.Часы, 2); Д.ОтработаноДней = Д.Дни;
        КонецЕсли;
    КонецЦикла;
    ЗаписатьРезультатыНачислений(Данные);
    ИзмеренияПодразделение = Новый Массив; ИзмеренияПодразделение.Добавить("Подразделение");
    ИзмеренияСотрудник = Новый Массив; ИзмеренияСотрудник.Добавить("Сотрудник");
    Разрезы = Новый Массив; Разрезы.Добавить("Сотрудник");
    Парам = Новый Структура("Основные,Базовые,Разрезы", ИзмеренияПодразделение, ИзмеренияПодразделение, Разрезы);
    БазаПремии = ТаблицаЗапроса("ВЫБРАТЬ Регистратор, НомерСтроки, Сотрудник, СотрудникРазрез, ЕСТЬNULL(РезультатБаза, 0) КАК РезультатБаза
    |ИЗ РегистрРасчета.Начисления.БазаНачисления(&Основные, &Базовые, &Разрезы, ВидРасчета = ЗНАЧЕНИЕ(ПланВидовРасчета.ОсновныеНачисления.Премия))", Парам);
    Для Каждого Д Из Данные Цикл
        Если Д.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда Продолжить; КонецЕсли;
        База = 0;
        Для Каждого Б Из БазаПремии.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Д.Регистратор, Д.НомерСтроки)) Цикл
            Если Б.СотрудникРазрез <> Д.Сотрудник Тогда База = База + Б.РезультатБаза; КонецЕсли;
        КонецЦикла;
        Норма = 0;
        СтрокиГрафика = Графики.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Д.Регистратор, Д.НомерСтроки));
        Если СтрокиГрафика.Количество() > 0 Тогда Норма = СтрокиГрафика[0].Норма; КонецЕсли;
        Д.Результат = ?(Норма = 0, 0, Окр(База * Д.Процент / 100 * Д.Дни / Норма, 2));
    КонецЦикла;
    ЗаписатьРезультатыНачислений(Данные);
    Месяцы = Новый Массив;
    Для Каждого Д Из Данные Цикл
        Если Д.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка И Месяцы.Найти(Д.ПериодРегистрации) = Неопределено Тогда Месяцы.Добавить(Д.ПериодРегистрации); КонецЕсли;
    КонецЦикла;
    // Последовательность месяцев необходима: более ранняя командировка входит в базу более поздней.
    Для Каждого Месяц Из Месяцы Цикл
        Парам = Новый Структура("Основные,Базовые,Месяц", ИзмеренияСотрудник, ИзмеренияСотрудник, Месяц);
        БазаКомандировки = ТаблицаЗапроса("ВЫБРАТЬ Регистратор, НомерСтроки, ЕСТЬNULL(РезультатБаза, 0) КАК РезультатБаза, ЕСТЬNULL(ОтработаноДнейБаза, 0) КАК ОтработаноДнейБаза
        |ИЗ РегистрРасчета.Начисления.БазаНачисления(&Основные, &Базовые, , ВидРасчета = ЗНАЧЕНИЕ(ПланВидовРасчета.ОсновныеНачисления.Командировка) И ПериодРегистрации = &Месяц)", Парам);
        Для Каждого Д Из Данные Цикл
            Если Д.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Или Д.ПериодРегистрации <> Месяц Тогда Продолжить; КонецЕсли;
            СтрокиБазы = БазаКомандировки.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Д.Регистратор, Д.НомерСтроки));
            Если СтрокиБазы.Количество() > 0 Тогда
                Б = СтрокиБазы[0];
                Д.Ставка = ?(Б.ОтработаноДнейБаза = 0, 0, Б.РезультатБаза / Б.ОтработаноДнейБаза);
                Д.Результат = Окр(Д.Ставка * Д.Дни, 2);
            КонецЕсли;
        КонецЦикла;
        ЗаписатьРезультатыНачислений(Данные);
    КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьРезультатыНачислений(Данные)
    Регистраторы = Новый Массив;
    Для Каждого Д Из Данные Цикл
        Если Регистраторы.Найти(Д.Регистратор) = Неопределено Тогда Регистраторы.Добавить(Д.Регистратор); КонецЕсли;
    КонецЦикла;
    Для Каждого Регистратор Из Регистраторы Цикл
        Набор = РегистрыРасчета.Начисления.СоздатьНаборЗаписей();
        Набор.Отбор.Регистратор.Установить(Регистратор); Набор.Прочитать();
        Для Каждого Д Из Набор Цикл
            Строки = Данные.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Регистратор, Д.НомерСтроки));
            Если Строки.Количество() > 0 Тогда ЗаполнитьЗначенияСвойств(Д, Строки[0], "Результат,Часы,Дни,ОтработаноДней,Ставка,Процент,Стаж"); КонецЕсли;
        КонецЦикла;
        Набор.Записать();
    КонецЦикла;
КонецПроцедуры

Функция ЭлементСправочника(ИмяСправочника, Наименование) Экспорт
    Менеджер = Справочники[ИмяСправочника];
    Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
    Если Не Ссылка.Пустая() Тогда Возврат Ссылка; КонецЕсли;
    Объект = Менеджер.СоздатьЭлемент(); Объект.Наименование = Наименование; Объект.Записать();
    Возврат Объект.Ссылка;
КонецФункции

Процедура ЗаполнитьДемонстрационныеДанные() Экспорт
    Цех = ЭлементСправочника("Подразделения", "Демо: Основной цех");
    Склад = ЭлементСправочника("Склады", "Демо: Склад");
    Деталь = ЭлементСправочника("Номенклатура", "Демо: Видеокарта");
    Блок = ЭлементСправочника("Номенклатура", "Демо: Системный блок");
    Товар = ЭлементСправочника("Номенклатура", "Демо: Принтер");
    Аналог = ЭлементСправочника("Номенклатура", "Демо: Принтер аналог");
    Об = Товар.ПолучитьОбъект(); Об.Артикул = "100"; Об.Записать();
    Об = Аналог.ПолучитьОбъект(); Об.Артикул = "200"; Об.Записать();
    Свойство = ЭлементСправочника("Свойства", "Демо: ASUS");
    Об = Свойство.ПолучитьОбъект(); Об.Номенклатура = Деталь; Об.Записать();
    Запись = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи();
    Запись.Период = Дата(2024,1,1); Запись.Подразделение = Цех; Запись.Метод = Перечисления.УчетнаяПолитика.ФИФО; Запись.Записать();
    Запись = РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи();
    Запись.Период = Дата(2024,1,1); Запись.СистемныйБлок = Блок; Запись.Номенклатура = Деталь; Запись.Свойство = Свойство; Запись.Количество = 2; Запись.Записать();
    Запись = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи(); Запись.Товар = Товар; Запись.Аналог = Аналог; Запись.Записать();
    П = Документы.ПриходнаяНакладная.СоздатьДокумент(); П.Дата = Дата(2024,1,2,10,0,0); П.Подразделение = Цех;
    С = П.СписокНоменклатуры.Добавить(); С.Номенклатура = Деталь; С.Свойство = Свойство; С.Количество = 10; С.Цена = 100; С.Сумма = 1000;
    П.Записать(РежимЗаписиДокумента.Проведение);
    П = Документы.ПриходнаяНакладная.СоздатьДокумент(); П.Дата = Дата(2024,1,3,10,0,0); П.Склад = Склад;
    С = П.СписокНоменклатуры.Добавить(); С.Номенклатура = Товар; С.Количество = 2; С.Цена = 100; С.Сумма = 200;
    С = П.СписокНоменклатуры.Добавить(); С.Номенклатура = Аналог; С.Количество = 3; С.Цена = 100; С.Сумма = 300;
    П.Записать(РежимЗаписиДокумента.Проведение);
    П = Документы.Сборка.СоздатьДокумент(); П.Дата = Дата(2024,1,4,10,0,0); П.ПодразделениеИсточник = Цех; П.ПодразделениеПолучатель = Цех;
    С = П.СистемныеБлоки.Добавить(); С.Номенклатура = Блок; С.Количество = 2;
    С = П.ДополнительныеДетали.Добавить(); С.Номенклатура = Деталь; С.Свойство = Свойство; С.Количество = 1;
    П.Записать(РежимЗаписиДокумента.Проведение);
    П = Документы.РасходнаяНакладная.СоздатьДокумент(); П.Дата = Дата(2024,1,5,10,0,0); П.Подразделение = Цех;
    С = П.СписокНоменклатуры.Добавить(); С.Номенклатура = Блок; С.Количество = 1; С.Цена = 400; С.Сумма = 400;
    П.Записать(РежимЗаписиДокумента.Проведение);
    П = Документы.РасходнаяНакладная.СоздатьДокумент(); П.Дата = Дата(2024,1,6,10,0,0); П.Склад = Склад;
