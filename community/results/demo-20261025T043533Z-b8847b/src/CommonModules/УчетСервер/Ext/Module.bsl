    П.Записать(РежимЗаписиДокумента.Проведение);
    П = Документы.Операция.СоздатьДокумент(); П.Дата = Дата(2024,1,7,10,0,0);
    С = П.Проводки.Добавить(); С.СчетДт = ПланыСчетов.Управленческий.Товары; С.СчетКт = ПланыСчетов.Управленческий.Поставщики;
    С.НоменклатураДт = Товар; С.СкладДт = Склад; С.КоличествоДт = 1; С.Сумма = 120;
