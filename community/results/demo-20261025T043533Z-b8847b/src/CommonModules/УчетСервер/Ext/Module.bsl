        День = День + 86400;
    КонецЦикла;
    Запись = РегистрыСведений.СведенияОСотрудниках.СоздатьМенеджерЗаписи();
    Запись.Период = Дата(2023,10,1); Запись.Сотрудник = Сотрудник; Запись.Подразделение = Цех; Запись.Оклад = 100; Запись.Записать();
    Запись = РегистрыСведений.СведенияОСотрудниках.СоздатьМенеджерЗаписи();
    Запись.Период = Дата(2023,10,1); Запись.Сотрудник = Руководитель; Запись.Подразделение = Цех; Запись.Оклад = 150; Запись.Записать();
    Запись = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Запись.Стаж = 0; Запись.Процент = 5; Запись.Записать();
    Запись = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Запись.Стаж = 1; Запись.Процент = 10; Запись.Записать();
    Запись = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Запись.Стаж = 3; Запись.Процент = 15; Запись.Записать();
    Месяц = Дата(2023,10,1);
    Пока Месяц <= Дата(2024,2,1) Цикл
