        С = П.ОсновныеНачисления.Добавить(); С.Сотрудник = Руководитель; С.Подразделение = Цех; С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф; С.ДатаНачала = Месяц; С.ДатаОкончания = КонецМесяца(Месяц);
        С = П.ОсновныеНачисления.Добавить(); С.Сотрудник = Руководитель; С.Подразделение = Цех; С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия; С.ДатаНачала = Месяц; С.ДатаОкончания = КонецМесяца(Месяц);
        П.Записать(РежимЗаписиДокумента.Проведение);
        Месяц = ДобавитьМесяц(Месяц, 1);
    КонецЦикла;
    П = Документы.НачислениеЗарплаты.СоздатьДокумент(); П.Дата = Дата(2024,3,5);
    С = П.ОсновныеНачисления.Добавить(); С.Сотрудник = Сотрудник; С.Подразделение = Цех; С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка; С.ДатаНачала = Дата(2024,1,28); С.ДатаОкончания = Дата(2024,3,4);
    П.Записать(РежимЗаписиДокумента.Проведение);
    Вид = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); Вид.Наименование = "Демо: Срок кредита, дни"; Вид.ТипЗначения = Новый ОписаниеТипов("Число"); Вид.Записать();
    Об = Руководитель.ПолучитьОбъект(); С = Об.ДополнительныеСведения.Добавить(); С.Характеристика = Вид.Ссылка; Об.Записать();
    Контрагент = ЭлементСправочника("Контрагенты", "Демо: Завод Сатурн");
    Об = Контрагент.ПолучитьОбъект(); Об.Менеджер = Руководитель;
    С = Об.ДополнительныеСведения.Добавить(); С.Характеристика = Вид.Ссылка; С.Значение = 10; Об.Записать();
КонецПроцедуры

Функция ПроверитьРешение() Экспорт
    Попытка
        ЗаполнитьДемонстрационныеДанные();
        Т = Отчеты.ПродажиБУ.СформироватьТаблицу(Дата(2024,1,1), КонецДня(Дата(2024,3,31)));
        Печать = ТабличныйОтчет(Т, "ПродажиБУ", Дата(2024,1,1), Дата(2024,3,31));
        Т = Отчеты.ПродажиОУ.СформироватьТаблицу(Дата(2024,1,1), КонецДня(Дата(2024,3,31)));
        Печать = ТабличныйОтчет(Т, "ПродажиОУ", Дата(2024,1,1), Дата(2024,3,31));
        Т = Отчеты.Ведомость.СформироватьТаблицу(Дата(2024,1,1), КонецДня(Дата(2024,3,31)), Справочники.Подразделения.НайтиПоНаименованию("Демо: Основной цех"));
        Печать = ТабличныйОтчет(Т, "Ведомость", Дата(2024,1,1), Дата(2024,3,31));
        Т = Отчеты.Премии.СформироватьТаблицу(Дата(2024,2,1), КонецМесяца(Дата(2024,2,1)));
        Печать = ТабличныйОтчет(Т, "Премии", Дата(2024,2,1), Дата(2024,2,29));
        Возврат "OK: демонстрационные данные проведены; четыре отчета сформированы";
    Исключение
        Возврат ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;
КонецФункции

Процедура НастроитьВидыРасчета() Экспорт
    Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф.ПолучитьОбъект();
    Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия.ПолучитьОбъект();
    Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка.ПолучитьОбъект();
    Если Тариф.ВытесняющиеВидыРасчета.Количество() = 0 Тогда
        С = Тариф.ВытесняющиеВидыРасчета.Добавить(); С.ВидРасчета = Командировка.Ссылка;
        Тариф.Записать();
    КонецЕсли;
    Если Премия.ВытесняющиеВидыРасчета.Количество() = 0 Тогда
        С = Премия.ВытесняющиеВидыРасчета.Добавить(); С.ВидРасчета = Командировка.Ссылка;
        С = Премия.БазовыеВидыРасчета.Добавить(); С.ВидРасчета = Тариф.Ссылка;
        Премия.Записать();
    КонецЕсли;
    Если Командировка.БазовыеВидыРасчета.Количество() = 0 Тогда
        С = Командировка.БазовыеВидыРасчета.Добавить(); С.ВидРасчета = Тариф.Ссылка;
        С = Командировка.БазовыеВидыРасчета.Добавить(); С.ВидРасчета = Премия.Ссылка;
        С = Командировка.БазовыеВидыРасчета.Добавить(); С.ВидРасчета = Командировка.Ссылка;
        Командировка.Записать();
    КонецЕсли;
КонецПроцедуры



Функция ТабличныйОтчет(Данные, Имя, Начало, Конец) Экспорт
    Док = Новый ТабличныйДокумент;
    Док.Область(1, 1).Текст = ?(Имя = "Ведомость", "Ведомость по подразделению", ?(Имя = "Премии", "Премии", "Продажи"));
    Док.Область(2, 1).Текст = ?(Имя = "Премии", "Месяц: " + Формат(Начало, "ДФ='ММММ yyyy'"), "За период " + Формат(Начало, "ДФ=dd.MM.yyyy") + " — " + Формат(Конец, "ДФ=dd.MM.yyyy"));
    Если Имя = "Ведомость" Тогда
        Заголовки = СтрРазделить("Производитель|Товар|Нач. ост.|Приход|Расход|Кон. ост.", "|");
        Значения = ТаблицаЗапроса("ВЫБРАТЬ Свойство, Значение ИЗ РегистрСведений.ЗначенияСвойств ГДЕ Характеристика.Наименование ПОДОБНО &Имя", Новый Структура("Имя", "%Производитель%"));
        Данные.Сортировать("Характеристика, Номенклатура");
        НомерСтроки = 5; ПоследнееСвойство = Неопределено;
        Для Каждого Стр Из Данные Цикл
            Если ПоследнееСвойство <> Стр.Характеристика Тогда
                Производитель = Значения.Найти(Стр.Характеристика, "Свойство");
                Док.Область(НомерСтроки, 1).Текст = ?(Производитель = Неопределено, Строка(Стр.Характеристика), Строка(Производитель.Значение));
                НомерСтроки = НомерСтроки + 1; ПоследнееСвойство = Стр.Характеристика;
            КонецЕсли;
            Док.Область(НомерСтроки, 2).Текст = Строка(Стр.Номенклатура);
            ПоляКоличества = СтрРазделить("НачКоличество,ПриходКоличество,РасходКоличество,КонКоличество", ",");
            ПоляСтоимости = СтрРазделить("НачОстаток,Приход,Расход,КонОстаток", ",");
            Для Индекс = 0 По 3 Цикл
                Док.Область(НомерСтроки, Индекс + 3).Текст = Формат(Стр[ПоляКоличества[Индекс]], "ЧДЦ=3;ЧН=0");
                Док.Область(НомерСтроки + 1, Индекс + 3).Текст = Формат(Стр[ПоляСтоимости[Индекс]], "ЧДЦ=2;ЧН=0");
            КонецЦикла;
            НомерСтроки = НомерСтроки + 2;
        КонецЦикла;
    Иначе
        Если Имя = "Премии" Тогда
            Поля = СтрРазделить("Сотрудник,Стаж,Процент,СуммаПремии", ",");
            Заголовки = СтрРазделить("Сотрудник|Трудовой стаж|% премии|Сумма премии", "|");
        ИначеЕсли Имя = "ПродажиБУ" Тогда
            Поля = СтрРазделить("Номенклатура,Продано,Количество,Себестоимость,Продажа,Прибыль", ",");
            Заголовки = СтрРазделить("Номенклатура|Продано|Кол-во|Себест-сть|Продажа|Прибыль", "|");
        Иначе
            Поля = СтрРазделить("Номенклатура,Количество,Себестоимость,Продажа,Прибыль", ",");
            Заголовки = СтрРазделить("Номенклатура|Кол-во|Себест-сть|Продажа|Прибыль", "|");
        КонецЕсли;
        НомерСтроки = 5;
        Если Имя = "ПродажиБУ" Тогда
            Группы = Данные.Скопировать(); Группы.Свернуть("Номенклатура", "Количество,Себестоимость,Продажа,Прибыль");
            Для Каждого Группа Из Группы Цикл
                Док.Область(НомерСтроки, 1).Текст = Строка(Группа.Номенклатура);
                Для Индекс = 2 По 5 Цикл Док.Область(НомерСтроки, Индекс + 1).Текст = Строка(Группа[Поля[Индекс]]); КонецЦикла;
                Док.Область(НомерСтроки, 1, НомерСтроки, 6).Шрифт = Новый Шрифт(, , Истина);
                НомерСтроки = НомерСтроки + 1;
                Для Каждого Стр Из Данные.НайтиСтроки(Новый Структура("Номенклатура", Группа.Номенклатура)) Цикл
                    Для Индекс = 1 По Поля.Количество() - 1 Цикл Док.Область(НомерСтроки, Индекс + 1).Текст = Строка(Стр[Поля[Индекс]]); КонецЦикла;
                    НомерСтроки = НомерСтроки + 1;
                КонецЦикла;
            КонецЦикла;
        Иначе
            Для Каждого Стр Из Данные Цикл
                Для Индекс = 0 По Поля.Количество() - 1 Цикл Док.Область(НомерСтроки, Индекс + 1).Текст = Строка(Стр[Поля[Индекс]]); КонецЦикла;
                НомерСтроки = НомерСтроки + 1;
            КонецЦикла;
        КонецЕсли;
        Док.Область(НомерСтроки, 1).Текст = "ИТОГО:";
        Для Индекс = 0 По Поля.Количество() - 1 Цикл
            Если Данные.Количество() > 0 И ТипЗнч(Данные[0][Поля[Индекс]]) = Тип("Число") И Поля[Индекс] <> "Стаж" И Поля[Индекс] <> "Процент" Тогда
                Док.Область(НомерСтроки, Индекс + 1).Текст = Формат(Данные.Итог(Поля[Индекс]), "ЧДЦ=2");
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Для Индекс = 0 По Заголовки.Количество() - 1 Цикл
        Док.Область(4, Индекс + 1).Текст = Заголовки[Индекс];
        Док.Область(4, Индекс + 1).Шрифт = Новый Шрифт(, , Истина);
        Док.Область(, Индекс + 1, , Индекс + 1).ШиринаКолонки = ?(Индекс < 2, 25, 15);
    КонецЦикла;
    Док.АвтоМасштаб = Истина;
    Возврат Док;
КонецФункции

Функция ДемоКонтрагент() Экспорт
    Возврат Справочники.Контрагенты.НайтиПоНаименованию("Демо: Завод Сатурн", Истина);
КонецФункции
