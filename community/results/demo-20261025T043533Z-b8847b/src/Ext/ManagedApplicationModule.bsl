Процедура ПриНачалеРаботыСистемы()
    Если СтрНайти(ПараметрЗапуска, "ЭкзаменПроверка|") = 1 Тогда
        Части = СтрРазделить(ПараметрЗапуска, "|");
        Попытка
            Текст = УчетСервер.ПроверитьРешение();
            Если Лев(Текст, 2) = "OK" Тогда
                Параметры = Новый Структура("Ключ", УчетСервер.ДемоКонтрагент());
                Форма = ПолучитьФорму("Справочник.Контрагенты.ФормаОбъекта", Параметры);
                Если Форма.Элементы.Найти("ДопПоле1") = Неопределено Тогда ВызватьИсключение "Не создано динамическое поле"; КонецЕсли;
                Форма.ДопПоле1 = 17;
                Форма.Записать();
                Текст = Текст + Символы.ПС + "OK: форма контрагента создана, динамическое поле записано";
                Форма = ПолучитьФорму("Отчет.ПродажиБУ.Форма.ФормаОтчета");
                Форма = ПолучитьФорму("Отчет.ПродажиОУ.Форма.ФормаОтчета");
                Форма = ПолучитьФорму("Отчет.Ведомость.Форма.ФормаОтчета");
                Форма = ПолучитьФорму("Отчет.Премии.Форма.ФормаОтчета");
                Текст = Текст + Символы.ПС + "OK: четыре формы отчетов созданы";
            КонецЕсли;
        Исключение
            Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
        КонецПопытки;
        Файл = Новый ЗаписьТекста(Части[1], КодировкаТекста.UTF8);
        Файл.Записать(Текст); Файл.Закрыть();
        ЗавершитьРаботуСистемы(Ложь);
    КонецЕсли;
КонецПроцедуры
