Процедура ПередЗаписью(Отказ,Замещение)
    // Дата начала действия сохраняется: будущая версия не должна действовать
    // раньше своего момента. Между изменениями — не менее семи календарных дней.
    Версии=Новый ТаблицаЗначений;
    Версии.Колонки.Добавить("СистемныйБлок",Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Версии.Колонки.Добавить("Период",Новый ОписаниеТипов("Дата"));
    Для Каждого С Из ЭтотОбъект Цикл
        Если С.Количество<=0 Или Не ЗначениеЗаполнено(С.СистемныйБлок) Или Не ЗначениеЗаполнено(С.Номенклатура) Тогда УчетСервер.Ошибка("В спецификации укажите блок, деталь и положительное количество.",Отказ);КонецЕсли;
        Р=Версии.Добавить();Р.СистемныйБлок=С.СистемныйБлок;Р.Период=С.Период;
    КонецЦикла;
    Если Отказ Или Версии.Количество()=0 Тогда Возврат;КонецЕсли;
    УчетСервер.Блокировка("РегистрСведений.Спецификации");
    ПолнаяЗамена=Замещение И Не Отбор.Период.Использование И Не Отбор.Номенклатура.Использование И Не Отбор.Свойство.Использование;
    Если Не ПолнаяЗамена Тогда
        П=Новый Структура("Блоки",Версии.ВыгрузитьКолонку("СистемныйБлок"));
        Старые=УчетСервер.ЗапросТаблица("ВЫБРАТЬ РАЗЛИЧНЫЕ СистемныйБлок,Период ИЗ РегистрСведений.Спецификации ГДЕ СистемныйБлок В (&Блоки)",П);
        Для Каждого С Из Старые Цикл Р=Версии.Добавить();Р.СистемныйБлок=С.СистемныйБлок;Р.Период=С.Период;КонецЦикла;
    КонецЕсли;
    Версии.Свернуть("СистемныйБлок,Период","");Версии.Сортировать("СистемныйБлок,Период");
    Блок=Неопределено;ПредыдущаяДата=Неопределено;
    Для Каждого С Из Версии Цикл
        Если Блок=С.СистемныйБлок И НачалоДня(С.Период)-НачалоДня(ПредыдущаяДата)<7*86400 Тогда
            УчетСервер.Ошибка("Спецификация системного блока может изменяться не чаще одного раза в семь календарных дней.",Отказ);Возврат;
        КонецЕсли;
        Блок=С.СистемныйБлок;ПредыдущаяДата=С.Период;
    КонецЦикла;
КонецПроцедуры
