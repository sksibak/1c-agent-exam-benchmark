Процедура ЗаполнитьГрафик(ДатаНачала,ДатаОкончания,ВыходныеДни,Подразделение,ЧасовВДень=8) Экспорт
    Если Не ЗначениеЗаполнено(Подразделение) Тогда ВызватьИсключение "Укажите подразделение графика.";КонецЕсли;
    Если ДатаОкончания<ДатаНачала Или ЧасовВДень<0 Или ЧасовВДень>24 Тогда ВызватьИсключение "Проверьте период и продолжительность рабочего дня.";КонецЕсли;
    НачатьТранзакцию();
    Попытка
        УчетСервер.Блокировка("РегистрСведений.ГрафикиРаботы");
        Набор=РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей();Набор.Отбор.Подразделение.Установить(Подразделение);Набор.Прочитать();
        Инд=Набор.Количество()-1;
        Пока Инд>=0 Цикл
            Если Набор[Инд].Дата>=НачалоДня(ДатаНачала) И Набор[Инд].Дата<=КонецДня(ДатаОкончания) Тогда Набор.Удалить(Инд);КонецЕсли;
            Инд=Инд-1;
        КонецЦикла;
        День=НачалоДня(ДатаНачала);
        Пока День<=КонецДня(ДатаОкончания) Цикл
            Р=Набор.Добавить();Р.Подразделение=Подразделение;Р.Дата=День;Р.Значение=?(СтрНайти(ВыходныеДни,Строка(ДеньНедели(День)))>0,0,ЧасовВДень);Р.Дни=?(Р.Значение>0,1,0);День=День+86400;
        КонецЦикла;
        Набор.Записать();ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры
