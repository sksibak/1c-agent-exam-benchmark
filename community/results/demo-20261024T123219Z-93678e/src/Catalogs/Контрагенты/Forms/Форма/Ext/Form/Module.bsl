&НаСервере
Процедура ПриСозданииНаСервере(Отказ,СтандартнаяОбработка)
    СоздатьПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент) Экспорт
    ИзменитьМенеджера();
КонецПроцедуры

&НаСервере
Процедура ИзменитьМенеджера()
    СохранитьПоля();СоздатьПоля();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ,ТекущийОбъект,ПараметрыЗаписи)
    СохранитьПоля();
    ТекущийОбъект.ДополнительныеСведения.Очистить();
    Для Каждого Стр Из Объект.ДополнительныеСведения Цикл
        НоваяСтрока=ТекущийОбъект.ДополнительныеСведения.Добавить();ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
    КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ИмяДопПоля(Вид)
    Возврат "ДопПоле"+СтрЗаменить(Строка(Вид.УникальныйИдентификатор()),"-","");
КонецФункции

&НаСервере
Процедура СохранитьПоля()
    Для Каждого Стр Из Объект.ДополнительныеСведения Цикл
        Имя=ИмяДопПоля(Стр.ВидСведений);
        Если Элементы.Найти(Имя)<>Неопределено Тогда Стр.Значение=ЭтотОбъект[Имя];КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СоздатьПоля()
    Удаляемые=Новый Массив;
    Для Каждого Р Из ПолучитьРеквизиты() Цикл
        Если Лев(Р.Имя,7)="ДопПоле" Тогда
            Э=Элементы.Найти(Р.Имя);Если Э<>Неопределено Тогда Элементы.Удалить(Э);КонецЕсли;
            Удаляемые.Добавить(Р.Имя);
        КонецЕсли;
    КонецЦикла;
    Если Удаляемые.Количество()>0 Тогда ИзменитьРеквизиты(Новый Массив,Удаляемые);КонецЕсли;
    Если Не ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат;КонецЕсли;
    П=Новый Структура("Менеджер",Объект.Менеджер);
    Сведения=УчетСервер.ЗапросТаблица("ВЫБРАТЬ ВидСведений, ВидСведений.Наименование КАК Наименование, ВидСведений.ТипЗначения КАК ТипЗначения ИЗ Справочник.ФизическиеЛица.ДополнительныеСведения ГДЕ Ссылка=&Менеджер УПОРЯДОЧИТЬ ПО НомерСтроки",П);
    Инд=0;
    Для Каждого С Из Сведения Цикл
        Инд=Инд+1;Имя=ИмяДопПоля(С.ВидСведений);
        Если Элементы.Найти(Имя)<>Неопределено Тогда Продолжить;КонецЕсли;
        Новые=Новый Массив;Новые.Добавить(Новый РеквизитФормы(Имя,С.ТипЗначения));ИзменитьРеквизиты(Новые);
        Поле=Элементы.Добавить(Имя,Тип("ПолеФормы"));Поле.Вид=ВидПоляФормы.ПолеВвода;Поле.ПутьКДанным=Имя;Поле.Заголовок=С.Наименование;Поле.УстановитьДействие("ПриИзменении","ДополнительноеСведениеПриИзменении");
        Строки=Объект.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведений",С.ВидСведений));
        Если Строки.Количество()>0 Тогда
            ЭтотОбъект[Имя]=Строки[0].Значение;
        Иначе
            НоваяСтрока=Объект.ДополнительныеСведения.Добавить();НоваяСтрока.ВидСведений=С.ВидСведений;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДополнительноеСведениеПриИзменении(Элемент)
    Модифицированность=Истина;
КонецПроцедуры
