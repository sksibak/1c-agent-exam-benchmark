Процедура Ошибка(Текст, Отказ) Экспорт
    Отказ = Истина;
    Сообщение = Новый СообщениеПользователю;
    Сообщение.Текст = Текст;
    Сообщение.Сообщить();
КонецПроцедуры

Функция ЗапросТаблица(Текст, Параметры = Неопределено) Экспорт
    Запрос = Новый Запрос(Текст);
    Если Параметры <> Неопределено Тогда
        Для Каждого П Из Параметры Цикл Запрос.УстановитьПараметр(П.Ключ, П.Значение); КонецЦикла;
    КонецЕсли;
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура Блокировка(ИмяРегистра, Источник = Неопределено, Поля = "") Экспорт
    Б = Новый БлокировкаДанных;
    Э = Б.Добавить(ИмяРегистра);
    Э.Режим = РежимБлокировкиДанных.Исключительный;
    Если Источник <> Неопределено Тогда
        Э.ИсточникДанных = Источник;
        Для Каждого ИмяПоля Из СтрРазделить(Поля, ",", Ложь) Цикл
            Э.ИспользоватьИзИсточникаДанных(ИмяПоля, ИмяПоля);
        КонецЦикла;
    КонецЕсли;
    Б.Заблокировать();
КонецПроцедуры

Функция Потребности() Экспорт
    Т = Новый ТаблицаЗначений;
    Т.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
    Т.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Т.Колонки.Добавить("Свойство", Новый ОписаниеТипов("СправочникСсылка.СвойстваНоменклатуры"));
    Т.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,3)));
    Т.Колонки.Добавить("Получатель", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Возврат Т;
КонецФункции

Процедура ПроверитьСтроки(Строки, Отказ) Экспорт
    Для Каждого С Из Строки Цикл
        Если С.Количество <= 0 Или Не ЗначениеЗаполнено(С.Номенклатура) Тогда
            Ошибка("Укажите номенклатуру и положительное количество в каждой строке.", Отказ);
        КонецЕсли;
        Если С.Цена < 0 Или С.Сумма < 0 Тогда Ошибка("Цена и сумма не могут быть отрицательными.", Отказ); КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция СписатьОУ(Док, Требования, Отказ, ПоПолитике = Истина) Экспорт
    Итоги = Новый Соответствие;
    Если Требования.Количество() = 0 Тогда Возврат Итоги; КонецЕсли;
    Требования.Свернуть("Подразделение,Номенклатура,Свойство,Получатель", "Количество");
    Док.Движения.ОстаткиПартий.Записывать = Истина;
    Док.Движения.ОстаткиПартий.Очистить();
    Док.Движения.ОстаткиПартий.Записать();
    П = Новый Структура("Момент,Товары,Подразделения", Новый Граница(Док.МоментВремени(), ВидГраницы.Исключая), Требования.ВыгрузитьКолонку("Номенклатура"), Требования.ВыгрузитьКолонку("Подразделение"));
    Остатки = ЗапросТаблица(
    "ВЫБРАТЬ Номенклатура, Подразделение, Свойство, Партия,
    | КоличествоОстаток КАК Количество, СтоимостьОстаток КАК Стоимость,
    | Партия.Дата КАК ДатаПартии
    |ИЗ РегистрНакопления.ОстаткиПартий.Остатки(&Момент,
    | Номенклатура В (&Товары) И Подразделение В (&Подразделения))
    |УПОРЯДОЧИТЬ ПО ДатаПартии, Партия", П);
    П.Вставить("Дата", Док.Дата);
    Политики = ЗапросТаблица("ВЫБРАТЬ Подразделение, Метод ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, Подразделение В (&Подразделения))",П);
    Для Каждого Т Из Требования Цикл
        Если Т.Количество <= 0 Тогда Ошибка("Количество деталей должно быть положительным.",Отказ); Продолжить; КонецЕсли;
        Отбор = Новый Структура("Номенклатура,Подразделение,Свойство",Т.Номенклатура,Т.Подразделение,Т.Свойство);
        Партии = Остатки.НайтиСтроки(Отбор);
        Всего = 0; Стоимость = 0;
        Для Каждого О Из Партии Цикл Всего = Всего + О.Количество; Стоимость = Стоимость + О.Стоимость; КонецЦикла;
        Если Всего < Т.Количество Тогда Ошибка("Недостаточно " + Строка(Т.Номенклатура) + " (" + Строка(Т.Свойство) + ") в " + Строка(Т.Подразделение) + ". Требуется " + Т.Количество + ", имеется " + Всего,Отказ); Продолжить; КонецЕсли;
        Политика = Политики.Найти(Т.Подразделение,"Подразделение");
        Если ПоПолитике И Политика = Неопределено Тогда Ошибка("Не задана учетная политика подразделения " + Строка(Т.Подразделение),Отказ); Продолжить; КонецЕсли;
        Если ПоПолитике И Политика.Метод = Перечисления.УчетнаяПолитика.ЛИФО Тогда
            Обратные = Новый Массив;
            Инд = Партии.Количество()-1;
            Пока Инд >= 0 Цикл Обратные.Добавить(Партии[Инд]); Инд = Инд-1; КонецЦикла;
            Партии = Обратные;
        КонецЕсли;
        Осталось = Т.Количество; СуммаСписания = 0;
        Средняя = Не ПоПолитике Или Политика.Метод = Перечисления.УчетнаяПолитика.Средняя;
        Для Каждого О Из Партии Цикл
            Если О.Количество <= 0 Или Осталось <= 0 Тогда Продолжить; КонецЕсли;
            Если Средняя Тогда
                К = Мин(О.Количество, Осталось, Окр(Т.Количество * О.Количество / Всего, 3));
            Иначе К = Мин(О.Количество,Осталось); КонецЕсли;
            Если К = 0 Тогда Продолжить; КонецЕсли;
            С = ?(К = О.Количество, О.Стоимость, Окр(О.Стоимость * К / О.Количество,2));
            ДобавитьРасходОУ(Док,О,К,С);
            О.Количество = О.Количество-К; О.Стоимость = О.Стоимость-С;
            Осталось = Осталось-К; СуммаСписания = СуммаСписания+С;
        КонецЦикла;
        // Последняя тысячная количества относится на оставшуюся партию.
        Если Осталось > 0 Тогда
            Для Каждого О Из Партии Цикл
                Если О.Количество <= 0 Или Осталось <= 0 Тогда Продолжить; КонецЕсли;
                К = Мин(О.Количество,Осталось); С = ?(К=О.Количество,О.Стоимость,Окр(О.Стоимость*К/О.Количество,2));
                ДобавитьРасходОУ(Док,О,К,С);О.Количество=О.Количество-К;О.Стоимость=О.Стоимость-С;Осталось=Осталось-К;СуммаСписания=СуммаСписания+С;
            КонецЦикла;
        КонецЕсли;
        Если Средняя Тогда
            ЦелеваяСтоимость=?(Т.Количество=Всего,Стоимость,Окр(Стоимость*Т.Количество/Всего,2));
            Разница=ЦелеваяСтоимость-СуммаСписания;
            // Корректировка округления стоимости внутри того же пула партий.
            // Она не меняет количество и не оставляет сумму на пустой партии.
            Если Разница>0 Тогда
                Для Каждого О Из Партии Цикл
                    Если О.Количество<=0 Или О.Стоимость<=0 Или Разница<=0 Тогда Продолжить;КонецЕсли;
                    Поправка=Мин(Разница,О.Стоимость);ДобавитьРасходОУ(Док,О,0,Поправка);О.Стоимость=О.Стоимость-Поправка;Разница=Разница-Поправка;
                КонецЦикла;
            ИначеЕсли Разница<0 Тогда
                Для Каждого О Из Партии Цикл
                    Если О.Количество<=0 Тогда Продолжить;КонецЕсли;
                    Д=Док.Движения.ОстаткиПартий.ДобавитьПриход();Д.Период=Док.Дата;Д.Номенклатура=О.Номенклатура;Д.Подразделение=О.Подразделение;Д.Свойство=О.Свойство;Д.Партия=О.Партия;Д.Стоимость=-Разница;О.Стоимость=О.Стоимость-Разница;Прервать;
                КонецЦикла;
            КонецЕсли;
            СуммаСписания=ЦелеваяСтоимость;
        КонецЕсли;
        Старое = Итоги.Получить(Т.Получатель);
        Итоги.Вставить(Т.Получатель, ?(Старое=Неопределено,0,Старое)+СуммаСписания);
    КонецЦикла;
    Возврат Итоги;
КонецФункции

Процедура ДобавитьРасходОУ(Док,О,К,С)
    Д = Док.Движения.ОстаткиПартий.ДобавитьРасход();
    Д.Период=Док.Дата;Д.Номенклатура=О.Номенклатура;Д.Подразделение=О.Подразделение;Д.Свойство=О.Свойство;Д.Партия=О.Партия;Д.Количество=К;Д.Стоимость=С;
КонецПроцедуры

Процедура Приход(Док,Отказ) Экспорт
    ПроверитьСтроки(Док.СписокНоменклатуры,Отказ);
    Если Отказ Тогда Возврат; КонецЕсли;
    Если Док.ОперативныйУчет Тогда
        Если Не ЗначениеЗаполнено(Док.Подразделение) Тогда Ошибка("Укажите подразделение.",Отказ);Возврат;КонецЕсли;
        Док.Движения.ОстаткиПартий.Записывать=Истина;
        Для Каждого С Из Док.СписокНоменклатуры Цикл
            Д=Док.Движения.ОстаткиПартий.ДобавитьПриход();Д.Период=Док.Дата;Д.Подразделение=Док.Подразделение;Д.Номенклатура=С.Номенклатура;Д.Свойство=С.Свойство;Д.Партия=Док.Ссылка;Д.Количество=С.Количество;Д.Стоимость=С.Сумма;
        КонецЦикла;
    КонецЕсли;
    Если Док.БухгалтерскийУчет Тогда
        НастроитьСчета();
        Если Не ЗначениеЗаполнено(Док.Склад) Тогда Ошибка("Укажите склад.",Отказ);Возврат;КонецЕсли;
        Док.Движения.УправленческийУчет.Записывать=Истина;
        Для Каждого С Из Док.СписокНоменклатуры Цикл
            Д=Док.Движения.УправленческийУчет.Добавить();Д.Период=Док.Дата;Д.СчетДт=ПланыСчетов.Управленческий.Товары;Д.СчетКт=ПланыСчетов.Управленческий.Поставщики;Д.НоменклатураДт=С.Номенклатура;Д.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады]=Док.Склад;Д.КоличествоДт=С.Количество;Д.Сумма=С.Сумма;
        КонецЦикла;
    КонецЕсли;
КонецПроцедуры

Процедура Продажа(Док,Отказ) Экспорт
    ПроверитьСтроки(Док.СписокНоменклатуры,Отказ);Если Отказ Тогда Возврат;КонецЕсли;
    Если Док.ОперативныйУчет Тогда
        Т=Потребности();
        Для Каждого С Из Док.СписокНоменклатуры Цикл
            Р=Т.Добавить();Р.Подразделение=?(ЗначениеЗаполнено(С.Подразделение),С.Подразделение,Док.Подразделение);Р.Номенклатура=С.Номенклатура;Р.Свойство=С.Свойство;Р.Количество=С.Количество;Р.Получатель=С.Номенклатура;
        КонецЦикла;
        Стоимости=СписатьОУ(Док,Т,Отказ);Если Отказ Тогда Возврат;КонецЕсли;
        // В регистр продаж попадает каждая фактически списанная партия.
        Док.Движения.ПродажиОУ.Записывать=Истина;
        СтрокиПродаж=Док.СписокНоменклатуры.Выгрузить();
        СтрокиПродаж.Свернуть("Номенклатура,Подразделение","Количество,Сумма");
        Для Каждого С Из СтрокиПродаж Цикл
            Д=Док.Движения.ПродажиОУ.Добавить();Д.Период=Док.Дата;Д.Номенклатура=С.Номенклатура;Д.Подразделение=?(ЗначениеЗаполнено(С.Подразделение),С.Подразделение,Док.Подразделение);Д.Количество=С.Количество;Д.Выручка=С.Сумма;
            Для Каждого М Из Док.Движения.ОстаткиПартий Цикл
                Если М.Номенклатура=Д.Номенклатура И М.Подразделение=Д.Подразделение Тогда Д.Себестоимость=Д.Себестоимость+?(М.ВидДвижения=ВидДвиженияНакопления.Расход,М.Стоимость,-М.Стоимость);КонецЕсли;
            КонецЦикла;
        КонецЦикла;
    КонецЕсли;
    Если Док.БухгалтерскийУчет Тогда ПродажаБУ(Док,Отказ);КонецЕсли;
КонецПроцедуры

Процедура Сборка(Док,Отказ) Экспорт
    Если Не ЗначениеЗаполнено(Док.ПодразделениеИсточник) Или Не ЗначениеЗаполнено(Док.ПодразделениеПолучатель) Тогда Ошибка("Укажите подразделения сборки.",Отказ);Возврат;КонецЕсли;
    Блоки=Док.СистемныеБлоки.Выгрузить();Блоки.Свернуть("СистемныйБлок","Количество");
    Если Блоки.Количество()=0 Тогда Ошибка("В сборке должен быть указан хотя бы один системный блок.",Отказ);Возврат;КонецЕсли;
    Для Каждого Б Из Блоки Цикл Если Б.Количество<=0 Или Не ЗначениеЗаполнено(Б.СистемныйБлок) Тогда Ошибка("Укажите системный блок и положительное количество.",Отказ);Возврат;КонецЕсли;КонецЦикла;
    П=Новый Структура("Дата,Блоки",Док.Дата,Блоки.ВыгрузитьКолонку("СистемныйБлок"));
    Спецификации=ЗапросТаблица("ВЫБРАТЬ С.СистемныйБлок, С.Номенклатура, С.Свойство, С.Количество
    |ИЗ РегистрСведений.Спецификации КАК С
    |ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ СистемныйБлок, МАКСИМУМ(Период) КАК Период ИЗ РегистрСведений.Спецификации ГДЕ Период <= &Дата И СистемныйБлок В (&Блоки) СГРУППИРОВАТЬ ПО СистемныйБлок) КАК Версия
    |ПО С.СистемныйБлок=Версия.СистемныйБлок И С.Период=Версия.Период",П);
    Т=Потребности();
    Для Каждого Б Из Блоки Цикл
        Состав=Спецификации.НайтиСтроки(Новый Структура("СистемныйБлок",Б.СистемныйБлок));
        Если Состав.Количество()=0 Тогда Ошибка("Нет актуальной спецификации " + Строка(Б.СистемныйБлок),Отказ);Возврат;КонецЕсли;
        Для Каждого С Из Состав Цикл Р=Т.Добавить();Р.Подразделение=Док.ПодразделениеИсточник;Р.Номенклатура=С.Номенклатура;Р.Свойство=С.Свойство;Р.Количество=С.Количество*Б.Количество;Р.Получатель=Б.СистемныйБлок;КонецЦикла;
    КонецЦикла;
    Для Каждого С Из Док.ДополнительныеДетали Цикл Р=Т.Добавить();Р.Подразделение=Док.ПодразделениеИсточник;Р.Номенклатура=С.Номенклатура;Р.Свойство=С.Свойство;Р.Количество=С.Количество;КонецЦикла;
    Стоимости=СписатьОУ(Док,Т,Отказ,Ложь);Если Отказ Тогда Возврат;КонецЕсли;
    ДопСтоимость=Стоимости.Получить(Справочники.Номенклатура.ПустаяСсылка());Если ДопСтоимость=Неопределено Тогда ДопСтоимость=0;КонецЕсли;
    ОстДоп=ДопСтоимость;ВсегоБлоков=Блоки.Итог("Количество");Инд=0;
    Для Каждого Б Из Блоки Цикл
        Инд=Инд+1;Доп=?(Инд=Блоки.Количество(),ОстДоп,Окр(ДопСтоимость*Б.Количество/ВсегоБлоков,2));ОстДоп=ОстДоп-Доп;
        Д=Док.Движения.ОстаткиПартий.ДобавитьПриход();Д.Период=Док.Дата;Д.Подразделение=Док.ПодразделениеПолучатель;Д.Номенклатура=Б.СистемныйБлок;Д.Партия=Док.Ссылка;Д.Количество=Б.Количество;Д.Стоимость=Стоимости.Получить(Б.СистемныйБлок)+Доп;
    КонецЦикла;
КонецПроцедуры

Функция СвязанныеТовары(Товар,Связи)
    Найденные=Новый Массив;Найденные.Добавить(Товар);Индекс=0;
    Пока Индекс < Найденные.Количество() Цикл
        Текущий=Найденные[Индекс];Индекс=Индекс+1;
        ТекущиеСвязи=Новый Массив;
        Для Каждого С Из Связи.НайтиСтроки(Новый Структура("Товар",Текущий)) Цикл ТекущиеСвязи.Добавить(С);КонецЦикла;
        Для Каждого С Из Связи.НайтиСтроки(Новый Структура("Аналог",Текущий)) Цикл ТекущиеСвязи.Добавить(С);КонецЦикла;
        Для Каждого С Из ТекущиеСвязи Цикл
            Другой=Неопределено;
            Если С.Товар=Текущий Тогда Другой=С.Аналог;ИначеЕсли С.Аналог=Текущий Тогда Другой=С.Товар;КонецЕсли;
            Если Другой<>Неопределено И Найденные.Найти(Другой)=Неопределено Тогда Найденные.Добавить(Другой);КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Возврат Найденные;
КонецФункции

Процедура ПродажаБУ(Док,Отказ)
    НастроитьСчета();
    Если Не ЗначениеЗаполнено(Док.Склад) Тогда Ошибка("Укажите склад.",Отказ);Возврат;КонецЕсли;
    // Общая блокировка товаров нужна: один аналог может участвовать в разных группах.
    Блокировка("РегистрБухгалтерии.УправленческийУчет");
    Док.Движения.УправленческийУчет.Записывать=Истина;Док.Движения.УправленческийУчет.Очистить();Док.Движения.УправленческийУчет.Записать();
    Док.Движения.ПродажиБУ.Записывать=Истина;
    Связи=ЗапросТаблица("ВЫБРАТЬ Товар, Аналог ИЗ РегистрСведений.Аналоги");
    Связи.Индексы.Добавить("Товар");Связи.Индексы.Добавить("Аналог");
    ВсеТовары=Новый Массив;Группы=Новый Соответствие;
    Для Каждого Стр Из Док.СписокНоменклатуры Цикл
        Если Группы.Получить(Стр.Номенклатура)<>Неопределено Тогда Продолжить;КонецЕсли;
        Связанные=СвязанныеТовары(Стр.Номенклатура,Связи);Группы.Вставить(Стр.Номенклатура,Связанные);
        Для Каждого Т Из Связанные Цикл Если ВсеТовары.Найти(Т)=Неопределено Тогда ВсеТовары.Добавить(Т);КонецЕсли;КонецЦикла;
    КонецЦикла;
    П=Новый Структура("Момент,Счет,Склад",Новый Граница(Док.МоментВремени(),ВидГраницы.Исключая),ПланыСчетов.Управленческий.Товары,Док.Склад);
    П.Вставить("Товары",ВсеТовары);
    Остатки=ЗапросТаблица("ВЫБРАТЬ Номенклатура, ЕСТЬNULL(СУММА(КоличествоОстаток),0) КАК Количество, ЕСТЬNULL(СУММА(СуммаОстаток),0) КАК Сумма
    |ИЗ РегистрБухгалтерии.УправленческийУчет.Остатки(&Момент, Счет=&Счет,, Номенклатура В (&Товары))
    |СГРУППИРОВАТЬ ПО Номенклатура",П);
    Складские=ЗапросТаблица("ВЫБРАТЬ Номенклатура, КоличествоОстаток КАК Количество
    |ИЗ РегистрБухгалтерии.УправленческийУчет.Остатки(&Момент, Счет=&Счет,, Субконто1=&Склад И Номенклатура В (&Товары))",П);
    Артикулы=ЗапросТаблица("ВЫБРАТЬ Ссылка КАК Товар, Артикул ИЗ Справочник.Номенклатура ГДЕ НЕ ЭтоГруппа И Ссылка В (&Товары) УПОРЯДОЧИТЬ ПО Артикул, Ссылка",П);
    Остатки.Индексы.Добавить("Номенклатура");Складские.Индексы.Добавить("Номенклатура");
    Для Каждого С Из Док.СписокНоменклатуры Цикл
        Группа=Группы.Получить(С.Номенклатура);
        Кандидаты=Новый Массив;Кандидаты.Добавить(С.Номенклатура);
        Для Каждого А Из Артикулы Цикл Если А.Товар<>С.Номенклатура И Группа.Найти(А.Товар)<>Неопределено Тогда Кандидаты.Добавить(А.Товар);КонецЕсли;КонецЦикла;
        Осталось=С.Количество;ВыручкаОст=С.Сумма;
        Для Каждого Товар Из Кандидаты Цикл
            Если Осталось<=0 Тогда Прервать;КонецЕсли;
            О=Остатки.Найти(Товар,"Номенклатура");СО=Складские.Найти(Товар,"Номенклатура");
            Если О=Неопределено Или СО=Неопределено Тогда Продолжить;КонецЕсли;
            Если О.Количество<=0 Или СО.Количество<=0 Тогда Продолжить;КонецЕсли;
            К=Мин(Осталось,СО.Количество,О.Количество);Стоимость=?(К=О.Количество,О.Сумма,Окр(О.Сумма*К/О.Количество,2));
            Выручка=?(К=Осталось,ВыручкаОст,Окр(С.Сумма*К/С.Количество,2));
            Д=Док.Движения.УправленческийУчет.Добавить();Д.Период=Док.Дата;Д.СчетДт=ПланыСчетов.Управленческий.ПрибылиУбытки;Д.СчетКт=ПланыСчетов.Управленческий.Товары;Д.НоменклатураКт=Товар;Д.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады]=Док.Склад;Д.КоличествоКт=К;Д.Сумма=Стоимость;
            Д=Док.Движения.УправленческийУчет.Добавить();Д.Период=Док.Дата;Д.СчетДт=ПланыСчетов.Управленческий.Покупатели;Д.СчетКт=ПланыСчетов.Управленческий.ПрибылиУбытки;Д.Сумма=Выручка;
            Д=Док.Движения.ПродажиБУ.Добавить();Д.Период=Док.Дата;Д.Номенклатура=С.Номенклатура;Д.Продано=Товар;Д.Количество=К;Д.Себестоимость=Стоимость;Д.Выручка=Выручка;
            О.Количество=О.Количество-К;О.Сумма=О.Сумма-Стоимость;СО.Количество=СО.Количество-К;Осталось=Осталось-К;ВыручкаОст=ВыручкаОст-Выручка;
        КонецЦикла;
        Если Осталось>0 Тогда Ошибка("Не хватает товара " + Строка(С.Номенклатура) + " и его аналогов. Недостает " + Осталось,Отказ);Возврат;КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура НастроитьСчета() Экспорт
    Счет=ПланыСчетов.Управленческий.Товары;
    Если Счет.ВидыСубконто.Количество()=0 Тогда
        О=Счет.ПолучитьОбъект();
        С=О.ВидыСубконто.Добавить();С.ВидСубконто=ПланыВидовХарактеристик.ВидыСубконто.Склады;С.ТолькоОбороты=Ложь;С.Суммовой=Ложь;С.КоличественныйСубконто=Истина;
        О.Количественный=Истина;О.Записать();
    КонецЕсли;
КонецПроцедуры



Процедура БлокироватьОУ() Экспорт
    Б=Новый БлокировкаДанных;
    Б.Добавить("РегистрНакопления.ОстаткиПартий").Режим=РежимБлокировкиДанных.Исключительный;
    Б.Добавить("РегистрНакопления.ОстаткиНоменклатуры").Режим=РежимБлокировкиДанных.Исключительный;
    Б.Заблокировать();
КонецПроцедуры

Процедура ЗаписатьОстаткиОУ(Док,Отказ) Экспорт
    // Партийный регистр хранит очередность и стоимость партий, общий —
    // экономические приходы/расходы без технических поправок округления.
    Пулы=Потребности();Пулы.Колонки.Удалить("Получатель");Пулы.Колонки.Добавить("Стоимость",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(18,2)));
    Пулы.Индексы.Добавить("Подразделение,Номенклатура,Свойство");
    Для Каждого Д Из Док.Движения.ОстаткиПартий Цикл
        Отбор=Новый Структура("Подразделение,Номенклатура,Свойство",Д.Подразделение,Д.Номенклатура,Д.Свойство);
        Найденные=Пулы.НайтиСтроки(Отбор);
        Если Найденные.Количество()=0 Тогда П=Пулы.Добавить();ЗаполнитьЗначенияСвойств(П,Отбор);Иначе П=Найденные[0];КонецЕсли;
        Знак=?(Д.ВидДвижения=ВидДвиженияНакопления.Расход,1,-1);
        П.Количество=П.Количество+Д.Количество*Знак;П.Стоимость=П.Стоимость+Д.Стоимость*Знак;
    КонецЦикла;
    Общие=Док.Движения.ОстаткиНоменклатуры;Общие.Записывать=Истина;Общие.Очистить();
    Для Каждого П Из Пулы Цикл
        Если П.Количество=0 И П.Стоимость=0 Тогда Продолжить;КонецЕсли;
        Расход=П.Количество>0 Или (П.Количество=0 И П.Стоимость>0);
        Если Расход Тогда Д=Общие.ДобавитьРасход();Иначе Д=Общие.ДобавитьПриход();КонецЕсли;
        Д.Период=Док.Дата;Д.Подразделение=П.Подразделение;Д.Номенклатура=П.Номенклатура;Д.Свойство=П.Свойство;Д.Количество=П.Количество*?(Расход,1,-1);Д.Стоимость=П.Стоимость*?(Расход,1,-1);
    КонецЦикла;
    Док.Движения.ОстаткиПартий.Записать();Общие.Записать();
    Если Пулы.Количество()=0 Тогда Возврат;КонецЕсли;
    Парам=Новый Структура("Момент,Товары,Подразделения",Новый Граница(Док.МоментВремени(),ВидГраницы.Включая),Пулы.ВыгрузитьКолонку("Номенклатура"),Пулы.ВыгрузитьКолонку("Подразделение"));
    Недостатки=ЕстьЗаписи("ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура,Подразделение,Свойство,КоличествоОстаток,СтоимостьОстаток
    |ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Момент,Номенклатура В (&Товары) И Подразделение В (&Подразделения))
    |ГДЕ КоличествоОстаток<0 ИЛИ СтоимостьОстаток<0 ИЛИ (КоличествоОстаток=0 И СтоимостьОстаток<>0)",Парам);
    Если Недостатки Тогда Ошибка("Движения приводят к отрицательному либо несогласованному остатку номенклатуры.",Отказ);КонецЕсли;
    Если Не Отказ Тогда
        НарушениеИстории=ЕстьЗаписи("ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура,Подразделение,Свойство,NULL КАК Партия
        |ИЗ РегистрНакопления.ОстаткиНоменклатуры.ОстаткиИОбороты(&Момент,,Регистратор,Движения,Номенклатура В (&Товары) И Подразделение В (&Подразделения))
        |ГДЕ КоличествоКонечныйОстаток<0 ИЛИ СтоимостьКонечныйОстаток<0 ИЛИ (КоличествоКонечныйОстаток=0 И СтоимостьКонечныйОстаток<>0)
        |ОБЪЕДИНИТЬ ВСЕ
        |ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура,Подразделение,Свойство,Партия
        |ИЗ РегистрНакопления.ОстаткиПартий.ОстаткиИОбороты(&Момент,,Регистратор,Движения,Номенклатура В (&Товары) И Подразделение В (&Подразделения))
        |ГДЕ КоличествоКонечныйОстаток<0 ИЛИ СтоимостьКонечныйОстаток<0 ИЛИ (КоличествоКонечныйОстаток=0 И СтоимостьКонечныйОстаток<>0)",Парам);
        Если НарушениеИстории Тогда Ошибка("Проведение нарушает остатки последующих документов. Перепроведите зависимые документы в хронологическом порядке.",Отказ);КонецЕсли;
    КонецЕсли;
    Док.Движения.ОстаткиПартий.Записывать=Ложь;Общие.Записывать=Ложь;
КонецПроцедуры

Функция ЕстьЗаписи(Текст,Параметры)
    Запрос=Новый Запрос(Текст);
    Для Каждого П Из Параметры Цикл Запрос.УстановитьПараметр(П.Ключ,П.Значение);КонецЦикла;
    Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

