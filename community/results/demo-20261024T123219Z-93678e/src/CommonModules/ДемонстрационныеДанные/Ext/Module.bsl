Функция Элемент(Менеджер,Имя)
    Ссылка=Менеджер.НайтиПоНаименованию(Имя,Истина);
    Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка;КонецЕсли;
    О=Менеджер.СоздатьЭлемент();О.Наименование=Имя;О.Записать();Возврат О.Ссылка;
КонецФункции

Функция ДокументПримера(Менеджер,Номер,Дата)
    С=Менеджер.НайтиПоНомеру(Номер,Дата);
    Если ЗначениеЗаполнено(С) Тогда Д=С.ПолучитьОбъект();Иначе Д=Менеджер.СоздатьДокумент();Д.Номер=Номер;КонецЕсли;
    Д.Дата=Дата;Возврат Д;
КонецФункции

