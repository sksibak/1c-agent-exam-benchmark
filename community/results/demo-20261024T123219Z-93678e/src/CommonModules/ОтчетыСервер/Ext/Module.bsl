Процедура Ячейка(Таб,Строка,Колонка,Значение,Число=Ложь,Жирный=Ложь,КакКоличество=Ложь)
    О=Таб.Область(Строка,Колонка);О.Шрифт=Новый Шрифт("Arial",10,Жирный);
    Если Число Тогда О.Текст=?(КакКоличество,Строка(Значение),Формат(Значение,"ЧДЦ=2;ЧН=0"));О.ГоризонтальноеПоложение=ГоризонтальноеПоложение.Право;
    Иначе О.Текст=Строка(Значение);КонецЕсли;
    Если Жирный Тогда О.Шрифт=Новый Шрифт("Arial",10,Истина);КонецЕсли;
КонецПроцедуры

Функция ПечатнаяФорма(Вид,Данные,Начало,Конец,Подразделение=Неопределено) Экспорт
    Т=Новый ТабличныйДокумент;
    Заголовок="Продажи с " + Формат(Начало,"ДФ=dd.MM.yyyy") + " по " + Формат(Конец,"ДФ=dd.MM.yyyy");
    Если Вид="ou_statement" Тогда Заголовок="Ведомость по подразделению «" + Строка(Подразделение) + "» за период с " + Формат(Начало,"ДФ=dd.MM.yyyy") + " по " + Формат(Конец,"ДФ=dd.MM.yyyy");КонецЕсли;
    Если Вид="pr_bonus" Тогда Заголовок="Месяц: " + Формат(Начало,"ДФ='MMMM yyyy'") + " г.";КонецЕсли;
    Если Вид="ou_statement" Тогда Колонки=СтрРазделить("Производитель,Товар,Нач. ост.,Приход,Расход,Кон. ост.",",");
    ИначеЕсли Вид="bu_sales" Тогда Колонки=СтрРазделить("Номенклатура,Продано,Кол-во,Себест-сть,Продажа,Прибыль",",");
    ИначеЕсли Вид="pr_bonus" Тогда Колонки=СтрРазделить("Сотрудник,Трудовой стаж,% премии,Сумма премии",",");
    Иначе Колонки=СтрРазделить("Номенклатура,Кол-во,Себест-сть,Продажа,Прибыль",",");КонецЕсли;
    ЧислоКолонок=Колонки.Количество();Т.Область(1,1,1,ЧислоКолонок).Объединить();Ячейка(Т,1,1,Заголовок,Ложь,Истина);
    Кол=0;Для Каждого К Из Колонки Цикл Кол=Кол+1;Ячейка(Т,3,Кол,К,Ложь,Истина);КонецЦикла;
    Н=3;ДвойныеСтроки=Новый Массив;
    Если Вид="ou_statement" Тогда
        Производитель=Неопределено;
        Для Каждого С Из Данные Цикл
            Если Производитель<>С.Производитель Тогда Н=Н+1;Производитель=С.Производитель;Ячейка(Т,Н,1,Производитель,Ложь,Истина);КонецЕсли;
            Н=Н+1;ДвойныеСтроки.Добавить(Н);
            ПодписьТовара=Строка(С.Номенклатура)+?(ПустаяСтрока(С.ДругиеХарактеристики),"",Символы.ПС+С.ДругиеХарактеристики);
            Ячейка(Т,Н,2,ПодписьТовара);
            ДвойнаяЯчейка(Т,Н,3,С.НачКоличество,С.НачСумма);ДвойнаяЯчейка(Т,Н,4,С.ПриходКоличество,С.ПриходСумма);ДвойнаяЯчейка(Т,Н,5,С.РасходКоличество,С.РасходСумма);ДвойнаяЯчейка(Т,Н,6,С.КонКоличество,С.КонСумма);
        КонецЦикла;
    ИначеЕсли Вид="bu_sales" Тогда
        Итоги=Данные.Скопировать();Итоги.Свернуть("Номенклатура","Количество,Себестоимость,Выручка,Прибыль");
        Для Каждого ИтогСтрока Из Итоги Цикл
            Н=Н+1;Ячейка(Т,Н,1,ИтогСтрока.Номенклатура,Ложь,Истина);Ячейка(Т,Н,3,ИтогСтрока.Количество,Истина,Истина,Истина);Ячейка(Т,Н,4,ИтогСтрока.Себестоимость,Истина,Истина);Ячейка(Т,Н,5,ИтогСтрока.Выручка,Истина,Истина);Ячейка(Т,Н,6,ИтогСтрока.Прибыль,Истина,Истина);
            Для Каждого С Из Данные.НайтиСтроки(Новый Структура("Номенклатура",ИтогСтрока.Номенклатура)) Цикл
                Н=Н+1;Ячейка(Т,Н,2,С.Продано);Ячейка(Т,Н,3,С.Количество,Истина,Ложь,Истина);Ячейка(Т,Н,4,С.Себестоимость,Истина);Ячейка(Т,Н,5,С.Выручка,Истина);Ячейка(Т,Н,6,С.Прибыль,Истина);
            КонецЦикла;
        КонецЦикла;
    ИначеЕсли Вид="pr_bonus" Тогда
        Для Каждого С Из Данные Цикл
            Н=Н+1;Ячейка(Т,Н,1,С.Сотрудник);Ячейка(Т,Н,2,Строка(Цел(С.Стаж))+" г. "+Строка(Окр((С.Стаж-Цел(С.Стаж))*12,0))+" мес.");Ячейка(Т,Н,3,С.Процент,Истина,Ложь,Истина);Ячейка(Т,Н,4,С.СуммаПремии,Истина);
        КонецЦикла;
        Н=Н+1;Ячейка(Т,Н,1,"ИТОГО:",Ложь,Истина);Ячейка(Т,Н,4,Данные.Итог("СуммаПремии"),Истина,Истина);
    Иначе
        Для Каждого С Из Данные Цикл
            Н=Н+1;Ячейка(Т,Н,1,С.Номенклатура);Ячейка(Т,Н,2,С.Количество,Истина,Ложь,Истина);Ячейка(Т,Н,3,С.Себестоимость,Истина);Ячейка(Т,Н,4,С.Выручка,Истина);Ячейка(Т,Н,5,С.Прибыль,Истина);
        КонецЦикла;
    КонецЕсли;
    Граница=Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
    Для ИндСтроки=3 По Н Цикл
        Для ИндКолонки=1 По ЧислоКолонок Цикл Т.Область(ИндСтроки,ИндКолонки).Обвести(Граница,Граница,Граница,Граница);КонецЦикла;
    КонецЦикла;
    Т.Область(1,1,Н,ЧислоКолонок).ВысотаСтроки=18;
    Для Каждого Инд Из ДвойныеСтроки Цикл Т.Область(Инд,1,Инд,ЧислоКолонок).ВысотаСтроки=36;КонецЦикла;
    Т.Область(1,1,Н,ЧислоКолонок).ШиринаКолонки=18;
    Т.Область(1,1,Н,1).ШиринаКолонки=30;
    Если Вид="bu_sales" Или Вид="ou_statement" Тогда Т.Область(1,2,Н,2).ШиринаКолонки=30;КонецЕсли;
    Т.Область(1,1,Н,ЧислоКолонок).РазмещениеТекста=ТипРазмещенияТекстаТабличногоДокумента.Переносить;
    // При прямом заполнении ячеек PDF не всегда пересчитывает автовысоту.
    // Резервируем высоту для длинных названий и явных переводов строки.
    Для ИндСтроки=3 По Н Цикл
        СтрокВДанных=1;
        Для ИндКолонки=1 По ЧислоКолонок Цикл
            Обл=Т.Область(ИндСтроки,ИндКолонки);Ширина=Обл.ШиринаКолонки;Емкость=?(Ширина>=30,16,10);ЧислоСтрок=0;
            Для Каждого Часть Из СтрРазделить(Обл.Текст,Символы.ПС,Истина) Цикл
                ЧислоСтрок=ЧислоСтрок+?(СтрДлина(Часть)<=Ширина,1,Цел((СтрДлина(Часть)+Емкость-1)/Емкость));
            КонецЦикла;
            СтрокВДанных=Макс(СтрокВДанных,ЧислоСтрок);
        КонецЦикла;
        ОблСтроки=Т.Область(ИндСтроки,1,ИндСтроки,ЧислоКолонок);ОблСтроки.ВысотаСтроки=Макс(ОблСтроки.ВысотаСтроки,СтрокВДанных*14+4);
    КонецЦикла;
    Т.ФиксацияСверху=3;Т.АвтоМасштаб=Истина;
    Возврат Т;
КонецФункции

Процедура ДобавитьХарактеристики(Данные) Экспорт
    Данные.Колонки.Добавить("ДругиеХарактеристики");Данные.Колонки.Добавить("Производитель");Данные.Колонки.Добавить("Характеристики");Данные.Колонки.Добавить("ПредставлениеТовара");
    П=Новый Структура("Свойства",Данные.ВыгрузитьКолонку("Свойство"));
    Значения=УчетСервер.ЗапросТаблица("ВЫБРАТЬ Свойство,Характеристика.Наименование КАК Наименование,Значение ИЗ РегистрСведений.ЗначенияСвойств ГДЕ Свойство В (&Свойства) УПОРЯДОЧИТЬ ПО Наименование",П);
    Для Каждого С Из Данные Цикл
        С.Производитель="Без характеристик";С.Характеристики="";С.ДругиеХарактеристики="";С.ПредставлениеТовара=Строка(С.Номенклатура);
        Для Каждого З Из Значения.НайтиСтроки(Новый Структура("Свойство",С.Свойство)) Цикл
            С.Характеристики=С.Характеристики+?(ПустаяСтрока(С.Характеристики),"","; ")+З.Наименование+": "+Строка(З.Значение);
            Если ВРег(З.Наименование)="ПРОИЗВОДИТЕЛЬ" Тогда С.Производитель=Строка(З.Значение);Иначе С.ДругиеХарактеристики=С.ДругиеХарактеристики+?(ПустаяСтрока(С.ДругиеХарактеристики),"","; ")+З.Наименование+": "+Строка(З.Значение);КонецЕсли;
        КонецЦикла;
        Если С.Производитель="Без характеристик" И Не ПустаяСтрока(С.Характеристики) Тогда С.Производитель=С.Характеристики;КонецЕсли;
    КонецЦикла;
    Данные.Сортировать("Производитель,ПредставлениеТовара");
КонецПроцедуры

Процедура ДвойнаяЯчейка(Таб,Строка,Колонка,Количество,Сумма)
    Текст=?(Количество=0,"",Строка(Количество))+Символы.ПС+?(Сумма=0,"",Формат(Сумма,"ЧДЦ=2;ЧН=0"));
    Ячейка(Таб,Строка,Колонка,Текст);
    Таб.Область(Строка,Колонка).ГоризонтальноеПоложение=ГоризонтальноеПоложение.Право;
КонецПроцедуры
