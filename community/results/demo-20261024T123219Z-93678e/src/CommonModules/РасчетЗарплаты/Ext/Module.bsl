Процедура НастроитьЗависимости() Экспорт
    ПВР=ПланыВидовРасчета.ОсновныеНачисления;
    Виды=Новый Массив;Виды.Добавить(ПВР.Оклад);Виды.Добавить(ПВР.Премия);Виды.Добавить(ПВР.Командировка);
    Тариф=ПВР.Оклад.ПолучитьОбъект();Премия=ПВР.Премия.ПолучитьОбъект();Командировка=ПВР.Командировка.ПолучитьОбъект();
    Если Тариф.ВытесняющиеВидыРасчета.Количество()=0 Тогда
        Р=Тариф.ВытесняющиеВидыРасчета.Добавить();Р.ВидРасчета=ПВР.Командировка;Тариф.Записать();
    КонецЕсли;
    Изменен=Ложь;
    Если Премия.ВытесняющиеВидыРасчета.Количество()=0 Тогда Р=Премия.ВытесняющиеВидыРасчета.Добавить();Р.ВидРасчета=ПВР.Командировка;Изменен=Истина;КонецЕсли;
    Если Премия.БазовыеВидыРасчета.Количество()=0 Тогда Р=Премия.БазовыеВидыРасчета.Добавить();Р.ВидРасчета=ПВР.Оклад;Изменен=Истина;КонецЕсли;
    Если Изменен Тогда Премия.Записать();КонецЕсли;
    Если Командировка.БазовыеВидыРасчета.Количество()=0 Тогда
        Для Каждого Б Из Виды Цикл Р=Командировка.БазовыеВидыРасчета.Добавить();Р.ВидРасчета=Б;КонецЦикла;
        Командировка.Записать();
    КонецЕсли;
КонецПроцедуры

Процедура Провести(Док,Отказ) Экспорт
    УчетСервер.Блокировка("РегистрРасчета.Начисления");
    НастроитьЗависимости();
    Область=ОбластьПересчета(Док);
    Набор=Док.Движения.Начисления;Набор.Записывать=Истина;Набор.Очистить();Набор.Записать();
    ПВР=ПланыВидовРасчета.ОсновныеНачисления;
    Ключи=Новый Соответствие;
    Для Каждого С Из Док.ОсновныеНачисления Цикл
        Если Не ЗначениеЗаполнено(С.Сотрудник) Или Не ЗначениеЗаполнено(С.Подразделение) Или Не ЗначениеЗаполнено(С.ВидРасчета) Или Не ЗначениеЗаполнено(С.ДатаНачала) Или С.ДатаОкончания<С.ДатаНачала Тогда
            УчетСервер.Ошибка("Проверьте сотрудника, подразделение, вид расчета и даты начисления.",Отказ);Возврат;
        КонецЕсли;
        Если С.ВидРасчета<>ПВР.Командировка И НачалоМесяца(С.ДатаНачала)<>НачалоМесяца(С.ДатаОкончания) Тогда УчетСервер.Ошибка("Тариф и премия вводятся в пределах календарного месяца.",Отказ);Возврат;КонецЕсли;
        Нач=НачалоДня(С.ДатаНачала);
        Пока Нач<=С.ДатаОкончания Цикл
            Кон=Мин(КонецДня(С.ДатаОкончания),КонецМесяца(Нач));
            Ключ=Строка(С.Сотрудник.УникальныйИдентификатор())+Строка(С.Подразделение.УникальныйИдентификатор())+Строка(С.ВидРасчета.УникальныйИдентификатор())+Формат(Нач,"ДФ=yyyyMMdd")+Формат(Кон,"ДФ=yyyyMMdd");
            Если Ключи.Получить(Ключ)=Неопределено Тогда
                Ключи.Вставить(Ключ,Истина);
                Д=Набор.Добавить();Д.ПериодРегистрации=НачалоМесяца(Нач);Д.ПериодДействияНачало=Нач;Д.ПериодДействияКонец=Кон;Д.Сотрудник=С.Сотрудник;Д.Подразделение=С.Подразделение;Д.ВидРасчета=С.ВидРасчета;
                Если С.ВидРасчета=ПВР.Командировка Тогда Д.ПериодРегистрации=Макс(Д.ПериодРегистрации,НачалоМесяца(Док.Дата));Д.БазовыйПериодНачало=ДобавитьМесяц(НачалоМесяца(Нач),-3);
                Иначе Д.БазовыйПериодНачало=ДобавитьМесяц(НачалоМесяца(Нач),-1);КонецЕсли;
                Д.БазовыйПериодКонец=КонецДня(НачалоМесяца(Нач)-1);
            КонецЕсли;
            Нач=НачалоДня(Кон+1);
        КонецЦикла;
    КонецЦикла;
    ОбъединитьПериоды(Набор);
    Набор.Записать();
    Дополнение=Набор.ПолучитьДополнение();
    Для Каждого С Из Дополнение Цикл
        Д=Набор.Добавить();ЗаполнитьЗначенияСвойств(Д,С);
        Д.Сторно=Истина;Д.ПериодРегистрации=С.ПериодРегистрацииСторно;Д.ПериодДействияНачало=С.ПериодДействияНачалоСторно;Д.ПериодДействияКонец=С.ПериодДействияКонецСторно;
    КонецЦикла;
    Если Дополнение.Количество()>0 Тогда Набор.Записать();КонецЕсли;
    РассчитатьВсе(Область);
    // Набор движений в объекте должен содержать окончательные результаты.
    Набор.Прочитать();Набор.Записывать=Ложь;
КонецПроцедуры

Процедура РассчитатьВсе(Область=Неопределено) Экспорт
    // Связи сотрудник—подразделение нужны для зависимых премий руководителей.
    // Виды должностей не хранятся; получаем связи из аналитики регистра.
    Связи=УчетСервер.ЗапросТаблица("ВЫБРАТЬ Сотрудник,Подразделение,МИНИМУМ(ПериодДействияНачало) КАК Начало ИЗ РегистрРасчета.Начисления СГРУППИРОВАТЬ ПО Сотрудник,Подразделение");
    Если Связи.Количество()=0 Тогда Возврат;КонецЕсли;
    Если Область=Неопределено Тогда
        Область=Новый Структура("Сотрудники,Подразделения,Начало",Новый Массив,Новый Массив,Дата(3999,1,1));
        Для Каждого С Из Связи Цикл ДобавитьВОбласть(Область,С.Сотрудник,С.Подразделение,С.Начало);КонецЦикла;
    КонецЕсли;
    Изменена=Истина;
    Пока Изменена Цикл
        Изменена=Ложь;
        Для Каждого С Из Связи Цикл
            Если Область.Сотрудники.Найти(С.Сотрудник)<>Неопределено Или Область.Подразделения.Найти(С.Подразделение)<>Неопределено Тогда
                Если Область.Сотрудники.Найти(С.Сотрудник)=Неопределено Тогда Область.Сотрудники.Добавить(С.Сотрудник);Изменена=Истина;КонецЕсли;
                Если Область.Подразделения.Найти(С.Подразделение)=Неопределено Тогда Область.Подразделения.Добавить(С.Подразделение);Изменена=Истина;КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    ПараметрыОбласти=Новый Структура("Сотрудники,Начало",Область.Сотрудники,НачалоМесяца(Область.Начало));
    // Фактические часы и дни — только из специализированной виртуальной таблицы.
    Данные=УчетСервер.ЗапросТаблица("ВЫБРАТЬ ПериодРегистрации,Регистратор,НомерСтроки,ВидРасчета,ПериодДействия,ПериодДействияНачало,ПериодДействияКонец,БазовыйПериодНачало,БазовыйПериодКонец,Активность,Сторно,Сотрудник,Подразделение,Результат,Часы,Дни,Ставка,Процент,Стаж,
    |ЕСТЬNULL(ЗначениеПериодДействия,0) КАК ЗначениеПериодДействия,ЕСТЬNULL(ЗначениеФактическийПериодДействия,0) КАК ЗначениеФактическийПериодДействия,
    |ЕСТЬNULL(ДниПериодДействия,0) КАК ДниПериодДействия,ЕСТЬNULL(ДниФактическийПериодДействия,0) КАК ДниФактическийПериодДействия
    |ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Сотрудник В (&Сотрудники) И ПериодДействияНачало>=&Начало) УПОРЯДОЧИТЬ ПО ПериодДействияНачало,Регистратор,НомерСтроки",ПараметрыОбласти);
    Если Данные.Количество()=0 Тогда Возврат;КонецЕсли;
    Данные.Колонки.Добавить("Месяц",Новый ОписаниеТипов("Дата"));
    Для Каждого С Из Данные Цикл С.Месяц=НачалоМесяца(С.ПериодДействияНачало);КонецЦикла;
    // Полные наборы нужны для сохранения неизменяемых строк того же регистратора.
    // Их ресурсы не используются как расчетная база.
    ИсходныеЗаписи=УчетСервер.ЗапросТаблица("ВЫБРАТЬ * ИЗ РегистрРасчета.Начисления ГДЕ Регистратор В (&Регистраторы) УПОРЯДОЧИТЬ ПО Регистратор,НомерСтроки",Новый Структура("Регистраторы",Данные.ВыгрузитьКолонку("Регистратор")));
    ИсходныеЗаписи.Индексы.Добавить("Регистратор");
    П=Новый Структура("Таблица",Данные);
    Ставки=УчетСервер.ЗапросТаблица("ВЫБРАТЬ РАЗЛИЧНЫЕ Сотрудник,ПериодДействияНачало ПОМЕСТИТЬ ДатыРасчета ИЗ &Таблица КАК Данные;
    |ВЫБРАТЬ Д.Сотрудник, Д.ПериодДействияНачало КАК ДатаНачала, МАКСИМУМ(С.Период) КАК Период
    |ПОМЕСТИТЬ Срезы
    |ИЗ ДатыРасчета КАК Д
    |ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифныеСтавки КАК С
    |ПО Д.Сотрудник=С.Сотрудник И С.Период<=НАЧАЛОПЕРИОДА(Д.ПериодДействияНачало,МЕСЯЦ)
    |СГРУППИРОВАТЬ ПО Д.Сотрудник,Д.ПериодДействияНачало;
    |ВЫБРАТЬ Д.Сотрудник,Д.ДатаНачала,ЕСТЬNULL(С.Ставка,0) КАК Ставка
    |ИЗ Срезы КАК Д ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифныеСтавки КАК С ПО Д.Сотрудник=С.Сотрудник И Д.Период=С.Период",П);
    Сотрудники=УчетСервер.ЗапросТаблица("ВЫБРАТЬ Ссылка КАК Сотрудник,НачалоСтажа ИЗ Справочник.ФизическиеЛица ГДЕ Ссылка В (&Сотрудники)",ПараметрыОбласти);
    Шкала=УчетСервер.ЗапросТаблица("ВЫБРАТЬ Стаж,Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО Стаж");
    ПВР=ПланыВидовРасчета.ОсновныеНачисления;КэшНаборов=Новый Соответствие;
    Для Каждого С Из Данные Цикл
        С.Результат=0;С.Часы=0;С.Дни=0;
        Если С.ВидРасчета=ПВР.Оклад Тогда
            Кандидаты=Ставки.НайтиСтроки(Новый Структура("Сотрудник,ДатаНачала",С.Сотрудник,С.ПериодДействияНачало));
            С.Ставка=?(Кандидаты.Количество()=0,0,Кандидаты[0].Ставка);
            С.Часы=С.ЗначениеФактическийПериодДействия;С.Дни=С.ДниФактическийПериодДействия;
            Если С.Сторно Тогда С.Часы=-С.Часы;С.Дни=-С.Дни;КонецЕсли;
            С.Результат=Окр(С.Ставка*С.Часы,2);
        ИначеЕсли С.ВидРасчета=ПВР.Премия Тогда
            Сотр=Сотрудники.Найти(С.Сотрудник,"Сотрудник");С.Стаж=0;С.Процент=0;
            Если Сотр<>Неопределено И ЗначениеЗаполнено(Сотр.НачалоСтажа) Тогда
                Месяцы=(Год(С.Месяц)-Год(Сотр.НачалоСтажа))*12+Месяц(С.Месяц)-Месяц(Сотр.НачалоСтажа);
                Если День(С.Месяц)<День(Сотр.НачалоСтажа) Тогда Месяцы=Месяцы-1;КонецЕсли;
                С.Стаж=Макс(0,Месяцы/12);
            КонецЕсли;
            Для Каждого Ш Из Шкала Цикл Если С.Стаж>=Ш.Стаж Тогда С.Процент=Ш.Процент;КонецЕсли;КонецЦикла;
        КонецЕсли;
    КонецЦикла;
    ЗаписатьРезультаты(Данные,КэшНаборов,ИсходныеЗаписи);
    ОсновныеИзмерения=Новый Массив;ОсновныеИзмерения.Добавить("Подразделение");Разрезы=Новый Массив;Разрезы.Добавить("Сотрудник");
    П=Новый Структура("Основные,Базовые,Разрезы,Премия",ОсновныеИзмерения,ОсновныеИзмерения,Разрезы,ПВР.Премия);
    П.Вставить("Сотрудники",Область.Сотрудники);П.Вставить("Начало",ПараметрыОбласти.Начало);
    БазаПремии=УчетСервер.ЗапросТаблица("ВЫБРАТЬ Регистратор,НомерСтроки,СотрудникРазрез,ЕСТЬNULL(РезультатБаза,0) КАК РезультатБаза ИЗ РегистрРасчета.Начисления.БазаНачисления(&Основные,&Базовые,&Разрезы,ВидРасчета=&Премия И Сотрудник В (&Сотрудники) И ПериодДействияНачало>=&Начало)",П);
    Для Каждого С Из Данные Цикл
        Если С.ВидРасчета<>ПВР.Премия Тогда Продолжить;КонецЕсли;
        База=0;
        Для Каждого Б Из БазаПремии.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки",С.Регистратор,С.НомерСтроки)) Цикл
            Если Б.СотрудникРазрез<>С.Сотрудник Тогда База=База+Б.РезультатБаза;КонецЕсли;
        КонецЦикла;
        Доля=?(С.ЗначениеПериодДействия=0,0,С.ЗначениеФактическийПериодДействия/С.ЗначениеПериодДействия);
        С.Результат=Окр(База*С.Процент/100*Доля,2);Если С.Сторно Тогда С.Результат=-С.Результат;КонецЕсли;
    КонецЦикла;
    ЗаписатьРезультаты(Данные,КэшНаборов,ИсходныеЗаписи);
    ОсновныеИзмерения=Новый Массив;ОсновныеИзмерения.Добавить("Сотрудник");Разрезы=Новый Массив;
    П=Новый Структура("Основные,Базовые,Разрезы,Командировка",ОсновныеИзмерения,ОсновныеИзмерения,Разрезы,ПВР.Командировка);
    П.Вставить("Сотрудники",Область.Сотрудники);П.Вставить("Начало",ПараметрыОбласти.Начало);
    БазаКомандировки=УчетСервер.ЗапросТаблица("ВЫБРАТЬ Регистратор,НомерСтроки,ЕСТЬNULL(РезультатБаза,0) КАК РезультатБаза,ЕСТЬNULL(ДниБаза,0) КАК ДниБаза ИЗ РегистрРасчета.Начисления.БазаНачисления(&Основные,&Базовые,&Разрезы,ВидРасчета=&Командировка И Сотрудник В (&Сотрудники) И ПериодДействияНачало>=&Начало)",П);
    Рассчитанные=Новый Массив;МесяцыКомандировок=Новый Массив;
    Для Каждого С Из Данные Цикл
        Если С.ВидРасчета=ПВР.Командировка И МесяцыКомандировок.Найти(С.Месяц)=Неопределено Тогда МесяцыКомандировок.Добавить(С.Месяц);КонецЕсли;
    КонецЦикла;
    Для Каждого МесяцРасчета Из МесяцыКомандировок Цикл
        РегистраторыМесяца=Новый Массив;СтрокиМесяца=Новый Массив;
        Для Каждого С Из Данные Цикл
            Если С.ВидРасчета<>ПВР.Командировка Или С.Месяц<>МесяцРасчета Тогда Продолжить;КонецЕсли;
            Базы=БазаКомандировки.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки",С.Регистратор,С.НомерСтроки));Сумма=0;Дни=0;
            Для Каждого Б Из Базы Цикл Сумма=Сумма+Б.РезультатБаза;Дни=Дни+Б.ДниБаза;КонецЦикла;
            // Начальная база получена виртуальной таблицей после записи тарифа
            // и премий. Здесь добавляются только уже ЗАПИСАННЫЕ результаты
            // предыдущих месяцев командировки, пересчитанные в этой транзакции.
            Для Каждого Р Из Рассчитанные Цикл
                Если Р.Сотрудник=С.Сотрудник И Р.ПериодДействияНачало>=С.БазовыйПериодНачало И Р.ПериодДействияНачало<=С.БазовыйПериодКонец Тогда Сумма=Сумма+Р.Результат;КонецЕсли;
            КонецЦикла;
            С.Результат=?(Дни=0,0,Окр(Сумма/Дни*С.ДниФактическийПериодДействия,2));
            СтрокиМесяца.Добавить(С);
            Если РегистраторыМесяца.Найти(С.Регистратор)=Неопределено Тогда РегистраторыМесяца.Добавить(С.Регистратор);КонецЕсли;
        КонецЦикла;
        ЗаписатьРезультаты(Данные,КэшНаборов,ИсходныеЗаписи,РегистраторыМесяца);
        Для Каждого С Из СтрокиМесяца Цикл Рассчитанные.Добавить(С);КонецЦикла;
    КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьРезультаты(Данные,КэшНаборов,ИсходныеЗаписи,ОтборРегистраторов=Неопределено)
    // Сохраняем номера строк: они связывают базу и фактический период с записью.
    Данные.Сортировать("Регистратор,НомерСтроки");
    Регистраторы=Новый Соответствие;
    Для Каждого С Из Данные Цикл
        Если ОтборРегистраторов=Неопределено Или ОтборРегистраторов.Найти(С.Регистратор)<>Неопределено Тогда Регистраторы.Вставить(С.Регистратор,Истина);КонецЕсли;
    КонецЦикла;
    Для Каждого Р Из Регистраторы Цикл
        Н=КэшНаборов.Получить(Р.Ключ);
        ПервыйРаз=Н=Неопределено;
        Если ПервыйРаз Тогда
            Н=РегистрыРасчета.Начисления.СоздатьНаборЗаписей();Н.Отбор.Регистратор.Установить(Р.Ключ);
            Для Каждого С Из ИсходныеЗаписи.НайтиСтроки(Новый Структура("Регистратор",Р.Ключ)) Цикл Д=Н.Добавить();ЗаполнитьЗначенияСвойств(Д,С);КонецЦикла;
        КонецЕсли;
        // Изменяются лишь ресурсы выбранных строк; остальные строки сохраняются.
        Для Каждого С Из Данные.НайтиСтроки(Новый Структура("Регистратор",Р.Ключ)) Цикл
            Д=Н[С.НомерСтроки-1];Д.Результат=С.Результат;Д.Часы=С.Часы;Д.Дни=С.Дни;Д.Ставка=С.Ставка;Д.Процент=С.Процент;Д.Стаж=С.Стаж;
        КонецЦикла;
        Если ПервыйРаз Тогда Н.Записать(Истина);КэшНаборов.Вставить(Р.Ключ,Н);
        Иначе Н.Записать(Истина,Истина);КонецЕсли;
    КонецЦикла;
    Данные.Сортировать("ПериодДействияНачало,Регистратор,НомерСтроки");
КонецПроцедуры

Процедура ОбъединитьПериоды(Набор)
    // Повторные и пересекающиеся строки одной работы не должны давать
    // двойную оплату. Разные подразделения и календарные месяцы независимы.
    Строки=Набор.Выгрузить();
    Строки.Сортировать("Сотрудник,Подразделение,ВидРасчета,ПериодРегистрации,ПериодДействияНачало,ПериодДействияКонец");
    Набор.Очистить();Предыдущая=Неопределено;
    Для Каждого С Из Строки Цикл
        Совпадает=Ложь;
        Если Предыдущая<>Неопределено Тогда
            Совпадает=Предыдущая.Сотрудник=С.Сотрудник И Предыдущая.Подразделение=С.Подразделение И Предыдущая.ВидРасчета=С.ВидРасчета И Предыдущая.ПериодРегистрации=С.ПериодРегистрации И НачалоМесяца(Предыдущая.ПериодДействияНачало)=НачалоМесяца(С.ПериодДействияНачало);
        КонецЕсли;
        Если Совпадает И С.ПериодДействияНачало<=Предыдущая.ПериодДействияКонец+1 Тогда
            Предыдущая.ПериодДействияКонец=Макс(Предыдущая.ПериодДействияКонец,С.ПериодДействияКонец);
        Иначе
            Предыдущая=Набор.Добавить();ЗаполнитьЗначенияСвойств(Предыдущая,С);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ОбластьПересчета(Док,ВключатьСтрокиДокумента=Истина) Экспорт
    Область=Новый Структура("Сотрудники,Подразделения,Начало",Новый Массив,Новый Массив,Дата(3999,1,1));
    Старые=УчетСервер.ЗапросТаблица("ВЫБРАТЬ Сотрудник,Подразделение,МИНИМУМ(ПериодДействияНачало) КАК Начало ИЗ РегистрРасчета.Начисления ГДЕ Регистратор=&Документ СГРУППИРОВАТЬ ПО Сотрудник,Подразделение",Новый Структура("Документ",Док.Ссылка));
    Для Каждого С Из Старые Цикл ДобавитьВОбласть(Область,С.Сотрудник,С.Подразделение,С.Начало);КонецЦикла;
    Если ВключатьСтрокиДокумента Тогда
        Для Каждого С Из Док.ОсновныеНачисления Цикл ДобавитьВОбласть(Область,С.Сотрудник,С.Подразделение,С.ДатаНачала);КонецЦикла;
    КонецЕсли;
    Возврат Область;
КонецФункции

Процедура ДобавитьВОбласть(Область,Сотрудник,Подразделение,Начало)
    Если Область.Сотрудники.Найти(Сотрудник)=Неопределено Тогда Область.Сотрудники.Добавить(Сотрудник);КонецЕсли;
    Если Область.Подразделения.Найти(Подразделение)=Неопределено Тогда Область.Подразделения.Добавить(Подразделение);КонецЕсли;
    Область.Начало=Мин(Область.Начало,Начало);
КонецПроцедуры
