&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ПоляСведений = Новый СписокЗначений;
    ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент) Экспорт
    ОбновитьДополнительныеПоля();
КонецПроцедуры

&НаСервере
Процедура ОбновитьДополнительныеПоля()
    СохранитьДополнительныеПоля(Объект);
    ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаСервере
Процедура СохранитьДополнительныеПоля(Получатель)
    Для Каждого Поле Из ПоляСведений Цикл
        НайденнаяСтрока = Неопределено;
        Для Каждого Строка Из Получатель.ДополнительныеСведения Цикл
            Если Строка.ВидСведения = Поле.Значение Тогда НайденнаяСтрока = Строка; Прервать; КонецЕсли;
        КонецЦикла;
        Если НайденнаяСтрока = Неопределено Тогда
            НайденнаяСтрока = Получатель.ДополнительныеСведения.Добавить();
            НайденнаяСтрока.ВидСведения = Поле.Значение;
        КонецЕсли;
        НайденнаяСтрока.Значение = ЭтотОбъект[Поле.Представление];
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПостроитьДополнительныеПоля()
    Удаляемые = Новый Массив;
    Для Каждого Поле Из ПоляСведений Цикл
        Элемент = Элементы.Найти(Поле.Представление);
        Если Элемент <> Неопределено Тогда Элементы.Удалить(Элемент); КонецЕсли;
        Удаляемые.Добавить(Поле.Представление);
    КонецЦикла;
    Если Удаляемые.Количество() > 0 Тогда ИзменитьРеквизиты(Новый Массив, Удаляемые); КонецЕсли;
    ПоляСведений.Очистить();
    Если Не ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат; КонецЕсли;
    Запрос = Новый Запрос(
    "ВЫБРАТЬ РАЗЛИЧНЫЕ С.ВидСведения КАК ВидСведения ПОМЕСТИТЬ Виды
    |ИЗ Справочник.ФизическиеЛица.ДополнительныеСведения КАК С
    |ГДЕ С.Ссылка = &Менеджер И НЕ С.ВидСведения.ПометкаУдаления;
    |ВЫБРАТЬ ВидСведения, ВидСведения.Наименование КАК Заголовок,
    | ВидСведения.ТипЗначения КАК ТипЗначения ИЗ Виды
    |УПОРЯДОЧИТЬ ПО Заголовок");
    Запрос.УстановитьПараметр("Менеджер", Объект.Менеджер);
    Виды = Запрос.Выполнить().Выгрузить();
    Добавляемые = Новый Массив; Индекс = 0;
    Для Каждого Вид Из Виды Цикл
        Индекс = Индекс + 1; ИмяПоля = "ДопСведение" + Формат(Индекс, "ЧГ=0");
        Добавляемые.Добавить(Новый РеквизитФормы(ИмяПоля, Вид.ТипЗначения, , Вид.Заголовок));
        ПоляСведений.Добавить(Вид.ВидСведения, ИмяПоля);
    КонецЦикла;
    Если Добавляемые.Количество() = 0 Тогда Возврат; КонецЕсли;
    ИзменитьРеквизиты(Добавляемые);
    Индекс = 0;
    Для Каждого Вид Из Виды Цикл
        Поле = ПоляСведений[Индекс]; Индекс = Индекс + 1;
        Элемент = Элементы.Добавить(Поле.Представление, Тип("ПолеФормы"));
        Элемент.Вид = ВидПоляФормы.ПолеВвода;
        Элемент.ПутьКДанным = Поле.Представление;
        Элемент.Заголовок = Вид.Заголовок;
        Для Каждого Строка Из Объект.ДополнительныеСведения Цикл
            Если Строка.ВидСведения = Вид.ВидСведения Тогда
                ЭтотОбъект[Поле.Представление] = Строка.Значение; Прервать;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    СохранитьДополнительныеПоля(ТекущийОбъект);
КонецПроцедуры
