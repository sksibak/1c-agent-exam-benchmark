Процедура ЗаполнитьГрафик(ДатаНачала, ДатаОкончания, ВыходныеДни, Подразделение, ЧасовВДень = 8) Экспорт
    Если Не ЗначениеЗаполнено(Подразделение) Тогда ВызватьИсключение "Выберите подразделение графика."; КонецЕсли;
    Если ДатаНачала > ДатаОкончания Или ЧасовВДень < 0 Или ЧасовВДень > 24 Тогда ВызватьИсключение "Проверьте период и количество часов."; КонецЕсли;
    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        Элемент = Блокировка.Добавить("РегистрСведений.ГрафикиРаботы"); Элемент.Режим = РежимБлокировкиДанных.Исключительный;
        Элемент.УстановитьЗначение("Подразделение", Подразделение); Блокировка.Заблокировать();
        Набор = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей(); Набор.Отбор.Подразделение.Установить(Подразделение); Набор.Прочитать();
        Индекс = Набор.Количество() - 1;
        Пока Индекс >= 0 Цикл
            Если Набор[Индекс].Дата >= НачалоДня(ДатаНачала) И Набор[Индекс].Дата <= КонецДня(ДатаОкончания) Тогда Набор.Удалить(Индекс); КонецЕсли;
            Индекс = Индекс - 1;
        КонецЦикла;
        День = НачалоДня(ДатаНачала);
        Пока День <= КонецДня(ДатаОкончания) Цикл
            Запись = Набор.Добавить(); Запись.Подразделение = Подразделение; Запись.Дата = День;
            Запись.Значение = ?(СтрНайти(ВыходныеДни, Строка(ДеньНедели(День))) > 0, 0, ЧасовВДень);
            День = День + 86400;
        КонецЦикла;
        Набор.Записать(); ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры
