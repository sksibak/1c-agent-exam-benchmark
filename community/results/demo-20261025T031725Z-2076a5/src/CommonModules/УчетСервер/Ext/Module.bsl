// Все обработчики вызываются внутри транзакции записи документа.
// Остатки читаются после удаления старых движений и установки управляемой блокировки.
Процедура Заблокировать(Пространство) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить(Пространство);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Функция СуммаСтроки(Строка) Экспорт
    Если Строка.Сумма <> 0 Тогда Возврат Окр(Строка.Сумма, 2); КонецЕсли;
    Возврат Окр(Строка.Цена * Строка.Количество, 2);
КонецФункции

Процедура ПроверитьТовары(Товары) Экспорт
    Если Товары.Количество() = 0 Тогда ВызватьИсключение "Не заполнен список товаров."; КонецЕсли;
    Для Каждого Строка Из Товары Цикл
        Если Не ЗначениеЗаполнено(Строка.Номенклатура) Или Строка.Количество <= 0 Тогда
            ВызватьИсключение "Укажите номенклатуру и положительное количество в строке " + Строка.НомерСтроки;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура Приход(Документ, Отказ) Экспорт
    НастроитьСчетТоваров();
    ПроверитьТовары(Документ.Товары);
    Если Не ЗначениеЗаполнено(Документ.Подразделение) И Не ЗначениеЗаполнено(Документ.Склад) Тогда
        ВызватьИсключение "Укажите подразделение для оперативного учета или склад для бухгалтерского учета.";
    КонецЕсли;
    Документ.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Документ.Движения.Управленческий.Записывать = Истина;
    Документ.Движения.ОстаткиНоменклатуры.Очистить();
    Документ.Движения.Управленческий.Очистить();
    Для Каждого Строка Из Документ.Товары Цикл
        Сумма = СуммаСтроки(Строка);
        Если Сумма < 0 Тогда ВызватьИсключение "Сумма поступления не может быть отрицательной."; КонецЕсли;
        Если ЗначениеЗаполнено(Документ.Подразделение) Тогда
            Движение = Документ.Движения.ОстаткиНоменклатуры.Добавить();
            Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
            Движение.Период = Документ.Дата;
            Движение.Подразделение = Документ.Подразделение;
            Движение.Номенклатура = Строка.Номенклатура;
            Движение.Свойство = Строка.Свойство;
            Движение.Партия = Документ.Ссылка;
            Движение.Количество = Строка.Количество;
            Движение.Стоимость = Сумма;
        КонецЕсли;
        Если ЗначениеЗаполнено(Документ.Склад) Тогда
            Движение = Документ.Движения.Управленческий.Добавить();
            Движение.Период = Документ.Дата;
            Движение.СчетДт = ПланыСчетов.Управленческий.Товары;
            Движение.СчетКт = ПланыСчетов.Управленческий.Поставщики;
            Движение.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Строка.Номенклатура;
            Движение.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Документ.Склад;
            Движение.КоличествоДт = Строка.Количество;
            Движение.Сумма = Сумма;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ОстаткиОУ(Документ, Подразделения, Товары)
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ Подразделение, Номенклатура, Свойство, Партия,
    | КоличествоОстаток КАК Количество, СтоимостьОстаток КАК Стоимость,
    | Партия.Дата КАК ДатаПартии
    |ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Момент, Подразделение В (&Подразделения) И Номенклатура В (&Товары))
    |УПОРЯДОЧИТЬ ПО ДатаПартии, Партия";
    Запрос.УстановитьПараметр("Момент", Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая));
    Запрос.УстановитьПараметр("Подразделения", Подразделения);
    Запрос.УстановитьПараметр("Товары", Товары);
    // Изменяемая таблица необходима для распределения дублей и дополнительных деталей.
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция СписатьОУ(Документ, Остатки, Подразделение, Товар, Свойство, Количество, Метод)
    Отбор = Новый Структура("Подразделение,Номенклатура,Свойство", Подразделение, Товар, Свойство);
    Партии = Остатки.НайтиСтроки(Отбор);
    ВсегоКоличество = 0; ВсегоСтоимость = 0;
    Для Каждого Партия Из Партии Цикл
        ВсегоКоличество = ВсегоКоличество + Партия.Количество;
        ВсегоСтоимость = ВсегоСтоимость + Партия.Стоимость;
    КонецЦикла;
    Если Количество > ВсегоКоличество Тогда
        ВызватьИсключение "Недостаточно " + Товар + " / " + Свойство + " в подразделении " + Подразделение
            + ". Требуется " + Количество + ", остаток " + ВсегоКоличество;
    КонецЕсли;
    Если Метод = Перечисления.УчетнаяПолитика.ПоСредней Тогда
        Возврат СписатьСреднюю(Документ, Партии, Подразделение, Товар, Свойство, Количество, ВсегоКоличество, ВсегоСтоимость);
    КонецЕсли;
    Осталось = Количество; Стоимость = 0;
    Индекс = ?(Метод = Перечисления.УчетнаяПолитика.ЛИФО, Партии.Количество() - 1, 0);
    Шаг = ?(Метод = Перечисления.УчетнаяПолитика.ЛИФО, -1, 1);
    Пока Индекс >= 0 И Индекс < Партии.Количество() И Осталось > 0 Цикл
        Партия = Партии[Индекс]; Индекс = Индекс + Шаг;
        Если Партия.Количество <= 0 Тогда Продолжить; КонецЕсли;
        Списать = Мин(Осталось, Партия.Количество);
        Если Списать = 0 Тогда Продолжить; КонецЕсли;
        Сумма = ?(Списать = Партия.Количество, Партия.Стоимость, Окр(Партия.Стоимость * Списать / Партия.Количество, 2));
        Движение = Документ.Движения.ОстаткиНоменклатуры.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
        Движение.Период = Документ.Дата;
        Движение.Подразделение = Подразделение;
        Движение.Номенклатура = Товар;
        Движение.Свойство = Свойство;
        Движение.Партия = Партия.Партия;
        Движение.Количество = Списать;
        Движение.Стоимость = Сумма;
        Партия.Количество = Партия.Количество - Списать;
        Партия.Стоимость = Партия.Стоимость - Сумма;
        Осталось = Осталось - Списать; Стоимость = Стоимость + Сумма;
    КонецЦикла;
    Возврат Стоимость;
КонецФункции

Функция СписатьСреднюю(Документ, Партии, Подразделение, Товар, Свойство, Количество, ВсегоКоличество, ВсегоСтоимость)
    Стоимость = ?(Количество = ВсегоКоличество, ВсегоСтоимость, Окр(ВсегоСтоимость * Количество / ВсегоКоличество, 2));
    План = Новый Массив; Осталось = Количество; ОстатокБазы = ВсегоКоличество; ПланСтоимость = 0;
    Для Каждого Партия Из Партии Цикл
        Если Партия.Количество <= 0 Тогда Продолжить; КонецЕсли;
        Списать = ?(ОстатокБазы = Партия.Количество, Осталось, Мин(Осталось, Окр(Осталось * Партия.Количество / ОстатокБазы, 3)));
        Сумма = ?(Списать = Партия.Количество, Партия.Стоимость, Окр(Партия.Стоимость * Списать / Партия.Количество, 2));
        План.Добавить(Новый Структура("Партия,Количество,Стоимость", Партия, Списать, Сумма));
        Осталось = Осталось - Списать; ОстатокБазы = ОстатокБазы - Партия.Количество; ПланСтоимость = ПланСтоимость + Сумма;
    КонецЦикла;
    // Копейки распределяются только на партии с остающимся количеством.
    // По полностью выбывшей партии сумма снимается целиком.
    Разница = Стоимость - ПланСтоимость;
    Для Каждого Строка Из План Цикл
        Если Разница = 0 Тогда Прервать; КонецЕсли;
        Если Строка.Партия.Количество = Строка.Количество Тогда Продолжить; КонецЕсли;
        Если Разница > 0 Тогда
            Поправка = Мин(Разница, Строка.Партия.Стоимость - Строка.Стоимость);
        Иначе
            Поправка = -Мин(-Разница, Строка.Стоимость);
        КонецЕсли;
        Строка.Стоимость = Строка.Стоимость + Поправка; Разница = Разница - Поправка;
    КонецЦикла;
    Если Разница < 0 Тогда
        // При очень малой дробной партии количество может округлиться до
        // полного выбытия. Остаток ее стоимости относится на остающийся запас.
        Для Каждого Строка Из План Цикл
            Если Строка.Партия.Количество > Строка.Количество Тогда
                Строка.Стоимость = Строка.Стоимость + Разница; Разница = 0; Прервать;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Если Разница <> 0 Или Осталось <> 0 Тогда ВызватьИсключение "Не удалось распределить среднюю себестоимость."; КонецЕсли;
    Для Каждого Строка Из План Цикл
        Партия = Строка.Партия;
        Если Строка.Количество <> 0 Или Строка.Стоимость <> 0 Тогда
            Движение = Документ.Движения.ОстаткиНоменклатуры.Добавить();
            Движение.ВидДвижения = ВидДвиженияНакопления.Расход; Движение.Период = Документ.Дата;
            Движение.Подразделение = Подразделение; Движение.Номенклатура = Товар; Движение.Свойство = Свойство;
            Движение.Партия = Партия.Партия; Движение.Количество = Строка.Количество; Движение.Стоимость = Строка.Стоимость;
        КонецЕсли;
        Партия.Количество = Партия.Количество - Строка.Количество;
        Партия.Стоимость = Партия.Стоимость - Строка.Стоимость;
    КонецЦикла;
    Возврат Стоимость;
КонецФункции

Функция Политики(Дата, Подразделения)
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Подразделение, Метод
    |ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, Подразделение В (&Подразделения))");
    Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.УстановитьПараметр("Подразделения", Подразделения);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ГрафАналогов()
    Запрос = Новый Запрос("ВЫБРАТЬ Товар, Аналог ИЗ РегистрСведений.Аналоги");
    Выборка = Запрос.Выполнить().Выбрать();
    Граф = Новый Соответствие;
    Пока Выборка.Следующий() Цикл
        Если Граф.Получить(Выборка.Товар) = Неопределено Тогда Граф.Вставить(Выборка.Товар, Новый Массив); КонецЕсли;
        Если Граф.Получить(Выборка.Аналог) = Неопределено Тогда Граф.Вставить(Выборка.Аналог, Новый Массив); КонецЕсли;
        Граф[Выборка.Товар].Добавить(Выборка.Аналог);
        Граф[Выборка.Аналог].Добавить(Выборка.Товар);
    КонецЦикла;
    Возврат Граф;
КонецФункции

Функция ГруппаАналогов(Товар, Граф)
    Группа = Новый Массив; Группа.Добавить(Товар); Индекс = 0;
    Пока Индекс < Группа.Количество() Цикл
        Соседи = Граф.Получить(Группа[Индекс]); Индекс = Индекс + 1;
        Если Соседи = Неопределено Тогда Продолжить; КонецЕсли;
        Для Каждого Сосед Из Соседи Цикл
            Если Группа.Найти(Сосед) = Неопределено Тогда Группа.Добавить(Сосед); КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Возврат Группа;
КонецФункции

Процедура ПродажаБУ(Документ)
    Заблокировать("РегистрБухгалтерии.Управленческий");
    Граф = ГрафАналогов();
    Группы = Новый Соответствие; НужныеТовары = Новый Массив;
    Для Каждого Строка Из Документ.Товары Цикл
        Если Группы.Получить(Строка.Номенклатура) <> Неопределено Тогда Продолжить; КонецЕсли;
        Группа = ГруппаАналогов(Строка.Номенклатура, Граф); Группы.Вставить(Строка.Номенклатура, Группа);
        Для Каждого Товар Из Группа Цикл
            Если НужныеТовары.Найти(Товар) = Неопределено Тогда НужныеТовары.Добавить(Товар); КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Запрос = Новый Запрос(
    "ВЫБРАТЬ ВЫРАЗИТЬ(Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
    | Субконто2 КАК Склад, КоличествоОстаток КАК Количество,
    | ВЫРАЗИТЬ(Субконто1 КАК Справочник.Номенклатура).Артикул КАК Артикул
    |ИЗ РегистрБухгалтерии.Управленческий.Остатки(&Момент, Счет = &Товары, &СкладскиеСубконто, Субконто2 = &Склад И Субконто1 В (&НужныеТовары))
    |УПОРЯДОЧИТЬ ПО Артикул, Номенклатура;
    |ВЫБРАТЬ Субконто1 КАК Номенклатура, КоличествоОстаток КАК Количество, СуммаОстаток КАК Сумма
    |ИЗ РегистрБухгалтерии.Управленческий.Остатки(&Момент, Счет = &Товары, &СтоимостныеСубконто, Субконто1 В (&НужныеТовары))");
    Запрос.УстановитьПараметр("Момент", Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая));
    Запрос.УстановитьПараметр("Товары", ПланыСчетов.Управленческий.Товары);
    Запрос.УстановитьПараметр("Склад", Документ.Склад);
    Запрос.УстановитьПараметр("НужныеТовары", НужныеТовары);
    СкладскиеСубконто = Новый Массив; СкладскиеСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура); СкладскиеСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склады);
    СтоимостныеСубконто = Новый Массив; СтоимостныеСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
    Запрос.УстановитьПараметр("СкладскиеСубконто", СкладскиеСубконто);
    Запрос.УстановитьПараметр("СтоимостныеСубконто", СтоимостныеСубконто);
    Пакет = Запрос.ВыполнитьПакет(); Остатки = Пакет[0].Выгрузить(); Итоги = Пакет[1].Выгрузить();
    Для Каждого Строка Из Документ.Товары Цикл
        Группа = Группы[Строка.Номенклатура];
        Кандидаты = Новый Массив;
        Свои = Остатки.НайтиСтроки(Новый Структура("Номенклатура,Склад", Строка.Номенклатура, Документ.Склад));
        Для Каждого Партия Из Свои Цикл Кандидаты.Добавить(Партия); КонецЦикла;
        Для Каждого Партия Из Остатки Цикл
            Если Партия.Склад = Документ.Склад И Партия.Номенклатура <> Строка.Номенклатура
                И Группа.Найти(Партия.Номенклатура) <> Неопределено Тогда Кандидаты.Добавить(Партия); КонецЕсли;
        КонецЦикла;
        Осталось = Строка.Количество; ВыручкаОсталась = СуммаСтроки(Строка);
        Для Каждого Партия Из Кандидаты Цикл
            Если Осталось <= 0 Тогда Прервать; КонецЕсли;
            Если Партия.Количество <= 0 Тогда Продолжить; КонецЕсли;
            Списать = Мин(Осталось, Партия.Количество);
            Итог = Итоги.Найти(Партия.Номенклатура, "Номенклатура");
            Если Итог = Неопределено Или Итог.Количество <= 0 Тогда ВызватьИсключение "Некорректный остаток стоимости товара."; КонецЕсли;
            Стоимость = ?(Списать = Итог.Количество, Итог.Сумма, Окр(Итог.Сумма * Списать / Итог.Количество, 2));
            Выручка = ?(Списать = Осталось, ВыручкаОсталась, Окр(СуммаСтроки(Строка) * Списать / Строка.Количество, 2));
            Движение = Документ.Движения.Управленческий.Добавить();
            Движение.Период = Документ.Дата;
            Движение.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки;
            Движение.СчетКт = ПланыСчетов.Управленческий.Товары;
            Движение.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Партия.Номенклатура;
            Движение.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Документ.Склад;
            Движение.КоличествоКт = Списать;
            Движение.Сумма = Стоимость;
            Движение.Заказано = Строка.Номенклатура;
            Движение.Продано = Партия.Номенклатура;
            Движение.КоличествоПродажи = Списать;
            Движение.ВыручкаПродажи = Выручка;
            Партия.Количество = Партия.Количество - Списать;
            Итог.Количество = Итог.Количество - Списать;
            Итог.Сумма = Итог.Сумма - Стоимость;
            Осталось = Осталось - Списать; ВыручкаОсталась = ВыручкаОсталась - Выручка;
        КонецЦикла;
        Если Осталось > 0 Тогда ВызватьИсключение "Недостаточно товара " + Строка.Номенклатура + " и всех его аналогов. Не хватает " + Осталось; КонецЕсли;
        Движение = Документ.Движения.Управленческий.Добавить();
        Движение.Период = Документ.Дата;
        Движение.СчетДт = ПланыСчетов.Управленческий.Покупатели;
        Движение.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки;
        Движение.Сумма = СуммаСтроки(Строка);
    КонецЦикла;
КонецПроцедуры

Процедура Продажа(Документ, Отказ) Экспорт
    ПроверитьТовары(Документ.Товары);
    Для Каждого Строка Из Документ.Товары Цикл
        Если СуммаСтроки(Строка) < 0 Тогда ВызватьИсключение "Сумма продажи не может быть отрицательной."; КонецЕсли;
    КонецЦикла;
    Документ.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Документ.Движения.Продажи.Записывать = Истина;
    Документ.Движения.Управленческий.Записывать = Истина;
    // Исключение старого набора обязательно при перепроведении.
    Документ.Движения.ОстаткиНоменклатуры.Очистить(); Документ.Движения.Управленческий.Очистить();
    Документ.Движения.Продажи.Очистить(); Документ.Движения.Записать();
    Подразделения = Новый Массив;
    Для Каждого Строка Из Документ.Товары Цикл
        Если ЗначениеЗаполнено(Строка.Подразделение) И Подразделения.Найти(Строка.Подразделение) = Неопределено Тогда Подразделения.Добавить(Строка.Подразделение); КонецЕсли;
    КонецЦикла;
    Если Подразделения.Количество() > 0 Тогда
        Заблокировать("РегистрНакопления.ОстаткиНоменклатуры");
        Остатки = ОстаткиОУ(Документ, Подразделения, Документ.Товары.Выгрузить().ВыгрузитьКолонку("Номенклатура"));
        УчетныеПолитики = Политики(Документ.Дата, Подразделения);
        Для Каждого Строка Из Документ.Товары Цикл
            Если Не ЗначениеЗаполнено(Строка.Подразделение) Тогда Продолжить; КонецЕсли;
            Политика = УчетныеПолитики.Найти(Строка.Подразделение, "Подразделение");
            Если Политика = Неопределено Тогда ВызватьИсключение "Не задана учетная политика подразделения " + Строка.Подразделение; КонецЕсли;
            Стоимость = СписатьОУ(Документ, Остатки, Строка.Подразделение, Строка.Номенклатура, Строка.Свойство, Строка.Количество, Политика.Метод);
            Движение = Документ.Движения.Продажи.Добавить();
            Движение.Период = Документ.Дата; Движение.Номенклатура = Строка.Номенклатура;
            Движение.Количество = Строка.Количество; Движение.Себестоимость = Стоимость;
            Движение.Выручка = СуммаСтроки(Строка);
        КонецЦикла;
    КонецЕсли;
    Если ЗначениеЗаполнено(Документ.Склад) Тогда ПродажаБУ(Документ); КонецЕсли;
    Если Не ЗначениеЗаполнено(Документ.Склад) И Подразделения.Количество() = 0 Тогда ВызватьИсключение "Не указаны ни склад, ни подразделения."; КонецЕсли;
    Документ.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Документ.Движения.Продажи.Записывать = Истина;
    Документ.Движения.Управленческий.Записывать = Истина;
КонецПроцедуры

Процедура Сборка(Документ, Отказ) Экспорт
    ПроверитьТовары(Документ.СистемныеБлоки);
    Если Не ЗначениеЗаполнено(Документ.ПодразделениеИсточник) Или Не ЗначениеЗаполнено(Документ.ПодразделениеПриемник) Тогда ВызватьИсключение "Укажите оба подразделения сборки."; КонецЕсли;
    Документ.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Документ.Движения.ОстаткиНоменклатуры.Очистить(); Документ.Движения.ОстаткиНоменклатуры.Записать();
    Заблокировать("РегистрНакопления.ОстаткиНоменклатуры");
    Подразделения = Новый Массив; Подразделения.Добавить(Документ.ПодразделениеИсточник);
    Блоки = Документ.СистемныеБлоки.Выгрузить(); Блоки.Свернуть("Номенклатура", "Количество");
    Запрос = Новый Запрос(
    "ВЫБРАТЬ СистемныйБлок, МАКСИМУМ(Период) КАК Период
    |ПОМЕСТИТЬ ПоследниеВерсии
    |ИЗ РегистрСведений.Спецификации
    |ГДЕ Период <= &Дата И СистемныйБлок В (&Блоки)
    |СГРУППИРОВАТЬ ПО СистемныйБлок
    |ИНДЕКСИРОВАТЬ ПО СистемныйБлок;
    |ВЫБРАТЬ С.СистемныйБлок, С.Деталь, С.Свойство, С.Количество
    |ИЗ РегистрСведений.Спецификации КАК С
    |ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПоследниеВерсии КАК Версии
    |ПО С.СистемныйБлок = Версии.СистемныйБлок И С.Период = Версии.Период");
    Запрос.УстановитьПараметр("Дата", Документ.Дата);
    Запрос.УстановитьПараметр("Блоки", Блоки.ВыгрузитьКолонку("Номенклатура"));
    Спецификации = Запрос.Выполнить().Выгрузить();
    НужныеДетали = Спецификации.ВыгрузитьКолонку("Деталь");
    Для Каждого Строка Из Документ.ДополнительныеДетали Цикл НужныеДетали.Добавить(Строка.Номенклатура); КонецЦикла;
    Остатки = ОстаткиОУ(Документ, Подразделения, НужныеДетали);
    Стоимости = Новый Соответствие; ОбщаяСтоимость = 0; ВсегоБлоков = Блоки.Итог("Количество");
    Для Каждого Блок Из Блоки Цикл
        Строки = Спецификации.НайтиСтроки(Новый Структура("СистемныйБлок", Блок.Номенклатура));
        Если Строки.Количество() = 0 Тогда ВызватьИсключение "Нет действующей спецификации для " + Блок.Номенклатура; КонецЕсли;
        Стоимость = 0;
        Для Каждого Строка Из Строки Цикл
            Если Строка.Количество <= 0 Тогда Продолжить; КонецЕсли;
            Стоимость = Стоимость + СписатьОУ(Документ, Остатки, Документ.ПодразделениеИсточник, Строка.Деталь, Строка.Свойство, Строка.Количество * Блок.Количество, Перечисления.УчетнаяПолитика.ПоСредней);
        КонецЦикла;
        Стоимости.Вставить(Блок.Номенклатура, Стоимость);
    КонецЦикла;
    Для Каждого Строка Из Документ.ДополнительныеДетали Цикл
        Если Строка.Количество <= 0 Тогда ВызватьИсключение "Количество дополнительных деталей должно быть положительным."; КонецЕсли;
        ОбщаяСтоимость = ОбщаяСтоимость + СписатьОУ(Документ, Остатки, Документ.ПодразделениеИсточник, Строка.Номенклатура, Строка.Свойство, Строка.Количество, Перечисления.УчетнаяПолитика.ПоСредней);
    КонецЦикла;
    ОстатокДополнительных = ОбщаяСтоимость; ОстатокБлоков = ВсегоБлоков;
    Для Каждого Блок Из Блоки Цикл
        Доля = ?(Блок.Количество = ОстатокБлоков, ОстатокДополнительных, Окр(ОбщаяСтоимость * Блок.Количество / ВсегоБлоков, 2));
        Движение = Документ.Движения.ОстаткиНоменклатуры.Добавить();
        Движение.ВидДвижения = ВидДвиженияНакопления.Приход; Движение.Период = Документ.Дата;
        Движение.Подразделение = Документ.ПодразделениеПриемник; Движение.Номенклатура = Блок.Номенклатура;
        Движение.Партия = Документ.Ссылка; Движение.Количество = Блок.Количество;
        Движение.Стоимость = Стоимости[Блок.Номенклатура] + Доля;
        ОстатокДополнительных = ОстатокДополнительных - Доля; ОстатокБлоков = ОстатокБлоков - Блок.Количество;
    КонецЦикла;
    Документ.Движения.ОстаткиНоменклатуры.Записывать = Истина;
КонецПроцедуры

Процедура Операция(Документ, Отказ) Экспорт
    НастроитьСчетТоваров();
    Документ.Движения.Управленческий.Записывать = Истина;
    Документ.Движения.Управленческий.Очистить();
    Для Каждого Строка Из Документ.Проводки Цикл
        Если Не ЗначениеЗаполнено(Строка.СчетДт) Или Не ЗначениеЗаполнено(Строка.СчетКт) Тогда ВызватьИсключение "Заполните счета ручной операции."; КонецЕсли;
        Движение = Документ.Движения.Управленческий.Добавить();
        ЗаполнитьЗначенияСвойств(Движение, Строка); Движение.Период = Документ.Дата;
        Если ЗначениеЗаполнено(Строка.НоменклатураДт) Тогда Движение.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Строка.НоменклатураДт; КонецЕсли;
        Если ЗначениеЗаполнено(Строка.НоменклатураКт) Тогда Движение.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Строка.НоменклатураКт; КонецЕсли;
        Если ЗначениеЗаполнено(Строка.СкладДт) Тогда Движение.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Строка.СкладДт; КонецЕсли;
        Если ЗначениеЗаполнено(Строка.СкладКт) Тогда Движение.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Строка.СкладКт; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура НастроитьСчетТоваров() Экспорт
    Счет = ПланыСчетов.Управленческий.Товары.ПолучитьОбъект();
    Если Счет.ВидыСубконто.Количество() = 2 И Счет.Количественный Тогда Возврат; КонецЕсли;
    Счет.Количественный = Истина;
    Счет.ВидыСубконто.Очистить();
    Вид = Счет.ВидыСубконто.Добавить(); Вид.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура;
    Вид.Суммовой = Истина; Вид.Количественный = Истина; Вид.ТолькоОбороты = Ложь;
    Вид = Счет.ВидыСубконто.Добавить(); Вид.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Склады;
    Вид.Суммовой = Ложь; Вид.Количественный = Истина; Вид.ТолькоОбороты = Ложь;
    Счет.Записать();
КонецПроцедуры
