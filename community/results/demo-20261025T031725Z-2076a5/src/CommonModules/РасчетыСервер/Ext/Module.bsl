Процедура НастроитьВидыРасчета() Экспорт
    // Предопределенные виды доступны и в чистой базе каркаса.
    Тариф = ПланыВидовРасчета.ОсновныеНачисления.Оклад.ПолучитьОбъект();
    Если Тариф.ВытесняющиеВидыРасчета.Количество() = 0 Тогда
        Тариф.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
        Тариф.Записать();
    КонецЕсли;
    Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия.ПолучитьОбъект();
    Если Премия.БазовыеВидыРасчета.Количество() = 0 Или Премия.ВытесняющиеВидыРасчета.Количество() = 0 Тогда
        Премия.БазовыеВидыРасчета.Очистить(); Премия.ВытесняющиеВидыРасчета.Очистить();
        Премия.БазовыеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Оклад;
        Премия.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
        Премия.Записать();
    КонецЕсли;
    Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка.ПолучитьОбъект();
    Если Командировка.БазовыеВидыРасчета.Количество() = 0 Тогда
        Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Оклад;
        Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия;
        Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
        Командировка.Записать();
    КонецЕсли;
КонецПроцедуры

Функция ПроцентПоСтажу(Стаж, Шкала)
    Для Каждого Строка Из Шкала Цикл
        Если Стаж >= Строка.СтажОт Тогда Возврат Строка.Процент; КонецЕсли;
    КонецЦикла;
    Возврат 0;
КонецФункции

Функция ПолныхЛет(НачалоСтажа, ДатаСтажа)
    Если Не ЗначениеЗаполнено(НачалоСтажа) Тогда Возврат 0; КонецЕсли;
    Лет = Год(ДатаСтажа) - Год(НачалоСтажа);
    Если ДобавитьМесяц(НачалоСтажа, Лет * 12) > ДатаСтажа Тогда Лет = Лет - 1; КонецЕсли;
    Возврат Макс(0, Лет);
КонецФункции

Функция ДанныеСтавок(Набор)
    Периоды = Новый ТаблицаЗначений;
    Периоды.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
    Периоды.Колонки.Добавить("Месяц", Новый ОписаниеТипов("Дата"));
    Для Каждого Запись Из Набор Цикл
        Если Запись.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Оклад Или Запись.Сторно Тогда Продолжить; КонецЕсли;
        Строка = Периоды.Добавить(); Строка.Сотрудник = Запись.Сотрудник; Строка.Месяц = НачалоМесяца(Запись.ПериодДействияНачало);
    КонецЦикла;
    Периоды.Свернуть("Сотрудник,Месяц");
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Сотрудник, Месяц ПОМЕСТИТЬ Периоды ИЗ &Периоды КАК Т
    |ИНДЕКСИРОВАТЬ ПО Сотрудник, Месяц;
    |ВЫБРАТЬ П.Сотрудник КАК Сотрудник, П.Месяц КАК Месяц, МАКСИМУМ(С.Период) КАК Период
    |ПОМЕСТИТЬ ПоследниеСтавки
    |ИЗ Периоды КАК П ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифныеСтавки КАК С
    |ПО П.Сотрудник = С.Сотрудник И С.Период <= П.Месяц
    |СГРУППИРОВАТЬ ПО П.Сотрудник, П.Месяц
    |ИНДЕКСИРОВАТЬ ПО Сотрудник, Период;
    |ВЫБРАТЬ П.Сотрудник, П.Месяц, ЕСТЬNULL(С.Ставка, 0) КАК Ставка
    |ИЗ ПоследниеСтавки КАК П ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифныеСтавки КАК С
    |ПО П.Сотрудник = С.Сотрудник И П.Период = С.Период");
    Запрос.УстановитьПараметр("Периоды", Периоды);
    // Несколько расчетных месяцев в документе требуют исторических срезов
    // на разные даты: максимум периода получаем одним пакетным запросом.
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура Начислить(Документ, Отказ) Экспорт
    УчетСервер.Заблокировать("РегистрРасчета.Начисления");
    НастроитьВидыРасчета();
    Набор = Документ.Движения.Начисления;
    Набор.Записывать = Истина;
    Набор.Очистить(); Набор.Записать();
    Входные = Документ.ОсновныеНачисления.Выгрузить();
    Если Входные.Количество() = 0 Тогда ВызватьИсключение "Не заполнены начисления."; КонецЕсли;
    // Полные дубли строк не удваивают оплату.
    Входные.Свернуть("Сотрудник,Подразделение,ВидРасчета,ДатаНачала,ДатаОкончания");
    Входные.Сортировать("ДатаНачала,ВидРасчета");
    НомерВходной = 0;
    Для Каждого Строка Из Входные Цикл
        НомерВходной = НомерВходной + 1;
        Если Не ЗначениеЗаполнено(Строка.Сотрудник) Или Не ЗначениеЗаполнено(Строка.Подразделение)
            Или Не ЗначениеЗаполнено(Строка.ВидРасчета) Или Не ЗначениеЗаполнено(Строка.ДатаНачала)
            Или Строка.ДатаОкончания < Строка.ДатаНачала Тогда ВызватьИсключение "Некорректная строка начисления."; КонецЕсли;
        Командировка = Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
        Если Не Командировка И НачалоМесяца(Строка.ДатаНачала) <> НачалоМесяца(Строка.ДатаОкончания) Тогда
            ВызватьИсключение "Тариф и премия должны находиться в пределах одного месяца.";
        КонецЕсли;
        Начало = НачалоДня(Строка.ДатаНачала);
        Пока Начало <= Строка.ДатаОкончания Цикл
            Конец = Мин(КонецМесяца(Начало), КонецДня(Строка.ДатаОкончания));
            Запись = Набор.Добавить();
            Запись.Сотрудник = Строка.Сотрудник; Запись.Подразделение = Строка.Подразделение;
            Запись.ВидРасчета = Строка.ВидРасчета;
            Запись.ПериодДействияНачало = Начало; Запись.ПериодДействияКонец = Конец;
            Запись.ПериодРегистрации = НачалоМесяца(Начало);
            Если Командировка Тогда
                Запись.ПериодРегистрации = Макс(НачалоМесяца(Документ.Дата), НачалоМесяца(Начало));
                // Средний дневной заработок фиксируется на начало командировки.
                Запись.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Строка.ДатаНачала), -3);
                Запись.БазовыйПериодКонец = НачалоМесяца(Строка.ДатаНачала) - 1;
            Иначе
                Запись.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало), -1);
                Запись.БазовыйПериодКонец = НачалоМесяца(Начало) - 1;
            КонецЕсли;
            Запись.ИсходнаяСтрока = НомерВходной;
            Начало = Конец + 1;
        КонецЦикла;
    КонецЦикла;
    // Платформа определяет периоды сторнирования прошлых начислений.
    Дополнение = Набор.ПолучитьДополнение();
    Для Каждого Строка Из Дополнение Цикл
        Запись = Набор.Добавить();
        ЗаполнитьЗначенияСвойств(Запись, Строка);
        Запись.Сторно = Истина;
        Запись.ПериодРегистрации = Строка.ПериодРегистрацииСторно;
        Запись.ПериодДействияНачало = Строка.ПериодДействияНачалоСторно;
        Запись.ПериодДействияКонец = Строка.ПериодДействияКонецСторно;
    КонецЦикла;
    Набор.Записать();
    Запрос = Новый Запрос(
    "ВЫБРАТЬ НомерСтроки,
    | ЕСТЬNULL(ЗначениеФактическийПериодДействия, 0) КАК Часы,
    | ЕСТЬNULL(ДнейФактическийПериодДействия, 0) КАК Дни,
    | ЕСТЬNULL(ДнейПериодРегистрации, 0) КАК НормаДней
    |ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор = &Документ)");
    Запрос.УстановитьПараметр("Документ", Документ.Ссылка);
    График = Запрос.Выполнить().Выгрузить();
    Ставки = ДанныеСтавок(Набор);
    Запрос.Текст = "ВЫБРАТЬ Ссылка КАК Сотрудник, НачалоСтажа ИЗ Справочник.ФизическиеЛица ГДЕ Ссылка В (&Сотрудники)";
    Запрос.УстановитьПараметр("Сотрудники", Входные.ВыгрузитьКолонку("Сотрудник"));
    Сотрудники = Запрос.Выполнить().Выгрузить();
    Запрос.Текст = "ВЫБРАТЬ СтажОт, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО СтажОт УБЫВ";
    Шкала = Запрос.Выполнить().Выгрузить();
    Для Каждого Запись Из Набор Цикл
        Данные = График.Найти(Запись.НомерСтроки, "НомерСтроки");
        Если Данные = Неопределено Тогда ВызватьИсключение "Не получены данные графика."; КонецЕсли;
        Если Запись.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Оклад Тогда
            Если Не Запись.Сторно Тогда
                Найдено = Ставки.НайтиСтроки(Новый Структура("Сотрудник,Месяц", Запись.Сотрудник, НачалоМесяца(Запись.ПериодДействияНачало)));
                Запись.Ставка = ?(Найдено.Количество() = 0, 0, Найдено[0].Ставка);
            КонецЕсли;
            Знак = ?(Запись.Сторно, -1, 1);
            Запись.Часы = Знак * Данные.Часы; Запись.Дни = Знак * Данные.Дни;
            Запись.Результат = Окр(Запись.Ставка * Запись.Часы, 2);
        Иначе
            Запись.Часы = 0; Запись.Дни = 0;
        КонецЕсли;
    КонецЦикла;
    Набор.Записать(Истина, Истина);
    Отбор = Новый Структура("Регистратор", Документ.Ссылка);
    Ресурсы = Новый Массив; Ресурсы.Добавить("Начисления.Результат"); Ресурсы.Добавить("Начисления.Дни");
    Измерения = Новый Структура("Подразделение", "Начисления.Подразделение");
    Разрезы = Новый Массив; Разрезы.Добавить("Начисления.Сотрудник");
    БазаПремии = РегистрыРасчета.Начисления.ПолучитьБазу(Отбор, Ресурсы, Измерения, Разрезы);
    Для Каждого Запись Из Набор Цикл
        Если Запись.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда Продолжить; КонецЕсли;
        Данные = График.Найти(Запись.НомерСтроки, "НомерСтроки");
        Сотрудник = Сотрудники.Найти(Запись.Сотрудник, "Сотрудник");
        Если Не Запись.Сторно Тогда
            Запись.Стаж = ПолныхЛет(Сотрудник.НачалоСтажа, НачалоМесяца(Запись.ПериодДействияНачало));
            Запись.Процент = ПроцентПоСтажу(Запись.Стаж, Шкала);
            Запись.НормаДней = Данные.НормаДней;
        КонецЕсли;
        База = 0;
        Для Каждого СтрокаБазы Из БазаПремии.НайтиСтроки(Новый Структура("НомерСтроки", Запись.НомерСтроки)) Цикл
            Если СтрокаБазы.Сотрудник <> Запись.Сотрудник Тогда База = База + СтрокаБазы.Результат; КонецЕсли;
        КонецЦикла;
        Запись.База = База;
        // Премия за неполный период пропорциональна рабочим дням.
        Запись.Результат = 0;
        Если Запись.НормаДней > 0 Тогда
            Запись.Результат = Окр(База * Запись.Процент / 100 * Данные.Дни / Запись.НормаДней, 2) * ?(Запись.Сторно, -1, 1);
        КонецЕсли;
    КонецЦикла;
    Набор.Записать(Истина, Истина);
    Измерения = Новый Структура("Сотрудник", "Начисления.Сотрудник");
    БазаКомандировок = РегистрыРасчета.Начисления.ПолучитьБазу(Отбор, Ресурсы, Измерения);
    РассчитанныеКомандировки = Новый Массив;
    Для Каждого Запись Из Набор Цикл
        Если Запись.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда Продолжить; КонецЕсли;
        Данные = График.Найти(Запись.НомерСтроки, "НомерСтроки");
        База = БазаКомандировок.Найти(Запись.НомерСтроки, "НомерСтроки");
        Запись.Результат = 0;
        Если База <> Неопределено И База.Дни > 0 Тогда
            СуммаБазы = База.Результат;
            // Ранние командировки того же документа еще не были рассчитаны
            // на момент пакетного получения базы. Дополняем базу в памяти.
            Для Каждого Предыдущая Из РассчитанныеКомандировки Цикл
                Если Предыдущая.Сотрудник = Запись.Сотрудник
                    И Предыдущая.ПериодДействияНачало >= Запись.БазовыйПериодНачало
                    И Предыдущая.ПериодДействияКонец <= Запись.БазовыйПериодКонец Тогда
                    СуммаБазы = СуммаБазы + Предыдущая.Результат;
                КонецЕсли;
            КонецЦикла;
            Запись.Результат = Окр(СуммаБазы / База.Дни * Данные.Дни, 2);
        КонецЕсли;
        РассчитанныеКомандировки.Добавить(Запись);
    КонецЦикла;
    Набор.Записать(Истина, Истина);
    ОбновитьНачисленияТекущихПериодов(Документ);
КонецПроцедуры

Процедура ОбновитьНачисленияТекущихПериодов(Документ)
    // При вводе отклонения отдельным документом в том же месяце сторно
    // не требуется. Фактический период изменен платформой: обновляем
    // результаты уже записанных тарифов и премий по новым данным графика.
    // Все данные читаются единым пакетом, внутри циклов запросов нет.
    Сотрудники = Документ.ОсновныеНачисления.Выгрузить().ВыгрузитьКолонку("Сотрудник");
    Периоды = Новый Массив;
    Для Каждого Строка Из Документ.ОсновныеНачисления Цикл
        Месяц = НачалоМесяца(Строка.ДатаНачала);
        Пока Месяц <= Строка.ДатаОкончания Цикл
            Если Периоды.Найти(Месяц) = Неопределено Тогда Периоды.Добавить(Месяц); КонецЕсли;
            Месяц = ДобавитьМесяц(Месяц, 1);
        КонецЦикла;
    КонецЦикла;
    Запрос = Новый Запрос(
    "ВЫБРАТЬ РАЗЛИЧНЫЕ Регистратор ПОМЕСТИТЬ Документы
    |ИЗ РегистрРасчета.Начисления
    |ГДЕ Сотрудник В (&Сотрудники) И ПериодРегистрации В (&Периоды);
    |ВЫБРАТЬ * ИЗ РегистрРасчета.Начисления.ДанныеГрафика(
    |Регистратор В (ВЫБРАТЬ Регистратор ИЗ Документы))
    |УПОРЯДОЧИТЬ ПО Регистратор, НомерСтроки");
    Запрос.УстановитьПараметр("Сотрудники", Сотрудники);
    Запрос.УстановитьПараметр("Периоды", Периоды);
    Таблица = Запрос.Выполнить().Выгрузить();
    Если Таблица.Количество() = 0 Тогда Возврат; КонецЕсли;
    Регистратор = Неопределено; Набор = Неопределено;
    Для Каждого Строка Из Таблица Цикл
        Если Строка.Регистратор <> Регистратор Тогда
            Если Набор <> Неопределено Тогда Набор.Записать(Истина, Ложь, Ложь, Ложь); КонецЕсли;
            Регистратор = Строка.Регистратор;
            Набор = РегистрыРасчета.Начисления.СоздатьНаборЗаписей();
            Набор.Отбор.Регистратор.Установить(Регистратор);
        КонецЕсли;
        Запись = Набор.Добавить(); ЗаполнитьЗначенияСвойств(Запись, Строка);
        Если Запись.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Оклад Тогда
            Знак = ?(Запись.Сторно, -1, 1);
            Запись.Часы = Знак * Строка.ЗначениеФактическийПериодДействия;
            Запись.Дни = Знак * Строка.ДнейФактическийПериодДействия;
            Запись.Результат = Окр(Запись.Часы * Запись.Ставка, 2);
        ИначеЕсли Запись.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
            Запись.Результат = 0;
            Если Запись.НормаДней > 0 Тогда
                Запись.Результат = Окр(Запись.База * Запись.Процент / 100
                    * Строка.ДнейФактическийПериодДействия / Запись.НормаДней, 2) * ?(Запись.Сторно, -1, 1);
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если Набор <> Неопределено Тогда Набор.Записать(Истина, Ложь, Ложь, Ложь); КонецЕсли;
КонецПроцедуры

Процедура ОтменаНачислений(Документ, Отказ) Экспорт
