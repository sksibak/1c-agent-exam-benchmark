Процедура СоздатьДанные() Экспорт
    Если ЗначениеЗаполнено(Документы.РасходнаяНакладная.НайтиПоНомеру("ДЕМОБУ", Дата(2026,1,10))) Тогда Возврат; КонецЕсли;
    НачатьТранзакцию();
    Попытка
        РасчетыСервер.НастроитьВидыРасчета();
        Цех = Элемент("Подразделения", "Основной цех (пример)");
        Магазин = Элемент("Подразделения", "Магазин (пример)");
        Склад = Элемент("Склады", "Основной склад (пример)");
        Процессор = Номенклатура("Процессор (пример)", "100");
        Аналог = Номенклатура("Процессор другого производителя (пример)", "200");
        Плата = Номенклатура("Материнская плата (пример)", "300");
        Блок = Номенклатура("Системный блок (пример)", "400");
        Принтер = Номенклатура("Принтер (пример)", "500");
        Свойство = Справочники.СвойстваНоменклатуры.СоздатьЭлемент();
        Свойство.Наименование = "ASUS / стандарт (пример)"; Свойство.Номенклатура = Процессор; Свойство.Записать();
        Производитель = ВидСведения("Производитель", Новый ОписаниеТипов("СправочникСсылка.ЗначенияХарактеристик"));
        ЗначениеПроизводителя = Элемент("ЗначенияХарактеристик", "ASUS");
        Значение = РегистрыСведений.ЗначенияСвойств.СоздатьМенеджерЗаписи();
        Значение.Свойство = Свойство.Ссылка; Значение.Характеристика = Производитель; Значение.Значение = ЗначениеПроизводителя; Значение.Записать();
        Политика(Цех, Перечисления.УчетнаяПолитика.ФИФО);
        Политика(Магазин, Перечисления.УчетнаяПолитика.ЛИФО);
        Связь = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи(); Связь.Товар = Процессор; Связь.Аналог = Аналог; Связь.Записать();
        Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
        Приход.Дата = Дата(2026,1,2,9,0,0); Приход.Номер = "ДЕМОПР1"; Приход.Подразделение = Цех; Приход.Склад = Склад;
        ТоварнаяСтрока(Приход, Процессор, Свойство.Ссылка, 10, 1000);
        ТоварнаяСтрока(Приход, Аналог, Справочники.СвойстваНоменклатуры.ПустаяСсылка(), 5, 1100);
        ТоварнаяСтрока(Приход, Плата, Справочники.СвойстваНоменклатуры.ПустаяСсылка(), 10, 2000);
        ТоварнаяСтрока(Приход, Принтер, Справочники.СвойстваНоменклатуры.ПустаяСсылка(), 5, 5000);
        Приход.Записать(РежимЗаписиДокумента.Проведение);
        Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
        Приход.Дата = Дата(2026,1,3,9,0,0); Приход.Номер = "ДЕМОПР2"; Приход.Подразделение = Цех; Приход.Склад = Склад;
        ТоварнаяСтрока(Приход, Процессор, Свойство.Ссылка, 10, 1200); Приход.Записать(РежимЗаписиДокумента.Проведение);
        Спецификация = РегистрыСведений.Спецификации.СоздатьНаборЗаписей();
        Строка = Спецификация.Добавить(); Строка.Период = Дата(2026,1,5); Строка.СистемныйБлок = Блок; Строка.Деталь = Процессор; Строка.Свойство = Свойство.Ссылка; Строка.Количество = 2;
        Строка = Спецификация.Добавить(); Строка.Период = Дата(2026,1,5); Строка.СистемныйБлок = Блок; Строка.Деталь = Плата; Строка.Количество = 1;
        Спецификация.Записать(Ложь);
        Сборка = Документы.Сборка.СоздатьДокумент(); Сборка.Дата = Дата(2026,1,6,10,0,0); Сборка.Номер = "ДЕМОСБ";
        Сборка.ПодразделениеИсточник = Цех; Сборка.ПодразделениеПриемник = Магазин;
        Строка = Сборка.СистемныеБлоки.Добавить(); Строка.Номенклатура = Блок; Строка.Количество = 2;
        Строка = Сборка.ДополнительныеДетали.Добавить(); Строка.Номенклатура = Процессор; Строка.Свойство = Свойство.Ссылка; Строка.Количество = 1;
        Сборка.Записать(РежимЗаписиДокумента.Проведение);
        Продажа = Документы.РасходнаяНакладная.СоздатьДокумент(); Продажа.Дата = Дата(2026,1,7,12,0,0); Продажа.Номер = "ДЕМООУ";
        Строка = Продажа.Товары.Добавить(); Строка.Подразделение = Магазин; Строка.Номенклатура = Блок; Строка.Количество = 1; Строка.Цена = 7500;
        Продажа.Записать(РежимЗаписиДокумента.Проведение);
        Операция = Документы.Операция.СоздатьДокумент(); Операция.Дата = Дата(2026,1,8,10,0,0); Операция.Номер = "ДЕМООП";
        Строка = Операция.Проводки.Добавить(); Строка.СчетДт = ПланыСчетов.Управленческий.Товары; Строка.СчетКт = ПланыСчетов.Управленческий.Поставщики;
        Строка.НоменклатураДт = Аналог; Строка.СкладДт = Склад; Строка.КоличествоДт = 1; Строка.Сумма = 1100;
        Операция.Записать(РежимЗаписиДокумента.Проведение);
        Продажа = Документы.РасходнаяНакладная.СоздатьДокумент(); Продажа.Дата = Дата(2026,1,10,12,0,0); Продажа.Номер = "ДЕМОБУ"; Продажа.Склад = Склад;
        ТоварнаяСтрока(Продажа, Процессор, Справочники.СвойстваНоменклатуры.ПустаяСсылка(), 23, 2000);
        Продажа.Записать(РежимЗаписиДокумента.Проведение);
        ЗаполнитьРасчеты(Цех);
        ЗаполнитьМенеджера();
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Функция Элемент(ИмяСправочника, Наименование)
    Найден = Справочники[ИмяСправочника].НайтиПоНаименованию(Наименование, Истина);
    Если ЗначениеЗаполнено(Найден) Тогда Возврат Найден; КонецЕсли;
    Объект = Справочники[ИмяСправочника].СоздатьЭлемент(); Объект.Наименование = Наименование; Объект.Записать();
    Возврат Объект.Ссылка;
КонецФункции

Функция Номенклатура(Наименование, Артикул)
    Ссылка = Элемент("Номенклатура", Наименование); Объект = Ссылка.ПолучитьОбъект(); Объект.Артикул = Артикул; Объект.Записать(); Возврат Ссылка;
КонецФункции

Процедура Политика(Подразделение, Метод)
    Запись = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи(); Запись.Период = Дата(2026,1,1); Запись.Подразделение = Подразделение; Запись.Метод = Метод; Запись.Записать();
КонецПроцедуры

Процедура ТоварнаяСтрока(Документ, Товар, Свойство, Количество, Цена)
    Строка = Документ.Товары.Добавить(); Строка.Номенклатура = Товар; Строка.Свойство = Свойство; Строка.Количество = Количество; Строка.Цена = Цена; Строка.Сумма = Количество * Цена;
КонецПроцедуры

Функция ВидСведения(Наименование, ТипЗначения)
    Ссылка = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(Наименование, Истина);
    Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка; КонецЕсли;
    Вид = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); Вид.Наименование = Наименование; Вид.ТипЗначения = ТипЗначения; Вид.Записать(); Возврат Вид.Ссылка;
КонецФункции

Процедура Начисление(Документ, Сотрудник, Подразделение, ВидРасчета, Начало, Конец)
    Строка = Документ.ОсновныеНачисления.Добавить(); Строка.Сотрудник = Сотрудник; Строка.Подразделение = Подразделение;
    Строка.ВидРасчета = ВидРасчета; Строка.ДатаНачала = Начало; Строка.ДатаОкончания = Конец;
КонецПроцедуры

Процедура ЗаполнитьРасчеты(Подразделение)
    Работник = Элемент("ФизическиеЛица", "Петров, сборщик (пример)");
    Руководитель = Элемент("ФизическиеЛица", "Иванов, руководитель (пример)");
    Объект = Работник.ПолучитьОбъект(); Объект.НачалоСтажа = Дата(2024,1,1); Объект.Записать();
    Объект = Руководитель.ПолучитьОбъект(); Объект.НачалоСтажа = Дата(2020,1,1); Объект.Записать();
    График = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей(); День = Дата(2025,10,1);
    Пока День <= Дата(2026,3,31) Цикл
        Запись = График.Добавить(); Запись.Подразделение = Подразделение; Запись.Дата = День; Запись.Значение = ?(ДеньНедели(День) <= 5, 8, 0); День = День + 86400;
    КонецЦикла;
    График.Записать(Ложь);
    Ставка = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи(); Ставка.Период = Дата(2025,10,1); Ставка.Сотрудник = Работник; Ставка.Ставка = 100; Ставка.Записать();
    Ставка = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи(); Ставка.Период = Дата(2025,10,1); Ставка.Сотрудник = Руководитель; Ставка.Ставка = 200; Ставка.Записать();
    Стажи = Новый Массив; Стажи.Добавить(0); Стажи.Добавить(1); Стажи.Добавить(3);
    Проценты = Новый Массив; Проценты.Добавить(5); Проценты.Добавить(10); Проценты.Добавить(15);
    Для Индекс = 0 По 2 Цикл
        Запись = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Запись.СтажОт = Стажи[Индекс]; Запись.Процент = Проценты[Индекс]; Запись.Записать();
    КонецЦикла;
    Документ = Документы.НачислениеЗарплаты.СоздатьДокумент(); Документ.Дата = Дата(2025,12,31,18,0,0); Документ.Номер = "ДЕМОЗП1";
    Месяц = Дата(2025,10,1);
    Пока Месяц <= Дата(2025,12,1) Цикл
        Начисление(Документ, Работник, Подразделение, ПланыВидовРасчета.ОсновныеНачисления.Оклад, Месяц, КонецМесяца(Месяц));
        Начисление(Документ, Руководитель, Подразделение, ПланыВидовРасчета.ОсновныеНачисления.Оклад, Месяц, КонецМесяца(Месяц));
        Месяц = ДобавитьМесяц(Месяц, 1);
    КонецЦикла;
    Документ.Записать(РежимЗаписиДокумента.Проведение);
    Документ = Документы.НачислениеЗарплаты.СоздатьДокумент(); Документ.Дата = Дата(2026,1,31,18,0,0); Документ.Номер = "ДЕМОЗП2";
    Начисление(Документ, Работник, Подразделение, ПланыВидовРасчета.ОсновныеНачисления.Оклад, Дата(2026,1,1), Дата(2026,1,31));
    Начисление(Документ, Руководитель, Подразделение, ПланыВидовРасчета.ОсновныеНачисления.Оклад, Дата(2026,1,1), Дата(2026,1,31));
    Начисление(Документ, Руководитель, Подразделение, ПланыВидовРасчета.ОсновныеНачисления.Премия, Дата(2026,1,1), Дата(2026,1,31));
    Документ.Записать(РежимЗаписиДокумента.Проведение);
    Поздний = Документы.НачислениеЗарплаты.СоздатьДокумент(); Поздний.Дата = Дата(2026,2,5,9,0,0); Поздний.Номер = "ДЕМОЗП3";
    Начисление(Поздний, Работник, Подразделение, ПланыВидовРасчета.ОсновныеНачисления.Командировка, Дата(2026,1,12), Дата(2026,1,16));
    Поздний.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры

Процедура ЗаполнитьМенеджера()
    Срок = ВидСведения("Срок кредита, дни", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0)));
    Валюта = ВидСведения("Валюта кредита", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
    Регион = ВидСведения("Регион", Новый ОписаниеТипов("СправочникСсылка.ЗначенияХарактеристик"));
    Менеджер = Элемент("ФизическиеЛица", "Менеджер Сидоров (пример)"); Объект = Менеджер.ПолучитьОбъект();
    Объект.ДополнительныеСведения.Очистить();
    Объект.ДополнительныеСведения.Добавить().ВидСведения = Валюта;
    Объект.ДополнительныеСведения.Добавить().ВидСведения = Срок;
    Объект.ДополнительныеСведения.Добавить().ВидСведения = Регион;
    Объект.Записать();
    Контрагент = Элемент("Контрагенты", "Завод Сатурн (пример)"); Объект = Контрагент.ПолучитьОбъект(); Объект.Менеджер = Менеджер;
    Строка = Объект.ДополнительныеСведения.Добавить(); Строка.ВидСведения = Срок; Строка.Значение = 10;
    Строка = Объект.ДополнительныеСведения.Добавить(); Строка.ВидСведения = Регион; Строка.Значение = Элемент("ЗначенияХарактеристик", "Москва");
    Объект.Записать();
    Телефон = ВидСведения("Дополнительный телефон", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
    ДругойМенеджер = Элемент("ФизическиеЛица", "Менеджер Кузнецов (пример)"); Объект = ДругойМенеджер.ПолучитьОбъект();
    Объект.ДополнительныеСведения.Очистить(); Объект.ДополнительныеСведения.Добавить().ВидСведения = Телефон;
    Объект.ДополнительныеСведения.Добавить().ВидСведения = Регион; Объект.Записать();
КонецПроцедуры
