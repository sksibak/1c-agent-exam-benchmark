Функция ПродажиОУ(НачалоПериода, КонецПериода) Экспорт
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Номенклатура, КоличествоОборот КАК Количество,
    | СебестоимостьОборот КАК Себестоимость, ВыручкаОборот КАК Выручка,
    | ВыручкаОборот - СебестоимостьОборот КАК Прибыль
    |ИЗ РегистрНакопления.Продажи.Обороты(&Начало, &Конец, , )
    |УПОРЯДОЧИТЬ ПО Номенклатура.Наименование");
    Запрос.УстановитьПараметр("Начало", НачалоДня(НачалоПериода));
    Запрос.УстановитьПараметр("Конец", КонецДня(КонецПериода));
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция Ведомость(НачалоПериода, КонецПериода, Подразделение) Экспорт
    Запрос = Новый Запрос(
    "ВЫБРАТЬ О.Номенклатура КАК Номенклатура, О.Свойство КАК Характеристика,
    | ЕСТЬNULL(З.Значение, О.Свойство) КАК Производитель,
    | СУММА(О.СтоимостьНачальныйОстаток) КАК НачальныйОстаток,
    | СУММА(О.СтоимостьПриход) КАК Приход,
    | СУММА(О.СтоимостьРасход) КАК Расход,
    | СУММА(О.СтоимостьКонечныйОстаток) КАК КонечныйОстаток,
    | СУММА(О.КоличествоНачальныйОстаток) КАК НачальноеКоличество,
    | СУММА(О.КоличествоПриход) КАК ПриходКоличество,
    | СУММА(О.КоличествоРасход) КАК РасходКоличество,
    | СУММА(О.КоличествоКонечныйОстаток) КАК КонечноеКоличество
    |ИЗ РегистрНакопления.ОстаткиНоменклатуры.ОстаткиИОбороты(&Начало, &Конец, , , Подразделение = &Подразделение) КАК О
    |ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойств КАК З
    |ПО О.Свойство = З.Свойство И З.Характеристика.Наименование = ""Производитель""
    |СГРУППИРОВАТЬ ПО О.Номенклатура, О.Свойство, ЕСТЬNULL(З.Значение, О.Свойство)
    |УПОРЯДОЧИТЬ ПО Производитель, Номенклатура.Наименование");
    Запрос.УстановитьПараметр("Начало", НачалоДня(НачалоПериода));
    Запрос.УстановитьПараметр("Конец", КонецДня(КонецПериода));
    Запрос.УстановитьПараметр("Подразделение", Подразделение);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПродажиБУ(НачалоПериода, КонецПериода) Экспорт
    // Связь заказанного товара с фактически проданным хранится в реквизитах
    // бухгалтерского движения и доступна в ДвиженияССубконто.
    Запрос = Новый Запрос(
    "ВЫБРАТЬ ВЫБОР КОГДА Заказано = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
    | ТОГДА СубконтоКт1 ИНАЧЕ Заказано КОНЕЦ КАК Номенклатура,
    | СубконтоКт1 КАК Продано,
    | СУММА(КоличествоКт) КАК Количество, СУММА(Сумма) КАК Себестоимость,
    | СУММА(ВыручкаПродажи) КАК Выручка,
    | СУММА(ВыручкаПродажи - Сумма) КАК Прибыль
    |ИЗ РегистрБухгалтерии.Управленческий.ДвиженияССубконто(&Начало, &Конец,
    | Активность И СчетДт = &Прибыль И СчетКт = &Товары, )
    |СГРУППИРОВАТЬ ПО ВЫБОР КОГДА Заказано = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
    | ТОГДА СубконтоКт1 ИНАЧЕ Заказано КОНЕЦ, СубконтоКт1
    |УПОРЯДОЧИТЬ ПО Номенклатура, Продано");
    Запрос.УстановитьПараметр("Начало", НачалоДня(НачалоПериода));
    Запрос.УстановитьПараметр("Конец", КонецДня(КонецПериода));
    Запрос.УстановитьПараметр("Прибыль", ПланыСчетов.Управленческий.ПрибылиУбытки);
    Запрос.УстановитьПараметр("Товары", ПланыСчетов.Управленческий.Товары);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция Премии(НачалоПериода, КонецПериода) Экспорт
    Если НачалоМесяца(НачалоПериода) <> НачалоМесяца(КонецПериода) Тогда ВызватьИсключение "Отчет о премиях формируется за один календарный месяц."; КонецЕсли;
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Сотрудник, МАКСИМУМ(Стаж) КАК Стаж, МАКСИМУМ(Процент) КАК Процент,
    | СУММА(Результат) КАК СуммаПремии
    |ИЗ РегистрРасчета.Начисления
    |ГДЕ ПериодДействия МЕЖДУ &Начало И &Конец И Активность И ВидРасчета = &Премия
    |СГРУППИРОВАТЬ ПО Сотрудник
    |УПОРЯДОЧИТЬ ПО Сотрудник.Наименование");
    Запрос.УстановитьПараметр("Начало", НачалоМесяца(НачалоПериода));
    Запрос.УстановитьПараметр("Конец", КонецМесяца(НачалоПериода));
    Запрос.УстановитьПараметр("Премия", ПланыВидовРасчета.ОсновныеНачисления.Премия);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура Ячейка(Документ, Строка, Колонка, Значение, Жирный = Ложь)
    Область = Документ.Область(Строка, Колонка);
    Область.Текст = Строка(Значение);
    Область.Шрифт = Новый Шрифт("Arial", 10, Жирный);
    Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
КонецПроцедуры

Функция ПредставитьОтчет(Данные, Заголовок, Вид) Экспорт
    Документ = Новый ТабличныйДокумент;
    Документ.АвтоМасштаб = Истина;
    Ячейка(Документ, 1, 1, Заголовок, Истина);
    Если Вид = "Ведомость" Тогда
        Заголовки = СтрРазделить("Производитель;Товар / свойство;Нач. ост.;Приход;Расход;Кон. ост.", ";");
    ИначеЕсли Вид = "Премии" Тогда
        Заголовки = СтрРазделить("Сотрудник;Трудовой стаж, лет;% премии;Сумма премии", ";");
    ИначеЕсли Вид = "ПродажиБУ" Тогда
        Заголовки = СтрРазделить("Номенклатура;Продано;Кол-во;Себест-сть;Продажа;Прибыль", ";");
    Иначе
        Заголовки = СтрРазделить("Номенклатура;Кол-во;Себест-сть;Продажа;Прибыль", ";");
    КонецЕсли;
    Для Индекс = 0 По Заголовки.Количество() - 1 Цикл Ячейка(Документ, 3, Индекс + 1, Заголовки[Индекс], Истина); КонецЦикла;
    Номер = 4; ПредыдущаяГруппа = Неопределено;
    Если Вид = "ПродажиБУ" Тогда
        ИтогиНоменклатуры = Данные.Скопировать();
        ИтогиНоменклатуры.Свернуть("Номенклатура", "Количество,Себестоимость,Выручка,Прибыль");
    КонецЕсли;
    Для Каждого СтрокаДанных Из Данные Цикл
        Если Вид = "Ведомость" Тогда
            Если ПредыдущаяГруппа <> СтрокаДанных.Производитель Тогда
                ПредставлениеПроизводителя = Строка(СтрокаДанных.Производитель);
                Если ПустаяСтрока(ПредставлениеПроизводителя) Тогда ПредставлениеПроизводителя = "Не указан"; КонецЕсли;
                Ячейка(Документ, Номер, 1, ПредставлениеПроизводителя, Истина);
                ПредыдущаяГруппа = СтрокаДанных.Производитель; Номер = Номер + 1;
            КонецЕсли;
            ПредставлениеТовара = Строка(СтрокаДанных.Номенклатура);
            Если ЗначениеЗаполнено(СтрокаДанных.Характеристика) Тогда ПредставлениеТовара = ПредставлениеТовара + " / " + Строка(СтрокаДанных.Характеристика); КонецЕсли;
            Ячейка(Документ, Номер, 2, ПредставлениеТовара);
            Ячейка(Документ, Номер, 3, Формат(СтрокаДанных.НачальноеКоличество, "ЧГ=0") + Символы.ПС + Формат(СтрокаДанных.НачальныйОстаток, "ЧДЦ=2"));
            Ячейка(Документ, Номер, 4, Формат(СтрокаДанных.ПриходКоличество, "ЧГ=0") + Символы.ПС + Формат(СтрокаДанных.Приход, "ЧДЦ=2"));
            Ячейка(Документ, Номер, 5, Формат(СтрокаДанных.РасходКоличество, "ЧГ=0") + Символы.ПС + Формат(СтрокаДанных.Расход, "ЧДЦ=2"));
            Ячейка(Документ, Номер, 6, Формат(СтрокаДанных.КонечноеКоличество, "ЧГ=0") + Символы.ПС + Формат(СтрокаДанных.КонечныйОстаток, "ЧДЦ=2"));
        ИначеЕсли Вид = "Премии" Тогда
            Ячейка(Документ, Номер, 1, СтрокаДанных.Сотрудник); Ячейка(Документ, Номер, 2, СтрокаДанных.Стаж);
            Ячейка(Документ, Номер, 3, СтрокаДанных.Процент); Ячейка(Документ, Номер, 4, Формат(СтрокаДанных.СуммаПремии, "ЧДЦ=2"));
        Иначе
            Смещение = ?(Вид = "ПродажиБУ", 1, 0);
            Если Вид = "ПродажиБУ" Тогда
                Если ПредыдущаяГруппа <> СтрокаДанных.Номенклатура Тогда
                    Итог = ИтогиНоменклатуры.Найти(СтрокаДанных.Номенклатура, "Номенклатура");
                    Ячейка(Документ, Номер, 1, СтрокаДанных.Номенклатура, Истина);
                    Ячейка(Документ, Номер, 3, Итог.Количество, Истина);
                    Ячейка(Документ, Номер, 4, Формат(Итог.Себестоимость, "ЧДЦ=2"), Истина);
                    Ячейка(Документ, Номер, 5, Формат(Итог.Выручка, "ЧДЦ=2"), Истина);
                    Ячейка(Документ, Номер, 6, Формат(Итог.Прибыль, "ЧДЦ=2"), Истина);
                    ПредыдущаяГруппа = СтрокаДанных.Номенклатура; Номер = Номер + 1;
                КонецЕсли;
                Ячейка(Документ, Номер, 2, СтрокаДанных.Продано);
            Иначе
                Ячейка(Документ, Номер, 1, СтрокаДанных.Номенклатура);
            КонецЕсли;
            Ячейка(Документ, Номер, 2 + Смещение, СтрокаДанных.Количество);
            Ячейка(Документ, Номер, 3 + Смещение, Формат(СтрокаДанных.Себестоимость, "ЧДЦ=2"));
            Ячейка(Документ, Номер, 4 + Смещение, Формат(СтрокаДанных.Выручка, "ЧДЦ=2"));
            Ячейка(Документ, Номер, 5 + Смещение, Формат(СтрокаДанных.Прибыль, "ЧДЦ=2"));
        КонецЕсли;
        Номер = Номер + 1;
    КонецЦикла;
    Если Вид = "Премии" Тогда
        Ячейка(Документ, Номер, 1, "ИТОГО:", Истина);
        Ячейка(Документ, Номер, 4, Формат(Данные.Итог("СуммаПремии"), "ЧДЦ=2"), Истина);
    КонецЕсли;
    ПоследняяСтрока = ?(Вид = "Премии", Номер, Макс(3, Номер - 1));
    Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
    Для НомерСтроки = 3 По ПоследняяСтрока Цикл
        Для Колонка = 1 По Заголовки.Количество() Цикл
            Документ.Область(НомерСтроки, Колонка).Обвести(Линия, Линия, Линия, Линия);
        КонецЦикла;
    КонецЦикла;
    Документ.Область(3, 1, 3, Заголовки.Количество()).ЦветФона = Новый Цвет(235, 235, 235);
    Документ.Область(1, 1, 1, Заголовки.Количество()).Объединить();
    Документ.Область(1, 1, Макс(3, Номер), 1).ШиринаКолонки = 28;
    Для Колонка = 2 По Заголовки.Количество() Цикл
        Документ.Область(1, Колонка, Макс(3, Номер), Колонка).ШиринаКолонки = ?(Колонка = 2 И Вид <> "Премии", 30, 17);
    КонецЦикла;
    Документ.ФиксацияСверху = 3;
    Возврат Документ;
КонецФункции
