&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)
    ИзменитьМенеджераНаСервере();
КонецПроцедуры

&НаСервере
Процедура ИзменитьМенеджераНаСервере()
    СохранитьДополнительныеПоля(Объект);
    ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаСервере
Процедура СохранитьДополнительныеПоля(Приемник)
    Для Каждого П Из СписокДопПолей Цикл
        Найдено = Ложь;
        Для Каждого Стр Из Приемник.ДополнительныеСведения Цикл
            Если Стр.ВидСведения = П.ВидСведения Тогда
                Стр.Значение = ЭтотОбъект[П.ИмяПоля]; Найдено = Истина; Прервать;
            КонецЕсли;
        КонецЦикла;
        Если Не Найдено Тогда
            Стр = Приемник.ДополнительныеСведения.Добавить(); Стр.ВидСведения = П.ВидСведения;
            Стр.Значение = ЭтотОбъект[П.ИмяПоля];
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПостроитьДополнительныеПоля()
    Удаляемые = Новый Массив;
    Для Каждого П Из СписокДопПолей Цикл
        Элементы.Удалить(Элементы[П.ИмяПоля]); Удаляемые.Добавить(П.ИмяПоля);
    КонецЦикла;
    СписокДопПолей.Очистить();
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ ВидСведения ПОМЕСТИТЬ Виды ИЗ Справочник.ФизическиеЛица.ДополнительныеСведения ГДЕ Ссылка = &Менеджер;
    |ВЫБРАТЬ С.ВидСведения, С.ВидСведения.Наименование КАК Заголовок,
    | С.ВидСведения.ТипЗначения КАК ТипЗначения
    |ИЗ Виды КАК С");
    Запрос.УстановитьПараметр("Менеджер", Объект.Менеджер);
    Выборка = Запрос.Выполнить().Выбрать(); Добавляемые = Новый Массив;
    Пока Выборка.Следующий() Цикл
        Имя = "ДопСведения_" + СтрЗаменить(Строка(Выборка.ВидСведения.УникальныйИдентификатор()), "-", "");
        Реквизит = Новый РеквизитФормы(Имя, Выборка.ТипЗначения, , Выборка.Заголовок);
        Добавляемые.Добавить(Реквизит);
        Стр = СписокДопПолей.Добавить(); Стр.ИмяПоля = Имя; Стр.ВидСведения = Выборка.ВидСведения; Стр.Заголовок = Выборка.Заголовок;
    КонецЦикла;
    ИзменитьРеквизиты(Добавляемые, Удаляемые);
    Для Каждого П Из СписокДопПолей Цикл
        Поле = Элементы.Добавить(П.ИмяПоля, Тип("ПолеФормы"), Элементы.ДополнительныеПоля);
        Поле.Вид = ВидПоляФормы.ПолеВвода; Поле.ПутьКДанным = П.ИмяПоля;
        Поле.Заголовок = П.Заголовок;
        Для Каждого Стр Из Объект.ДополнительныеСведения Цикл
            Если Стр.ВидСведения = П.ВидСведения Тогда ЭтотОбъект[П.ИмяПоля] = Стр.Значение; Прервать; КонецЕсли;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    СохранитьДополнительныеПоля(ТекущийОбъект);
КонецПроцедуры

