Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    Попытка
        Если СписокНоменклатуры.Количество() = 0 Тогда ВызватьИсключение "Добавьте товары в накладную"; КонецЕсли;
        ЕстьРазрез = ЗначениеЗаполнено(Склад) Или ЗначениеЗаполнено(Подразделение);
        Для Каждого Стр Из СписокНоменклатуры Цикл
            Если Не ЗначениеЗаполнено(Стр.Номенклатура) Или Стр.Количество <= 0 Тогда ВызватьИсключение "Укажите товар и положительное количество в каждой строке"; КонецЕсли;
            ЕстьРазрез = ЕстьРазрез Или ЗначениеЗаполнено(Стр.Подразделение);
        КонецЦикла;
        Если Не ЕстьРазрез Тогда ВызватьИсключение "Укажите склад или подразделение"; КонецЕсли;
        УчетСервер.ПродажаБухгалтерская(ЭтотОбъект);
        УчетСервер.ПродажаОперативная(ЭтотОбъект);
    Исключение
        Отказ = Истина;
        Сообщение = Новый СообщениеПользователю;
        Сообщение.Текст = ОписаниеОшибки();
        Сообщение.Сообщить();
    КонецПопытки;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
    Попытка
        УчетСервер.ОтменитьТоварныйДокумент(ЭтотОбъект);
    Исключение
        Отказ = Истина;
        Сообщение = Новый СообщениеПользователю; Сообщение.Текст = ОписаниеОшибки(); Сообщение.Сообщить();
    КонецПопытки;
КонецПроцедуры
