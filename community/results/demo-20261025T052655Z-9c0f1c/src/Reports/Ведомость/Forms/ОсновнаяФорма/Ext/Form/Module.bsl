&НаКлиенте
Процедура Сформировать(Команда)
    СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса()); КонецПериода = КонецМесяца(ТекущаяДатаСеанса());
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
    Если НачалоПериода > КонецПериода Тогда ВызватьИсключение "Начало периода позже окончания"; КонецЕсли; Если Не ЗначениеЗаполнено(Подразделение) Тогда ВызватьИсключение "Выберите подразделение"; КонецЕсли;
    Данные = Отчеты.Ведомость.Сформировать(НачалоПериода, КонецПериода, Подразделение, ВидХарактеристики);
    Результат.Очистить();
    Заголовок = "Ведомость с " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy") + " по " + Формат(КонецПериода, "ДФ=dd.MM.yyyy"); Заголовок = Заголовок + ", " + Строка(Подразделение);
    Результат.Область(1, 1, 1, 6).Объединить();
    Результат.Область(1, 1).Текст = Заголовок;
    Результат.Область(1, 1).Шрифт = Новый Шрифт(, 12, Истина);
    Заголовки = СтрРазделить("Характеристика|Товар|Нач. ост.|Приход|Расход|Кон. ост.", "|");
    Для Индекс = 0 По Заголовки.Количество() - 1 Цикл
        Результат.Область(3, Индекс + 1).Текст = Заголовки[Индекс];
        Результат.Область(3, Индекс + 1).Шрифт = Новый Шрифт(, , Истина);
        Результат.Область(3, Индекс + 1).ШиринаКолонки = ?(Индекс < 2, 25, 17);
    КонецЦикла;
    СтрокаВывода = 4;
    ПредыдущаяХарактеристика = Неопределено;
    Для Каждого Стр Из Данные Цикл
        Если ПредыдущаяХарактеристика <> Стр.Характеристика Тогда
 Результат.Область(СтрокаВывода, 1).Текст = ?(ЗначениеЗаполнено(Стр.Характеристика), Строка(Стр.Характеристика), "Не указана"); Результат.Область(СтрокаВывода, 1).Шрифт = Новый Шрифт(, , Истина); СтрокаВывода = СтрокаВывода + 1; ПредыдущаяХарактеристика = Стр.Характеристика; КонецЕсли;
        Результат.Область(СтрокаВывода, 2).Текст = Строка(Стр.Номенклатура);
Результат.Область(СтрокаВывода, 3).Текст = Строка(Стр.НачальноеКоличество) + Символы.ПС + Формат(Стр.НачальныйОстаток, "ЧДЦ=2; ЧН=0");
Результат.Область(СтрокаВывода, 4).Текст = Строка(Стр.ПриходКоличество) + Символы.ПС + Формат(Стр.Приход, "ЧДЦ=2; ЧН=0");
Результат.Область(СтрокаВывода, 5).Текст = Строка(Стр.РасходКоличество) + Символы.ПС + Формат(Стр.Расход, "ЧДЦ=2; ЧН=0");
Результат.Область(СтрокаВывода, 6).Текст = Строка(Стр.КонечноеКоличество) + Символы.ПС + Формат(Стр.КонечныйОстаток, "ЧДЦ=2; ЧН=0");

        СтрокаВывода = СтрокаВывода + 1;
    КонецЦикла;
    Результат.Область(СтрокаВывода, 2).Текст = "ИТОГО";Результат.Область(СтрокаВывода, 3).Текст = Строка(Данные.Итог("НачальноеКоличество")) + Символы.ПС + Формат(Данные.Итог("НачальныйОстаток"), "ЧДЦ=2; ЧН=0");Результат.Область(СтрокаВывода, 4).Текст = Строка(Данные.Итог("ПриходКоличество")) + Символы.ПС + Формат(Данные.Итог("Приход"), "ЧДЦ=2; ЧН=0");Результат.Область(СтрокаВывода, 5).Текст = Строка(Данные.Итог("РасходКоличество")) + Символы.ПС + Формат(Данные.Итог("Расход"), "ЧДЦ=2; ЧН=0");Результат.Область(СтрокаВывода, 6).Текст = Строка(Данные.Итог("КонечноеКоличество")) + Символы.ПС + Формат(Данные.Итог("КонечныйОстаток"), "ЧДЦ=2; ЧН=0");
    Результат.АвтоМасштаб = Истина;
    Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
    Для НомерСтроки = 3 По СтрокаВывода Цикл
        Для НомерКолонки = 1 По 6 Цикл
            Результат.Область(НомерСтроки, НомерКолонки).Обвести(Линия, Линия, Линия, Линия);
        КонецЦикла;
    КонецЦикла;
    Результат.Область(СтрокаВывода, 1, СтрокаВывода, 6).Шрифт = Новый Шрифт(, , Истина);
КонецПроцедуры

