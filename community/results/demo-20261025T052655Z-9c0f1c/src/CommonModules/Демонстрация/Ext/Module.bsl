Функция Элемент(Менеджер, Имя) Экспорт
    Ссылка = Менеджер.НайтиПоНаименованию(Имя, Истина);
    Если Не ЗначениеЗаполнено(Ссылка) Тогда
        Объект = Менеджер.СоздатьЭлемент(); Объект.Наименование = Имя; Объект.Записать(); Ссылка = Объект.Ссылка;
    КонецЕсли;
    Возврат Ссылка;
КонецФункции

Процедура Заполнить() Экспорт
    НачатьТранзакцию();
    Попытка
        НастроитьИДанные();
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры

Процедура НастроитьИДанные()
    РасчетЗарплаты.НастроитьВидыРасчета();
    Цех = Элемент(Справочники.Подразделения, "Демо: основной цех");
    Склад = Элемент(Справочники.Склады, "Демо: центральный склад");
    Деталь = Элемент(Справочники.Номенклатура, "Демо: процессор");
    Блок = Элемент(Справочники.Номенклатура, "Демо: системный блок");
    Принтер = Элемент(Справочники.Номенклатура, "Демо: принтер");
    Аналог = Элемент(Справочники.Номенклатура, "Демо: принтер аналог");
    Поставщик = Элемент(Справочники.Контрагенты, "Демо: поставщик");
    Свойство = Элемент(Справочники.СвойстваНоменклатуры, "Демо: стандарт");
    СвОбъект = Свойство.ПолучитьОбъект(); СвОбъект.Номенклатура = Деталь; СвОбъект.Записать();
    Д = Деталь.ПолучитьОбъект(); Д.Артикул = "D001"; Д.Записать();
    Д = Принтер.ПолучитьОбъект(); Д.Артикул = "D002"; Д.Записать();
    Д = Аналог.ПолучитьОбъект(); Д.Артикул = "D003"; Д.Записать();
    Менеджер = Элемент(Справочники.ФизическиеЛица, "Демо: руководитель");
    Работник = Элемент(Справочники.ФизическиеЛица, "Демо: работник");
    Для Каждого Сотрудник Из Новый Структура("А,Б", Менеджер, Работник) Цикл
        Д = Сотрудник.Значение.ПолучитьОбъект(); Д.НачалоСтажа = Дата(2020,1,1); Д.Записать();
    КонецЦикла;
    Вид = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Производитель", Истина);
    Если Не ЗначениеЗаполнено(Вид) Тогда
        Д = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); Д.Наименование = "Производитель"; Д.ТипЗначения = Новый ОписаниеТипов("Строка"); Д.Записать(); Вид = Д.Ссылка;
    КонецЕсли;
    Запись = РегистрыСведений.ЗначенияСвойств.СоздатьМенеджерЗаписи(); Запись.Свойство = Свойство; Запись.Характеристика = Вид; Запись.Значение = "ASUS"; Запись.Записать();
    ВидДоп = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Срок кредита, дни", Истина);
    Если Не ЗначениеЗаполнено(ВидДоп) Тогда
        Д = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); Д.Наименование = "Срок кредита, дни"; Д.ТипЗначения = Новый ОписаниеТипов("Число"); Д.Записать(); ВидДоп = Д.Ссылка;
    КонецЕсли;
    ВалютаВид = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Валюта кредита", Истина);
    Если Не ЗначениеЗаполнено(ВалютаВид) Тогда
        Д = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); Д.Наименование = "Валюта кредита"; Д.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.Валюты"); Д.Записать(); ВалютаВид = Д.Ссылка;
    КонецЕсли;
    РегионВид = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Регион", Истина);
    Если Не ЗначениеЗаполнено(РегионВид) Тогда
        Д = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); Д.Наименование = "Регион"; Д.ТипЗначения = Новый ОписаниеТипов("Строка"); Д.Записать(); РегионВид = Д.Ссылка;
    КонецЕсли;
    Д = Менеджер.ПолучитьОбъект(); Д.ДополнительныеСведения.Очистить();
    Д.ДополнительныеСведения.Добавить().ВидСведения = ВалютаВид;
    Д.ДополнительныеСведения.Добавить().ВидСведения = ВидДоп;
    Д.ДополнительныеСведения.Добавить().ВидСведения = РегионВид; Д.Записать();
    Д = Работник.ПолучитьОбъект(); Д.ДополнительныеСведения.Очистить(); Д.ДополнительныеСведения.Добавить().ВидСведения = РегионВид; Д.Записать();
    Д = Поставщик.ПолучитьОбъект(); Д.Менеджер = Менеджер; Д.ДополнительныеСведения.Очистить(); С = Д.ДополнительныеСведения.Добавить(); С.ВидСведения = ВидДоп; С.Значение = 10; Д.Записать();
    Запись = РегистрыСведений.УчетнаяПолитика.СоздатьМенеджерЗаписи(); Запись.Период = Дата(2025,1,1); Запись.Подразделение = Цех; Запись.Метод = Перечисления.МетодыСписания.FIFO; Запись.Записать();
    Запись = РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи(); Запись.Период = Дата(2025,1,6); Запись.Блок = Блок; Запись.Деталь = Деталь; Запись.Свойство = Свойство; Запись.Количество = 2; Запись.Записать();
    Запись = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи(); Запись.Номенклатура = Принтер; Запись.Аналог = Аналог; Запись.Записать();
    // Идемпотентная демонстрация: номера документов зарезервированы только для примера.
    Если Не ЗначениеЗаполнено(Документы.ПриходнаяНакладная.НайтиПоНомеру("ДЕМО00001")) Тогда
        Д = Документы.ПриходнаяНакладная.СоздатьДокумент(); Д.Номер = "ДЕМО00001"; Д.Дата = Дата(2025,1,7,10,0,0); Д.Подразделение = Цех; Д.Склад = Склад; Д.Контрагент = Поставщик;
        С = Д.СписокНоменклатуры.Добавить(); С.Номенклатура = Деталь; С.Свойство = Свойство; С.Количество = 10; С.Цена = 100; С.Сумма = 1000;
        С = Д.СписокНоменклатуры.Добавить(); С.Номенклатура = Аналог; С.Количество = 5; С.Цена = 200; С.Сумма = 1000;
        Д.Записать(РежимЗаписиДокумента.Проведение);
        Д = Документы.Сборка.СоздатьДокумент(); Д.Номер = "ДЕМО00001"; Д.Дата = Дата(2025,1,8,10,0,0); Д.ПодразделениеИсточник = Цех; Д.ПодразделениеПолучатель = Цех;
        С = Д.Блоки.Добавить(); С.Номенклатура = Блок; С.Количество = 2;
        Д.Записать(РежимЗаписиДокумента.Проведение);
        Д = Документы.РасходнаяНакладная.СоздатьДокумент(); Д.Номер = "ДЕМО00001"; Д.Дата = Дата(2025,1,9,10,0,0); Д.Подразделение = Цех;
        С = Д.СписокНоменклатуры.Добавить(); С.Номенклатура = Блок; С.Подразделение = Цех; С.Количество = 1; С.Цена = 300; С.Сумма = 300;
        Д.Записать(РежимЗаписиДокумента.Проведение);
        Д = Документы.РасходнаяНакладная.СоздатьДокумент(); Д.Номер = "ДЕМО00002"; Д.Дата = Дата(2025,1,10,10,0,0); Д.Склад = Склад;
        С = Д.СписокНоменклатуры.Добавить(); С.Номенклатура = Принтер; С.Количество = 2; С.Цена = 400; С.Сумма = 800;
        Д.Записать(РежимЗаписиДокумента.Проведение);
        Д = Документы.Операция.СоздатьДокумент(); Д.Номер = "ДЕМО00001"; Д.Дата = Дата(2025,1,11,10,0,0);
        С = Д.Проводки.Добавить(); С.СчетДт = ПланыСчетов.Управленческий.Товары; С.СчетКт = ПланыСчетов.Управленческий.Поставщики;
        С.НоменклатураДт = Принтер; С.СкладДт = Склад; С.КоличествоДт = 1; С.Сумма = 150;
        Д.Записать(РежимЗаписиДокумента.Проведение);
    КонецЕсли;
    Набор = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей(); Набор.Отбор.Подразделение.Установить(Цех);
    День = Дата(2024,10,1);
    Пока День <= Дата(2025,3,31) Цикл
        С = Набор.Добавить(); С.Дата = День; С.Подразделение = Цех; С.Значение = ?(ДеньНедели(День) <= 5, 8, 0); С.Дни = ?(С.Значение > 0, 1, 0); День = День + 86400;
    КонецЦикла;
    Набор.Записать();
    Для Каждого Сотрудник Из Новый Структура("А,Б", Менеджер, Работник) Цикл
        Запись = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи(); Запись.Период = Дата(2024,1,1); Запись.Сотрудник = Сотрудник.Значение; Запись.Ставка = 100; Запись.Записать();
    КонецЦикла;
    Для Индекс = 0 По 2 Цикл
        Запись = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Запись.Стаж = ?(Индекс = 0, 0, ?(Индекс = 1, 1, 3)); Запись.Процент = ?(Индекс = 0, 5, ?(Индекс = 1, 10, 15)); Запись.Записать();
    КонецЦикла;
    Если Не ЗначениеЗаполнено(Документы.НачислениеЗарплаты.НайтиПоНомеру("ДЕМО00001")) Тогда
        Д = Документы.НачислениеЗарплаты.СоздатьДокумент(); Д.Номер = "ДЕМО00001"; Д.Дата = Дата(2025,1,31,12,0,0);
        Для Каждого Сотрудник Из Новый Структура("А,Б", Менеджер, Работник) Цикл
            С = Д.ОсновныеНачисления.Добавить(); С.Сотрудник = Сотрудник.Значение; С.Подразделение = Цех; С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф; С.ДатаНачала = Дата(2025,1,1); С.ДатаОкончания = Дата(2025,1,31);
        КонецЦикла;
        Д.Записать(РежимЗаписиДокумента.Проведение);
        Д = Документы.НачислениеЗарплаты.СоздатьДокумент(); Д.Номер = "ДЕМО00002"; Д.Дата = Дата(2025,2,28,12,0,0);
        С = Д.ОсновныеНачисления.Добавить(); С.Сотрудник = Менеджер; С.Подразделение = Цех; С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия; С.ДатаНачала = Дата(2025,2,1); С.ДатаОкончания = Дата(2025,2,28);
        С = Д.ОсновныеНачисления.Добавить(); С.Сотрудник = Работник; С.Подразделение = Цех; С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка; С.ДатаНачала = Дата(2025,2,10); С.ДатаОкончания = Дата(2025,2,14);
        Д.Записать(РежимЗаписиДокумента.Проведение);
    КонецЕсли;
КонецПроцедуры



Функция ДанныеФормы() Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Справочник.Валюты");
    В = Запрос.Выполнить().Выбрать(); Валюта = Справочники.Валюты.ПустаяСсылка(); Если В.Следующий() Тогда Валюта = В.Ссылка; КонецЕсли;
    Возврат Новый Структура("Контрагент,Подразделение,Менеджер1,Менеджер2,Валюта", Справочники.Контрагенты.НайтиПоНаименованию("Демо: поставщик", Истина), Справочники.Подразделения.НайтиПоНаименованию("Демо: основной цех", Истина), Справочники.ФизическиеЛица.НайтиПоНаименованию("Демо: руководитель", Истина), Справочники.ФизическиеЛица.НайтиПоНаименованию("Демо: работник", Истина), Валюта);
КонецФункции
