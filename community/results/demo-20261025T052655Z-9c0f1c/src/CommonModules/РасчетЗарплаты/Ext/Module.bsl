Процедура НастроитьВидыРасчета() Экспорт
    Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
    Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия;
    Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
    Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК ЧислоСвязей ИЗ ПланВидовРасчета.ОсновныеНачисления.ВытесняющиеВидыРасчета
    |ГДЕ Ссылка В (&Тариф, &Премия) И ВидРасчета = &Командировка;
    |ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК ЧислоСвязей ИЗ ПланВидовРасчета.ОсновныеНачисления.БазовыеВидыРасчета
    |ГДЕ (Ссылка = &Премия И ВидРасчета = &Тариф) ИЛИ (Ссылка = &Командировка И ВидРасчета В (&Все))");
    Все = Новый Массив; Все.Добавить(Тариф); Все.Добавить(Премия); Все.Добавить(Командировка);
    Запрос.УстановитьПараметр("Тариф", Тариф); Запрос.УстановитьПараметр("Премия", Премия);
    Запрос.УстановитьПараметр("Командировка", Командировка); Запрос.УстановитьПараметр("Все", Все);
    Пакет = Запрос.ВыполнитьПакет(); Вытеснение = Пакет[0].Выбрать(); Базы = Пакет[1].Выбрать();
    Вытеснение.Следующий(); Базы.Следующий();
    Если Вытеснение.ЧислоСвязей = 2 И Базы.ЧислоСвязей = 4 Тогда Возврат; КонецЕсли;
    // Инициализация выполняется однократно; при обычном проведении объекты не читаются и не записываются.
    БазыТарифа = Новый Массив;
    УстановитьСвязиВида(Тариф, Командировка, БазыТарифа);
    БазыПремии = Новый Массив; БазыПремии.Добавить(Тариф);
    УстановитьСвязиВида(Премия, Командировка, БазыПремии);
    УстановитьСвязиВида(Командировка, Неопределено, Все);
КонецПроцедуры

Процедура УстановитьСвязиВида(Вид, Вытесняющий, Базовые)
    Объект = Вид.ПолучитьОбъект();
    Объект.ВытесняющиеВидыРасчета.Очистить(); Объект.БазовыеВидыРасчета.Очистить();
    Если Вытесняющий <> Неопределено Тогда Объект.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = Вытесняющий; КонецЕсли;
    Для Каждого База Из Базовые Цикл Объект.БазовыеВидыРасчета.Добавить().ВидРасчета = База; КонецЦикла;
    Объект.Записать();
КонецПроцедуры

Процедура Провести(Документ) Экспорт
    Если Документ.ОсновныеНачисления.Количество() = 0 Тогда ВызватьИсключение "Введите начисления"; КонецЕсли;
    НастроитьВидыРасчета();
    Блокировка = Новый БлокировкаДанных;
    Блокировка.Добавить("РегистрРасчета.Начисления").Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    Набор = Документ.Движения.Начисления; Набор.Записывать = Истина; Набор.Очистить();
    Строки = Документ.ОсновныеНачисления.Выгрузить();
    Строки.Свернуть("Сотрудник,Подразделение,ВидРасчета,ДатаНачала,ДатаОкончания", "Размер");
    Для Каждого Стр Из Строки Цикл
        Если Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Тариф И Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия И Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда ВызватьИсключение "Выберите тариф, премию или командировку"; КонецЕсли;
        Если Не ЗначениеЗаполнено(Стр.Сотрудник) Или Не ЗначениеЗаполнено(Стр.Подразделение) Или Не ЗначениеЗаполнено(Стр.ВидРасчета) Тогда ВызватьИсключение "Заполните сотрудника, подразделение и вид расчета"; КонецЕсли;
        Если Стр.ДатаНачала > Стр.ДатаОкончания Или Не ЗначениеЗаполнено(Стр.ДатаНачала) Тогда ВызватьИсключение "Некорректный период начисления"; КонецЕсли;
        Если Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка И НачалоМесяца(Стр.ДатаНачала) <> НачалоМесяца(Стр.ДатаОкончания) Тогда ВызватьИсключение "Тариф и премия вводятся в пределах одного месяца"; КонецЕсли;
        Начало = НачалоДня(Стр.ДатаНачала);
        Пока Начало <= Стр.ДатаОкончания Цикл
            Конец = Мин(КонецМесяца(Начало), КонецДня(Стр.ДатаОкончания));
            Дв = Набор.Добавить(); Дв.Сотрудник = Стр.Сотрудник; Дв.Подразделение = Стр.Подразделение; Дв.ВидРасчета = Стр.ВидРасчета;
            Дв.ПериодДействияНачало = Начало; Дв.ПериодДействияКонец = Конец;
            Дв.ПериодРегистрации = ?(Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка, Макс(НачалоМесяца(Документ.Дата), НачалоМесяца(Начало)), НачалоМесяца(Начало));
            Дв.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало), ?(Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка, -3, -1));
            Дв.БазовыйПериодКонец = НачалоМесяца(Начало) - 1;
            Начало = НачалоМесяца(ДобавитьМесяц(Начало, 1));
        КонецЦикла;
    КонецЦикла;
    // Специализированное дополнение платформы дает сторно за прошлые периоды.
    Дополнение = Набор.ПолучитьДополнение();
    Для Каждого Стр Из Дополнение Цикл
        Дв = Набор.Добавить(); ЗаполнитьЗначенияСвойств(Дв, Стр);
        Дв.Сторно = Истина; Дв.ПериодРегистрации = Стр.ПериодРегистрацииСторно;
        Дв.ПериодДействияНачало = Стр.ПериодДействияНачалоСторно; Дв.ПериодДействияКонец = Стр.ПериодДействияКонецСторно;
    КонецЦикла;
    Набор.Записать();
    РассчитатьСВытесненнымиЗаписями(Набор, Документ.Ссылка);
КонецПроцедуры

Процедура РассчитатьНабор(Наборы, Регистраторы) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Регистратор, НомерСтроки, ЗначениеФактическийПериодДействия КАК Часы,
    | ДниФактическийПериодДействия КАК Дни, ДниПериодДействия КАК ДниПлан
    |ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор В (&Регистраторы))";
    Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
    График = Запрос.Выполнить().Выгрузить();
    // Получаем все срезы ставок для расчетных месяцев одним запросом по интервалам.
    Запрос.Текст = "ВЫБРАТЬ Н.Регистратор, Н.НомерСтроки, Н.Сотрудник, Н.Сотрудник.НачалоСтажа КАК НачалоСтажа,
    | МАКСИМУМ(С.Период) КАК Период ПОМЕСТИТЬ ПоследниеСтавки
    |ИЗ РегистрРасчета.Начисления КАК Н ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифныеСтавки КАК С
    |ПО Н.Сотрудник = С.Сотрудник И С.Период <= НАЧАЛОПЕРИОДА(Н.ПериодДействияНачало, МЕСЯЦ)
    |ГДЕ Н.Регистратор В (&Регистраторы)
    |СГРУППИРОВАТЬ ПО Н.Регистратор, Н.НомерСтроки, Н.Сотрудник, Н.Сотрудник.НачалоСтажа;
    |ВЫБРАТЬ П.Регистратор, П.НомерСтроки, П.НачалоСтажа, ЕСТЬNULL(С.Ставка, 0) КАК Ставка
    |ИЗ ПоследниеСтавки КАК П ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифныеСтавки КАК С
    |ПО П.Сотрудник = С.Сотрудник И П.Период = С.Период";
    Ставки = Запрос.Выполнить().Выгрузить();
    Запрос.Текст = "ВЫБРАТЬ Стаж, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО Стаж";
    Шкала = Запрос.Выполнить().Выгрузить();
    Для Каждого Набор Из Наборы Цикл
    Для Каждого Дв Из Набор Цикл
        Г = СтрокаРасчета(График, Дв);
        С = СтрокаРасчета(Ставки, Дв);
        Дв.Часы = ?(Г = Неопределено, 0, Г.Часы); Дв.Дни = ?(Г = Неопределено Или Дв.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Тариф, 0, Г.Дни) * ?(Дв.Сторно, -1, 1);
        Если С <> Неопределено Тогда
            Дв.Ставка = С.Ставка;
            Месяцев = (Год(Дв.ПериодДействияНачало) - Год(С.НачалоСтажа)) * 12 + Месяц(Дв.ПериодДействияНачало) - Месяц(С.НачалоСтажа);
            Если День(Дв.ПериодДействияНачало) < День(С.НачалоСтажа) Тогда Месяцев = Месяцев - 1; КонецЕсли;
            Дв.Стаж = Макс(0, Месяцев / 12);
        КонецЕсли;
        Если Не Дв.Сторно Тогда Дв.НормаДней = ?(Г = Неопределено, 0, Г.ДниПлан); КонецЕсли;
        Дв.Процент = 0;
        Для Каждого П Из Шкала Цикл Если Дв.Стаж >= П.Стаж Тогда Дв.Процент = П.Процент; КонецЕсли; КонецЦикла;
        Если Дв.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
            Дв.Результат = Окр(Дв.Ставка * Дв.Часы, 2) * ?(Дв.Сторно, -1, 1);
        КонецЕсли;
    КонецЦикла;
    КонецЦикла;
    СохранитьНаборы(Наборы);
    // База премии: сначала группируем по подразделению, затем исключаем начисления самого руководителя.
    Запрос.Текст = "ВЫБРАТЬ Регистратор, НомерСтроки, РезультатБаза КАК Результат
    |ИЗ РегистрРасчета.Начисления.БазаНачисления(&ИзмеренияПремии, &ИзмеренияПремии, , Регистратор В (&Регистраторы) И ВидРасчета = &Премия)";
    Измерения = Новый Массив; Измерения.Добавить("Подразделение");
    Запрос.УстановитьПараметр("ИзмеренияПремии", Измерения); Запрос.УстановитьПараметр("Премия", ПланыВидовРасчета.ОсновныеНачисления.Премия);
    БазаПодразделения = Запрос.Выполнить().Выгрузить();
    ИзмеренияСотрудника = Новый Массив; ИзмеренияСотрудника.Добавить("Сотрудник"); ИзмеренияСотрудника.Добавить("Подразделение");
    Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ИзмеренияПремии", "&ИзмеренияСотрудника");
    Запрос.УстановитьПараметр("ИзмеренияСотрудника", ИзмеренияСотрудника);
    БазаРуководителя = Запрос.Выполнить().Выгрузить();
    Для Каждого Набор Из Наборы Цикл
    Для Каждого Дв Из Набор Цикл
        Если Дв.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда Продолжить; КонецЕсли;
        Б = СтрокаРасчета(БазаПодразделения, Дв); Л = СтрокаРасчета(БазаРуководителя, Дв);
        СуммаБазы = ?(Б = Неопределено, 0, Б.Результат) - ?(Л = Неопределено, 0, Л.Результат);
        Г = СтрокаРасчета(График, Дв);
        Доля = ?(Г = Неопределено Или Дв.НормаДней = 0, 0, Г.Дни / Дв.НормаДней);
        Дв.Результат = Окр(СуммаБазы * Дв.Процент / 100 * Доля, 2) * ?(Дв.Сторно, -1, 1);
    КонецЦикла;
    КонецЦикла;
    СохранитьНаборы(Наборы);
    Запрос.Текст = "ВЫБРАТЬ Регистратор, НомерСтроки, РезультатБаза КАК Результат, ДниБаза КАК Дни
    |ИЗ РегистрРасчета.Начисления.БазаНачисления(&Измерения, &Измерения, , Регистратор В (&Регистраторы) И ВидРасчета = &Командировка)";
    Измерения = Новый Массив; Измерения.Добавить("Сотрудник");
    Запрос.УстановитьПараметр("Измерения", Измерения); Запрос.УстановитьПараметр("Командировка", ПланыВидовРасчета.ОсновныеНачисления.Командировка);
    БазаКомандировки = Запрос.Выполнить().Выгрузить();
    Порядок = Новый ТаблицаЗначений;
    Для Каждого ИмяКолонки Из СтрРазделить("Месяц,Сотрудник,Движение,Изменение", ",") Цикл Порядок.Колонки.Добавить(ИмяКолонки); КонецЦикла;
    Для Каждого Набор Из Наборы Цикл
        Для Каждого Дв Из Набор Цикл
            Если Дв.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда Продолжить; КонецЕсли;
            Стр = Порядок.Добавить(); Стр.Месяц = НачалоМесяца(Дв.ПериодДействияНачало); Стр.Сотрудник = Дв.Сотрудник; Стр.Движение = Дв; Стр.Изменение = 0;
        КонецЦикла;
    КонецЦикла;
    Порядок.Сортировать("Месяц");
    Для Каждого Стр Из Порядок Цикл
        Дв = Стр.Движение;
        Б = СтрокаРасчета(БазаКомандировки, Дв); Г = СтрокаРасчета(График, Дв);
        СуммаБазы = ?(Б = Неопределено, 0, Б.Результат);
        // Внутри длинной командировки результаты предыдущих месяцев текущего пакета уже известны.
        Для Каждого Ранее Из Порядок Цикл
            Если Ранее.Сотрудник = Дв.Сотрудник И Ранее.Месяц >= Дв.БазовыйПериодНачало И Ранее.Месяц <= Дв.БазовыйПериодКонец Тогда
                СуммаБазы = СуммаБазы + Ранее.Изменение;
            КонецЕсли;
        КонецЦикла;
        СтарыйРезультат = Дв.Результат;
        Если Б = Неопределено Или Б.Дни = 0 Тогда Дв.Результат = 0;
        Иначе Дв.Результат = Окр(СуммаБазы / Б.Дни * ?(Г = Неопределено, 0, Г.Дни), 2); КонецЕсли;
        Стр.Изменение = Дв.Результат - СтарыйРезультат;
    КонецЦикла;
    СохранитьНаборы(Наборы);
КонецПроцедуры


Процедура РассчитатьСВытесненнымиЗаписями(ТекущийНабор, ТекущийРегистратор, Отмена = Ложь) Экспорт
    // В том же периоде регистрации платформа меняет фактический период старых записей.
    // Прочитаем затронутые наборы одним запросом; повторные обращения к БД в цикле не нужны.
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Старые.Регистратор КАК Регистратор ПОМЕСТИТЬ Затронутые
    |ИЗ РегистрРасчета.Начисления КАК Новые ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрРасчета.Начисления КАК Старые
    |ПО Новые.Сотрудник = Старые.Сотрудник И Новые.Подразделение = Старые.Подразделение
    | И Новые.ПериодРегистрации = Старые.ПериодРегистрации
    | И Новые.ПериодДействияНачало <= Старые.ПериодДействияКонец
    | И Новые.ПериодДействияКонец >= Старые.ПериодДействияНачало
    |ГДЕ Новые.Регистратор = &Текущий И Старые.Регистратор <> &Текущий;
    |ВЫБРАТЬ Н.Регистратор, Н.ВидРасчета, Н.Активность, Н.Сторно, Н.ПериодРегистрации,
    | Н.ПериодДействияНачало, Н.ПериодДействияКонец, Н.БазовыйПериодНачало, Н.БазовыйПериодКонец,
    | Н.Сотрудник, Н.Подразделение, Н.Результат, Н.Дни, Н.Часы, Н.Ставка, Н.Стаж, Н.Процент, Н.НормаДней
    |ИЗ РегистрРасчета.Начисления КАК Н ГДЕ Н.Регистратор В (ВЫБРАТЬ Регистратор ИЗ Затронутые)
    |УПОРЯДОЧИТЬ ПО Н.Регистратор, Н.НомерСтроки");
    Запрос.УстановитьПараметр("Текущий", ТекущийРегистратор);
    Выборка = Запрос.Выполнить().Выбрать(); Наборы = Новый Массив; Регистраторы = Новый Массив;
    Если Отмена Тогда
        ТекущийНабор.Очистить(); ТекущийНабор.Записать();
    Иначе
        Наборы.Добавить(ТекущийНабор); Регистраторы.Добавить(ТекущийРегистратор);
    КонецЕсли;
    Предыдущий = Неопределено; Набор = Неопределено;
    Пока Выборка.Следующий() Цикл
        Если Предыдущий <> Выборка.Регистратор Тогда
            Набор = РегистрыРасчета.Начисления.СоздатьНаборЗаписей(); Набор.Отбор.Регистратор.Установить(Выборка.Регистратор);
            Наборы.Добавить(Набор); Регистраторы.Добавить(Выборка.Регистратор); Предыдущий = Выборка.Регистратор;
        КонецЕсли;
        Дв = Набор.Добавить(); ЗаполнитьЗначенияСвойств(Дв, Выборка);
    КонецЦикла;
    Если Наборы.Количество() = 0 Тогда Возврат; КонецЕсли;
    СохранитьНаборы(Наборы);
    РассчитатьНабор(Наборы, Регистраторы);
КонецПроцедуры

Процедура СохранитьНаборы(Наборы)
    Для Каждого Набор Из Наборы Цикл Набор.Записать(); КонецЦикла;
КонецПроцедуры

Функция СтрокаРасчета(Таблица, Движение)
    Строки = Таблица.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Движение.Регистратор, Движение.НомерСтроки));
    Возврат ?(Строки.Количество() = 0, Неопределено, Строки[0]);
