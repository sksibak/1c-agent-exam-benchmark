// Все итоговые данные читаются пакетно после блокировки и удаления старых движений.
// Все итоговые данные читаются пакетно после блокировки и удаления старых движений.
Процедура ЗаблокироватьОстатки(ИмяРегистра, Данные, Бухгалтерский = Ложь) Экспорт
    Если Данные.Количество() = 0 Тогда Возврат; КонецЕсли;
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить(ИмяРегистра);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Элемент.ИсточникДанных = Данные;
    Элемент.ИспользоватьИзИсточникаДанных(?(Бухгалтерский, "Субконто1", "Номенклатура"), "Номенклатура");
    Если Не Бухгалтерский Тогда
        Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
    КонецЕсли;
    Блокировка.Заблокировать();
КонецПроцедуры

Функция Потребность() Экспорт
    Т = Новый ТаблицаЗначений;
    Т.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
    Т.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Т.Колонки.Добавить("Свойство", Новый ОписаниеТипов("СправочникСсылка.СвойстваНоменклатуры"));
    Т.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
    Т.Колонки.Добавить("Блок", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Т.Колонки.Добавить("Выручка", Новый ОписаниеТипов("Число"));
    Возврат Т;
КонецФункции

Функция ОстаткиДеталей(Документ, Требования) Экспорт
    ЗаблокироватьОстатки("РегистрНакопления.ОстаткиНоменклатуры", Требования);
    Документ.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Документ.Движения.ОстаткиНоменклатуры.Очистить();
    Документ.Движения.ОстаткиНоменклатуры.Записать();
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Подразделение, Номенклатура, Свойство, Партия,
    | КоличествоОстаток КАК Количество, СтоимостьОстаток КАК Стоимость
    |ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Момент,
    | Подразделение В (&Подразделения) И Номенклатура В (&Товары))
    |УПОРЯДОЧИТЬ ПО Партия.Дата, Партия";
    Запрос.УстановитьПараметр("Момент", Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая));
    Запрос.УстановитьПараметр("Подразделения", Требования.ВыгрузитьКолонку("Подразделение"));
    Запрос.УстановитьПараметр("Товары", Требования.ВыгрузитьКолонку("Номенклатура"));
    // Изменяемая таблица нужна для последовательного распределения партий и дублей строк.
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция Политики(Документ, Требования) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ Подразделение, Метод ИЗ
    |РегистрСведений.УчетнаяПолитика.СрезПоследних(&Дата, Подразделение В (&Список))");
    Запрос.УстановитьПараметр("Дата", Документ.Дата);
    Запрос.УстановитьПараметр("Список", Требования.ВыгрузитьКолонку("Подразделение"));
    Результат = Новый Соответствие;
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл Результат.Вставить(Выборка.Подразделение, Выборка.Метод); КонецЦикла;
    Возврат Результат;
КонецФункции

Функция СписатьДетали(Документ, Требование, Остатки, Метод) Экспорт
    Если Требование.Количество <= 0 Тогда ВызватьИсключение "Количество должно быть положительным"; КонецЕсли;
    Отбор = Новый Структура("Подразделение,Номенклатура,Свойство", Требование.Подразделение, Требование.Номенклатура, Требование.Свойство);
    Партии = Остатки.НайтиСтроки(Отбор);
    Всего = 0; Стоимость = 0;
    Для Каждого П Из Партии Цикл Всего = Всего + П.Количество; Стоимость = Стоимость + П.Стоимость; КонецЦикла;
    Если Всего < Требование.Количество Тогда
        ВызватьИсключение СтрШаблон("Недостаточно %1, свойство %2, подразделение %3. Требуется %4, остаток %5", Требование.Номенклатура, Требование.Свойство, Требование.Подразделение, Требование.Количество, Всего);
    КонецЕсли;
    Если Метод = Неопределено Или Не ЗначениеЗаполнено(Метод) Тогда
        ВызватьИсключение "Не задана учетная политика подразделения";
    КонецЕсли;
    Осталось = Требование.Количество; Итог = 0;
    Средняя = Метод = Перечисления.МетодыСписания.Средняя;
    ЦелеваяСтоимость = ?(Осталось = Всего, Стоимость, Окр(Стоимость * Осталось / Всего, 2));
    Для Индекс = 0 По Партии.Количество() - 1 Цикл
        Номер = ?(Метод = Перечисления.МетодыСписания.LIFO, Партии.Количество() - 1 - Индекс, Индекс);
        П = Партии[Номер];
        Если П.Количество <= 0 Тогда Продолжить; КонецЕсли;
        Если Средняя Тогда
            Кол = ?(Индекс = Партии.Количество() - 1, Осталось, Мин(Осталось, Окр(П.Количество * Требование.Количество / Всего, 3)));
        Иначе Кол = Мин(Осталось, П.Количество); КонецЕсли;
        Если Кол <= 0 Тогда Продолжить; КонецЕсли;
        Сумма = ?(Кол = П.Количество, П.Стоимость, Окр(П.Стоимость * Кол / П.Количество, 2));
        Если Средняя И Кол = Осталось Тогда Сумма = ЦелеваяСтоимость - Итог; КонецЕсли;
        Движение = Документ.Движения.ОстаткиНоменклатуры.ДобавитьРасход();
        Движение.Период = Документ.Дата;
        ЗаполнитьЗначенияСвойств(Движение, П, "Подразделение,Номенклатура,Свойство,Партия");
        Движение.Количество = Кол; Движение.Стоимость = Сумма;
        П.Количество = П.Количество - Кол; П.Стоимость = П.Стоимость - Сумма;
        Осталось = Осталось - Кол; Итог = Итог + Сумма;
        Если Осталось = 0 Тогда Прервать; КонецЕсли;
    КонецЦикла;
    Возврат Итог;
КонецФункции

Процедура ПроверитьОстатки(Документ, Требования) Экспорт
    Документ.Движения.ОстаткиНоменклатуры.БлокироватьДляИзменения = Истина;
    Документ.Движения.ОстаткиНоменклатуры.Записать();
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура ИЗ
    |РегистрНакопления.ОстаткиНоменклатуры.Остатки(, Подразделение В (&Подразделения) И Номенклатура В (&Товары))
    |ГДЕ КоличествоОстаток < 0 ИЛИ СтоимостьОстаток < 0");
    Запрос.УстановитьПараметр("Подразделения", Требования.ВыгрузитьКолонку("Подразделение"));
    Запрос.УстановитьПараметр("Товары", Требования.ВыгрузитьКолонку("Номенклатура"));
    Если Не Запрос.Выполнить().Пустой() Тогда ВызватьИсключение "Документ нарушает остатки последующих документов"; КонецЕсли;
КонецПроцедуры

Процедура Приход(Документ) Экспорт
    Если Документ.СписокНоменклатуры.Количество() = 0 Тогда ВызватьИсключение "Добавьте товары в накладную"; КонецЕсли;
    Если Не ЗначениеЗаполнено(Документ.Склад) И Не ЗначениеЗаполнено(Документ.Подразделение) Тогда ВызватьИсключение "Укажите склад или подразделение"; КонецЕсли;
    Ключи = СтарыеКлючиОстатков(Документ);
    Для Каждого Стр Из Документ.СписокНоменклатуры Цикл
        Ключ = Ключи.Добавить(); Ключ.Номенклатура = Стр.Номенклатура; Ключ.Свойство = Стр.Свойство; Ключ.Подразделение = Документ.Подразделение;
    КонецЦикла;
    Товары = СтарыеТоварыБухгалтерии(Документ); ДобавитьКлючи(Товары, Документ.СписокНоменклатуры.Выгрузить());
    ЗаблокироватьОстатки("РегистрБухгалтерии.Управленческий", Товары, Истина);
    ЗаблокироватьОстатки("РегистрНакопления.ОстаткиНоменклатуры", Ключи);
    Документ.Движения.ОстаткиНоменклатуры.Очистить();
    Документ.Движения.Управленческий.Очистить();
    Документ.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Документ.Движения.Управленческий.Записывать = Истина;
    Для Каждого Стр Из Документ.СписокНоменклатуры Цикл
        Если Стр.Количество <= 0 Тогда ВызватьИсключение "Количество прихода должно быть положительным"; КонецЕсли;
        Сумма = ?(Стр.Сумма = 0, Окр(Стр.Количество * Стр.Цена, 2), Стр.Сумма);
        Если Сумма < 0 Тогда ВызватьИсключение "Сумма прихода не может быть отрицательной"; КонецЕсли;
        Если ЗначениеЗаполнено(Документ.Подразделение) Тогда
            Дв = Документ.Движения.ОстаткиНоменклатуры.ДобавитьПриход();
            Дв.Период = Документ.Дата; Дв.Подразделение = Документ.Подразделение;
            Дв.Номенклатура = Стр.Номенклатура; Дв.Свойство = Стр.Свойство;
            Дв.Партия = Документ.Ссылка; Дв.Количество = Стр.Количество; Дв.Стоимость = Сумма;
        КонецЕсли;
        Если ЗначениеЗаполнено(Документ.Склад) Тогда
            Дв = Документ.Движения.Управленческий.Добавить(); Дв.Период = Документ.Дата;
            Дв.СчетДт = ПланыСчетов.Управленческий.Товары; Дв.СчетКт = ПланыСчетов.Управленческий.Поставщики;
            Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.Номенклатура;
            Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Документ.Склад;
            Дв.КоличествоДт = Стр.Количество; Дв.Сумма = Сумма;
        КонецЕсли;
    КонецЦикла;
    ПроверитьОстаткиБухгалтерии(Документ, Товары);
    ПроверитьОстатки(Документ, Ключи);
КонецПроцедуры

Процедура ПродажаОперативная(Документ) Экспорт
    Требования = Потребность();
    Для Каждого Стр Из Документ.СписокНоменклатуры Цикл
        Подразделение = ?(ЗначениеЗаполнено(Стр.Подразделение), Стр.Подразделение, Документ.Подразделение);
        Если Не ЗначениеЗаполнено(Подразделение) Тогда Продолжить; КонецЕсли;
        Если Стр.Количество <= 0 Или Стр.Сумма < 0 Тогда ВызватьИсключение "Проверьте количество и сумму строки продажи"; КонецЕсли;
        Т = Требования.Добавить(); ЗаполнитьЗначенияСвойств(Т, Стр); Т.Подразделение = Подразделение;
        Т.Выручка = ?(Стр.Сумма = 0, Окр(Стр.Количество * Стр.Цена, 2), Стр.Сумма);
    КонецЦикла;
    Документ.Движения.Продажи.Очистить();
    Документ.Движения.Продажи.Записывать = Истина;
    Если Требования.Количество() = 0 Тогда
        Документ.Движения.ОстаткиНоменклатуры.Записывать = Истина; Документ.Движения.ОстаткиНоменклатуры.Очистить(); Возврат;
    КонецЕсли;
    Требования.Свернуть("Подразделение,Номенклатура,Свойство,Блок", "Количество,Выручка");
    Остатки = ОстаткиДеталей(Документ, Требования); Методы = Политики(Документ, Требования);
    Для Каждого Т Из Требования Цикл
        Себестоимость = СписатьДетали(Документ, Т, Остатки, Методы.Получить(Т.Подразделение));
        Дв = Документ.Движения.Продажи.Добавить(); Дв.Период = Документ.Дата;
        Дв.Номенклатура = Т.Номенклатура; Дв.Подразделение = Т.Подразделение; Дв.Количество = Т.Количество; Дв.Себестоимость = Себестоимость;
        Дв.Выручка = Т.Выручка;
    КонецЦикла;
    ПроверитьОстатки(Документ, Требования);
КонецПроцедуры

Процедура Сборка(Документ) Экспорт
    Если Не ЗначениеЗаполнено(Документ.ПодразделениеИсточник) Или Не ЗначениеЗаполнено(Документ.ПодразделениеПолучатель) Тогда ВызватьИсключение "Укажите оба подразделения"; КонецЕсли;
    Если Документ.Блоки.Количество() = 0 Тогда ВызватьИсключение "Укажите собираемые блоки"; КонецЕсли;
    СтарыеКлючи = СтарыеКлючиОстатков(Документ);
    Блоки = Документ.Блоки.Выгрузить(); Блоки.Свернуть("Номенклатура", "Количество");
    Запрос = Новый Запрос("ВЫБРАТЬ Блок, МАКСИМУМ(Период) КАК Период ПОМЕСТИТЬ Версии
    |ИЗ РегистрСведений.Спецификации ГДЕ Период <= &Дата И Блок В (&Блоки) СГРУППИРОВАТЬ ПО Блок;
    |ВЫБРАТЬ С.Блок, С.Деталь, С.Свойство, С.Количество ИЗ РегистрСведений.Спецификации КАК С
    |ВНУТРЕННЕЕ СОЕДИНЕНИЕ Версии КАК Вер ПО С.Блок = Вер.Блок И С.Период = Вер.Период ГДЕ С.Количество > 0");
    Запрос.УстановитьПараметр("Дата", Документ.Дата); Запрос.УстановитьПараметр("Блоки", Блоки.ВыгрузитьКолонку("Номенклатура"));
    Спецификация = Запрос.Выполнить().Выгрузить(); Требования = Потребность();
    Для Каждого Б Из Блоки Цикл
        Если Б.Количество <= 0 Тогда ВызватьИсключение "Количество блоков должно быть положительным"; КонецЕсли;
        Состав = Спецификация.НайтиСтроки(Новый Структура("Блок", Б.Номенклатура));
        Если Состав.Количество() = 0 Тогда ВызватьИсключение СтрШаблон("Нет спецификации для %1", Б.Номенклатура); КонецЕсли;
        Для Каждого С Из Состав Цикл
            Т = Требования.Добавить(); Т.Подразделение = Документ.ПодразделениеИсточник; Т.Номенклатура = С.Деталь;
            Т.Свойство = С.Свойство; Т.Количество = С.Количество * Б.Количество; Т.Блок = Б.Номенклатура;
        КонецЦикла;
    КонецЦикла;
    Для Каждого С Из Документ.ДополнительныеДетали Цикл
        Т = Требования.Добавить(); ЗаполнитьЗначенияСвойств(Т, С); Т.Подразделение = Документ.ПодразделениеИсточник;
    КонецЦикла;
    КлючиКонтроля = Требования.Скопировать();
    ДобавитьКлючи(КлючиКонтроля, СтарыеКлючи);
    Для Каждого Б Из Блоки Цикл Ключ = КлючиКонтроля.Добавить(); Ключ.Номенклатура = Б.Номенклатура; Ключ.Подразделение = Документ.ПодразделениеПолучатель; КонецЦикла;
    ЗаблокироватьОстатки("РегистрНакопления.ОстаткиНоменклатуры", КлючиКонтроля);
    Остатки = ОстаткиДеталей(Документ, Требования); Методы = Политики(Документ, Требования);
    Затраты = Новый Соответствие; Дополнительно = 0;
    Для Каждого Б Из Блоки Цикл Затраты.Вставить(Б.Номенклатура, 0); КонецЦикла;
    Для Каждого Т Из Требования Цикл
        Цена = СписатьДетали(Документ, Т, Остатки, Методы.Получить(Т.Подразделение));
        Если ЗначениеЗаполнено(Т.Блок) Тогда Затраты.Вставить(Т.Блок, Затраты.Получить(Т.Блок) + Цена);
        Иначе Дополнительно = Дополнительно + Цена; КонецЕсли;
    КонецЦикла;
    ОстатокДоп = Дополнительно; ВсегоБлоков = Блоки.Итог("Количество");
    Для Каждого Б Из Блоки Цикл
        Доля = ?(Блоки.Индекс(Б) = Блоки.Количество() - 1, ОстатокДоп, Окр(Дополнительно * Б.Количество / ВсегоБлоков, 2));
        ОстатокДоп = ОстатокДоп - Доля;
        Дв = Документ.Движения.ОстаткиНоменклатуры.ДобавитьПриход(); Дв.Период = Документ.Дата;
        Дв.Подразделение = Документ.ПодразделениеПолучатель; Дв.Номенклатура = Б.Номенклатура; Дв.Партия = Документ.Ссылка;
        Дв.Количество = Б.Количество; Дв.Стоимость = Затраты.Получить(Б.Номенклатура) + Доля;
    КонецЦикла;
    ПроверитьОстатки(Документ, КлючиКонтроля);
КонецПроцедуры
Процедура ПродажаБухгалтерская(Документ) Экспорт
    Документ.Движения.Управленческий.Записывать = Истина;
    Если Не ЗначениеЗаполнено(Документ.Склад) Тогда Документ.Движения.Управленческий.Очистить(); Возврат; КонецЕсли;
    СтрокиПродажи = Документ.СписокНоменклатуры.Выгрузить();
    Для Каждого Стр Из СтрокиПродажи Цикл
        Если Стр.Количество <= 0 Или Стр.Сумма < 0 Тогда ВызватьИсключение "Проверьте количество и сумму строки продажи"; КонецЕсли;
        Если Стр.Сумма = 0 Тогда Стр.Сумма = Окр(Стр.Количество * Стр.Цена, 2); КонецЕсли;
    КонецЦикла;
    СтрокиПродажи.Свернуть("Номенклатура", "Количество,Сумма");
    // Граф аналогов и артикулы читаются один раз, транзитивное замыкание строится в памяти.
    Запрос = Новый Запрос("ВЫБРАТЬ Номенклатура, Аналог ИЗ РегистрСведений.Аналоги");
    Связи = Запрос.Выполнить().Выгрузить();
    Запрос.Текст = "ВЫБРАТЬ Ссылка КАК Номенклатура, Артикул ИЗ Справочник.Номенклатура ГДЕ НЕ ЭтоГруппа УПОРЯДОЧИТЬ ПО Артикул, Ссылка";
    Номенклатура = Запрос.Выполнить().Выгрузить();
    ВсеТовары = Новый Массив; Группы = Новый Соответствие;
    Для Каждого Стр Из СтрокиПродажи Цикл
        Если Стр.Количество <= 0 Тогда ВызватьИсключение "Количество продажи должно быть положительным"; КонецЕсли;
        Если Группы.Получить(Стр.Номенклатура) <> Неопределено Тогда Продолжить; КонецЕсли;
        Доступные = Новый Массив; Доступные.Добавить(Стр.Номенклатура);
        Индекс = 0;
        Пока Индекс < Доступные.Количество() Цикл
            Узел = Доступные[Индекс];
            Для Каждого Связь Из Связи Цикл
                Если Связь.Номенклатура = Узел Тогда Сосед = Связь.Аналог;
                ИначеЕсли Связь.Аналог = Узел Тогда Сосед = Связь.Номенклатура;
                Иначе Продолжить; КонецЕсли;
                Если Доступные.Найти(Сосед) = Неопределено Тогда Доступные.Добавить(Сосед); КонецЕсли;
            КонецЦикла;
            Индекс = Индекс + 1;
        КонецЦикла;
        Порядок = Новый Массив; Порядок.Добавить(Стр.Номенклатура);
        Для Каждого Товар Из Номенклатура Цикл
            Если Товар.Номенклатура <> Стр.Номенклатура И Доступные.Найти(Товар.Номенклатура) <> Неопределено Тогда Порядок.Добавить(Товар.Номенклатура); КонецЕсли;
        КонецЦикла;
        Группы.Вставить(Стр.Номенклатура, Порядок);
        Для Каждого Товар Из Порядок Цикл Если ВсеТовары.Найти(Товар) = Неопределено Тогда ВсеТовары.Добавить(Товар); КонецЕсли; КонецЦикла;
    КонецЦикла;
    ДанныеБлокировки = Новый ТаблицаЗначений;
    ДанныеБлокировки.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Для Каждого Товар Из ВсеТовары Цикл ДанныеБлокировки.Добавить().Номенклатура = Товар; КонецЦикла;
    ЗаблокироватьОстатки("РегистрБухгалтерии.Управленческий", ДанныеБлокировки, Истина);
    Документ.Движения.Управленческий.Очистить(); Документ.Движения.Управленческий.Записать();
    Запрос.Текст = "ВЫБРАТЬ Субконто1 КАК Номенклатура, Субконто2 КАК Склад, КоличествоОстатокДт КАК Количество
    |ИЗ РегистрБухгалтерии.Управленческий.Остатки(&Момент, Счет = &Счет, &ВидыПолные, Субконто1 В (&Товары))";
    Запрос.УстановитьПараметр("Момент", Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая));
    Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары); Запрос.УстановитьПараметр("Товары", ВсеТовары);
    ВидыПолные = Новый Массив; ВидыПолные.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура); ВидыПолные.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склады);
    Запрос.УстановитьПараметр("ВидыПолные", ВидыПолные);
    Остатки = Запрос.Выполнить().Выгрузить();
    ВидыСтоимости = Новый Массив; ВидыСтоимости.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
    Запрос.УстановитьПараметр("ВидыСтоимости", ВидыСтоимости);
    Запрос.Текст = "ВЫБРАТЬ Субконто1 КАК Номенклатура, СуммаОстатокДт КАК Сумма ИЗ РегистрБухгалтерии.Управленческий.Остатки(&Момент, Счет = &Счет, &ВидыСтоимости, Субконто1 В (&Товары))";
    Стоимости = Запрос.Выполнить().Выгрузить();
    Для Каждого Стр Из СтрокиПродажи Цикл
        Осталось = Стр.Количество; РаспределеноПродажи = 0;
        Продажа = Стр.Сумма;
        Для Каждого Товар Из Группы.Получить(Стр.Номенклатура) Цикл
            СтрокиТовара = Остатки.НайтиСтроки(Новый Структура("Номенклатура", Товар));
            ОбщееКоличество = 0; ОбщаяСумма = 0; СкладскаяСтрока = Неопределено;
            Для Каждого Ост Из СтрокиТовара Цикл
                ОбщееКоличество = ОбщееКоличество + Ост.Количество; 
                Если Ост.Склад = Документ.Склад Тогда СкладскаяСтрока = Ост; КонецЕсли;
            КонецЦикла;
            Если СкладскаяСтрока = Неопределено Или СкладскаяСтрока.Количество <= 0 Тогда Продолжить; КонецЕсли;
            СтоимостьТовара = Стоимости.Найти(Товар, "Номенклатура");
            ОбщаяСумма = ?(СтоимостьТовара = Неопределено, 0, СтоимостьТовара.Сумма);
            Количество = Мин(Осталось, СкладскаяСтрока.Количество);
            Сумма = ?(Количество = ОбщееКоличество, ОбщаяСумма, Окр(ОбщаяСумма * Количество / ОбщееКоличество, 2));
            Дв = Документ.Движения.Управленческий.Добавить(); Дв.Период = Документ.Дата;
            Дв.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки; Дв.СчетКт = ПланыСчетов.Управленческий.Товары;
            Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.Номенклатура; Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Товар; Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Документ.Склад;
            Дв.КоличествоКт = Количество; Дв.Сумма = Сумма;
            Дв.ВыручкаПродажи = ?(Количество = Осталось, Продажа - РаспределеноПродажи, Окр(Продажа * Количество / Стр.Количество, 2));
            РаспределеноПродажи = РаспределеноПродажи + Дв.ВыручкаПродажи;
            СкладскаяСтрока.Количество = СкладскаяСтрока.Количество - Количество;
            Если СтоимостьТовара <> Неопределено Тогда СтоимостьТовара.Сумма = СтоимостьТовара.Сумма - Сумма; КонецЕсли;
            Осталось = Осталось - Количество;
            Если Осталось = 0 Тогда Прервать; КонецЕсли;
        КонецЦикла;
        Если Осталось > 0 Тогда ВызватьИсключение СтрШаблон("Не хватает товара %1 и его аналогов, дефицит %2", Стр.Номенклатура, Осталось); КонецЕсли;
        Дв = Документ.Движения.Управленческий.Добавить(); Дв.Период = Документ.Дата;
        Дв.СчетДт = ПланыСчетов.Управленческий.Покупатели; Дв.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки;
        Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.Номенклатура; Дв.Сумма = Продажа;
    КонецЦикла;
    Документ.Движения.Управленческий.БлокироватьДляИзменения = Истина;
    Документ.Движения.Управленческий.Записать();
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Субконто1 ИЗ
    |РегистрБухгалтерии.Управленческий.Остатки(, Счет = &Счет, &ВидыПолные, Субконто1 В (&Товары) И Субконто2 = &Склад)
    |ГДЕ КоличествоОстатокДт < 0";
    Запрос.УстановитьПараметр("Склад", Документ.Склад);
    Если Не Запрос.Выполнить().Пустой() Тогда ВызватьИсключение "Продажа нарушает остатки последующих документов"; КонецЕсли;
КонецПроцедуры

Процедура Операция(Документ) Экспорт
    Если Документ.Проводки.Количество() = 0 Тогда ВызватьИсключение "Введите проводки операции"; КонецЕсли;
    Документ.Движения.Управленческий.Очистить();
    Документ.Движения.Управленческий.Записывать = Истина;
    Для Каждого Стр Из Документ.Проводки Цикл
        Если Не ЗначениеЗаполнено(Стр.СчетДт) Или Не ЗначениеЗаполнено(Стр.СчетКт) Тогда ВызватьИсключение "Укажите корреспонденцию счетов"; КонецЕсли;
        Дв = Документ.Движения.Управленческий.Добавить();
        ЗаполнитьЗначенияСвойств(Дв, Стр, "СчетДт,СчетКт,КоличествоДт,КоличествоКт,Сумма"); Дв.Период = Документ.Дата;
        Если ЗначениеЗаполнено(Стр.НоменклатураДт) Тогда Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.НоменклатураДт; КонецЕсли;
        Если ЗначениеЗаполнено(Стр.НоменклатураКт) Тогда Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.НоменклатураКт; КонецЕсли;
        Если ЗначениеЗаполнено(Стр.СкладДт) Тогда Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Стр.СкладДт; КонецЕсли;
        Если ЗначениеЗаполнено(Стр.СкладКт) Тогда Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Стр.СкладКт; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция СтарыеКлючиОстатков(Документ) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Подразделение, Номенклатура, Свойство ИЗ РегистрНакопления.ОстаткиНоменклатуры ГДЕ Регистратор = &Документ");
    Запрос.УстановитьПараметр("Документ", Документ.Ссылка);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ДобавитьКлючи(Приемник, Источник) Экспорт
    Для Каждого Стр Из Источник Цикл ЗаполнитьЗначенияСвойств(Приемник.Добавить(), Стр); КонецЦикла;
КонецПроцедуры

Функция СтарыеТоварыБухгалтерии(Документ) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ СубконтоДт1 КАК Номенклатура ИЗ РегистрБухгалтерии.Управленческий.ДвиженияССубконто(, , Регистратор = &Документ И СчетДт = &Товары)
    |ОБЪЕДИНИТЬ ВЫБРАТЬ СубконтоКт1 ИЗ РегистрБухгалтерии.Управленческий.ДвиженияССубконто(, , Регистратор = &Документ И СчетКт = &Товары)");
    Запрос.УстановитьПараметр("Документ", Документ.Ссылка); Запрос.УстановитьПараметр("Товары", ПланыСчетов.Управленческий.Товары);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ПроверитьОстаткиБухгалтерии(Документ, Товары) Экспорт
    Если Товары.Количество() = 0 Тогда Возврат; КонецЕсли;
    ЗаблокироватьОстатки("РегистрБухгалтерии.Управленческий", Товары, Истина);
    Документ.Движения.Управленческий.БлокироватьДляИзменения = Истина;
    Документ.Движения.Управленческий.Записать();
    Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 Субконто1 ИЗ РегистрБухгалтерии.Управленческий.Остатки(, Счет = &Счет, , Субконто1 В (&Товары)) ГДЕ КоличествоОстатокДт < 0");
    Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары); Запрос.УстановитьПараметр("Товары", Товары.ВыгрузитьКолонку("Номенклатура"));
    Если Не Запрос.Выполнить().Пустой() Тогда ВызватьИсключение "Изменение нарушает складские остатки бухгалтерского учета"; КонецЕсли;
КонецПроцедуры

Процедура ОтменитьТоварныйДокумент(Документ, Оперативный = Истина, Бухгалтерский = Истина) Экспорт
    Если Бухгалтерский Тогда
        Товары = СтарыеТоварыБухгалтерии(Документ);
        Документ.Движения.Управленческий.Очистить();
        ПроверитьОстаткиБухгалтерии(Документ, Товары);
    КонецЕсли;
    Если Оперативный Тогда
        Ключи = СтарыеКлючиОстатков(Документ);
        ЗаблокироватьОстатки("РегистрНакопления.ОстаткиНоменклатуры", Ключи);
        Документ.Движения.ОстаткиНоменклатуры.Очистить();
        ПроверитьОстатки(Документ, Ключи);
    КонецЕсли;
КонецПроцедуры

