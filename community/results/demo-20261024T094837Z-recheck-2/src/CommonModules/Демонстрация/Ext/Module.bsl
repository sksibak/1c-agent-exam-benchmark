Функция Элемент(ИмяСправочника, Имя) Экспорт
    Менеджер=Справочники[ИмяСправочника]; Ссылка=Менеджер.НайтиПоНаименованию(Имя,Истина);
    Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка; КонецЕсли;
    Объект=Менеджер.СоздатьЭлемент(); Объект.Наименование=Имя; Объект.Записать(); Возврат Объект.Ссылка;
КонецФункции

Процедура Заполнить() Экспорт
    РасчетыЗарплаты.НастроитьВиды();
    Счет=ПланыСчетов.Управленческий.Товары.ПолучитьОбъект(); Счет.Количественный=Истина; Счет.Записать();
    Цех=Элемент("Подразделения","Демо: основной цех"); Салон=Элемент("Подразделения","Демо: торговый зал");
    Склад=Элемент("Склады","Демо: основной склад");
    Деталь=Элемент("Номенклатура","Демо: процессор"); Блок=Элемент("Номенклатура","Демо: системный блок");
    Товар=Элемент("Номенклатура","Демо: принтер"); Аналог=Элемент("Номенклатура","Демо: аналог принтера");
    Об=Товар.ПолучитьОбъект(); Об.Артикул="D002"; Об.Производитель="ASUS"; Об.Записать();
    Об=Аналог.ПолучитьОбъект(); Об.Артикул="D001"; Об.Производитель="PALIT"; Об.Записать();
    Об=Деталь.ПолучитьОбъект(); Об.Производитель="ASUS"; Об.Записать();
    Свойство=Элемент("Свойства","Демо: процессор 8 ядер"); Об=Свойство.ПолучитьОбъект(); Об.Номенклатура=Деталь; Об.Записать();
    ВидПроизводителя=ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Производитель",Истина);
    Если Не ЗначениеЗаполнено(ВидПроизводителя) Тогда
        Вид=ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); Вид.Наименование="Производитель"; Вид.ТипЗначения=Новый ОписаниеТипов("Строка"); Вид.Записать(); ВидПроизводителя=Вид.Ссылка;
    КонецЕсли;
    ЗначениеСвойства=РегистрыСведений.ЗначенияСвойств.СоздатьМенеджерЗаписи(); ЗначениеСвойства.Свойство=Свойство; ЗначениеСвойства.Характеристика=ВидПроизводителя; ЗначениеСвойства.Значение="ASUS"; ЗначениеСвойства.Записать();
    Запись=РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи(); Запись.Товар=Товар; Запись.Аналог=Аналог; Запись.Записать();
    Для Каждого Подр Из Новый Структура("Цех,Салон",Цех,Салон) Цикл
        Запись=РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи(); Запись.Период=Дата(2025,1,1);
        Запись.Подразделение=Подр.Значение; Запись.Метод=Перечисления.УчетнаяПолитика.ФИФО; Запись.Записать();
    КонецЦикла;
    Запись=РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи(); Запись.Период=Дата(2025,1,6);
    Запись.Блок=Блок; Запись.Номенклатура=Деталь; Запись.Свойство=Свойство; Запись.Количество=2; Запись.Записать();
    Д=Документы.ПриходнаяНакладная.СоздатьДокумент(); Д.Дата=Дата(2025,1,7,10,0,0); Д.Подразделение=Цех; Д.ОперативныйУчет=Истина;
    Стр=Д.СписокНоменклатуры.Добавить(); Стр.Номенклатура=Деталь; Стр.Свойство=Свойство; Стр.Количество=10; Стр.Цена=1000;
    Д.Записать(РежимЗаписиДокумента.Проведение);
    Д=Документы.Сборка.СоздатьДокумент(); Д.Дата=Дата(2025,1,8,10,0,0); Д.Источник=Цех; Д.Получатель=Салон;
    Стр=Д.Блоки.Добавить(); Стр.Номенклатура=Блок; Стр.Количество=2; Д.Записать(РежимЗаписиДокумента.Проведение);
    Д=Документы.РасходнаяНакладная.СоздатьДокумент(); Д.Дата=Дата(2025,1,9,10,0,0); Д.ОперативныйУчет=Истина;
    Стр=Д.СписокНоменклатуры.Добавить(); Стр.Номенклатура=Блок; Стр.Подразделение=Салон; Стр.Количество=1; Стр.Цена=3000; Д.Записать(РежимЗаписиДокумента.Проведение);
    Д=Документы.ПриходнаяНакладная.СоздатьДокумент(); Д.Дата=Дата(2025,1,10,10,0,0); Д.Склад=Склад;
    Стр=Д.СписокНоменклатуры.Добавить(); Стр.Номенклатура=Товар; Стр.Количество=1; Стр.Цена=100;
    Стр=Д.СписокНоменклатуры.Добавить(); Стр.Номенклатура=Аналог; Стр.Количество=4; Стр.Цена=100;
    Д.Записать(РежимЗаписиДокумента.Проведение);
    Д=Документы.РасходнаяНакладная.СоздатьДокумент(); Д.Дата=Дата(2025,1,11,10,0,0); Д.Склад=Склад;
    Стр=Д.СписокНоменклатуры.Добавить(); Стр.Номенклатура=Товар; Стр.Количество=3; Стр.Цена=150; Д.Записать(РежимЗаписиДокумента.Проведение);
    Д=Документы.Операция.СоздатьДокумент(); Д.Дата=Дата(2025,1,12,10,0,0); Стр=Д.Проводки.Добавить();
    Стр.СчетДт=ПланыСчетов.Управленческий.Касса; Стр.СчетКт=ПланыСчетов.Управленческий.Покупатели; Стр.Сумма=450; Д.Записать(РежимЗаписиДокумента.Проведение);
    Сотрудник=Элемент("ФизическиеЛица","Демо: Иванов, руководитель"); Рабочий=Элемент("ФизическиеЛица","Демо: Петров");
    Для Каждого Сотр Из Новый Структура("Руководитель,Рабочий",Сотрудник,Рабочий) Цикл
        Об=Сотр.Значение.ПолучитьОбъект(); Об.НачалоСтажа=Дата(2020,1,1); Об.Записать();
        Запись=РегистрыСведений.СведенияОСотрудниках.СоздатьМенеджерЗаписи(); Запись.Период=Дата(2025,1,1); Запись.Сотрудник=Сотр.Значение; Запись.Подразделение=Цех; Запись.Оклад=100; Запись.Записать();
    КонецЦикла;
    Набор=РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей(); Набор.Отбор.Подразделение.Установить(Цех);
    ДеньГрафика=Дата(2025,1,1);
    Пока ДеньГрафика<=Дата(2025,4,30) Цикл
        Запись=Набор.Добавить(); Запись.Подразделение=Цех; Запись.Дата=ДеньГрафика;
        Запись.Дни=?(ДеньНедели(ДеньГрафика)<=5,1,0); Запись.Значение=Запись.Дни*8; ДеньГрафика=ДеньГрафика+86400;
    КонецЦикла; Набор.Записать();
    Для Каждого Ступень Из Новый Структура("Ноль,Год,Три",0,1,3) Цикл
        Запись=РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Запись.Стаж=Ступень.Значение; Запись.Процент=?(Ступень.Значение=0,5,?(Ступень.Значение=1,10,15)); Запись.Записать();
    КонецЦикла;
    Для Мес=1 По 3 Цикл
        Д=Документы.НачислениеЗарплаты.СоздатьДокумент(); Д.Дата=КонецМесяца(Дата(2025,Мес,1));
        Для Каждого Сотр Из Новый Структура("Руководитель,Рабочий",Сотрудник,Рабочий) Цикл
            Стр=Д.ОсновныеНачисления.Добавить(); Стр.Сотрудник=Сотр.Значение; Стр.Подразделение=Цех; Стр.ВидРасчета=ПланыВидовРасчета.ОсновныеНачисления.Тариф;
            Стр.ДатаНачала=Дата(2025,Мес,1); Стр.ДатаОкончания=КонецМесяца(Стр.ДатаНачала);
        КонецЦикла; Д.Записать(РежимЗаписиДокумента.Проведение);
    КонецЦикла;
    Д=Документы.НачислениеЗарплаты.СоздатьДокумент(); Д.Дата=Дата(2025,4,30);
    Стр=Д.ОсновныеНачисления.Добавить(); Стр.Сотрудник=Сотрудник; Стр.Подразделение=Цех; Стр.ВидРасчета=ПланыВидовРасчета.ОсновныеНачисления.Премия; Стр.ДатаНачала=Дата(2025,4,1); Стр.ДатаОкончания=Дата(2025,4,30);
    Стр=Д.ОсновныеНачисления.Добавить(); Стр.Сотрудник=Рабочий; Стр.Подразделение=Цех; Стр.ВидРасчета=ПланыВидовРасчета.ОсновныеНачисления.Командировка; Стр.ДатаНачала=Дата(2025,4,7); Стр.ДатаОкончания=Дата(2025,4,11);
    Д.Записать(РежимЗаписиДокумента.Проведение);
    Вид=ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Регион",Истина);
    Если Не ЗначениеЗаполнено(Вид) Тогда Об=ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); Об.Наименование="Регион"; Об.ТипЗначения=Новый ОписаниеТипов("Строка"); Об.Записать(); Вид=Об.Ссылка; КонецЕсли;
    Об=Сотрудник.ПолучитьОбъект(); Об.ДополнительныеСведения.Очистить(); Об.ДополнительныеСведения.Добавить().ВидСведений=Вид; Об.Записать();
    Контрагент=Элемент("Контрагенты","Демо: завод Сатурн"); Об=Контрагент.ПолучитьОбъект(); Об.Менеджер=Сотрудник; Об.ДополнительныеСведения.Очистить(); Стр=Об.ДополнительныеСведения.Добавить(); Стр.ВидСведений=Вид; Стр.Значение="Новосибирск"; Об.Записать();
    ДополнитьСведенияМенеджера();
КонецПроцедуры


Процедура ДополнитьСведенияМенеджера() Экспорт
    Менеджер=Справочники.ФизическиеЛица.НайтиПоНаименованию("Демо: Иванов, руководитель",Истина).ПолучитьОбъект();
    Контрагент=Справочники.Контрагенты.НайтиПоНаименованию("Демо: завод Сатурн",Истина).ПолучитьОбъект();
    Валюта=Элемент("Валюты","Доллар США");
    Для Каждого Пара Из Новый Структура("Валюта,Срок","Валюта кредита","Срок кредита, дни") Цикл
        Вид=ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(Пара.Значение,Истина);
        Если Не ЗначениеЗаполнено(Вид) Тогда
            Об=ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); Об.Наименование=Пара.Значение;
            Об.ТипЗначения=Новый ОписаниеТипов(?(Пара.Ключ="Валюта","СправочникСсылка.Валюты","Число")); Об.Записать(); Вид=Об.Ссылка;
        КонецЕсли;
        Менеджер.ДополнительныеСведения.Добавить().ВидСведений=Вид;
        Стр=Контрагент.ДополнительныеСведения.Добавить(); Стр.ВидСведений=Вид; Стр.Значение=?(Пара.Ключ="Валюта",Валюта,10);
    КонецЦикла;
    Менеджер.Записать(); Контрагент.Записать();
КонецПроцедуры

