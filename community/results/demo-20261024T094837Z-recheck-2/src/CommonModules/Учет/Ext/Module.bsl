Процедура НастроитьСчета() Экспорт
    Счет=ПланыСчетов.Управленческий.Товары;
    Если Счет.ВидыСубконто.Количество()=0 Тогда
        Блокировать("ПланСчетов.Управленческий");
        Об=Счет.ПолучитьОбъект(); Об.Количественный=Истина;
        Вид=Об.ВидыСубконто.Добавить(); Вид.ВидСубконто=ПланыВидовХарактеристик.ВидыСубконто.Склады;
        Вид.Суммовой=Ложь; Вид.Количественный=Истина; Об.Записать();
    КонецЕсли;
КонецПроцедуры

Функция ЗапросТаблица(Текст, Параметры = Неопределено) Экспорт
    Запрос = Новый Запрос(Текст);
    Если Параметры <> Неопределено Тогда
        Для Каждого П Из Параметры Цикл
            Запрос.УстановитьПараметр(П.Ключ, П.Значение);
        КонецЦикла;
    КонецЕсли;
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура Блокировать(Имя) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить(Имя);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Функция СуммаСтроки(Строка) Экспорт
    Если Строка.Количество <= 0 Тогда
        ВызватьИсключение "Количество должно быть положительным";
    КонецЕсли;
    Если Строка.Сумма < 0 Или Строка.Цена < 0 Тогда
        ВызватьИсключение "Цена и сумма не могут быть отрицательными";
    КонецЕсли;
    Если Строка.Сумма = 0 Тогда
        Возврат Окр(Строка.Количество * Строка.Цена, 2);
    КонецЕсли;
    Возврат Строка.Сумма;
КонецФункции

Процедура Приход(Док, Отказ) Экспорт
    НастроитьСчета();
    Если Не Док.ОперативныйУчет И Не ЗначениеЗаполнено(Док.Подразделение) И Не ЗначениеЗаполнено(Док.Склад) Тогда ВызватьИсключение "Укажите склад или подразделение"; КонецЕсли;
    Блокировать("РегистрНакопления.ОстаткиНоменклатуры");
    Блокировать("РегистрБухгалтерии.Хозрасчетный");
    Док.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Док.Движения.Хозрасчетный.Записывать = Истина;
    Для Каждого Стр Из Док.СписокНоменклатуры Цикл
        Сумма = СуммаСтроки(Стр);
        Если Не ЗначениеЗаполнено(Стр.Номенклатура) Тогда ВызватьИсключение "Не указан товар"; КонецЕсли;
        Если Док.ОперативныйУчет Или ЗначениеЗаполнено(Док.Подразделение) Тогда
            Если Не ЗначениеЗаполнено(Док.Подразделение) Тогда ВызватьИсключение "Не указано подразделение"; КонецЕсли;
            Д = Док.Движения.ОстаткиНоменклатуры.Добавить();
            Д.Период = Док.Дата; Д.ВидДвижения = ВидДвиженияНакопления.Приход;
            Д.Подразделение = Док.Подразделение; Д.Номенклатура = Стр.Номенклатура;
            Д.Свойство = Стр.Свойство; Д.Партия = Док.Ссылка;
            Д.Количество = Стр.Количество; Д.Стоимость = Сумма;
        КонецЕсли;
        Если ЗначениеЗаполнено(Док.Склад) Тогда
            Д = Док.Движения.Хозрасчетный.Добавить(); Д.Период = Док.Дата;
            Д.СчетДт = ПланыСчетов.Управленческий.Товары; Д.СчетКт = ПланыСчетов.Управленческий.Поставщики;
            Д.НоменклатураДт = Стр.Номенклатура; Д.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Док.Склад;
            Д.КоличествоДт = Стр.Количество; Д.Сумма = Сумма;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ЗапасыОУ(Док, Товары, Подразделения) Экспорт
    Блокировать("РегистрНакопления.ОстаткиНоменклатуры");
    Док.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Док.Движения.ОстаткиНоменклатуры.Записать();
    П = Новый Структура("Граница,Товары,Подразделения", Новый Граница(Док.МоментВремени(), ВидГраницы.Исключая), Товары, Подразделения);
    Возврат ЗапросТаблица("ВЫБРАТЬ Подразделение, Номенклатура, Свойство, Партия, КоличествоОстаток КАК Количество, СтоимостьОстаток КАК Стоимость
    |ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Граница, Номенклатура В (&Товары) И Подразделение В (&Подразделения))
    |УПОРЯДОЧИТЬ ПО Партия.Дата, Партия", П);
КонецФункции

Функция СписатьОУ(Док, Запасы, Подразделение, Товар, Свойство, Количество, Метод) Экспорт
    Если Количество <= 0 Тогда ВызватьИсключение "Количество должно быть положительным"; КонецЕсли;
    Строки = Запасы.НайтиСтроки(Новый Структура("Подразделение,Номенклатура,Свойство", Подразделение, Товар, Свойство));
    ВсегоКоличество = 0; ВсегоСтоимость = 0;
    Для Каждого Стр Из Строки Цикл ВсегоКоличество = ВсегоКоличество + Стр.Количество; ВсегоСтоимость = ВсегоСтоимость + Стр.Стоимость; КонецЦикла;
    Если ВсегоКоличество < Количество Тогда ВызватьИсключение "Недостаточно " + Строка(Товар) + " в подразделении " + Строка(Подразделение); КонецЕсли;
    Стоимость = 0; Осталось = Количество;
    ЦелеваяСтоимость=?(Количество=ВсегоКоличество,ВсегоСтоимость,Окр(ВсегоСтоимость*Количество/ВсегоКоличество,2));
    Если Метод = Перечисления.УчетнаяПолитика.ЛИФО Тогда
        Обратные = Новый Массив;
        Индекс = Строки.Количество()-1;
        Пока Индекс >= 0 Цикл Обратные.Добавить(Строки[Индекс]); Индекс = Индекс-1; КонецЦикла;
        Строки = Обратные;
    КонецЕсли;
    Для Каждого Стр Из Строки Цикл
        Если Осталось <= 0 Или Стр.Количество <= 0 Тогда Продолжить; КонецЕсли;
        Если Метод = Перечисления.УчетнаяПолитика.Средняя Тогда
            Списать = Мин(Осталось, Окр(Количество * Стр.Количество / ВсегоКоличество, 3));
        Иначе
            Списать = Мин(Осталось, Стр.Количество);
        КонецЕсли;
        Если Списать = Стр.Количество Тогда Сумма = Стр.Стоимость; Иначе Сумма = Окр(Стр.Стоимость * Списать / Стр.Количество, 2); КонецЕсли;
        Если Списать = 0 Тогда Продолжить; КонецЕсли;
        Д = Док.Движения.ОстаткиНоменклатуры.Добавить();
        Д.Период = Док.Дата; Д.ВидДвижения = ВидДвиженияНакопления.Расход;
        Д.Подразделение = Подразделение; Д.Номенклатура = Товар; Д.Свойство = Свойство; Д.Партия = Стр.Партия;
        Д.Количество = Списать; Д.Стоимость = Сумма;
        Стр.Количество = Стр.Количество - Списать; Стр.Стоимость = Стр.Стоимость - Сумма;
        Стоимость = Стоимость + Сумма; Осталось = Осталось - Списать;
    КонецЦикла;
    // Остаток округления количества распределяется по ещё доступным партиям.
    Если Осталось > 0 Тогда
        Для Каждого Стр Из Строки Цикл
            Если Осталось <= 0 Тогда Прервать; КонецЕсли;
            Если Стр.Количество <= 0 Тогда Продолжить; КонецЕсли;
            Списать = Мин(Осталось, Стр.Количество);
            Сумма = ?(Списать = Стр.Количество, Стр.Стоимость, Окр(Стр.Стоимость * Списать / Стр.Количество,2));
            Д = Док.Движения.ОстаткиНоменклатуры.Добавить(); Д.Период = Док.Дата; Д.ВидДвижения = ВидДвиженияНакопления.Расход;
            Д.Подразделение = Подразделение; Д.Номенклатура = Товар; Д.Свойство = Свойство; Д.Партия = Стр.Партия; Д.Количество = Списать; Д.Стоимость = Сумма;
            Стр.Количество = Стр.Количество - Списать; Стр.Стоимость = Стр.Стоимость - Сумма;
            Стоимость = Стоимость + Сумма; Осталось = Осталось - Списать;
        КонецЦикла;
    КонецЕсли;
    Если Метод=Перечисления.УчетнаяПолитика.Средняя Тогда
        Разница=ЦелеваяСтоимость-Стоимость;
        Для Каждого Стр Из Строки Цикл
            Если Разница=0 Тогда Прервать; КонецЕсли;
            Если Стр.Количество<=0 Тогда Продолжить; КонецЕсли;
            Коррекция=?(Разница>0,Мин(Разница,Стр.Стоимость),Разница);
            Если Коррекция=0 Тогда Продолжить; КонецЕсли;
            // Копейки средней оценки относятся на непустую партию.
            // Количество партии сохраняется, её стоимость остаётся неотрицательной.
            Д=Док.Движения.ОстаткиНоменклатуры.Добавить(); Д.Период=Док.Дата; Д.ВидДвижения=ВидДвиженияНакопления.Расход;
            Д.Подразделение=Подразделение; Д.Номенклатура=Товар; Д.Свойство=Свойство; Д.Партия=Стр.Партия; Д.Стоимость=Коррекция;
            Стр.Стоимость=Стр.Стоимость-Коррекция; Стоимость=Стоимость+Коррекция; Разница=Разница-Коррекция;
        КонецЦикла;
        Если Разница<>0 Тогда ВызватьИсключение "Не удалось распределить округление средней стоимости"; КонецЕсли;
    КонецЕсли;
    Возврат Стоимость;
КонецФункции

Процедура ПродажаОУ(Док) Экспорт
    Товары = Док.СписокНоменклатуры.ВыгрузитьКолонку("Номенклатура");
    Подразделения = Док.СписокНоменклатуры.ВыгрузитьКолонку("Подразделение"); Подразделения.Добавить(Док.Подразделение);
    Запасы = ЗапасыОУ(Док, Товары, Подразделения);
    Политики = ЗапросТаблица("ВЫБРАТЬ Подразделение, Метод ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, Подразделение В (&Подразделения))", Новый Структура("Дата,Подразделения", Док.Дата, Подразделения));
    Док.Движения.ПродажиОУ.Записывать = Истина;
    Для Каждого Стр Из Док.СписокНоменклатуры Цикл
        Подр = ?(ЗначениеЗаполнено(Стр.Подразделение), Стр.Подразделение, Док.Подразделение);
        Если Не ЗначениеЗаполнено(Подр) Тогда ВызватьИсключение "Не указано подразделение строки"; КонецЕсли;
        Пол = Политики.Найти(Подр,"Подразделение");
        Если Пол = Неопределено Тогда ВызватьИсключение "Не задана учетная политика подразделения"; КонецЕсли;
        Сумма = СуммаСтроки(Стр);
        Себестоимость = СписатьОУ(Док, Запасы, Подр, Стр.Номенклатура, Стр.Свойство, Стр.Количество, Пол.Метод);
        Д = Док.Движения.ПродажиОУ.Добавить(); Д.Период = Док.Дата; Д.Номенклатура = Стр.Номенклатура; Д.Подразделение = Подр;
        Д.Количество = Стр.Количество; Д.Себестоимость = Себестоимость; Д.Выручка = Сумма;
    КонецЦикла;
КонецПроцедуры

Процедура Собрать(Док, Отказ) Экспорт
    Если Не ЗначениеЗаполнено(Док.Источник) Или Не ЗначениеЗаполнено(Док.Получатель) Тогда ВызватьИсключение "Укажите подразделения сборки"; КонецЕсли;
    Блокировать("РегистрСведений.Спецификации");
    Спецификации = ЗапросТаблица("ВЫБРАТЬ Блок, МАКСИМУМ(Период) КАК Период ПОМЕСТИТЬ Версии
    |ИЗ РегистрСведений.Спецификации ГДЕ Период <= &Дата И Блок В (&Блоки) СГРУППИРОВАТЬ ПО Блок;
    |ВЫБРАТЬ С.Блок, С.Номенклатура, С.Свойство, С.Количество
    |ИЗ РегистрСведений.Спецификации КАК С ВНУТРЕННЕЕ СОЕДИНЕНИЕ Версии КАК Версия ПО С.Блок=Версия.Блок И С.Период=Версия.Период", Новый Структура("Дата,Блоки", Док.Дата, Док.Блоки.ВыгрузитьКолонку("Номенклатура")));
    Товары = Спецификации.ВыгрузитьКолонку("Номенклатура");
    Для Каждого Стр Из Док.ДополнительныеДетали Цикл Товары.Добавить(Стр.Номенклатура); КонецЦикла;
    Подразделения = Новый Массив; Подразделения.Добавить(Док.Источник);
    Запасы = ЗапасыОУ(Док, Товары, Подразделения);
    ВсегоБлоков = Док.Блоки.Итог("Количество"); Если ВсегоБлоков <= 0 Тогда ВызватьИсключение "Не указаны собираемые блоки"; КонецЕсли;
    ДопСтоимость = 0;
    Для Каждого Стр Из Док.ДополнительныеДетали Цикл
        ДопСтоимость = ДопСтоимость + СписатьОУ(Док,Запасы,Док.Источник,Стр.Номенклатура,Стр.Свойство,Стр.Количество,Перечисления.УчетнаяПолитика.Средняя);
    КонецЦикла;
    ОстДоп = ДопСтоимость; ОстБлоков = ВсегоБлоков;
    Для Каждого Блок Из Док.Блоки Цикл
        Если Блок.Количество <= 0 Тогда ВызватьИсключение "Количество блоков должно быть положительным"; КонецЕсли;
        Детали = Спецификации.НайтиСтроки(Новый Структура("Блок",Блок.Номенклатура));
        Если Детали.Количество()=0 Тогда ВызватьИсключение "Нет актуальной спецификации " + Строка(Блок.Номенклатура); КонецЕсли;
        Стоимость = ?(Блок.Количество=ОстБлоков, ОстДоп, Окр(ДопСтоимость*Блок.Количество/ВсегоБлоков,2));
        ОстДоп = ОстДоп - Стоимость; ОстБлоков = ОстБлоков - Блок.Количество;
        Для Каждого Деталь Из Детали Цикл
            Стоимость = Стоимость + СписатьОУ(Док,Запасы,Док.Источник,Деталь.Номенклатура,Деталь.Свойство,Деталь.Количество*Блок.Количество,Перечисления.УчетнаяПолитика.Средняя);
        КонецЦикла;
        Д=Док.Движения.ОстаткиНоменклатуры.Добавить(); Д.Период=Док.Дата; Д.ВидДвижения=ВидДвиженияНакопления.Приход;
        Д.Подразделение=Док.Получатель; Д.Номенклатура=Блок.Номенклатура; Д.Партия=Док.Ссылка; Д.Количество=Блок.Количество; Д.Стоимость=Стоимость;
    КонецЦикла;
КонецПроцедуры

Функция ГруппаАналогов(Товар, Связи)
    Группа = Новый Массив; Группа.Добавить(Товар); Позиция=0;
    Пока Позиция < Группа.Количество() Цикл
        Текущий=Группа[Позиция];
        Для Каждого Связь Из Связи Цикл
            Если Связь.Товар=Текущий И Группа.Найти(Связь.Аналог)=Неопределено Тогда Группа.Добавить(Связь.Аналог); КонецЕсли;
            Если Связь.Аналог=Текущий И Группа.Найти(Связь.Товар)=Неопределено Тогда Группа.Добавить(Связь.Товар); КонецЕсли;
        КонецЦикла;
        Позиция=Позиция+1;
    КонецЦикла;
    Возврат Группа;
КонецФункции

Процедура ПродажаБУ(Док) Экспорт
    НастроитьСчета();
    Блокировать("РегистрБухгалтерии.Хозрасчетный");
    Блокировать("РегистрСведений.Аналоги");
    Док.Движения.Хозрасчетный.Записывать=Истина; Док.Движения.Хозрасчетный.Записать();
    Связи=ЗапросТаблица("ВЫБРАТЬ Товар, Аналог ИЗ РегистрСведений.Аналоги");
    ВсеТовары=Новый Массив; Группы=Новый Соответствие;
    Для Каждого Стр Из Док.СписокНоменклатуры Цикл
        Группа=ГруппаАналогов(Стр.Номенклатура,Связи); Группы.Вставить(Стр.Номенклатура,Группа);
        Для Каждого Т Из Группа Цикл Если ВсеТовары.Найти(Т)=Неопределено Тогда ВсеТовары.Добавить(Т); КонецЕсли; КонецЦикла;
    КонецЦикла;
    ВидыСубконто=Новый Массив; ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склады);
    П=Новый Структура("Граница,Счет,Товары,ВидыСубконто",Новый Граница(Док.МоментВремени(),ВидГраницы.Исключая),ПланыСчетов.Управленческий.Товары,ВсеТовары,ВидыСубконто);
    Стоимости=ЗапросТаблица("ВЫБРАТЬ Номенклатура,СуммаОстаток КАК Стоимость,КоличествоОстаток КАК Количество ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Граница,Счет=&Счет,,Номенклатура В (&Товары))",П);
    Запасы=ЗапросТаблица("ВЫБРАТЬ Номенклатура, Субконто1 КАК Склад, КоличествоОстаток КАК Количество
    |ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Граница, Счет = &Счет, &ВидыСубконто, Номенклатура В (&Товары))
    |УПОРЯДОЧИТЬ ПО Номенклатура.Артикул, Номенклатура",П);
    Для Каждого Стр Из Док.СписокНоменклатуры Цикл
        Продажа=СуммаСтроки(Стр); Осталось=Стр.Количество; ОстВыручка=Продажа;
        Группа=Группы[Стр.Номенклатура]; Кандидаты=Новый Массив;
        // Сначала запрошенный товар; затем аналоги в порядке артикула, заданном запросом.
        Для Каждого З Из Запасы Цикл Если З.Номенклатура=Стр.Номенклатура И З.Склад=Док.Склад Тогда Кандидаты.Добавить(З); КонецЕсли; КонецЦикла;
        Для Каждого З Из Запасы Цикл Если З.Номенклатура<>Стр.Номенклатура И З.Склад=Док.Склад И Группа.Найти(З.Номенклатура)<>Неопределено Тогда Кандидаты.Добавить(З); КонецЕсли; КонецЦикла;
        Для Каждого З Из Кандидаты Цикл
            Если Осталось<=0 Тогда Прервать; КонецЕсли; Если З.Количество<=0 Тогда Продолжить; КонецЕсли;
            Списать=Мин(Осталось,З.Количество); Ост=Стоимости.Найти(З.Номенклатура,"Номенклатура"); КолВсего=Ост.Количество; СумВсего=Ост.Стоимость;
            Себестоимость=?(Списать=КолВсего,СумВсего,Окр(СумВсего*Списать/КолВсего,2));
            Выручка=?(Списать=Осталось,ОстВыручка,Окр(Продажа*Списать/Стр.Количество,2));
            Д=Док.Движения.Хозрасчетный.Добавить(); Д.Период=Док.Дата;
            Д.СчетДт=ПланыСчетов.Управленческий.ПрибылиУбытки; Д.СчетКт=ПланыСчетов.Управленческий.Товары;
            Д.НоменклатураКт=З.Номенклатура; Д.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады]=Док.Склад; Д.КоличествоКт=Списать; Д.Сумма=Себестоимость;
            Д.ЗаказаннаяНоменклатура=Стр.Номенклатура; Д.Выручка=Выручка;
            З.Количество=З.Количество-Списать; Ост.Количество=Ост.Количество-Списать; Ост.Стоимость=Ост.Стоимость-Себестоимость;
            Осталось=Осталось-Списать; ОстВыручка=ОстВыручка-Выручка;
        КонецЦикла;
        Если Осталось>0 Тогда ВызватьИсключение "Недостаточно товара и аналогов: "+Строка(Стр.Номенклатура); КонецЕсли;
        Д=Док.Движения.Хозрасчетный.Добавить(); Д.Период=Док.Дата;
        Д.СчетДт=ПланыСчетов.Управленческий.Покупатели; Д.СчетКт=ПланыСчетов.Управленческий.ПрибылиУбытки; Д.Сумма=Продажа;
    КонецЦикла;
КонецПроцедуры



