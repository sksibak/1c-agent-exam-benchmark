Процедура НастроитьВиды() Экспорт
    Тариф=ПланыВидовРасчета.ОсновныеНачисления.Тариф;
    Премия=ПланыВидовРасчета.ОсновныеНачисления.Премия;
    Командировка=ПланыВидовРасчета.ОсновныеНачисления.Командировка;
    Для Каждого Вид Из Новый Структура("Тариф,Премия,Командировка",Тариф,Премия,Командировка) Цикл
        Об=Вид.Значение.ПолучитьОбъект(); Изменен=Ложь;
        Если Вид.Ключ<>"Командировка" И Об.ВытесняющиеВидыРасчета.Количество()=0 Тогда
            Об.ВытесняющиеВидыРасчета.Добавить().ВидРасчета=Командировка; Изменен=Истина;
        КонецЕсли;
        Если Вид.Ключ="Премия" И Об.БазовыеВидыРасчета.Количество()=0 Тогда
            Об.БазовыеВидыРасчета.Добавить().ВидРасчета=Тариф; Изменен=Истина;
        КонецЕсли;
        Если Вид.Ключ="Командировка" И Об.БазовыеВидыРасчета.Количество()=0 Тогда
            Об.БазовыеВидыРасчета.Добавить().ВидРасчета=Тариф;
            Об.БазовыеВидыРасчета.Добавить().ВидРасчета=Премия;
            Об.БазовыеВидыРасчета.Добавить().ВидРасчета=Командировка; Изменен=Истина;
        КонецЕсли;
        Если Изменен Тогда Об.Записать(); КонецЕсли;
    КонецЦикла;
КонецПроцедуры


Процедура Начислить(Док, Отказ) Экспорт
    Учет.Блокировать("РегистрРасчета.Начисления"); НастроитьВиды();
    Предыдущие=Учет.ЗапросТаблица("ВЫБРАТЬ Подразделение,ПериодДействияНачало КАК ДатаНачала,ПериодДействияКонец КАК ДатаОкончания ИЗ РегистрРасчета.Начисления ГДЕ Регистратор=&Док",Новый Структура("Док",Док.Ссылка));
    Набор=Док.Движения.Начисления; Набор.Очистить(); Набор.Записывать=Истина;
    Командировка=ПланыВидовРасчета.ОсновныеНачисления.Командировка;
    Премия=ПланыВидовРасчета.ОсновныеНачисления.Премия;
    Для Каждого Стр Из Док.ОсновныеНачисления Цикл
        Если Не ЗначениеЗаполнено(Стр.Сотрудник) Или Не ЗначениеЗаполнено(Стр.Подразделение) Или Не ЗначениеЗаполнено(Стр.ВидРасчета) Тогда ВызватьИсключение "Укажите сотрудника, подразделение и вид расчета"; КонецЕсли;
        Если Не ЗначениеЗаполнено(Стр.ДатаНачала) Или Стр.ДатаОкончания<Стр.ДатаНачала Тогда ВызватьИсключение "Неверный период начисления"; КонецЕсли;
        Если Стр.ВидРасчета<>Командировка И НачалоМесяца(Стр.ДатаНачала)<>НачалоМесяца(Стр.ДатаОкончания) Тогда ВызватьИсключение "Тариф и премия вводятся в пределах месяца"; КонецЕсли;
        Начало=НачалоДня(Стр.ДатаНачала);
        Пока Начало<=Стр.ДатаОкончания Цикл
            Д=Набор.Добавить(); Д.ПериодРегистрации=?(ЗначениеЗаполнено(Стр.ПериодРегистрации),НачалоМесяца(Стр.ПериодРегистрации),НачалоМесяца(Начало));
            Если Д.ПериодРегистрации<НачалоМесяца(Начало) Тогда Д.ПериодРегистрации=НачалоМесяца(Начало); КонецЕсли;
            Д.Сотрудник=Стр.Сотрудник; Д.Подразделение=Стр.Подразделение; Д.ВидРасчета=Стр.ВидРасчета;
            Д.ПериодДействияНачало=Начало; Д.ПериодДействияКонец=Мин(КонецМесяца(Начало),КонецДня(Стр.ДатаОкончания));
            Если Д.ВидРасчета=Премия Тогда Д.БазовыйПериодНачало=ДобавитьМесяц(НачалоМесяца(Начало),-1); Д.БазовыйПериодКонец=НачалоМесяца(Начало)-1; КонецЕсли;
            Если Д.ВидРасчета=Командировка Тогда Д.БазовыйПериодНачало=ДобавитьМесяц(НачалоМесяца(Стр.ДатаНачала),-3); Д.БазовыйПериодКонец=НачалоМесяца(Стр.ДатаНачала)-1; КонецЕсли;
            Начало=КонецМесяца(Начало)+1;
        КонецЦикла;
    КонецЦикла;
    Набор.Записать();
    // Дополнение платформы находит вытесняемые записи прошлых периодов.
    Дополнение=Набор.ПолучитьДополнение();
    ИсходныеГрафики=Учет.ЗапросТаблица("ВЫБРАТЬ Регистратор,НомерСтроки,ЗначениеПериодДействия КАК Норма ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор В (&Регистраторы))",Новый Структура("Регистраторы",Дополнение.ВыгрузитьКолонку("Регистратор")));
    Для Каждого Стр Из Дополнение Цикл
        Д=Набор.Добавить(); ЗаполнитьЗначенияСвойств(Д,Стр,,"НомерСтроки,Регистратор,ПериодДействия");
        Д.ПериодРегистрации=Стр.ПериодРегистрацииСторно;
        Д.ПериодДействияНачало=Стр.ПериодДействияНачалоСторно; Д.ПериодДействияКонец=Стр.ПериодДействияКонецСторно;
        Д.Сторно=Истина; Д.Результат=0; Д.Дни=0;
        ИсходныйГрафик=НайтиДанные(ИсходныеГрафики,Стр.Регистратор,Стр.НомерСтроки);
        Если ИсходныйГрафик<>Неопределено Тогда Д.НормаПремии=ИсходныйГрафик.Норма; КонецЕсли;
    КонецЦикла;
    Если Дополнение.Количество()>0 Тогда Набор.Записать(); КонецЕсли;
    ПересчитатьСвязанные(Док,Предыдущие);
    Набор.Записывать=Ложь;
КонецПроцедуры

Процедура ПересчитатьСвязанные(Док,Предыдущие=Неопределено) Экспорт
    Подразделения=Док.ОсновныеНачисления.ВыгрузитьКолонку("Подразделение");
    Если Предыдущие<>Неопределено Тогда Для Каждого Стар Из Предыдущие Цикл Подразделения.Добавить(Стар.Подразделение); КонецЦикла; КонецЕсли;
    Если Подразделения.Количество()=0 Тогда Возврат; КонецЕсли;
    Минимум=Дата(3999,1,1); Максимум=Дата(1,1,1);
    Для Каждого Стр Из Док.ОсновныеНачисления Цикл Минимум=Мин(Минимум,НачалоМесяца(Стр.ДатаНачала)); Максимум=Макс(Максимум,КонецМесяца(Стр.ДатаОкончания)); КонецЦикла;
    Если Предыдущие<>Неопределено Тогда Для Каждого Стар Из Предыдущие Цикл Минимум=Мин(Минимум,НачалоМесяца(Стар.ДатаНачала)); Максимум=Макс(Максимум,КонецМесяца(Стар.ДатаОкончания)); КонецЦикла; КонецЕсли;
    П=Новый Структура("Подразделения,Начало,Конец",Подразделения,Минимум,ДобавитьМесяц(Максимум,4));
    Регистраторы=Учет.ЗапросТаблица("ВЫБРАТЬ РАЗЛИЧНЫЕ Регистратор ИЗ РегистрРасчета.Начисления
    |ГДЕ Подразделение В (&Подразделения) И ПериодДействияНачало МЕЖДУ &Начало И &Конец",П).ВыгрузитьКолонку("Регистратор");
    Если Регистраторы.Количество()>0 Тогда ПересчитатьНаборы(Регистраторы); КонецЕсли;
КонецПроцедуры

Функция НайтиДанные(Таблица,Регистратор,НомерСтроки)
    Строки=Таблица.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки",Регистратор,НомерСтроки));
    Если Строки.Количество()=0 Тогда Возврат Неопределено; КонецЕсли;
    Возврат Строки[0];
КонецФункции

Процедура ПересчитатьНаборы(Регистраторы) Экспорт
    П=Новый Структура("Регистраторы",Регистраторы);
    Данные=Учет.ЗапросТаблица("ВЫБРАТЬ * ИЗ РегистрРасчета.Начисления ГДЕ Регистратор В (&Регистраторы) УПОРЯДОЧИТЬ ПО Регистратор,НомерСтроки",П);
    Графики=Учет.ЗапросТаблица("ВЫБРАТЬ Регистратор, НомерСтроки, ЗначениеФактическийПериодДействия КАК Часы, ДниФактическийПериодДействия КАК Дни, ЗначениеПериодДействия КАК Норма
    |ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор В (&Регистраторы))",П);
    П.Вставить("Сотрудники",Данные.ВыгрузитьКолонку("Сотрудник"));
    Ставки=Учет.ЗапросТаблица("ВЫБРАТЬ Период,Сотрудник,Подразделение,Оклад ИЗ РегистрСведений.СведенияОСотрудниках ГДЕ Сотрудник В (&Сотрудники) УПОРЯДОЧИТЬ ПО Период УБЫВ",П);
    Стажи=Учет.ЗапросТаблица("ВЫБРАТЬ Ссылка КАК Сотрудник,НачалоСтажа ИЗ Справочник.ФизическиеЛица ГДЕ Ссылка В (&Сотрудники)",П);
    Шкала=Учет.ЗапросТаблица("ВЫБРАТЬ Стаж,Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО Стаж УБЫВ");
    Наборы=Новый Соответствие;
    Для Каждого Регистратор Из Регистраторы Цикл
        Набор=РегистрыРасчета.Начисления.СоздатьНаборЗаписей(); Набор.Отбор.Регистратор.Установить(Регистратор);
        Таблица=Данные.Скопировать(Данные.НайтиСтроки(Новый Структура("Регистратор",Регистратор))); Набор.Загрузить(Таблица); Набор.Записать();
        Для Каждого Д Из Набор Цикл
            Г=НайтиДанные(Графики,Регистратор,Д.НомерСтроки); Если Г=Неопределено Тогда Продолжить; КонецЕсли;
            Знак=?(Д.Сторно,-1,1);
            Если Не Д.Сторно И Д.ВидРасчета=ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда Д.НормаПремии=Г.Норма; КонецЕсли;
            Если Д.ВидРасчета=ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
                Д.Ставка=0;
                Для Каждого С Из Ставки Цикл Если С.Сотрудник=Д.Сотрудник И С.Подразделение=Д.Подразделение И С.Период<=НачалоМесяца(Д.ПериодДействияНачало) Тогда Д.Ставка=С.Оклад; Прервать; КонецЕсли; КонецЦикла;
                Д.Результат=Знак*Окр(Д.Ставка*Г.Часы,2); Д.Дни=Знак*Г.Дни;
            КонецЕсли;
            Стаж=Стажи.Найти(Д.Сотрудник,"Сотрудник"); Д.Стаж=0; Д.Процент=0;
            Если Стаж<>Неопределено И ЗначениеЗаполнено(Стаж.НачалоСтажа) Тогда
                ДатаСтажа=НачалоМесяца(Д.ПериодДействияНачало);
                Месяцев=(Год(ДатаСтажа)-Год(Стаж.НачалоСтажа))*12+Месяц(ДатаСтажа)-Месяц(Стаж.НачалоСтажа);
                Если День(ДатаСтажа)<День(Стаж.НачалоСтажа) Тогда Месяцев=Месяцев-1; КонецЕсли;
                Д.Стаж=Макс(0,Месяцев/12);
            КонецЕсли;
            Для Каждого Ш Из Шкала Цикл Если Д.Стаж>=Ш.Стаж Тогда Д.Процент=Ш.Процент; Прервать; КонецЕсли; КонецЦикла;
        КонецЦикла;
        Набор.Записать(); Наборы.Вставить(Регистратор,Набор);
    КонецЦикла;
    Измерения=Новый Массив; Измерения.Добавить("Сотрудник"); Измерения.Добавить("Подразделение");
    Подразделения=Новый Массив; Подразделения.Добавить("Подразделение");
    П.Вставить("Измерения",Измерения); П.Вставить("Подразделения",Подразделения);
    База=ПолучитьБазу(П);
    БазаОтдела=Учет.ЗапросТаблица("ВЫБРАТЬ Регистратор,НомерСтроки,РезультатБаза КАК Сумма ИЗ РегистрРасчета.Начисления.БазаНачисления(&Подразделения,&Подразделения,,Регистратор В (&Регистраторы))",П);
    Для Каждого Пара Из Наборы Цикл
        Для Каждого Д Из Пара.Значение Цикл
            Если Д.ВидРасчета<>ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда Продолжить; КонецЕсли;
            Г=НайтиДанные(Графики,Пара.Ключ,Д.НомерСтроки); Если Г=Неопределено Тогда Продолжить; КонецЕсли;
            Б=НайтиДанные(База,Пара.Ключ,Д.НомерСтроки); О=НайтиДанные(БазаОтдела,Пара.Ключ,Д.НомерСтроки);
            Сумма=0; Если О<>Неопределено Тогда Сумма=О.Сумма; КонецЕсли; Если Б<>Неопределено Тогда Сумма=Сумма-Б.Сумма; КонецЕсли;
            Норма=?(Д.НормаПремии>0,Д.НормаПремии,Г.Норма);
            Д.Результат=0; Если Норма>0 Тогда Д.Результат=?(Д.Сторно,-1,1)*Окр(Сумма*Д.Процент/100*Г.Часы/Норма,2); КонецЕсли;
        КонецЦикла; Пара.Значение.Записать();
    КонецЦикла;

    // База читается одним пакетом. Изменения командировок внутри пакета
    // учитываются по хронологии без запросов в цикле.
    База=ПолучитьБазу(П);
    Командировки=Новый ТаблицаЗначений;
    Для Каждого Имя Из СтрРазделить("Регистратор,НомерСтроки,Начало,Запись",",") Цикл Командировки.Колонки.Добавить(Имя); КонецЦикла;
    Для Каждого Пара Из Наборы Цикл
        Для Каждого Д Из Пара.Значение Цикл
            Если Д.ВидРасчета=ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
                Стр=Командировки.Добавить(); Стр.Регистратор=Пара.Ключ; Стр.НомерСтроки=Д.НомерСтроки; Стр.Начало=Д.ПериодДействияНачало; Стр.Запись=Д;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Командировки.Сортировать("Начало,НомерСтроки"); Дельты=Новый Массив;
    Для Каждого Стр Из Командировки Цикл
        Д=Стр.Запись; Г=НайтиДанные(Графики,Стр.Регистратор,Д.НомерСтроки); Б=НайтиДанные(База,Стр.Регистратор,Д.НомерСтроки);
        СтарыйРезультат=Д.Результат; Сумма=0; Дни=0;
        Если Б<>Неопределено Тогда Сумма=Б.Сумма; Дни=Б.Дни; КонецЕсли;
        Для Каждого Дельта Из Дельты Цикл
            Если Дельта.Сотрудник=Д.Сотрудник И Дельта.Подразделение=Д.Подразделение И Дельта.Начало>=Д.БазовыйПериодНачало И Дельта.Начало<=Д.БазовыйПериодКонец Тогда Сумма=Сумма+Дельта.Сумма; КонецЕсли;
        КонецЦикла;
        Д.Результат=0;
        Если Г<>Неопределено И Дни>0 Тогда Д.Результат=?(Д.Сторно,-1,1)*Окр(Сумма/Дни*Г.Дни,2); КонецЕсли;
        Дельты.Добавить(Новый Структура("Сотрудник,Подразделение,Начало,Сумма",Д.Сотрудник,Д.Подразделение,Д.ПериодДействияНачало,Д.Результат-СтарыйРезультат));
    КонецЦикла;
    Для Каждого Пара Из Наборы Цикл Пара.Значение.Записать(); КонецЦикла;

КонецПроцедуры

Функция ПолучитьБазу(П)
    Возврат Учет.ЗапросТаблица("ВЫБРАТЬ Регистратор,НомерСтроки,РезультатБаза КАК Сумма,ДниБаза КАК Дни ИЗ РегистрРасчета.Начисления.БазаНачисления(&Измерения,&Измерения,,Регистратор В (&Регистраторы))",П);
КонецФункции


