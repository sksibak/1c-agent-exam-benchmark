&НаСервере
Функция ИмяПоля(Вид)
    Возврат "ДопСведение"+СтрЗаменить(Строка(Вид.УникальныйИдентификатор()),"-","");
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ПостроитьПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)
    СменитьМенеджера();
КонецПроцедуры

&НаСервере
Процедура СменитьМенеджера() Экспорт
    СохранитьПоляВФорме();
    ПостроитьПоля();
КонецПроцедуры

&НаСервере
Процедура СохранитьПоляВФорме()
    Для Каждого Стр Из Объект.ДополнительныеСведения Цикл
        Имя=ИмяПоля(Стр.ВидСведений);
        Если Элементы.Найти(Имя)<>Неопределено Тогда Стр.Значение=ЭтотОбъект[Имя]; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПостроитьПоля()
    Удалить=Новый Массив;
    Для Каждого Имя Из СтрРазделить(ИменаДопПолей,",",Ложь) Цикл
        Если Элементы.Найти(Имя)<>Неопределено Тогда Элементы.Удалить(Элементы[Имя]); КонецЕсли;
        Удалить.Добавить(Имя);
    КонецЦикла;
    Если Удалить.Количество()>0 Тогда ИзменитьРеквизиты(,Удалить); КонецЕсли;
    ИменаДопПолей="";
    Если Не ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат; КонецЕсли;
    Виды=Учет.ЗапросТаблица("ВЫБРАТЬ РАЗЛИЧНЫЕ ВидСведений ПОМЕСТИТЬ Виды ИЗ Справочник.ФизическиеЛица.ДополнительныеСведения ГДЕ Ссылка=&Менеджер;
    |ВЫБРАТЬ ВидСведений, ВидСведений.Наименование КАК Заголовок, ВидСведений.ТипЗначения КАК ТипЗначения ИЗ Виды",Новый Структура("Менеджер",Объект.Менеджер));
    Добавить=Новый Массив;
    Для Каждого Вид Из Виды Цикл Добавить.Добавить(Новый РеквизитФормы(ИмяПоля(Вид.ВидСведений),Вид.ТипЗначения,"",Вид.Заголовок)); КонецЦикла;
    Если Добавить.Количество()>0 Тогда ИзменитьРеквизиты(Добавить); КонецЕсли;
    Для Каждого Вид Из Виды Цикл
        Имя=ИмяПоля(Вид.ВидСведений); Поле=Элементы.Добавить(Имя,Тип("ПолеФормы")); Поле.Вид=ВидПоляФормы.ПолеВвода; Поле.ПутьКДанным=Имя; Поле.Заголовок=Вид.Заголовок;
        ИменаДопПолей=ИменаДопПолей+?(ПустаяСтрока(ИменаДопПолей),"",",")+Имя;
        Строки=Объект.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведений",Вид.ВидСведений));
        Если Строки.Количество()=0 Тогда Стр=Объект.ДополнительныеСведения.Добавить(); Стр.ВидСведений=Вид.ВидСведений; Иначе ЭтотОбъект[Имя]=Строки[0].Значение; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    Для Каждого Стр Из ТекущийОбъект.ДополнительныеСведения Цикл
        Имя=ИмяПоля(Стр.ВидСведений);
        Если Элементы.Найти(Имя)<>Неопределено Тогда Стр.Значение=ЭтотОбъект[Имя]; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

