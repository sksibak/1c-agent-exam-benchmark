
&НаСервере
Процедура ПриСозданииНаСервере(Отказ,СтандартнаяОбработка)
    Начало=НачалоМесяца(ТекущаяДата()); Конец=КонецМесяца(Начало);
КонецПроцедуры
&НаКлиенте
Процедура Сформировать(Команда)
    СформироватьНаСервере();
КонецПроцедуры
&НаСервере
Процедура Ячейка(Стр,Кол,Значение,Жирный=Ложь,Деньги=Ложь)
    Область=Результат.Область(Стр,Кол);
    Если Деньги Тогда Область.Текст=Формат(Значение,"ЧДЦ=2;ЧН=0"); Иначе Область.Текст=Строка(Значение); КонецЕсли;
    Если Жирный Тогда Область.Шрифт=Новый Шрифт(,,Истина); КонецЕсли;
КонецПроцедуры
&НаСервере
Процедура Шапка(Заголовок,Колонки)
    Результат.Очистить(); Ячейка(1,1,Заголовок,Истина);
    Ячейка(2,1,Формат(Начало,"ДФ=dd.MM.yyyy")+" — "+Формат(Конец,"ДФ=dd.MM.yyyy"));
    Индекс=0;
    Для Каждого Имя Из СтрРазделить(Колонки,",") Цикл Индекс=Индекс+1; Ячейка(4,Индекс,Имя,Истина); Результат.Область(4,Индекс).ШиринаКолонки=18; КонецЦикла;
    Результат.Область(4,1).ШиринаКолонки=35;
    Результат.АвтоМасштаб=Истина;
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере() Экспорт
    Если Не ЗначениеЗаполнено(Подразделение) Тогда ВызватьИсключение "Укажите подразделение"; КонецЕсли;
    Таблица=Отчеты.Ведомость.Сформировать(Начало,Конец,Подразделение);
    Шапка("Ведомость по подразделению «"+Строка(Подразделение)+"»","Производитель,Товар / свойство,Нач. остаток,Приход,Расход,Кон. остаток");
    Результат.Область(4,2).ШиринаКолонки=45;
    Номер=5; Производитель=Неопределено;
    Для Каждого Стр Из Таблица Цикл
        Если Производитель<>Стр.Производитель Тогда Производитель=Стр.Производитель; Ячейка(Номер,1,Производитель,Истина); Номер=Номер+1; КонецЕсли;
        Товар=Строка(Стр.Номенклатура); Если ЗначениеЗаполнено(Стр.Характеристика) Тогда Товар=Товар+" / "+Строка(Стр.Характеристика); КонецЕсли;
        Ячейка(Номер,2,Товар);
        Ячейка(Номер,3,Стр.НачальноеКоличество); Ячейка(Номер,4,Стр.ПриходКоличество); Ячейка(Номер,5,Стр.РасходКоличество); Ячейка(Номер,6,Стр.КонечноеКоличество); Номер=Номер+1;
        Ячейка(Номер,3,Стр.НачальныйОстаток,Ложь,Истина); Ячейка(Номер,4,Стр.Приход,Ложь,Истина); Ячейка(Номер,5,Стр.Расход,Ложь,Истина); Ячейка(Номер,6,Стр.КонечныйОстаток,Ложь,Истина); Номер=Номер+1;
    КонецЦикла;
    Ячейка(Номер,1,"ИТОГО",Истина);
    Ячейка(Номер,3,Таблица.Итог("НачальноеКоличество"),Истина); Ячейка(Номер,4,Таблица.Итог("ПриходКоличество"),Истина); Ячейка(Номер,5,Таблица.Итог("РасходКоличество"),Истина); Ячейка(Номер,6,Таблица.Итог("КонечноеКоличество"),Истина); Номер=Номер+1;
    Ячейка(Номер,3,Таблица.Итог("НачальныйОстаток"),Истина,Истина); Ячейка(Номер,4,Таблица.Итог("Приход"),Истина,Истина); Ячейка(Номер,5,Таблица.Итог("Расход"),Истина,Истина); Ячейка(Номер,6,Таблица.Итог("КонечныйОстаток"),Истина,Истина);
КонецПроцедуры
