
&НаСервере
Процедура ПриСозданииНаСервере(Отказ,СтандартнаяОбработка)
    Начало=НачалоМесяца(ТекущаяДата()); Конец=КонецМесяца(Начало);
КонецПроцедуры
&НаКлиенте
Процедура Сформировать(Команда)
    СформироватьНаСервере();
КонецПроцедуры
&НаСервере
Процедура Ячейка(Стр,Кол,Значение,Жирный=Ложь,Деньги=Ложь)
    Область=Результат.Область(Стр,Кол);
    Если Деньги Тогда Область.Текст=Формат(Значение,"ЧДЦ=2;ЧН=0"); Иначе Область.Текст=Строка(Значение); КонецЕсли;
    Если Жирный Тогда Область.Шрифт=Новый Шрифт(,,Истина); КонецЕсли;
КонецПроцедуры
&НаСервере
Процедура Шапка(Заголовок,Колонки)
    Результат.Очистить(); Ячейка(1,1,Заголовок,Истина);
    Ячейка(2,1,Формат(Начало,"ДФ=dd.MM.yyyy")+" — "+Формат(Конец,"ДФ=dd.MM.yyyy"));
    Индекс=0;
    Для Каждого Имя Из СтрРазделить(Колонки,",") Цикл Индекс=Индекс+1; Ячейка(4,Индекс,Имя,Истина); Результат.Область(4,Индекс).ШиринаКолонки=18; КонецЦикла;
    Результат.Область(4,1).ШиринаКолонки=35;
    Результат.АвтоМасштаб=Истина;
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере() Экспорт
    Таблица=Отчеты.ПродажиБУ.Сформировать(Начало,Конец);
    Шапка("Продажи товаров и их аналогов","Номенклатура,Продано,Количество,Себестоимость,Продажа,Прибыль");
    Результат.Область(4,2).ШиринаКолонки=35;
    Номер=5; Текущий=Неопределено;
    Для Каждого Стр Из Таблица Цикл
        Если Текущий<>Стр.Номенклатура Тогда
            Текущий=Стр.Номенклатура; Группа=Таблица.Скопировать(Таблица.НайтиСтроки(Новый Структура("Номенклатура",Текущий)));
            Ячейка(Номер,1,Текущий,Истина); Ячейка(Номер,3,Группа.Итог("Количество"),Истина);
            Ячейка(Номер,4,Группа.Итог("Себестоимость"),Истина,Истина); Ячейка(Номер,5,Группа.Итог("Выручка"),Истина,Истина); Ячейка(Номер,6,Группа.Итог("Прибыль"),Истина,Истина); Номер=Номер+1;
        КонецЕсли;
        Ячейка(Номер,2,Стр.Продано); Ячейка(Номер,3,Стр.Количество); Ячейка(Номер,4,Стр.Себестоимость,Ложь,Истина); Ячейка(Номер,5,Стр.Выручка,Ложь,Истина); Ячейка(Номер,6,Стр.Прибыль,Ложь,Истина); Номер=Номер+1;
    КонецЦикла;
    Ячейка(Номер,1,"ИТОГО",Истина); Ячейка(Номер,3,Таблица.Итог("Количество"),Истина); Ячейка(Номер,4,Таблица.Итог("Себестоимость"),Истина,Истина); Ячейка(Номер,5,Таблица.Итог("Выручка"),Истина,Истина); Ячейка(Номер,6,Таблица.Итог("Прибыль"),Истина,Истина);
КонецПроцедуры
