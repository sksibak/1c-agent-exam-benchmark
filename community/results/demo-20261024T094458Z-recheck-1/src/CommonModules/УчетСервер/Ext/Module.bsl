// Все чтения остатков выполняются пакетно после удаления старых движений
// и под исключительной управляемой блокировкой. Таблицы нужны для резервирования
// общих остатков между дублирующимися строками и пересекающимися аналогами.
Процедура Блокировать(ИмяРегистра) Экспорт
 Блокировка = Новый БлокировкаДанных;
 Элемент = Блокировка.Добавить(ИмяРегистра);
 Элемент.Режим = РежимБлокировкиДанных.Исключительный;
 Блокировка.Заблокировать();
КонецПроцедуры

Функция ЗапросТаблица(Текст, Параметры = Неопределено) Экспорт
 З = Новый Запрос(Текст);
 Если Параметры <> Неопределено Тогда
  Для Каждого П Из Параметры Цикл З.УстановитьПараметр(П.Ключ, П.Значение); КонецЦикла;
 КонецЕсли;
 Возврат З.Выполнить().Выгрузить();
КонецФункции

Функция ОстаткиОУ(Док) Экспорт
 Блокировать("РегистрНакопления.ОстаткиНоменклатуры");
 Док.Движения.ОстаткиНоменклатуры.Записывать = Истина;
 Док.Движения.ОстаткиНоменклатуры.Очистить();
 Док.Движения.ОстаткиНоменклатуры.Записать();
 Возврат ЗапросТаблица("ВЫБРАТЬ Подразделение, Номенклатура, Свойство, Партия,
 |КоличествоОстаток КАК Количество, СтоимостьОстаток КАК Стоимость
 |ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Момент, )
 |УПОРЯДОЧИТЬ ПО Партия.Дата, Партия", Новый Структура("Момент", Новый Граница(Док.МоментВремени(), ВидГраницы.Исключая)));
КонецФункции

Функция Политики(Дата) Экспорт
 Возврат ЗапросТаблица("ВЫБРАТЬ Подразделение, Метод ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, )", Новый Структура("Дата", Дата));
КонецФункции

Функция Метод(Политики, Подразделение)
 Строки = Политики.НайтиСтроки(Новый Структура("Подразделение", Подразделение));
 Если Строки.Количество() = 0 Тогда Возврат Перечисления.УчетнаяПолитика.Средняя; КонецЕсли;
 Если Не ЗначениеЗаполнено(Строки[0].Метод) Тогда Возврат Перечисления.УчетнаяПолитика.Средняя; КонецЕсли;
 Возврат Строки[0].Метод;
КонецФункции

Процедура ПриходОУ(Док, Подразделение, Товар, Свойство, Количество, Стоимость) Экспорт
 Д = Док.Движения.ОстаткиНоменклатуры.Добавить();
 Д.Период = Док.Дата; Д.ВидДвижения = ВидДвиженияНакопления.Приход;
 Д.Подразделение = Подразделение; Д.Номенклатура = Товар;
 Д.Свойство = Свойство; Д.Партия = Док.Ссылка;
 Д.Количество = Количество; Д.Стоимость = Стоимость;
КонецПроцедуры

Функция СписатьОУ(Док, Остатки, Политики, Подразделение, Товар, Свойство, Количество) Экспорт
 Если Количество <= 0 Тогда ВызватьИсключение "Количество должно быть положительным"; КонецЕсли;
 Отбор = Новый Структура("Подразделение,Номенклатура,Свойство", Подразделение, Товар, Свойство);
 Строки = Остатки.НайтиСтроки(Отбор); Всего = 0; Сумма = 0;
 Для Каждого С Из Строки Цикл Всего = Всего + С.Количество; Сумма = Сумма + С.Стоимость; КонецЦикла;
 Если Всего < Количество Тогда ВызватьИсключение "Недостаточно: " + Строка(Товар) + ", свойство " + Строка(Свойство) + ", подразделение " + Строка(Подразделение); КонецЕсли;
 Способ = Метод(Политики, Подразделение);
 Если Способ = Перечисления.УчетнаяПолитика.Средняя Тогда
  Возврат СписатьСреднюю(Док,Строки,Подразделение,Товар,Свойство,Количество,Всего,Сумма);
 КонецЕсли;
 Осталось = Количество; Себестоимость = 0;
 Для Инд = 0 По Строки.Количество()-1 Цикл
  Если Способ = Перечисления.УчетнаяПолитика.ЛИФО Тогда С = Строки[Строки.Количество()-1-Инд]; Иначе С = Строки[Инд]; КонецЕсли;
  Если С.Количество <= 0 Тогда Продолжить; КонецЕсли;
  К = Мин(С.Количество, Осталось);
  Если К = 0 Тогда Продолжить; КонецЕсли;
  Стоимость = ?(К = С.Количество, С.Стоимость, Окр(С.Стоимость * К / С.Количество, 2));
  Д = Док.Движения.ОстаткиНоменклатуры.Добавить();
  Д.Период = Док.Дата; Д.ВидДвижения = ВидДвиженияНакопления.Расход;
  Д.Подразделение = Подразделение; Д.Номенклатура = Товар; Д.Свойство = Свойство; Д.Партия = С.Партия;
  Д.Количество = К; Д.Стоимость = Стоимость;
  С.Количество = С.Количество - К; С.Стоимость = С.Стоимость - Стоимость;
  Осталось = Осталось - К; Себестоимость = Себестоимость + Стоимость;
  Если Осталось = 0 Тогда Прервать; КонецЕсли;
 КонецЦикла;
 Если Осталось > 0 Тогда ВызватьИсключение "Не удалось распределить списание по партиям"; КонецЕсли;
 Возврат Себестоимость;
КонецФункции

Процедура ПодготовитьБУ(Док) Экспорт
 НастроитьСчета();
 Блокировать("РегистрБухгалтерии.Хозрасчетный");
 Док.Движения.Хозрасчетный.Записывать = Истина;
 Док.Движения.Хозрасчетный.Очистить(); Док.Движения.Хозрасчетный.Записать();
КонецПроцедуры

Процедура ПриходБУ(Док) Экспорт
 ПодготовитьБУ(Док);
 Для Каждого С Из Док.СписокНоменклатуры Цикл
  Д = Док.Движения.Хозрасчетный.Добавить(); Д.Период = Док.Дата;
  Д.СчетДт = ПланыСчетов.Управленческий.Товары; Д.СчетКт = ПланыСчетов.Управленческий.Поставщики;
  Д.НоменклатураДт = С.Номенклатура; Д.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Док.Склад;
  Д.КоличествоДт = С.Количество; Д.Сумма = С.Сумма;
 КонецЦикла;
КонецПроцедуры

Процедура ПродажаБУ(Док) Экспорт
 ПодготовитьБУ(Док);
 П = Новый Структура("Момент,Товары", Новый Граница(Док.МоментВремени(), ВидГраницы.Исключая), ПланыСчетов.Управленческий.Товары);
 Виды = Новый Массив; Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склады); П.Вставить("Виды",Виды);
 Остатки = ЗапросТаблица("ВЫБРАТЬ Номенклатура, Субконто1 КАК Склад, КоличествоОстаток КАК Количество
 |ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Момент, Счет = &Товары, &Виды, )", П);
 Общие = ЗапросТаблица("ВЫБРАТЬ Номенклатура, КоличествоОстаток КАК Количество, СуммаОстаток КАК Сумма
 |ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Момент, Счет = &Товары, , )",П);
 Связи = ЗапросТаблица("ВЫБРАТЬ Товар, Аналог ИЗ РегистрСведений.Аналоги");
 Артикулы = ЗапросТаблица("ВЫБРАТЬ Ссылка КАК Номенклатура, Артикул ИЗ Справочник.Номенклатура УПОРЯДОЧИТЬ ПО Артикул, Ссылка");
 Для Каждого С Из Док.СписокНоменклатуры Цикл
  Группа = Новый Массив; Группа.Добавить(С.Номенклатура); Инд = 0;
  Пока Инд < Группа.Количество() Цикл
   Для Каждого Связь Из Связи Цикл
    Кандидат = Неопределено;
    Если Связь.Товар = Группа[Инд] Тогда Кандидат = Связь.Аналог;
    ИначеЕсли Связь.Аналог = Группа[Инд] Тогда Кандидат = Связь.Товар; КонецЕсли;
    Если Кандидат <> Неопределено И Группа.Найти(Кандидат) = Неопределено Тогда Группа.Добавить(Кандидат); КонецЕсли;
   КонецЦикла; Инд = Инд + 1;
  КонецЦикла;
  Порядок = Новый Массив; Порядок.Добавить(С.Номенклатура);
  Для Каждого А Из Артикулы Цикл
   Если А.Номенклатура <> С.Номенклатура И Группа.Найти(А.Номенклатура) <> Неопределено Тогда Порядок.Добавить(А.Номенклатура); КонецЕсли;
  КонецЦикла;
  Осталось = С.Количество; ВыручкаОст = С.Сумма;
  Для Каждого Товар Из Порядок Цикл
   Найдено = Остатки.НайтиСтроки(Новый Структура("Номенклатура,Склад", Товар, Док.Склад));
   Если Найдено.Количество() = 0 Тогда Продолжить; КонецЕсли;
   О = Найдено[0]; К = Мин(О.Количество, Осталось);
   Если К <= 0 Тогда Продолжить; КонецЕсли;
   Общ = Общие.Найти(Товар, "Номенклатура");
   Если Общ.Количество <= 0 Тогда ВызватьИсключение "Некорректные остатки бухгалтерского учета"; КонецЕсли;
   Стоимость = ?(К = Общ.Количество, Общ.Сумма, Окр(Общ.Сумма * К / Общ.Количество, 2));
   Выручка = ?(К = Осталось, ВыручкаОст, Окр(С.Сумма * К / С.Количество, 2));
   Д = Док.Движения.Хозрасчетный.Добавить(); Д.Период = Док.Дата;
   Д.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки; Д.СчетКт = ПланыСчетов.Управленческий.Товары;
   Д.НоменклатураКт = Товар; Д.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Док.Склад; Д.КоличествоКт = К; Д.Сумма = Стоимость; Д.Заказано = С.Номенклатура; Д.ФактическиПродано = Товар;
   Д = Док.Движения.Хозрасчетный.Добавить(); Д.Период = Док.Дата;
   Д.СчетДт = ПланыСчетов.Управленческий.Покупатели; Д.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки;
   Д.Сумма = Выручка; Д.Заказано = С.Номенклатура; Д.ФактическиПродано = Товар;
   О.Количество = О.Количество - К; Общ.Количество = Общ.Количество - К; Общ.Сумма = Общ.Сумма - Стоимость;
   Осталось = Осталось - К; ВыручкаОст = ВыручкаОст - Выручка;
   Если Осталось = 0 Тогда Прервать; КонецЕсли;
  КонецЦикла;
  Если Осталось > 0 Тогда ВызватьИсключение "Недостаточно товара и аналогов: " + Строка(С.Номенклатура); КонецЕсли;
 КонецЦикла;
КонецПроцедуры

Процедура НастроитьВидыРасчета() Экспорт
 Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
 Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия;
 Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка;

 О = Тариф.ПолучитьОбъект();
 Если О.ВытесняющиеВидыРасчета.Найти(Командировка,"ВидРасчета") = Неопределено Тогда
  С = О.ВытесняющиеВидыРасчета.Добавить(); С.ВидРасчета = Командировка; О.Записать();
 КонецЕсли;
 О = Премия.ПолучитьОбъект(); Изменен = Ложь;
 Если О.ВытесняющиеВидыРасчета.Найти(Командировка,"ВидРасчета") = Неопределено Тогда
  С = О.ВытесняющиеВидыРасчета.Добавить(); С.ВидРасчета = Командировка; Изменен = Истина;
 КонецЕсли;
 Если О.БазовыеВидыРасчета.Найти(Тариф,"ВидРасчета") = Неопределено Тогда
  С = О.БазовыеВидыРасчета.Добавить(); С.ВидРасчета = Тариф; Изменен = Истина;
 КонецЕсли;
 Если Изменен Тогда О.Записать(); КонецЕсли;
 О = Командировка.ПолучитьОбъект(); Изменен = Ложь;
 Для Каждого Имя Из СтрРазделить("Тариф,Премия,Командировка",",") Цикл
  Вид = ПланыВидовРасчета.ОсновныеНачисления[Имя];
  Если О.БазовыеВидыРасчета.Найти(Вид,"ВидРасчета") = Неопределено Тогда
   С = О.БазовыеВидыРасчета.Добавить(); С.ВидРасчета = Вид; Изменен = Истина;
  КонецЕсли;
 КонецЦикла;
 Если Изменен Тогда О.Записать(); КонецЕсли;
КонецПроцедуры

// Пересчет выполняется по сохраненным записям регистра, включая документы,
// затронутые поздним вводом командировки. Механизм перерасчетов не используется.
Процедура РассчитатьНачисления() Экспорт
 График = ЗапросТаблица("ВЫБРАТЬ Регистратор, НомерСтроки,
 |ЕСТЬNULL(ЗначениеФактическийПериодДействия,0) КАК Часы, ЕСТЬNULL(ДниФактическийПериодДействия,0) КАК Дни,
 |ЕСТЬNULL(ЗначениеПериодДействия,0) КАК Норма
 |ИЗ РегистрРасчета.Начисления.ДанныеГрафика( )");
 Ставки = ЗапросТаблица("ВЫБРАТЬ Период, Сотрудник, Ставка ИЗ РегистрСведений.ТарифныеСтавки УПОРЯДОЧИТЬ ПО Период УБЫВ");
 Шкала = ЗапросТаблица("ВЫБРАТЬ СтажОт, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО СтажОт УБЫВ");
 Сотрудники = ЗапросТаблица("ВЫБРАТЬ Ссылка КАК Сотрудник, НачалоСтажа ИЗ Справочник.ФизическиеЛица");
 ДанныеРегистра = ЗапросТаблица("ВЫБРАТЬ Регистратор, НомерСтроки, ПериодРегистрации, ВидРасчета,
 |ПериодДействияНачало, ПериодДействияКонец, БазовыйПериодНачало, БазовыйПериодКонец,
 |Сторно, Активность, Сотрудник, Подразделение, Ставка, Процент, Стаж, Результат, Дни, Часы
 |ИЗ РегистрРасчета.Начисления УПОРЯДОЧИТЬ ПО Регистратор, НомерСтроки");
 СписокДокументов = ДанныеРегистра.Скопировать(,"Регистратор"); СписокДокументов.Свернуть("Регистратор");
 Наборы = Новый Массив;
 Для Каждого Д Из СписокДокументов Цикл
  Н = РегистрыРасчета.Начисления.СоздатьНаборЗаписей(); Н.Отбор.Регистратор.Установить(Д.Регистратор); Н.Загрузить(ДанныеРегистра.Скопировать(Новый Структура("Регистратор",Д.Регистратор))); Н.Записать();
  Для Каждого С Из Н Цикл
   Строки = График.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки",Д.Регистратор,С.НомерСтроки));
   С.Часы = 0; С.Дни = 0;
   Для Каждого Г Из Строки Цикл С.Часы = С.Часы + Г.Часы; С.Дни = С.Дни + Г.Дни; КонецЦикла;
   Если С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
    С.Ставка = 0;
    Для Каждого Т Из Ставки Цикл
     Если Т.Сотрудник = С.Сотрудник И Т.Период <= НачалоМесяца(С.ПериодДействияНачало) Тогда С.Ставка = Т.Ставка; Прервать; КонецЕсли;
    КонецЦикла;
    С.Результат = Окр(С.Ставка * С.Часы,2);
   КонецЕсли;
   Если С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
    С.Стаж = 0; С.Процент = 0;
    Лицо = Сотрудники.Найти(С.Сотрудник,"Сотрудник");
    Если Лицо <> Неопределено И ЗначениеЗаполнено(Лицо.НачалоСтажа) Тогда
     Месяцев = (Год(С.ПериодДействияНачало)-Год(Лицо.НачалоСтажа))*12 + Месяц(С.ПериодДействияНачало)-Месяц(Лицо.НачалоСтажа);
     Если День(С.ПериодДействияНачало) < День(Лицо.НачалоСтажа) Тогда Месяцев = Месяцев - 1; КонецЕсли;
     С.Стаж = Макс(0,Месяцев/12);
    КонецЕсли;
    Для Каждого Ш Из Шкала Цикл Если С.Стаж >= Ш.СтажОт Тогда С.Процент = Ш.Процент; Прервать; КонецЕсли; КонецЦикла;
   КонецЕсли;
  КонецЦикла;
  Для Каждого С Из Н Цикл Если С.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда С.Дни = 0; КонецЕсли; КонецЦикла;
  Н.Записать(); Наборы.Добавить(Н);
 КонецЦикла;
 Измерения = Новый Массив; Измерения.Добавить("Подразделение"); Разрезы = Новый Массив; Разрезы.Добавить("Сотрудник");
 П = Новый Структура("Основные,Базовые,Разрезы",Измерения,Измерения,Разрезы);
 База = ЗапросТаблица("ВЫБРАТЬ Регистратор, НомерСтроки, СотрудникРазрез, ЕСТЬNULL(РезультатБаза,0) КАК РезультатБаза
 |ИЗ РегистрРасчета.Начисления.БазаНачисления(&Основные,&Базовые,&Разрезы, )",П);
 Для Каждого Н Из Наборы Цикл
  Для Каждого С Из Н Цикл
   Если С.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда Продолжить; КонецЕсли;
   Сумма = 0;
   Для Каждого Б Из База.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки",Н.Отбор.Регистратор.Значение,С.НомерСтроки)) Цикл
    Если Б.СотрудникРазрез <> С.Сотрудник Тогда Сумма = Сумма + Б.РезультатБаза; КонецЕсли;
   КонецЦикла;
   Норма = 0;
   Для Каждого Г Из График.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки",Н.Отбор.Регистратор.Значение,С.НомерСтроки)) Цикл Норма = Норма + Г.Норма; КонецЦикла;
   С.Результат = ?(Норма=0,0,Окр(Сумма * С.Процент / 100 * С.Часы / Норма,2));
  КонецЦикла;
  Н.Записать();
 КонецЦикла;
 // Командировки считаются по возрастанию месяцев. Результат более ранней
 // командировки входит в трехмесячную базу следующей, поэтому чтение базы
 // разделено по зависимым месяцам, а не по сотрудникам или строкам.
 Месяцы = Новый ТаблицаЗначений; Месяцы.Колонки.Добавить("Месяц",Новый ОписаниеТипов("Дата"));
 Для Каждого Н Из Наборы Цикл
  Для Каждого С Из Н Цикл
   Если С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
    Месяц = НачалоМесяца(С.ПериодДействияНачало);
    Если Месяцы.Найти(Месяц,"Месяц") = Неопределено Тогда М = Месяцы.Добавить(); М.Месяц = Месяц; КонецЕсли;
    С.Результат = 0;
   КонецЕсли;
  КонецЦикла; Н.Записать();
 КонецЦикла;
 Месяцы.Сортировать("Месяц");
 Измерения = Новый Массив; Измерения.Добавить("Сотрудник");
 Для Каждого М Из Месяцы Цикл
  П = Новый Структура("Основные,Базовые,Месяц",Измерения,Измерения,М.Месяц);
  База = ЗапросТаблица("ВЫБРАТЬ Регистратор, НомерСтроки, ЕСТЬNULL(РезультатБаза,0) КАК РезультатБаза, ЕСТЬNULL(ДниБаза,0) КАК ДниБаза
  |ИЗ РегистрРасчета.Начисления.БазаНачисления(&Основные,&Базовые, , ПериодДействия = &Месяц)",П);
  Для Каждого Н Из Наборы Цикл
   Изменен = Ложь;
   Для Каждого С Из Н Цикл
    Если С.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Или НачалоМесяца(С.ПериодДействияНачало) <> М.Месяц Тогда Продолжить; КонецЕсли;
    Сумма = 0; Дни = 0;
    Для Каждого Б Из База.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки",Н.Отбор.Регистратор.Значение,С.НомерСтроки)) Цикл Сумма = Сумма + Б.РезультатБаза; Дни = Дни + Б.ДниБаза; КонецЦикла;
    ДнейКомандировки = 0;
    Для Каждого Г Из График.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки",Н.Отбор.Регистратор.Значение,С.НомерСтроки)) Цикл ДнейКомандировки = ДнейКомандировки + Г.Дни; КонецЦикла;
    С.Результат = ?(Дни=0,0,Окр(Сумма / Дни * ДнейКомандировки,2)); Изменен = Истина;
   КонецЦикла;
   Если Изменен Тогда Н.Записать(); КонецЕсли;
  КонецЦикла;
 КонецЦикла;
КонецПроцедуры





Функция ПечатныйОтчет(Таблица, Вид, Начало, Конец, Подразделение = Неопределено) Экспорт
 Док = Новый ТабличныйДокумент; Док.ОтображатьСетку = Ложь;
 Заголовок = ?(Вид="ВедомостьПоПодразделению","Ведомость по подразделению «"+Строка(Подразделение)+"»",?(Вид="ПремииЗаМесяц","Премии за месяц","Продажи"));
 Док.Область(1,1).Текст = Заголовок;
 Док.Область(2,1).Текст = ?(Вид="ПремииЗаМесяц",Формат(Начало,"ДФ=MMMM yyyy"),"с "+Формат(Начало,"ДФ=dd.MM.yyyy")+" по "+Формат(Конец,"ДФ=dd.MM.yyyy"));
 Если Вид="ВедомостьПоПодразделению" Тогда
  Заголовки = СтрРазделить("Производитель,Товар / свойство,Нач. ост.,Приход,Расход,Кон. ост.",",");
 ИначеЕсли Вид="ПродажиАналогов" Тогда
  Заголовки = СтрРазделить("Номенклатура,Продано,Кол-во,Себест-сть,Продажа,Прибыль",",");
 ИначеЕсли Вид="ПродажиОперативные" Тогда
  Заголовки = СтрРазделить("Номенклатура,Кол-во,Себест-сть,Продажа,Прибыль",",");
 Иначе Заголовки = СтрРазделить("Сотрудник,Трудовой стаж,% премии,Сумма премии",","); КонецЕсли;
 Для Инд=0 По Заголовки.Количество()-1 Цикл Док.Область(4,Инд+1).Текст = Заголовки[Инд]; КонецЦикла;
 Док.Область(4,1,4,Заголовки.Количество()).ЦветФона = WebЦвета.СветлоСерый;
 Док.Область(1,1,2,Заголовки.Количество()).Шрифт = Новый Шрифт(,12,Истина);
 Док.Область(4,1,4,Заголовки.Количество()).Шрифт = Новый Шрифт(,,Истина);
 СтрокаВывода = 5;
 Если Вид="ВедомостьПоПодразделению" Тогда
  ТекПроизводитель = Неопределено;
  Для Каждого С Из Таблица Цикл
   Если ТекПроизводитель <> С.Производитель Тогда
    ТекПроизводитель = С.Производитель; Док.Область(СтрокаВывода,1).Текст = ТекПроизводитель;
    Док.Область(СтрокаВывода,1,СтрокаВывода,6).ЦветФона = WebЦвета.СветлоСерый; СтрокаВывода = СтрокаВывода + 1;
   КонецЕсли;
   Док.Область(СтрокаВывода,2).Текст = Строка(С.Номенклатура);
   Док.Область(СтрокаВывода+1,2).Текст = Строка(С.Характеристика);
   ЧисловаяЯчейка(Док, СтрокаВывода,3, С.НачКоличество); ЧисловаяЯчейка(Док, СтрокаВывода+1,3, С.НачОстаток);
   ЧисловаяЯчейка(Док, СтрокаВывода,4, С.ПриходКоличество); ЧисловаяЯчейка(Док, СтрокаВывода+1,4, С.Приход);
   ЧисловаяЯчейка(Док, СтрокаВывода,5, С.РасходКоличество); ЧисловаяЯчейка(Док, СтрокаВывода+1,5, С.Расход);
   ЧисловаяЯчейка(Док, СтрокаВывода,6, С.КонКоличество); ЧисловаяЯчейка(Док, СтрокаВывода+1,6, С.КонОстаток);
   Док.Область(СтрокаВывода+1,3,СтрокаВывода+1,6).Формат = "ЧДЦ=2";
   СтрокаВывода = СтрокаВывода + 2;
  КонецЦикла;
 ИначеЕсли Вид="ПродажиАналогов" Тогда
  Группы = Таблица.Скопировать(); Группы.Свернуть("Номенклатура","Количество,Себестоимость,Продажа,Прибыль");
  Для Каждого Г Из Группы Цикл
   Док.Область(СтрокаВывода,1).Текст = Строка(Г.Номенклатура);
   ЧисловаяЯчейка(Док, СтрокаВывода,3, Г.Количество); ЧисловаяЯчейка(Док, СтрокаВывода,4, Г.Себестоимость);
   ЧисловаяЯчейка(Док, СтрокаВывода,5, Г.Продажа); ЧисловаяЯчейка(Док, СтрокаВывода,6, Г.Прибыль);
   Док.Область(СтрокаВывода,1,СтрокаВывода,6).Шрифт = Новый Шрифт(,,Истина); СтрокаВывода = СтрокаВывода + 1;
   Для Каждого С Из Таблица.НайтиСтроки(Новый Структура("Номенклатура",Г.Номенклатура)) Цикл
    Док.Область(СтрокаВывода,2).Текст = Строка(С.Продано);
    ЧисловаяЯчейка(Док, СтрокаВывода,3, С.Количество); ЧисловаяЯчейка(Док, СтрокаВывода,4, С.Себестоимость);
    ЧисловаяЯчейка(Док, СтрокаВывода,5, С.Продажа); ЧисловаяЯчейка(Док, СтрокаВывода,6, С.Прибыль); СтрокаВывода = СтрокаВывода + 1;
   КонецЦикла;
  КонецЦикла;
 ИначеЕсли Вид="ПродажиОперативные" Тогда
  Для Каждого С Из Таблица Цикл
   Док.Область(СтрокаВывода,1).Текст = Строка(С.Номенклатура);
   ЧисловаяЯчейка(Док, СтрокаВывода,2, С.Количество); ЧисловаяЯчейка(Док, СтрокаВывода,3, С.Себестоимость);
   ЧисловаяЯчейка(Док, СтрокаВывода,4, С.Продажа); ЧисловаяЯчейка(Док, СтрокаВывода,5, С.Прибыль); СтрокаВывода = СтрокаВывода + 1;
  КонецЦикла;
 Иначе
  Для Каждого С Из Таблица Цикл
   Док.Область(СтрокаВывода,1).Текст = Строка(С.Сотрудник);
   Лет = Цел(С.Стаж); Месяцев = Окр((С.Стаж-Лет)*12,0);
   Док.Область(СтрокаВывода,2).Текст = Строка(Лет)+" лет "+Строка(Месяцев)+" мес.";
   ЧисловаяЯчейка(Док, СтрокаВывода,3, С.Процент); ЧисловаяЯчейка(Док, СтрокаВывода,4, С.СуммаПремии); СтрокаВывода = СтрокаВывода + 1;
  КонецЦикла;
  Док.Область(СтрокаВывода,1,СтрокаВывода,3).Объединить(); Док.Область(СтрокаВывода,1).Текст = "ИТОГО:";
  ЧисловаяЯчейка(Док, СтрокаВывода,4, Таблица.Итог("СуммаПремии"));
  Док.Область(СтрокаВывода,1,СтрокаВывода,4).Шрифт = Новый Шрифт(,,Истина);
 КонецЕсли;
 Для Инд=1 По Заголовки.Количество() Цикл Док.Область(,Инд,,Инд).ШиринаКолонки = ?(Инд<=2,30,16); КонецЦикла;
 Док.ФиксацияСверху = 4; Док.АвтоМасштаб = Истина;
 Возврат Док;
КонецФункции

Процедура ЧисловаяЯчейка(Док, Ряд, Колонка, Значение)
 Ячейка = Док.Область(Ряд, Колонка); Ячейка.СодержитЗначение = Истина; Ячейка.Значение = Значение;
КонецПроцедуры

Процедура НастроитьСчета() Экспорт
 Счет = ПланыСчетов.Управленческий.Товары.ПолучитьОбъект();
 Если Счет.КоличественныйУчет И Счет.ВидыСубконто.Количество() > 0 Тогда Возврат; КонецЕсли;
 Счет.КоличественныйУчет = Истина;
 Счет.ВидыСубконто.Очистить(); С = Счет.ВидыСубконто.Добавить(); С.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Склады;
 С.ТолькоОбороты = Ложь; С.Количественный = Истина; С.Суммовой = Ложь; Счет.Записать();
КонецПроцедуры

// При средней округление суммы выполняется один раз по всему списанию,
// затем распределяется по партиям. Это исключает потерю копеек на мелких партиях.
Функция СписатьСреднюю(Док, Строки, Подразделение, Товар, Свойство, Количество, Всего, Сумма)
 Распределение = Новый Массив; Осталось = Количество;
 Для Каждого С Из Строки Цикл
  Если С.Количество <= 0 Тогда Продолжить; КонецЕсли;
  К = Мин(С.Количество,Осталось,Окр(Количество*С.Количество/Всего,3));
  Р = Новый Структура("Остаток,Количество,Стоимость",С,К,0); Распределение.Добавить(Р); Осталось = Осталось-К;
 КонецЦикла;
 Для Каждого Р Из Распределение Цикл
  Если Осталось <= 0 Тогда Прервать; КонецЕсли;
  К = Мин(Осталось,Р.Остаток.Количество-Р.Количество); Р.Количество = Р.Количество+К; Осталось = Осталось-К;
 КонецЦикла;
 ЦелеваяСумма = ?(Количество=Всего,Сумма,Окр(Сумма*Количество/Всего,2)); Распределено = 0;
 Для Каждого Р Из Распределение Цикл
  Р.Стоимость = ?(Р.Количество=Р.Остаток.Количество,Р.Остаток.Стоимость,Мин(Р.Остаток.Стоимость,Окр(Р.Остаток.Стоимость*Количество/Всего,2)));
  Распределено = Распределено+Р.Стоимость;
 КонецЦикла;
 Разница = ЦелеваяСумма-Распределено;
 Для Каждого Р Из Распределение Цикл
  Если Разница=0 Тогда Прервать; КонецЕсли;
  Если Р.Количество=Р.Остаток.Количество Тогда Продолжить; КонецЕсли;
  Поправка = ?(Разница>0,Мин(Разница,Р.Остаток.Стоимость-Р.Стоимость),-Мин(-Разница,Р.Стоимость));
  Р.Стоимость = Р.Стоимость+Поправка; Разница = Разница-Поправка;
 КонецЦикла;
 Если Разница<>0 Или Осталось<>0 Тогда ВызватьИсключение "Недостаточная точность распределения средней себестоимости"; КонецЕсли;
 Для Каждого Р Из Распределение Цикл
  Если Р.Количество=0 И Р.Стоимость=0 Тогда Продолжить; КонецЕсли;
  Д = Док.Движения.ОстаткиНоменклатуры.Добавить(); Д.Период=Док.Дата; Д.ВидДвижения=ВидДвиженияНакопления.Расход;
  Д.Подразделение=Подразделение; Д.Номенклатура=Товар; Д.Свойство=Свойство; Д.Партия=Р.Остаток.Партия;
  Д.Количество=Р.Количество; Д.Стоимость=Р.Стоимость;
  Р.Остаток.Количество=Р.Остаток.Количество-Р.Количество; Р.Остаток.Стоимость=Р.Остаток.Стоимость-Р.Стоимость;
 КонецЦикла;
 Возврат ЦелеваяСумма;
КонецФункции
