&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
 ПостроитьПоля();
КонецПроцедуры
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
 ПостроитьПоля();
КонецПроцедуры
&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)
 ПостроитьПоля();
КонецПроцедуры
&НаСервере
Процедура ПостроитьПоля()
 Удаляемые = Новый Массив;
 Для Каждого Э Из Элементы Цикл
  Если ТипЗнч(Э) = Тип("ПолеФормы") И Лев(Э.Имя,8) = "Сведение" Тогда Удаляемые.Добавить(Э.Имя); КонецЕсли;
 КонецЦикла;
 Для Каждого Имя Из Удаляемые Цикл Элементы.Удалить(Элементы[Имя]); КонецЦикла;
 Если Удаляемые.Количество() > 0 Тогда ИзменитьРеквизиты(Новый Массив, Удаляемые); КонецЕсли;
 Если Не ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат; КонецЕсли;
 Виды = Объект.Менеджер.ДополнительныеСведения.Выгрузить();
 Добавляемые = Новый Массив; Номер = 0;
 Для Каждого С Из Виды Цикл
  Номер = Номер + 1;
  Если Не ЗначениеЗаполнено(С.ВидСведения) Тогда Продолжить; КонецЕсли;
  Имя = "Сведение" + Строка(Номер);
  Добавляемые.Добавить(Новый РеквизитФормы(Имя, С.ВидСведения.ТипЗначения, , Строка(С.ВидСведения)));
 КонецЦикла;
 ИзменитьРеквизиты(Добавляемые); Номер = 0;
 Для Каждого С Из Виды Цикл
  Номер = Номер + 1;
  Если Не ЗначениеЗаполнено(С.ВидСведения) Тогда Продолжить; КонецЕсли;
  Имя = "Сведение" + Строка(Номер);
  Поле = Элементы.Добавить(Имя, Тип("ПолеФормы")); Поле.Вид = ВидПоляФормы.ПолеВвода;
  Поле.ПутьКДанным = Имя; Поле.Заголовок = Строка(С.ВидСведения);
  Для Каждого Значение Из Объект.ДополнительныеСведения Цикл
   Если Значение.ВидСведения = С.ВидСведения Тогда ЭтотОбъект[Имя] = Значение.Значение; Прервать; КонецЕсли;
  КонецЦикла;
 КонецЦикла;
КонецПроцедуры
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
 Если Не ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат; КонецЕсли;
 Номер = 0;
 Для Каждого С Из Объект.Менеджер.ДополнительныеСведения Цикл
  Номер = Номер + 1; Имя = "Сведение" + Строка(Номер);
  Если Не ЗначениеЗаполнено(С.ВидСведения) Тогда Продолжить; КонецЕсли;
  Строки = ТекущийОбъект.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведения",С.ВидСведения));
  Если Строки.Количество() = 0 Тогда Д = ТекущийОбъект.ДополнительныеСведения.Добавить(); Д.ВидСведения = С.ВидСведения; Иначе Д = Строки[0]; КонецЕсли;
  Д.Значение = ЭтотОбъект[Имя];
 КонецЦикла;
КонецПроцедуры

