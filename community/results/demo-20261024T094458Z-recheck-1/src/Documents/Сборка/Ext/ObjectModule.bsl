Процедура ОбработкаПроведения(Отказ, РежимПроведения)
 Если Не ЗначениеЗаполнено(Источник) Или Не ЗначениеЗаполнено(Получатель) Тогда ВызватьИсключение "Заполните подразделения сборки"; КонецЕсли;
 Остатки = УчетСервер.ОстаткиОУ(ЭтотОбъект); Политики = УчетСервер.Политики(Дата);
 Спецификации = УчетСервер.ЗапросТаблица("ВЫБРАТЬ Блок, Деталь, Свойство, Количество ИЗ РегистрСведений.Спецификации.СрезПоследних(&Дата, )", Новый Структура("Дата", Дата));
 ВсегоБлоков = Блоки.Итог("Количество");
 Если ВсегоБлоков <= 0 Тогда ВызватьИсключение "Укажите собираемые блоки"; КонецЕсли;
 ДопСтоимость = 0;
 Для Каждого С Из ДополнительныеДетали Цикл
  ДопСтоимость = ДопСтоимость + УчетСервер.СписатьОУ(ЭтотОбъект, Остатки, Политики, Источник, С.Номенклатура, С.Свойство, С.Количество);
 КонецЦикла;
 Распределено = 0;
 Для Каждого С Из Блоки Цикл
  Если С.Количество <= 0 Тогда ВызватьИсключение "Количество блоков должно быть положительным"; КонецЕсли;
  Состав = Спецификации.НайтиСтроки(Новый Структура("Блок", С.Блок));
  Если Состав.Количество() = 0 Тогда ВызватьИсключение "Не задана спецификация: " + Строка(С.Блок); КонецЕсли;
  Стоимость = 0;
  Для Каждого Д Из Состав Цикл
   Если Д.Количество <= 0 Тогда Продолжить; КонецЕсли;
   Стоимость = Стоимость + УчетСервер.СписатьОУ(ЭтотОбъект, Остатки, Политики, Источник, Д.Деталь, Д.Свойство, Д.Количество * С.Количество);
  КонецЦикла;
  Доля = ?(С.НомерСтроки = Блоки.Количество(), ДопСтоимость - Распределено, Окр(ДопСтоимость * С.Количество / ВсегоБлоков, 2));
  Распределено = Распределено + Доля;
  УчетСервер.ПриходОУ(ЭтотОбъект, Получатель, С.Блок, Справочники.СвойстваНоменклатуры.ПустаяСсылка(), С.Количество, Стоимость + Доля);
 КонецЦикла;
КонецПроцедуры
