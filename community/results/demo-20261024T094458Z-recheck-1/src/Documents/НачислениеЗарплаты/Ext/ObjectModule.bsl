Процедура ОбработкаПроведения(Отказ, РежимПроведения)
 УчетСервер.НастроитьВидыРасчета();
 УчетСервер.Блокировать("РегистрРасчета.Начисления");
 Движения.Начисления.Записывать = Истина;
 Движения.Начисления.Очистить(); Движения.Начисления.Записать();
 // Равные строки дают одно начисление. Разные строки с пересечением
 // периодов одного вида расчета требуют исправления пользователем.
 СтрокиДокумента = ОсновныеНачисления.Выгрузить();
 СтрокиДокумента.Свернуть("Сотрудник,Подразделение,ВидРасчета,ДатаНачала,ДатаОкончания");
 Периоды = УчетСервер.ЗапросТаблица("ВЫБРАТЬ Сотрудник, Подразделение, ВидРасчета, ПериодДействияНачало КАК Начало, ПериодДействияКонец КАК Конец ИЗ РегистрРасчета.Начисления ГДЕ Активность");
 Для Каждого С Из СтрокиДокумента Цикл
  Если Не ЗначениеЗаполнено(С.Сотрудник) Или Не ЗначениеЗаполнено(С.Подразделение) Или Не ЗначениеЗаполнено(С.ВидРасчета) Тогда ВызватьИсключение "Заполните сотрудника, подразделение и вид расчета"; КонецЕсли;
  Если Не ЗначениеЗаполнено(С.ДатаНачала) Или Не ЗначениеЗаполнено(С.ДатаОкончания) Тогда ВызватьИсключение "Заполните период начисления"; КонецЕсли;
  Если С.ДатаОкончания < С.ДатаНачала Тогда ВызватьИсключение "Окончание раньше начала"; КонецЕсли;
  Командировка = С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
  Если Не Командировка И НачалоМесяца(С.ДатаНачала) <> НачалоМесяца(С.ДатаОкончания) Тогда ВызватьИсключение "Тариф и премия вводятся в пределах месяца"; КонецЕсли;
  Начало = НачалоДня(С.ДатаНачала);
  Пока Начало <= С.ДатаОкончания Цикл
   Конец = Мин(КонецМесяца(Начало),КонецДня(С.ДатаОкончания));
   Для Каждого П Из Периоды.НайтиСтроки(Новый Структура("Сотрудник,Подразделение,ВидРасчета",С.Сотрудник,С.Подразделение,С.ВидРасчета)) Цикл
    Если П.Начало <= Конец И П.Конец >= Начало Тогда ВызватьИсключение "Пересекаются периоды начисления сотрудника " + Строка(С.Сотрудник); КонецЕсли;
   КонецЦикла;
   П = Периоды.Добавить(); П.Сотрудник=С.Сотрудник; П.Подразделение=С.Подразделение; П.ВидРасчета=С.ВидРасчета; П.Начало=Начало; П.Конец=Конец;
   Д = Движения.Начисления.Добавить();
   Д.ПериодРегистрации = НачалоМесяца(Начало);
   Д.ВидРасчета = С.ВидРасчета; Д.Сотрудник = С.Сотрудник; Д.Подразделение = С.Подразделение;
   Д.ПериодДействияНачало = Начало; Д.ПериодДействияКонец = Конец;
   Если Командировка Тогда
    Д.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало),-3);
    Д.БазовыйПериодКонец = НачалоМесяца(Начало)-1;
   ИначеЕсли С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
    Д.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало),-1);
    Д.БазовыйПериодКонец = НачалоМесяца(Начало)-1;
   КонецЕсли;
   Начало = КонецМесяца(Начало)+1;
  КонецЦикла;
 КонецЦикла;
 Движения.Начисления.Записать();
 УчетСервер.РассчитатьНачисления();
 Движения.Начисления.Прочитать();
КонецПроцедуры
Процедура ОбработкаУдаленияПроведения(Отказ)
 УчетСервер.Блокировать("РегистрРасчета.Начисления");
 Движения.Начисления.Очистить(); Движения.Начисления.Записать();
 УчетСервер.РассчитатьНачисления();
КонецПроцедуры
