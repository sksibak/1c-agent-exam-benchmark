Процедура ЗаполнитьГрафик(ДатаНачала, ДатаОкончания, ВыходныеДни, Подразделение, ЧасовВДень = 8) Экспорт
 Если Не ЗначениеЗаполнено(Подразделение) Тогда ВызватьИсключение "Выберите подразделение"; КонецЕсли;
 Если ДатаОкончания < ДатаНачала Или ЧасовВДень <= 0 Тогда ВызватьИсключение "Проверьте период и часы в день"; КонецЕсли;
 Набор = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей();
 Набор.Отбор.Подразделение.Установить(Подразделение); Набор.Прочитать(); Таблица = Набор.Выгрузить();
 День = НачалоДня(ДатаНачала);
 Пока День <= ДатаОкончания Цикл
  С = Таблица.Найти(День,"Дата");
  Если С = Неопределено Тогда С = Таблица.Добавить(); С.Дата = День; С.Подразделение = Подразделение; КонецЕсли;
  С.Значение = ?(СтрНайти(ВыходныеДни,Строка(ДеньНедели(День)))>0,0,ЧасовВДень);
  С.Дни = ?(С.Значение>0,1,0); День = День + 86400;
 КонецЦикла;
 Набор.Загрузить(Таблица); Набор.Записать();
КонецПроцедуры
