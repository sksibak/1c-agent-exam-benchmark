    Запись = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи(); Запись.Период = Дата(2024,1,1);
    Запись.Подразделение = Цех; Запись.Метод = Перечисления.УчетнаяПолитика.ФИФО; Запись.Записать();
    Запись.Подразделение = Сборочный; Запись.Метод = Перечисления.УчетнаяПолитика.Средняя; Запись.Записать();
    Запись = РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи(); Запись.Период = Дата(2024,1,1);
