    Запись = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи(); Запись.Товар = Деталь; Запись.Аналог = Аналог; Запись.Записать();
    Приход = Документы.ПриходнаяНакладная.СоздатьДокумент(); Приход.Дата = Дата(2024,1,2,10,0,0); Приход.Склад = Склад; Приход.Подразделение = Цех;
    С = Приход.СписокНоменклатуры.Добавить(); С.Номенклатура = Деталь; С.Свойство = Свойство; С.Количество = 10; С.Цена = 100; С.Сумма = 1000;
    С = Приход.СписокНоменклатуры.Добавить(); С.Номенклатура = Аналог; С.Количество = 5; С.Цена = 120; С.Сумма = 600;
    Приход.Записать(РежимЗаписиДокумента.Проведение);
    Сборка = Документы.Сборка.СоздатьДокумент(); Сборка.Дата = Дата(2024,1,3,10,0,0); Сборка.Источник = Цех; Сборка.Получатель = Сборочный;
    С = Сборка.Блоки.Добавить(); С.Блок = Блок; С.Количество = 2;
    С = Сборка.Дополнительно.Добавить(); С.Деталь = Деталь; С.Свойство = Свойство; С.Количество = 1;
    Сборка.Записать(РежимЗаписиДокумента.Проведение);
    Продажа = Документы.РасходнаяНакладная.СоздатьДокумент(); Продажа.Дата = Дата(2024,1,4,10,0,0);
    С = Продажа.СписокНоменклатуры.Добавить(); С.Номенклатура = Блок; С.Подразделение = Сборочный; С.Количество = 1; С.Цена = 400; С.Сумма = 400;
    Продажа.Записать(РежимЗаписиДокумента.Проведение);
    Продажа = Документы.РасходнаяНакладная.СоздатьДокумент(); Продажа.Дата = Дата(2024,1,5,10,0,0); Продажа.Склад = Склад;
    С = Продажа.СписокНоменклатуры.Добавить(); С.Номенклатура = Деталь; С.Количество = 12; С.Цена = 200; С.Сумма = 2400;
    Продажа.Записать(РежимЗаписиДокумента.Проведение);
    Операция = Документы.Операция.СоздатьДокумент(); Операция.Дата = Дата(2024,1,6,10,0,0);
    С = Операция.Проводки.Добавить(); С.СчетДт = ПланыСчетов.Управленческий.Товары; С.СчетКт = ПланыСчетов.Управленческий.Поставщики;
    С.НоменклатураДт = Деталь; С.СкладДт = Склад; С.КоличествоДт = 2; С.Сумма = 220;
    Операция.Записать(РежимЗаписиДокумента.Проведение);
    ЗаполнитьПримерЗарплаты();
    ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию(); ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры


Процедура Начислить(Документ) Экспорт
    Блокировать("РегистрРасчета.Начисления");
    НастроитьВидыРасчета();
    Документ.Движения.Начисления.Записывать = Истина;
    Набор = Документ.Движения.Начисления;
    Набор.Очистить();
    УникальныеСтроки = Новый Соответствие;
    Для Каждого С Из Документ.ОсновныеНачисления Цикл
        Если С.ДатаНачала > С.ДатаОкончания Тогда ВызватьИсключение "Начало периода позже окончания"; КонецЕсли;
        Если Не ЗначениеЗаполнено(С.Сотрудник) Или Не ЗначениеЗаполнено(С.Подразделение) Тогда ВызватьИсключение "Укажите сотрудника и подразделение"; КонецЕсли;
        Если С.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка И НачалоМесяца(С.ДатаНачала) <> НачалоМесяца(С.ДатаОкончания) Тогда
            ВызватьИсключение "Тариф и премия вводятся только в пределах календарного месяца";
        КонецЕсли;
        КлючСтроки = Строка(С.Сотрудник.УникальныйИдентификатор()) + Строка(С.Подразделение.УникальныйИдентификатор()) + Строка(С.ВидРасчета.УникальныйИдентификатор()) + Формат(С.ДатаНачала, "ДФ=yyyyMMdd") + Формат(С.ДатаОкончания, "ДФ=yyyyMMdd");
        Если УникальныеСтроки.Получить(КлючСтроки) <> Неопределено Тогда Продолжить; КонецЕсли;
        УникальныеСтроки.Вставить(КлючСтроки, Истина);
        Начало = НачалоДня(С.ДатаНачала);
        Пока Начало <= С.ДатаОкончания Цикл
            Д = Набор.Добавить(); Д.Активность = Истина;
            Д.ПериодРегистрации = Макс(НачалоМесяца(Документ.Дата), НачалоМесяца(Начало));
            Д.ВидРасчета = С.ВидРасчета; Д.Сотрудник = С.Сотрудник; Д.Подразделение = С.Подразделение;
            Д.ПериодДействияНачало = Начало; Д.ПериодДействияКонец = Мин(КонецМесяца(Начало), КонецДня(С.ДатаОкончания));
            Если С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
                Д.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало), -1); Д.БазовыйПериодКонец = НачалоМесяца(Начало) - 1;
            ИначеЕсли С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
                Д.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(С.ДатаНачала), -3); Д.БазовыйПериодКонец = НачалоМесяца(С.ДатаНачала) - 1;
            КонецЕсли;
            Начало = НачалоМесяца(ДобавитьМесяц(Начало, 1));
        КонецЦикла;
    КонецЦикла;
    Набор.Записать();
    // Дополнение платформы определяет интервалы сторно при позднем вводе вытеснения.
    Дополнение = Набор.ПолучитьДополнение();
    Для Каждого Сторнируемая Из Дополнение Цикл
        Д = Набор.Добавить();
        ЗаполнитьЗначенияСвойств(Д, Сторнируемая, , "Регистратор,НомерСтроки,ПериодДействия");
        Д.ПериодРегистрации = Сторнируемая.ПериодРегистрацииСторно;
        Д.ПериодДействияНачало = Сторнируемая.ПериодДействияНачалоСторно;
        Д.ПериодДействияКонец = Сторнируемая.ПериодДействияКонецСторно;
        Д.Сторно = Истина; Д.Результат = 0; Д.Дни = 0;
    КонецЦикла;
    Если Дополнение.Количество() > 0 Тогда Набор.Записать(); КонецЕсли;
    РассчитатьНачисления();
    // Набор движений объекта обновляется после общего расчета, чтобы запись документа не затерла результаты.
    Набор.Прочитать();
КонецПроцедуры

Функция КлючЗаписи(Регистратор, НомерСтроки)
    Возврат Строка(Регистратор.УникальныйИдентификатор()) + ":" + Строка(НомерСтроки);
КонецФункции

Процедура ЗаписатьНаборы(Наборы)
    Для Каждого Н Из Наборы Цикл Н.Значение.Записать(); КонецЦикла;
КонецПроцедуры

Функция БазаРасчетов(Измерения, Виды, Строки, Наборы)
    // Период регистрации ведущей записи ограничивает доступную платформе базу.
    // Временные записанные строки премии позволяют получить актуальную базу для
    // старого периода, не изменяя периоды регистрации исторических начислений.
    Для Каждого Э Из Наборы Цикл НаборПроб = Э.Значение; Прервать; КонецЦикла;
    ИсходноеКоличество = НаборПроб.Количество(); МесяцБазы = Дата(1,1,1);
    Для Каждого С Из Строки Цикл МесяцБазы = Макс(МесяцБазы, С.ПериодРегистрации); КонецЦикла;
    Пробы = Новый Массив;
    Для Каждого С Из Строки Цикл
        Если Виды.Найти(С.ВидРасчета) = Неопределено Тогда Продолжить; КонецЕсли;
        Д = НаборПроб.Добавить(); Д.Активность = Истина;
        Д.ПериодРегистрации = МесяцБазы; Д.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия;
        Д.ПериодДействияНачало = С.ПериодДействияНачало; Д.ПериодДействияКонец = С.ПериодДействияКонец;
        Д.БазовыйПериодНачало = С.БазовыйПериодНачало; Д.БазовыйПериодКонец = С.БазовыйПериодКонец;
        Д.Сотрудник = С.Сотрудник; Д.Подразделение = С.Подразделение;
        Пробы.Добавить(Новый Структура("Индекс,Регистратор,НомерСтроки", НаборПроб.Количество() - 1, С.Регистратор, С.НомерСтроки));
    КонецЦикла;
    НаборПроб.Записать();
    Номера = Новый Массив; СоответствиеСтрок = Новый Соответствие;
    Для Каждого Проба Из Пробы Цикл
        Номер = НаборПроб[Проба.Индекс].НомерСтроки; Номера.Добавить(Номер); СоответствиеСтрок.Вставить(Номер, Проба);
    КонецЦикла;
    ДляКомандировки = Виды.Найти(ПланыВидовРасчета.ОсновныеНачисления.Командировка) <> Неопределено;
    Если ДляКомандировки Тогда
        Вид = ПланыВидовРасчета.ОсновныеНачисления.Премия.ПолучитьОбъект(); Вид.БазовыеВидыРасчета.Очистить();
        Вид.БазовыеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
        Вид.БазовыеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия;
        Вид.БазовыеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка; Вид.Записать();
    КонецЕсли;
    П = Новый Структура("Основные,Базовые,Регистратор,Номера", Измерения, Измерения, НаборПроб.Отбор.Регистратор.Значение, Номера);
    Результат = ЗапросТаблица("ВЫБРАТЬ Регистратор, НомерСтроки, РезультатБаза, ДниБаза
    | ИЗ РегистрРасчета.Начисления.БазаНачисления(&Основные, &Базовые, , Регистратор = &Регистратор И НомерСтроки В (&Номера))", П);
    Если ДляКомандировки Тогда
        Вид.БазовыеВидыРасчета.Очистить(); Вид.БазовыеВидыРасчета.Добавить().ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф; Вид.Записать();
    КонецЕсли;
    Для Каждого Р Из Результат Цикл
        Проба = СоответствиеСтрок.Получить(Р.НомерСтроки); Р.Регистратор = Проба.Регистратор; Р.НомерСтроки = Проба.НомерСтроки;
    КонецЦикла;
    Пока НаборПроб.Количество() > ИсходноеКоличество Цикл НаборПроб.Удалить(НаборПроб.Количество() - 1); КонецЦикла;
    НаборПроб.Записать();
    Возврат Результат;
КонецФункции

Процедура РассчитатьНачисления() Экспорт
    // Пересчитываем затронутые результаты из записанных регистров. Объектов перерасчета нет.
    Строки = ЗапросТаблица("ВЫБРАТЬ Регистратор, НомерСтроки, ПериодРегистрации, ВидРасчета,
    | ПериодДействияНачало, ПериодДействияКонец, БазовыйПериодНачало, БазовыйПериодКонец,
    | Активность, Сторно, Сотрудник, Подразделение, Результат, Дни, Стаж, Процент
    | ИЗ РегистрРасчета.Начисления УПОРЯДОЧИТЬ ПО Регистратор, НомерСтроки");
    Если Строки.Количество() = 0 Тогда Возврат; КонецЕсли;
    Наборы = Новый Соответствие; Записи = Новый Соответствие;
    Месяцы = Новый Массив;
    Для Каждого С Из Строки Цикл
        Набор = Наборы.Получить(С.Регистратор);
        Если Набор = Неопределено Тогда
            Набор = РегистрыРасчета.Начисления.СоздатьНаборЗаписей(); Набор.Отбор.Регистратор.Установить(С.Регистратор); Наборы.Вставить(С.Регистратор, Набор);
        КонецЕсли;
        Д = Набор.Добавить(); ЗаполнитьЗначенияСвойств(Д, С);
        Записи.Вставить(КлючЗаписи(С.Регистратор, С.НомерСтроки), Д);
        Месяц = НачалоМесяца(С.ПериодДействияНачало);
        Если Месяцы.Найти(Месяц) = Неопределено Тогда Месяцы.Добавить(Месяц); КонецЕсли;
    КонецЦикла;
    График = ЗапросТаблица("ВЫБРАТЬ Регистратор, НомерСтроки, ЧасыФактическийПериодДействия КАК Часы,
    | ДниФактическийПериодДействия КАК Дни, ЧасыПериодДействия КАК Норма
    | ИЗ РегистрРасчета.Начисления.ДанныеГрафика()");
    Графики = Новый Соответствие;
    Для Каждого С Из График Цикл Графики.Вставить(КлючЗаписи(С.Регистратор, С.НомерСтроки), С); КонецЦикла;
    Запрос = Новый Запрос; Текст = "";
    Для ИндексМесяца = 0 По Месяцы.Количество() - 1 Цикл
        Если ИндексМесяца > 0 Тогда Текст = Текст + Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС; КонецЕсли;
        Имя = "М" + Формат(ИндексМесяца, "ЧГ=0");
        Текст = Текст + "ВЫБРАТЬ &" + Имя + " КАК Месяц, Сотрудник, Подразделение, Ставка ИЗ РегистрСведений.ТарифныеСтавки.СрезПоследних(&" + Имя + ", )";
        Запрос.УстановитьПараметр(Имя, Месяцы[ИндексМесяца]);
    КонецЦикла;
    Запрос.Текст = Текст; Ставки = Запрос.Выполнить().Выгрузить();
    Шкала = ЗапросТаблица("ВЫБРАТЬ СтажОт, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО СтажОт");
    Сотрудники = ЗапросТаблица("ВЫБРАТЬ Ссылка, НачалоСтажа ИЗ Справочник.ФизическиеЛица");
    Для Каждого С Из Строки Цикл
        Ключ = КлючЗаписи(С.Регистратор, С.НомерСтроки); Д = Записи.Получить(Ключ); Г = Графики.Получить(Ключ);
        Если С.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда Продолжить; КонецЕсли;
        Ставка = Ставки.НайтиСтроки(Новый Структура("Месяц,Сотрудник,Подразделение", НачалоМесяца(С.ПериодДействияНачало), С.Сотрудник, С.Подразделение));
        Если Ставка.Количество() = 0 Тогда ВызватьИсключение "Нет тарифной ставки на начало месяца: " + Строка(С.Сотрудник); КонецЕсли;
        Д.Результат = Окр(Ставка[0].Ставка * МодульЧисла(Г.Часы), 2) * ?(С.Сторно, -1, 1); Д.Дни = МодульЧисла(Г.Дни) * ?(С.Сторно, -1, 1);
    КонецЦикла;
    ЗаписатьНаборы(Наборы);
    Виды = Новый Массив; Виды.Добавить(ПланыВидовРасчета.ОсновныеНачисления.Премия);
    Измерения = Новый Массив; Измерения.Добавить("Подразделение");
    ОбщаяБаза = БазаРасчетов(Измерения, Виды, Строки, Наборы);
    Измерения.Добавить("Сотрудник"); СвояБаза = БазаРасчетов(Измерения, Виды, Строки, Наборы);
    Для Каждого С Из Строки Цикл
        Если С.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда Продолжить; КонецЕсли;
        Ключ = КлючЗаписи(С.Регистратор, С.НомерСтроки); Д = Записи.Получить(Ключ); Г = Графики.Получить(Ключ);
        Работник = Сотрудники.Найти(С.Сотрудник, "Ссылка");
        Месяц = НачалоМесяца(С.ПериодДействияНачало);
        Стаж = Макс(0, (Год(Месяц) - Год(Работник.НачалоСтажа)) * 12 + Месяц(Месяц) - Месяц(Работник.НачалоСтажа));
        Если День(Месяц) < День(Работник.НачалоСтажа) Тогда Стаж = Макс(0, Стаж - 1); КонецЕсли;
        Д.Стаж = Стаж / 12; Д.Процент = 0;
        Для Каждого Порог Из Шкала Цикл Если Порог.СтажОт <= Д.Стаж Тогда Д.Процент = Порог.Процент; КонецЕсли; КонецЦикла;
        Отбор = Новый Структура("Регистратор,НомерСтроки", С.Регистратор, С.НомерСтроки);
        База = 0;
        Для Каждого Б Из ОбщаяБаза.НайтиСтроки(Отбор) Цикл База = База + Б.РезультатБаза; КонецЦикла;
        Для Каждого Б Из СвояБаза.НайтиСтроки(Отбор) Цикл База = База - Б.РезультатБаза; КонецЦикла;
        Д.Результат = ?(Г.Норма = 0, 0, Окр(База * Д.Процент / 100 * МодульЧисла(Г.Часы / Г.Норма), 2)) * ?(С.Сторно, -1, 1); Д.Дни = 0;
    КонецЦикла;
    ЗаписатьНаборы(Наборы);
    Виды.Очистить(); Виды.Добавить(ПланыВидовРасчета.ОсновныеНачисления.Командировка);
    Измерения = Новый Массив; Измерения.Добавить("Сотрудник");
    БазаКомандировок = БазаРасчетов(Измерения, Виды, Строки, Наборы);
    Командировки = Строки.Скопировать(); Командировки.Сортировать("ПериодДействияНачало, Регистратор, НомерСтроки");
    КорректировкиБазы = Новый Массив;
    Для Каждого С Из Командировки Цикл
        Если С.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда Продолжить; КонецЕсли;
        Ключ = КлючЗаписи(С.Регистратор, С.НомерСтроки); Д = Записи.Получить(Ключ); Г = Графики.Получить(Ключ);
        Сумма = 0; Дни = 0;
        Для Каждого Б Из БазаКомандировок.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", С.Регистратор, С.НомерСтроки)) Цикл
            Сумма = Сумма + Б.РезультатБаза; Дни = Дни + Б.ДниБаза;
        КонецЦикла;
        // База уже содержит прежние значения командировок. Учитываем разницы ранее
        // рассчитанных месяцев в памяти, без чтения регистра в цикле.
        Для Каждого Корректировка Из КорректировкиБазы Цикл
            Если Корректировка.Сотрудник = С.Сотрудник И Корректировка.Месяц >= С.БазовыйПериодНачало И Корректировка.Месяц <= С.БазовыйПериодКонец Тогда
                Сумма = Сумма + Корректировка.Разница;
            КонецЕсли;
        КонецЦикла;
        Д.Результат = ?(Дни = 0, 0, Окр(Сумма / Дни * Г.Дни, 2)); Д.Дни = 0;
        КорректировкиБазы.Добавить(Новый Структура("Сотрудник,Месяц,Разница", С.Сотрудник, НачалоМесяца(С.ПериодДействияНачало), Д.Результат - С.Результат));
    КонецЦикла;
    ЗаписатьНаборы(Наборы);
КонецПроцедуры

Функция МодульЧисла(Число)
    Возврат Макс(Число, -Число);
КонецФункции

Процедура ЯчейкаОтчета(Документ, НомерСтроки, НомерКолонки, Значение, Жирный = Ложь)
    Область = Документ.Область(НомерСтроки, НомерКолонки);
    Если ТипЗнч(Значение) = Тип("Число") Тогда
        Область.СодержитЗначение = Истина; Область.Значение = Значение;
    Иначе Область.Текст = Строка(Значение); КонецЕсли;
    Если Жирный Тогда Область.Шрифт = Новый Шрифт(, , Истина); КонецЕсли;
КонецПроцедуры

Процедура ВывестиОтчет(Документ, Таблица, Вид, НачалоПериода, КонецПериода, Подразделение = Неопределено) Экспорт
    Документ.АвтоМасштаб = Истина;
    Если Вид = "Премии" Тогда
        Заголовки = СтрРазделить("Сотрудник;Трудовой стаж, лет;% премии;Сумма премии", ";");
        Поля = СтрРазделить("Сотрудник;Стаж;Процент;Сумма", ";");
        ЯчейкаОтчета(Документ, 1, 1, "Месяц: " + Формат(НачалоПериода, "ДФ='ММММ гггг'"), Истина);
    ИначеЕсли Вид = "ВедомостьПодразделения" Тогда
        Заголовки = СтрРазделить("Производитель;Товар;Нач. ост.;Приход;Расход;Кон. ост.", ";");
        Поля = СтрРазделить("Производитель;Номенклатура;НачСумма;ПриходСумма;РасходСумма;КонСумма", ";");
        ЯчейкаОтчета(Документ, 1, 1, "Ведомость по подразделению «" + Строка(Подразделение) + "» за период с " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy") + " по " + Формат(КонецПериода, "ДФ=dd.MM.yyyy"), Истина);
    Иначе
        Заголовки = СтрРазделить("Номенклатура;Кол-во;Себестоимость;Продажа;Прибыль", ";");
        Поля = СтрРазделить("Номенклатура;Количество;Себестоимость;Выручка;Прибыль", ";");
        Если Вид = "ПродажиБухгалтерские" Тогда Заголовки.Вставить(1, "Продано"); Поля.Вставить(1, "Продано"); КонецЕсли;
        ЯчейкаОтчета(Документ, 1, 1, "Продажи с " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy") + " по " + Формат(КонецПериода, "ДФ=dd.MM.yyyy"), Истина);
    КонецЕсли;
    Для Индекс = 0 По Заголовки.Количество() - 1 Цикл
        ЯчейкаОтчета(Документ, 3, Индекс + 1, Заголовки[Индекс], Истина);
        Документ.Область(, Индекс + 1, , Индекс + 1).ШиринаКолонки = ?(Индекс < 2, 30, 18);
    КонецЦикла;
    Номер = 4; ПредыдущаяГруппа = Неопределено;
    Для Каждого С Из Таблица Цикл
        Если Вид = "ПродажиБухгалтерские" И (ПредыдущаяГруппа = Неопределено Или ПредыдущаяГруппа <> С.Номенклатура) Тогда
            ЯчейкаОтчета(Документ, Номер, 1, С.Номенклатура, Истина);
            СтрокиГруппы = Таблица.НайтиСтроки(Новый Структура("Номенклатура", С.Номенклатура));
            Для Индекс = 2 По Поля.Количество() - 1 Цикл
                Итого = 0; Для Каждого Г Из СтрокиГруппы Цикл Итого = Итого + Г[Поля[Индекс]]; КонецЦикла;
                ЯчейкаОтчета(Документ, Номер, Индекс + 1, Итого, Истина);
            КонецЦикла;
            ПредыдущаяГруппа = С.Номенклатура; Номер = Номер + 1;
        КонецЕсли;
        Если Вид = "ВедомостьПодразделения" Тогда
            Если ПредыдущаяГруппа = Неопределено Или ПредыдущаяГруппа <> С.Производитель Тогда
                ЯчейкаОтчета(Документ, Номер, 1, С.Производитель, Истина); Номер = Номер + 1; ПредыдущаяГруппа = С.Производитель;
            КонецЕсли;
            ЯчейкаОтчета(Документ, Номер, 2, С.Номенклатура);
            Количества = СтрРазделить("НачКоличество;ПриходКоличество;РасходКоличество;КонКоличество", ";");
            Для Индекс = 0 По 3 Цикл
                ЯчейкаОтчета(Документ, Номер, Индекс + 3, С[Количества[Индекс]]);
                ЯчейкаОтчета(Документ, Номер + 1, Индекс + 3, С[Поля[Индекс + 2]]);
            КонецЦикла;
            Номер = Номер + 2;
        Иначе
            Для Индекс = 0 По Поля.Количество() - 1 Цикл
                Если Вид = "ПродажиБухгалтерские" И Индекс = 0 Тогда Продолжить; КонецЕсли;
                ЯчейкаОтчета(Документ, Номер, Индекс + 1, С[Поля[Индекс]]);
            КонецЦикла;
            Номер = Номер + 1;
        КонецЕсли;
    КонецЦикла;
    ЯчейкаОтчета(Документ, Номер, 1, "ИТОГО", Истина);
    Для Индекс = 0 По Поля.Количество() - 1 Цикл
        Поле = Поля[Индекс];
        Если Таблица.Колонки.Найти(Поле) <> Неопределено И Таблица.Колонки[Поле].ТипЗначения.СодержитТип(Тип("Число")) И Поле <> "Стаж" И Поле <> "Процент" Тогда
            ЯчейкаОтчета(Документ, Номер, Индекс + 1, Таблица.Итог(Поле), Истина);
        КонецЕсли;
    КонецЦикла;
    Документ.Область(1, 1, 1, Поля.Количество()).Объединить();
    ЛинияСетки = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
    Для СтрокаСетки = 3 По Номер Цикл
        Для КолонкаСетки = 1 По Поля.Количество() Цикл
            Область = Документ.Область(СтрокаСетки, КолонкаСетки);
            Область.ГраницаСверху = ЛинияСетки; Область.ГраницаСнизу = ЛинияСетки;
            Область.ГраницаСлева = ЛинияСетки; Область.ГраницаСправа = ЛинияСетки;
            Если СтрокаСетки = 3 Тогда Область.ЦветФона = Новый Цвет(235, 235, 235); КонецЕсли;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры
Процедура НастроитьПланСчетов() Экспорт
    Товары = ПланыСчетов.Управленческий.Товары.ПолучитьОбъект();
    Прибыль = ПланыСчетов.Управленческий.ПрибылиУбытки.ПолучитьОбъект();
    Если Товары.ВидыСубконто.Количество() = 2 И Прибыль.ВидыСубконто.Количество() = 2 И Прибыль.ВидыСубконто[0].Количественный Тогда Возврат; КонецЕсли;
    Товары.Количественный = Истина; Товары.ВидыСубконто.Очистить();
    С = Товары.ВидыСубконто.Добавить(); С.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура; С.Суммовой = Истина; С.Количественный = Истина;
    С = Товары.ВидыСубконто.Добавить(); С.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Склад; С.Суммовой = Ложь; С.Количественный = Истина;
    Товары.Записать();
    Прибыль.ВидыСубконто.Очистить();
    С = Прибыль.ВидыСубконто.Добавить(); С.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Заказано; С.ТолькоОбороты = Истина; С.Суммовой = Истина; С.Количественный = Истина;
    С = Прибыль.ВидыСубконто.Добавить(); С.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Продано; С.ТолькоОбороты = Истина; С.Суммовой = Истина; С.Количественный = Истина;
    Прибыль.Записать();
КонецПроцедуры

Процедура ЗаполнитьСубконто(Движение, Счет, Сторона, Значение1, Значение2) Экспорт
    Индекс = 0;
    Для Каждого С Из Счет.ВидыСубконто Цикл
        Движение["Субконто" + Сторона][С.ВидСубконто] = ?(Индекс = 0, Значение1, Значение2);
        Индекс = Индекс + 1;
    КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьПримерЗарплаты() Экспорт
    Отдел = ПримерСправочник("Подразделения", "Отдел продаж (пример)");
    Работник = ПримерСправочник("ФизическиеЛица", "Петров П.П. (пример)");
    Руководитель = ПримерСправочник("ФизическиеЛица", "Иванов И.И. (пример)");
    О = Работник.ПолучитьОбъект(); О.НачалоСтажа = Дата(2021,1,1); О.Записать();
    О = Руководитель.ПолучитьОбъект(); О.НачалоСтажа = Дата(2019,1,1); О.Записать();
    График = РегистрыСведений.ГрафикиПодразделений.СоздатьНаборЗаписей(); График.Отбор.Подразделение.Установить(Отдел);
    ДеньГрафика = Дата(2024,1,1);
    Пока ДеньГрафика < Дата(2024,6,1) Цикл
        С = График.Добавить(); С.Подразделение = Отдел; С.Дата = ДеньГрафика;
        С.Часы = ?(ДеньНедели(ДеньГрафика) <= 5, 8, 0); С.Дни = ?(С.Часы > 0, 1, 0); ДеньГрафика = ДеньГрафика + 86400;
    КонецЦикла;
    График.Записать();
    Сотрудники = Новый Массив; Сотрудники.Добавить(Работник); Сотрудники.Добавить(Руководитель);
    Для Каждого Сотрудник Из Сотрудники Цикл
        Запись = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи(); Запись.Период = Дата(2024,1,1); Запись.Сотрудник = Сотрудник; Запись.Подразделение = Отдел; Запись.Ставка = 100; Запись.Записать();
    КонецЦикла;
    Шкала = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Шкала.СтажОт = 0; Шкала.Процент = 5; Шкала.Записать();
    Шкала.СтажОт = 1; Шкала.Процент = 10; Шкала.Записать(); Шкала.СтажОт = 3; Шкала.Процент = 15; Шкала.Записать();
    Для НомерМесяца = 1 По 4 Цикл
        Док = Документы.НачислениеЗарплаты.СоздатьДокумент(); Док.Дата = КонецМесяца(Дата(2024,НомерМесяца,1));
        Для Каждого Сотрудник Из Сотрудники Цикл
            С = Док.ОсновныеНачисления.Добавить(); С.Сотрудник = Сотрудник; С.Подразделение = Отдел;
            С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф; С.ДатаНачала = НачалоМесяца(Док.Дата); С.ДатаОкончания = КонецМесяца(Док.Дата);
        КонецЦикла;
        Если НомерМесяца > 1 Тогда
            С = Док.ОсновныеНачисления.Добавить(); С.Сотрудник = Руководитель; С.Подразделение = Отдел;
            С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия; С.ДатаНачала = НачалоМесяца(Док.Дата); С.ДатаОкончания = КонецМесяца(Док.Дата);
        КонецЕсли;
        Если НомерМесяца = 4 Тогда
            С = Док.ОсновныеНачисления.Добавить(); С.Сотрудник = Работник; С.Подразделение = Отдел;
            С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка; С.ДатаНачала = Дата(2024,4,15); С.ДатаОкончания = Дата(2024,4,19);
        КонецЕсли;
        Док.Записать(РежимЗаписиДокумента.Проведение);
    КонецЦикла;
    // Позднее отклонение прошлого месяца и одна командировка через границу месяцев.
    Для НомерПримера = 1 По 2 Цикл
        Док = Документы.НачислениеЗарплаты.СоздатьДокумент(); Док.Дата = Дата(2024,5,10);
        С = Док.ОсновныеНачисления.Добавить(); С.Сотрудник = Работник; С.Подразделение = Отдел;
        С.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
        Если НомерПримера = 1 Тогда С.ДатаНачала = Дата(2024,1,15); С.ДатаОкончания = Дата(2024,1,19);
        Иначе С.ДатаНачала = Дата(2024,4,29); С.ДатаОкончания = Дата(2024,5,3); КонецЕсли;
        Док.Записать(РежимЗаписиДокумента.Проведение);
    КонецЦикла;
    Вид = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Срок кредита, дни", Истина);
    Если Вид.Пустая() Тогда
        О = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); О.Наименование = "Срок кредита, дни"; О.ТипЗначения = Новый ОписаниеТипов("Число"); О.Записать(); Вид = О.Ссылка;
    КонецЕсли;
    СрокКредита = Вид;
    ВалютаКредита = ВидСведенияПримера("Валюта кредита", "СправочникСсылка.Валюты");
    Регион = ВидСведенияПримера("Регион", "Строка");
    О = Руководитель.ПолучитьОбъект(); О.ДополнительныеСведения.Очистить();
    О.ДополнительныеСведения.Добавить().ВидСведения = ВалютаКредита;
    О.ДополнительныеСведения.Добавить().ВидСведения = СрокКредита;
    О.ДополнительныеСведения.Добавить().ВидСведения = Регион; О.Записать();
    Контрагент = ПримерСправочник("Контрагенты", "Завод Сатурн (пример)"); О = Контрагент.ПолучитьОбъект(); О.Менеджер = Руководитель;
    О.ДополнительныеСведения.Очистить();
    С = О.ДополнительныеСведения.Добавить(); С.ВидСведения = ВалютаКредита; С.Значение = Справочники.Валюты.РоссийскийРубль;
    С = О.ДополнительныеСведения.Добавить(); С.ВидСведения = СрокКредита; С.Значение = 10;
    С = О.ДополнительныеСведения.Добавить(); С.ВидСведения = Регион; С.Значение = "Москва"; О.Записать();
    Вид = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Производитель", Истина);
    Если Вид.Пустая() Тогда
        О = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); О.Наименование = "Производитель"; О.ТипЗначения = Новый ОписаниеТипов("Строка"); О.Записать(); Вид = О.Ссылка;
    КонецЕсли;
    Запись = РегистрыСведений.ЗначенияСвойств.СоздатьМенеджерЗаписи(); Запись.Свойство = Справочники.СвойстваДеталей.НайтиПоНаименованию("ASUS (пример)", Истина); Запись.Характеристика = Вид; Запись.Значение = "ASUS"; Запись.Записать();
КонецПроцедуры
Процедура ПроверитьОстаткиПриОтмене(Документ) Экспорт
    Блокировать("РегистрНакопления.ОстаткиНоменклатуры");
    Блокировать("РегистрБухгалтерии.Хозрасчетный");
    Если Документ.Метаданные().Имя <> "Операция" Тогда
        Набор = РегистрыНакопления.ОстаткиНоменклатуры.СоздатьНаборЗаписей(); Набор.Отбор.Регистратор.Установить(Документ.Ссылка); Набор.Записать();
        Ошибки = ЗапросТаблица("ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура, Подразделение, Свойство, Партия, КоличествоОстаток, СуммаОстаток
        | ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Конец, Партия = &Партия)
        | ГДЕ КоличествоОстаток < 0 ИЛИ СуммаОстаток < 0", Новый Структура("Конец,Партия", Дата(3999,12,31), Документ.Ссылка));
        Если Ошибки.Количество() > 0 Тогда ВызватьИсключение "Отмена проведения создаст отрицательные остатки. Сначала отмените последующие документы."; КонецЕсли;
    КонецЕсли;
    Если Документ.Метаданные().Имя <> "Сборка" Тогда
        Набор = РегистрыБухгалтерии.Хозрасчетный.СоздатьНаборЗаписей(); Набор.Отбор.Регистратор.Установить(Документ.Ссылка); Набор.Записать();
        Виды = Новый Массив; Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура); Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склад);
        Ошибки = ЗапросТаблица("ВЫБРАТЬ ПЕРВЫЕ 1 Субконто1, Субконто2, КоличествоОстаток
        | ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Конец, Счет = &Счет, &Виды, )
        | ГДЕ КоличествоОстаток < 0", Новый Структура("Конец,Счет,Виды", Дата(3999,12,31), ПланыСчетов.Управленческий.Товары, Виды));
        Если Ошибки.Количество() > 0 Тогда ВызватьИсключение "Отмена проведения создаст нехватку товаров на складе"; КонецЕсли;
        Виды.Удалить(1);
        Ошибки = ЗапросТаблица("ВЫБРАТЬ ПЕРВЫЕ 1 Субконто1, СуммаОстаток
        | ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Конец, Счет = &Счет, &Виды, )
        | ГДЕ СуммаОстаток < 0", Новый Структура("Конец,Счет,Виды", Дата(3999,12,31), ПланыСчетов.Управленческий.Товары, Виды));
        Если Ошибки.Количество() > 0 Тогда ВызватьИсключение "Отмена проведения создаст отрицательную стоимость товаров"; КонецЕсли;
    КонецЕсли;
КонецПроцедуры

Функция РасходПоСредней(Документ, Партии, Количество, ВсегоКоличество, ВсегоСумма)
    Себестоимость = ?(Количество = ВсегоКоличество, ВсегоСумма, Окр(ВсегоСумма * Количество / ВсегоКоличество, 2));
    ОсталосьСписать = Количество; Распределение = Новый Массив;
    Для Каждого П Из Партии Цикл
        Списать = Мин(Макс(П.Количество, 0), ОсталосьСписать);
        Распределение.Добавить(Новый Структура("Остаток,БылоКоличество,НовоеКоличество,БылоСумма", П, П.Количество, П.Количество - Списать, П.Сумма));
        ОсталосьСписать = ОсталосьСписать - Списать;
    КонецЦикла;
    ОсталосьКоличество = ВсегоКоличество - Количество; ОсталосьСумма = ВсегоСумма - Себестоимость;
    // Остаток партий оценивается по средней. Это обеспечивает точную себестоимость,
    // отсутствие отрицательных остатков и обнуление стоимости полностью списанных партий.
    // Нулевые количественные движения перераспределяют балансовую стоимость между партиями.
    Для Каждого Р Из Распределение Цикл
        Если Р.НовоеКоличество = 0 Тогда НоваяСумма = 0;
        ИначеЕсли Р.НовоеКоличество = ОсталосьКоличество Тогда НоваяСумма = ОсталосьСумма;
        Иначе НоваяСумма = Мин(ОсталосьСумма, Окр(ОсталосьСумма * Р.НовоеКоличество / ОсталосьКоличество, 2)); КонецЕсли;
        П = Р.Остаток; СписатьКоличество = Р.БылоКоличество - Р.НовоеКоличество; СписатьСумма = Р.БылоСумма - НоваяСумма;
        Если СписатьКоличество <> 0 Или СписатьСумма <> 0 Тогда
            Д = Документ.Движения.ОстаткиНоменклатуры.Добавить(); Д.Период = Документ.Дата; Д.ВидДвижения = ВидДвиженияНакопления.Расход;
            Д.Подразделение = П.Подразделение; Д.Номенклатура = П.Номенклатура; Д.Свойство = П.Свойство; Д.Партия = П.Партия;
            Д.Количество = СписатьКоличество; Д.Сумма = СписатьСумма;
        КонецЕсли;
        П.Количество = Р.НовоеКоличество; П.Сумма = НоваяСумма;
        ОсталосьКоличество = ОсталосьКоличество - Р.НовоеКоличество; ОсталосьСумма = ОсталосьСумма - НоваяСумма;
    КонецЦикла;
    Возврат Себестоимость;
КонецФункции

Процедура ПроверитьНакладную(Документ)
    Если Документ.СписокНоменклатуры.Количество() = 0 Тогда ВызватьИсключение "Не заполнена табличная часть накладной"; КонецЕсли;
    Для Каждого С Из Документ.СписокНоменклатуры Цикл
        Если Не ЗначениеЗаполнено(С.Номенклатура) Тогда ВызватьИсключение "Укажите номенклатуру"; КонецЕсли;
        Если С.Количество <= 0 Тогда ВызватьИсключение "Количество должно быть положительным"; КонецЕсли;
        Если СуммаСтроки(С) < 0 Тогда ВызватьИсключение "Сумма не может быть отрицательной"; КонецЕсли;
        Если Не ЗначениеЗаполнено(Документ.Склад) И Не ЗначениеЗаполнено(Документ.Подразделение) И Не ЗначениеЗаполнено(С.Подразделение) Тогда
            ВызватьИсключение "Для строки необходимо указать подразделение либо склад в шапке накладной";
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ВидСведенияПримера(Наименование, ИмяТипа)
    Вид = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(Наименование, Истина);
    Если Вид.Пустая() Тогда
        О = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); О.Наименование = Наименование; О.ТипЗначения = Новый ОписаниеТипов(ИмяТипа); О.Записать(); Вид = О.Ссылка;
    КонецЕсли;
    Возврат Вид;
КонецФункции
