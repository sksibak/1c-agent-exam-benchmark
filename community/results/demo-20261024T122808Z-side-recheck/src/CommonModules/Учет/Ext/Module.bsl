// Серверные алгоритмы проведения. Таблицы остатков читаются однократно после блокировки.
Процедура Блокировать(ИмяРегистра) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить(ИмяРегистра);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры

Функция ЗапросТаблица(Текст, Параметры = Неопределено) Экспорт
    Запрос = Новый Запрос(Текст);
    Если Параметры <> Неопределено Тогда
        Для Каждого П Из Параметры Цикл Запрос.УстановитьПараметр(П.Ключ, П.Значение); КонецЦикла;
    КонецЕсли;
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ОстаткиОУ(Документ, ЧитатьОстатки = Истина) Экспорт
    Блокировать("РегистрНакопления.ОстаткиНоменклатуры");
    Документ.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Документ.Движения.ОстаткиНоменклатуры.Очистить();
    Документ.Движения.ОстаткиНоменклатуры.Записать();
    Если Не ЧитатьОстатки Тогда Возврат Неопределено; КонецЕсли;
    Подразделения = Новый Массив;
    Если Документ.Метаданные().Имя = "Сборка" Тогда
        Подразделения.Добавить(Документ.Источник); Подразделения.Добавить(Документ.Получатель);
    Иначе
        Подразделения.Добавить(Документ.Подразделение);
        Для Каждого С Из Документ.СписокНоменклатуры Цикл
            Если Подразделения.Найти(С.Подразделение) = Неопределено Тогда Подразделения.Добавить(С.Подразделение); КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    П = Новый Структура("Момент,Подразделения", Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая), Подразделения);
    Возврат ЗапросТаблица("ВЫБРАТЬ Подразделение, Номенклатура, Свойство, Партия,
    | Партия.Дата КАК ДатаПартии, КоличествоОстаток КАК Количество, СуммаОстаток КАК Сумма
    | ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Момент, Подразделение В (&Подразделения))", П);
КонецФункции

Функция РасходОУ(Документ, Остатки, Подразделение, Товар, Свойство, Знач Количество, Метод) Экспорт
    Если Количество <= 0 Тогда ВызватьИсключение "Количество должно быть положительным"; КонецЕсли;
    Отбор = Новый Структура("Подразделение,Номенклатура,Свойство", Подразделение, Товар, Свойство);
    Партии = Остатки.НайтиСтроки(Отбор);
    Всего = 0; Стоимость = 0;
    Для Каждого П Из Партии Цикл Всего = Всего + П.Количество; Стоимость = Стоимость + П.Сумма; КонецЦикла;
    Если Всего < Количество Тогда ВызватьИсключение "Недостаточно: " + Строка(Товар) + ", подразделение " + Строка(Подразделение); КонецЕсли;
    Если Метод = Перечисления.УчетнаяПолитика.Средняя Тогда
        Возврат РасходПоСредней(Документ, Партии, Количество, Всего, Стоимость);
    КонецЕсли;
    Осталось = Количество; Результат = 0;
    Для Каждого П Из Партии Цикл
        Если Осталось = 0 Тогда Прервать; КонецЕсли;
        Если П.Количество <= 0 Тогда Продолжить; КонецЕсли;
        К = Мин(П.Количество, Осталось);
        Если К = П.Количество Тогда С = П.Сумма; Иначе С = Окр(П.Сумма * К / П.Количество, 2); КонецЕсли;
        Д = Документ.Движения.ОстаткиНоменклатуры.Добавить();
        Д.Период = Документ.Дата; Д.ВидДвижения = ВидДвиженияНакопления.Расход;
        Д.Подразделение = Подразделение; Д.Номенклатура = Товар; Д.Свойство = Свойство;
        Д.Партия = П.Партия; Д.Количество = К; Д.Сумма = С;
        П.Количество = П.Количество - К; П.Сумма = П.Сумма - С;
        Результат = Результат + С; Осталось = Осталось - К;
    КонецЦикла;
    Если Осталось <> 0 Тогда ВызватьИсключение "Ошибка распределения количества по партиям"; КонецЕсли;
    Возврат Результат;
КонецФункции

Процедура ПриходОУ(Документ, Подразделение, Товар, Свойство, Количество, Сумма) Экспорт
    Если Количество <= 0 Или Сумма < 0 Тогда ВызватьИсключение "Некорректное количество или сумма"; КонецЕсли;
    Д = Документ.Движения.ОстаткиНоменклатуры.Добавить();
    Д.Период = Документ.Дата; Д.ВидДвижения = ВидДвиженияНакопления.Приход;
    Д.Подразделение = Подразделение; Д.Номенклатура = Товар; Д.Свойство = Свойство;
    Д.Партия = Документ.Ссылка; Д.Количество = Количество; Д.Сумма = Сумма;
КонецПроцедуры

Функция СуммаСтроки(СтрокаТЧ) Экспорт
    Если СтрокаТЧ.Сумма <> 0 Тогда Возврат СтрокаТЧ.Сумма; КонецЕсли;
    Возврат Окр(СтрокаТЧ.Количество * СтрокаТЧ.Цена, 2);
КонецФункции

Функция Проводка(Документ, Дебет, Кредит, Сумма) Экспорт
    Д = Документ.Движения.Хозрасчетный.Добавить(); Д.Период = Документ.Дата;
    Д.СчетДт = Дебет; Д.СчетКт = Кредит; Д.Сумма = Сумма; Д.Активность = Истина;
    Возврат Д;
КонецФункции

Процедура Приход(Документ) Экспорт
    ПроверитьНакладную(Документ);
    НастроитьПланСчетов();
    Документ.Движения.Хозрасчетный.Очистить();
    ОстаткиОУ(Документ, Ложь);
    Документ.Движения.Хозрасчетный.Записывать = Истина;
    Для Каждого С Из Документ.СписокНоменклатуры Цикл
        Если С.Количество <= 0 Тогда ВызватьИсключение "Количество должно быть положительным"; КонецЕсли;
        П = ?(ЗначениеЗаполнено(С.Подразделение), С.Подразделение, Документ.Подразделение);
        Если ЗначениеЗаполнено(П) Тогда
            Документ.Движения.ОстаткиНоменклатуры.Записывать = Истина;
            ПриходОУ(Документ, П, С.Номенклатура, С.Свойство, С.Количество, СуммаСтроки(С));
        КонецЕсли;
        Если ЗначениеЗаполнено(Документ.Склад) Тогда
            Д = Проводка(Документ, ПланыСчетов.Управленческий.Товары, ПланыСчетов.Управленческий.Поставщики, СуммаСтроки(С));
            ЗаполнитьСубконто(Д, Д.СчетДт, "Дт", С.Номенклатура, Документ.Склад); Д.КоличествоДт = С.Количество;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ПродажаОУ(Документ) Экспорт
    ПроверитьНакладную(Документ);
    Документ.Движения.Продажи.Очистить();
    Остатки = ОстаткиОУ(Документ);
    СтрокиПродажи = Документ.СписокНоменклатуры.Выгрузить();
    Для Каждого С Из СтрокиПродажи Цикл
        Если С.Количество <= 0 Тогда ВызватьИсключение "Количество должно быть положительным"; КонецЕсли;
        С.Сумма = СуммаСтроки(С);
        Если Не ЗначениеЗаполнено(С.Подразделение) Тогда С.Подразделение = Документ.Подразделение; КонецЕсли;
    КонецЦикла;
    СтрокиПродажи.Свернуть("Подразделение,Номенклатура,Свойство", "Количество,Сумма");
    Политики = ЗапросТаблица("ВЫБРАТЬ Подразделение, Метод ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, )", Новый Структура("Дата", Документ.Дата));
    Документ.Движения.Продажи.Записывать = Истина;
    Для Каждого С Из СтрокиПродажи Цикл
        П = ?(ЗначениеЗаполнено(С.Подразделение), С.Подразделение, Документ.Подразделение);
        Если Не ЗначениеЗаполнено(П) Тогда Продолжить; КонецЕсли;
        Пол = Политики.Найти(П, "Подразделение");
        Если Пол = Неопределено Тогда ВызватьИсключение "Не задана учетная политика подразделения " + Строка(П); КонецЕсли;
        Остатки.Сортировать("ДатаПартии " + ?(Пол.Метод = Перечисления.УчетнаяПолитика.ЛИФО, "УБЫВ", "ВОЗР") + ", Партия");
        Стоимость = РасходОУ(Документ, Остатки, П, С.Номенклатура, С.Свойство, С.Количество, Пол.Метод);
        Д = Документ.Движения.Продажи.Добавить(); Д.Период = Документ.Дата;
        Д.Номенклатура = С.Номенклатура; Д.Подразделение = П; Д.Количество = С.Количество;
        Д.Себестоимость = Стоимость; Д.Выручка = С.Сумма;
    КонецЦикла;
КонецПроцедуры

Функция ГруппаАналогов(Товар, Связи) Экспорт
    Группа = Новый Массив; Группа.Добавить(Товар);
    Индекс = 0;
    Пока Индекс < Группа.Количество() Цикл
        Текущий = Группа[Индекс];
        Для Каждого Связь Из Связи Цикл
            Если Связь.Товар = Текущий И Группа.Найти(Связь.Аналог) = Неопределено Тогда Группа.Добавить(Связь.Аналог); КонецЕсли;
            Если Связь.Аналог = Текущий И Группа.Найти(Связь.Товар) = Неопределено Тогда Группа.Добавить(Связь.Товар); КонецЕсли;
        КонецЦикла;
        Индекс = Индекс + 1;
    КонецЦикла;
    Возврат Группа;
КонецФункции

Процедура ПродажаБУ(Документ) Экспорт
    НастроитьПланСчетов();
    Если Не ЗначениеЗаполнено(Документ.Склад) Тогда Возврат; КонецЕсли;
    Блокировать("РегистрБухгалтерии.Хозрасчетный");
    Документ.Движения.Хозрасчетный.Записывать = Истина;
    Документ.Движения.Хозрасчетный.Очистить(); Документ.Движения.Хозрасчетный.Записать();
    СтрокиПродажи = Документ.СписокНоменклатуры.Выгрузить();
    Для Каждого С Из СтрокиПродажи Цикл
        Если С.Количество <= 0 Тогда ВызватьИсключение "Количество должно быть положительным"; КонецЕсли;
        С.Сумма = СуммаСтроки(С);
    КонецЦикла;
    СтрокиПродажи.Свернуть("Номенклатура", "Количество,Сумма");
    Связи = ЗапросТаблица("ВЫБРАТЬ Товар, Аналог ИЗ РегистрСведений.Аналоги");
    НужныеТовары = Новый Массив;
    Для Каждого С Из СтрокиПродажи Цикл
        Для Каждого Т Из ГруппаАналогов(С.Номенклатура, Связи) Цикл
            Если НужныеТовары.Найти(Т) = Неопределено Тогда НужныеТовары.Добавить(Т); КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Виды = Новый Массив; Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура); Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склад);
    Параметры = Новый Структура("Момент,Счет,Виды,Товары,Склад", Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая), ПланыСчетов.Управленческий.Товары, Виды, НужныеТовары, Документ.Склад);
    Остатки = ЗапросТаблица("ВЫБРАТЬ Субконто1 КАК Номенклатура, Субконто1.Артикул КАК Артикул, Субконто2 КАК Склад, КоличествоОстаток КАК Количество
    | ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Момент, Счет = &Счет, &Виды, Субконто1 В (&Товары) И Субконто2 = &Склад)", Параметры);
    Виды = Новый Массив; Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура); Параметры.Виды = Виды;
    Итоги = ЗапросТаблица("ВЫБРАТЬ Субконто1 КАК Номенклатура, КоличествоОстаток КАК Количество, СуммаОстаток КАК Сумма
    | ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Момент, Счет = &Счет, &Виды, Субконто1 В (&Товары))", Параметры);
    Остатки.Сортировать("Артикул, Номенклатура");
    План = Новый ТаблицаЗначений;
    План.Колонки.Добавить("Заказано", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    План.Колонки.Добавить("Продано", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    План.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
    План.Колонки.Добавить("Выручка", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
    План.Колонки.Добавить("Себестоимость", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
    Для Каждого С Из СтрокиПродажи Цикл
        Осталось = С.Количество; ВыручкаОстаток = С.Сумма; Группа = ГруппаАналогов(С.Номенклатура, Связи);
        Для Проход = 1 По 2 Цикл
            Для Каждого П Из Остатки Цикл
                Если Осталось = 0 Тогда Прервать; КонецЕсли;
                Если П.Количество <= 0 Тогда Продолжить; КонецЕсли;
                Если (Проход = 1 И П.Номенклатура <> С.Номенклатура) Или (Проход = 2 И П.Номенклатура = С.Номенклатура) Тогда Продолжить; КонецЕсли;
                Если Группа.Найти(П.Номенклатура) = Неопределено Тогда Продолжить; КонецЕсли;
                К = Мин(Осталось, П.Количество);
                Продажа = План.Добавить(); Продажа.Заказано = С.Номенклатура; Продажа.Продано = П.Номенклатура; Продажа.Количество = К;
                Продажа.Выручка = ?(К = Осталось, ВыручкаОстаток, Окр(С.Сумма * К / С.Количество, 2));
                ВыручкаОстаток = ВыручкаОстаток - Продажа.Выручка; П.Количество = П.Количество - К; Осталось = Осталось - К;
            КонецЦикла;
        КонецЦикла;
        Если Осталось > 0 Тогда ВызватьИсключение "Недостаточно товара и его аналогов: " + Строка(С.Номенклатура); КонецЕсли;
    КонецЦикла;
    // Одна средняя себестоимость на фактически списанную номенклатуру документа.
    // Это исключает зависимость округления от дублей и от нескольких исходных аналогов.
    Списания = План.Скопировать(); Списания.Свернуть("Продано", "Количество");
    Для Каждого С Из Списания Цикл
        Итого = Итоги.Найти(С.Продано, "Номенклатура");
        Если Итого = Неопределено Или Итого.Количество <= 0 Тогда ВызватьИсключение "Нет количественной базы для средней себестоимости"; КонецЕсли;
        СуммаОстаток = ?(С.Количество = Итого.Количество, Итого.Сумма, Окр(Итого.Сумма * С.Количество / Итого.Количество, 2));
        ОбщаяСумма = СуммаОстаток; КоличествоОстаток = С.Количество;
        Для Каждого Продажа Из План.НайтиСтроки(Новый Структура("Продано", С.Продано)) Цикл
            Продажа.Себестоимость = ?(Продажа.Количество = КоличествоОстаток, СуммаОстаток, Мин(СуммаОстаток, Окр(ОбщаяСумма * Продажа.Количество / С.Количество, 2)));
            СуммаОстаток = СуммаОстаток - Продажа.Себестоимость; КоличествоОстаток = КоличествоОстаток - Продажа.Количество;
        КонецЦикла;
    КонецЦикла;
    Для Каждого Продажа Из План Цикл
        Д = Проводка(Документ, ПланыСчетов.Управленческий.ПрибылиУбытки, ПланыСчетов.Управленческий.Товары, Продажа.Себестоимость);
        ЗаполнитьСубконто(Д, Д.СчетКт, "Кт", Продажа.Продано, Документ.Склад); Д.КоличествоКт = Продажа.Количество;
        ЗаполнитьСубконто(Д, Д.СчетДт, "Дт", Продажа.Заказано, Продажа.Продано);
        Д = Проводка(Документ, ПланыСчетов.Управленческий.Покупатели, ПланыСчетов.Управленческий.ПрибылиУбытки, Продажа.Выручка);
        ЗаполнитьСубконто(Д, Д.СчетКт, "Кт", Продажа.Заказано, Продажа.Продано);
    КонецЦикла;
КонецПроцедуры

Процедура Сборка(Документ) Экспорт
    Если Не ЗначениеЗаполнено(Документ.Источник) Или Не ЗначениеЗаполнено(Документ.Получатель) Тогда ВызватьИсключение "Укажите подразделения списания и выпуска"; КонецЕсли;
    Остатки = ОстаткиОУ(Документ); Остатки.Сортировать("ДатаПартии, Партия");
    Если Документ.Блоки.Количество() = 0 Тогда ВызватьИсключение "Не указаны собираемые блоки"; КонецЕсли;
    Спецификации = ЗапросТаблица("ВЫБРАТЬ Блок, Деталь, Свойство, Количество, Период
    | ИЗ РегистрСведений.Спецификации ГДЕ Период <= &Дата", Новый Структура("Дата", Документ.Дата));
    План = Новый ТаблицаЗначений;
    План.Колонки.Добавить("Выпуск", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
    План.Колонки.Добавить("Деталь", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    План.Колонки.Добавить("Свойство", Новый ОписаниеТипов("СправочникСсылка.СвойстваДеталей"));
    План.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3)));
    План.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
    СтоимостиВыпуска = Новый Массив; ИндексВыпуска = 0;
    Для Каждого С Из Документ.Блоки Цикл
        Если С.Количество <= 0 Тогда ВызватьИсключение "Количество должно быть положительным"; КонецЕсли;
        СтоимостиВыпуска.Добавить(0);
        Детали = Спецификации.НайтиСтроки(Новый Структура("Блок", С.Блок)); Актуальная = Дата(1,1,1);
        Для Каждого Д Из Детали Цикл Актуальная = Макс(Актуальная, Д.Период); КонецЦикла;
        Если Актуальная = Дата(1,1,1) Тогда ВызватьИсключение "Нет спецификации блока " + Строка(С.Блок); КонецЕсли;
        Для Каждого Д Из Детали Цикл
            Если Д.Период <> Актуальная Тогда Продолжить; КонецЕсли;
            Требование = План.Добавить(); Требование.Выпуск = ИндексВыпуска; Требование.Деталь = Д.Деталь;
            Требование.Свойство = Д.Свойство; Требование.Количество = С.Количество * Д.Количество;
        КонецЦикла;
        ИндексВыпуска = ИндексВыпуска + 1;
    КонецЦикла;
    Для Каждого С Из Документ.Дополнительно Цикл
        Если С.Количество <= 0 Тогда ВызватьИсключение "Количество дополнительной детали должно быть положительным"; КонецЕсли;
        Требование = План.Добавить(); Требование.Выпуск = -1; Требование.Деталь = С.Деталь; Требование.Свойство = С.Свойство; Требование.Количество = С.Количество;
    КонецЦикла;
    Требования = План.Скопировать(); Требования.Свернуть("Деталь,Свойство", "Количество");
    Для Каждого Т Из Требования Цикл
        Стоимость = РасходОУ(Документ, Остатки, Документ.Источник, Т.Деталь, Т.Свойство, Т.Количество, Перечисления.УчетнаяПолитика.Средняя);
        СуммаОстаток = Стоимость; КоличествоОстаток = Т.Количество;
        Для Каждого Требование Из План.НайтиСтроки(Новый Структура("Деталь,Свойство", Т.Деталь, Т.Свойство)) Цикл
            Требование.Стоимость = ?(Требование.Количество = КоличествоОстаток, СуммаОстаток, Мин(СуммаОстаток, Окр(Стоимость * Требование.Количество / Т.Количество, 2)));
            СуммаОстаток = СуммаОстаток - Требование.Стоимость; КоличествоОстаток = КоличествоОстаток - Требование.Количество;
        КонецЦикла;
    КонецЦикла;
    ДопСтоимость = 0;
    Для Каждого Требование Из План Цикл
        Если Требование.Выпуск = -1 Тогда ДопСтоимость = ДопСтоимость + Требование.Стоимость;
        Иначе СтоимостиВыпуска[Требование.Выпуск] = СтоимостиВыпуска[Требование.Выпуск] + Требование.Стоимость; КонецЕсли;
    КонецЦикла;
    ВсегоБлоков = Документ.Блоки.Итог("Количество"); ИндексВыпуска = 0;
    Для Каждого С Из Документ.Блоки Цикл
        Доп = ?(С.Количество = ВсегоБлоков, ДопСтоимость, Окр(ДопСтоимость * С.Количество / ВсегоБлоков, 2));
        ПриходОУ(Документ, Документ.Получатель, С.Блок, Справочники.СвойстваДеталей.ПустаяСсылка(), С.Количество, СтоимостиВыпуска[ИндексВыпуска] + Доп);
        ДопСтоимость = ДопСтоимость - Доп; ВсегоБлоков = ВсегоБлоков - С.Количество; ИндексВыпуска = ИндексВыпуска + 1;
    КонецЦикла;
КонецПроцедуры

Процедура НастроитьВидыРасчета() Экспорт
    Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф.ПолучитьОбъект();
    Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия.ПолучитьОбъект();
    Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка.ПолучитьОбъект();
    Если Тариф.ВытесняющиеВидыРасчета.Количество() = 1 И Премия.ВытесняющиеВидыРасчета.Количество() = 1 И Премия.БазовыеВидыРасчета.Количество() = 1 И Командировка.БазовыеВидыРасчета.Количество() = 3 Тогда Возврат; КонецЕсли;
    Тариф.ВытесняющиеВидыРасчета.Очистить(); Тариф.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = Командировка.Ссылка;
    Премия.ВытесняющиеВидыРасчета.Очистить(); Премия.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = Командировка.Ссылка;
    Премия.БазовыеВидыРасчета.Очистить(); Премия.БазовыеВидыРасчета.Добавить().ВидРасчета = Тариф.Ссылка;
    Командировка.БазовыеВидыРасчета.Очистить();
    Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = Тариф.Ссылка;
    Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = Премия.Ссылка;
    Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = Командировка.Ссылка;
    Тариф.Записать(); Премия.Записать(); Командировка.Записать();
КонецПроцедуры
Функция ПримерСправочник(Имя, Наименование) Экспорт
    Ссылка = Справочники[Имя].НайтиПоНаименованию(Наименование, Истина);
    Если Не Ссылка.Пустая() Тогда Возврат Ссылка; КонецЕсли;
    Объект = Справочники[Имя].СоздатьЭлемент(); Объект.Наименование = Наименование; Объект.Записать(); Возврат Объект.Ссылка;
КонецФункции

