    НачатьТранзакцию();
    Попытка
    НастроитьВидыРасчета();
    Цех = ПримерСправочник("Подразделения", "Основной цех (пример)");
    Сборочный = ПримерСправочник("Подразделения", "Сборочный цех (пример)");
