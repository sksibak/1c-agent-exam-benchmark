&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ПерестроитьПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент) Экспорт
    ПерестроитьПоля();
КонецПроцедуры

&НаСервере
Процедура СохранитьСведения(ОбъектЗаписи)
    Для Каждого П Из ДинамическиеСведения Цикл
        Найденная = Неопределено;
        Для Каждого Стр Из ОбъектЗаписи.ДополнительныеСведения Цикл
            Если Стр.ВидСведения = П.ВидСведения Тогда Найденная = Стр; Прервать; КонецЕсли;
        КонецЦикла;
        Если Найденная = Неопределено Тогда Найденная = ОбъектЗаписи.ДополнительныеСведения.Добавить(); Найденная.ВидСведения = П.ВидСведения; КонецЕсли;
        Найденная.Значение = ЭтотОбъект[П.ИмяПоля];
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПерестроитьПоля()
    СохранитьСведения(Объект);
    Удаляемые = Новый Массив;
    Для Каждого П Из ДинамическиеСведения Цикл
        Элементы.Удалить(Элементы[П.ИмяПоля]); Удаляемые.Добавить(П.ИмяПоля);
    КонецЦикла;
    ДинамическиеСведения.Очистить();
    ИзменитьРеквизиты(Новый Массив, Удаляемые);
    Если Не ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат; КонецЕсли;
    Виды = Учет.ЗапросТаблица("ВЫБРАТЬ Список.ВидСведения, Список.ВидСведения.Наименование КАК Заголовок, Список.ВидСведения.ТипЗначения КАК ТипЗначения
    | ИЗ (ВЫБРАТЬ ВидСведения, МИНИМУМ(НомерСтроки) КАК Порядок ИЗ Справочник.ФизическиеЛица.ДополнительныеСведения ГДЕ Ссылка = &Менеджер СГРУППИРОВАТЬ ПО ВидСведения) КАК Список УПОРЯДОЧИТЬ ПО Список.Порядок", Новый Структура("Менеджер", Объект.Менеджер));
    Добавляемые = Новый Массив;
    Индекс = 0;
    Для Каждого Вид Из Виды Цикл
        Имя = "Сведение" + Строка(Индекс); Индекс = Индекс + 1;
        Добавляемые.Добавить(Новый РеквизитФормы(Имя, Вид.ТипЗначения));
        П = ДинамическиеСведения.Добавить(); П.ИмяПоля = Имя; П.ВидСведения = Вид.ВидСведения;
    КонецЦикла;
    ИзменитьРеквизиты(Добавляемые);
    Индекс = 0;
    Для Каждого Вид Из Виды Цикл
        Имя = "Сведение" + Строка(Индекс); Индекс = Индекс + 1;
        Поле = Элементы.Добавить(Имя, Тип("ПолеФормы")); Поле.Вид = ВидПоляФормы.ПолеВвода;
        Поле.ПутьКДанным = Имя; Поле.Заголовок = Вид.Заголовок;
        Для Каждого С Из Объект.ДополнительныеСведения Цикл
            Если С.ВидСведения = Вид.ВидСведения Тогда ЭтотОбъект[Имя] = С.Значение; Прервать; КонецЕсли;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    СохранитьСведения(ТекущийОбъект);
КонецПроцедуры

